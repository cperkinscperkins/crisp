;; s-expressions. unenclosed. 
;; comments like this

;; version and provenance information to be included later. 
;; as well as compilation flags.  Though few of them are relevant to metadata. 

;; each def-orchestration results in one .spv file and one .metacrisp file.
;; if there are NO def-orchestrations, then we generate a default one for each kernel, 
;; in which case we'll see one .spv and one .metacrisp file per kernel.

;; aliases
(:aliases
  (def-type iii int)
  (def-type fff float))

;; structs are in reverse dependency order
;; we only need to include structs that are used at kernel boundary.
;; Q: can structs show up in the def-orchestration? 
;; A: likely yes. But that would mean they'd ALSO be at the kernel boundary. 
(:structs
  (def-struct point (x iii) (y int))
  (def-struct rect (min point) (max point)))

;; records are NEW. 
(:records
  (def-record v-point (x fff) (y int)))

#|
;; original
(def-kernel my_kernel (v in-c &out out-c)
  (declare #'(double (cell iii :address-space :global :access :read-only)
              &out (cell double :address-space :global :access :write-only))) 
   ;; some operation that calls (make-scratch-cell iii)
   ...)

(def-kernel rec_kernel (vp)
   (declare #'(v-point))
   ...)


 STRATEGIES.
 Pretend our kernel is like the following
 (def-kernel lighten_image (image-data width height)
   (declare (type image-data (vector uchar :address-space :global :access :read-write))
            (type width height ulong)
            (global-size :derive-from ( width height) :strategy :one-thread-per))
    ...)

  
  Then the metadata for the kernel will have a :global-size entry
  and it's value will be a direct copy of that declaration 
  e.g.
  (:name "lighten_image"
    :source #P"path/to/lighten.crisp"
    :global-size (global-size :derive-from ( width height) :strategy :one-thread-per)
    ... etc.)

|#

;; the .metacrisp file might have multiple kernels.
;; the kernels will also have their "strategy" information recorded here. 
(:kernels 
    
    (:name "my_kernel" 
      :source #P"path/to/some.crisp"
      :global-size (global-size ...)   ;<-- if the kernel declared such, it is copied here.
      :local-size  (local-size ...)
      :num-groups (num-groups :derive-from (n) :strategy :strided)
      (:output-targets ((:spv #P"path/to/some/.spv") (:ptx #P"path/to/some/.ptx")))
        (:physical-signature 
        ;; scratch cell "sc"
        ;; container
        (0 ulong) ;; byte-size
        (1 voidp) ;; data pointer
        ;; offset
        (2 ulong) 

        ;; "v"
        (3 double)

        ;; "in"
        ;; cell
        ;; container
        (4 ulong) ;; byte-size
        (5 voidp) ;; data pointer
        ;; offset
        (6 ulong)  

        ;; "out"
        ;; cell
        ;; container
        (7 ulong) ;; byte-size
        (8 voidp) ;; data pointer
        ;; offset
        (9 ulong))

        ;; if the cell declarations end up repeating address-space and access, that's fine. 

        (:declared-signature
        ;; simple scalar
        (:name v
         :type double
         :range (3 3))

        ;; tensor / vector / matrix params have two extra keys:
        ;;   :rank  N       — number of dimensions (1 for vector, 2 for matrix, N for tensor)
        ;;   :align :compact | :strided
        ;;                  — stride layout strategy
        ;; The :range spans all 3N+3 physical slots:
        ;;   PTR, BYTE_SIZE, OFF_0..N-1, STR_0..N-1, EXT_0..N-1, LENGTH
        ;; Example — a vector (N=1) starting at slot 1:
        ;;   (:name v :type out-vec-t :direction :out
        ;;    :address-space :global :access :read-write
        ;;    :rank 1 :align :compact :range (1 6))
        ;; Example — a matrix (N=2) starting at slot 0:
        ;;   (:name m :type mat-t :direction :out
        ;;    :address-space :global :access :read-write
        ;;    :rank 2 :align :compact :range (0 8))

        ;; cell
        (:name in 
         :type (cell iii ) 
         :address-space :global 
         :access :read-only 
         :range (4 6))

        ;; cell
        (:name out 
         :type (cell double ) 
         :direction :out
         :address-space :global 
         :access :write-only 
         :range (7 9)))


        ;; implicit params could be : debug logging vector, scratch Storage Handles, or
        ;; user defined 'implicit' params.  
        ;; the debug logging one is important to distinguish. 
        ;; tensors (but not cell) will have :size-expr which could be a key or actual value.
        ;; I added :size-expr here, though for a real cell it would not be present
        (:implicit-params
            (:name "sc"
             :msg  "please add an extra 10 bytes"
             :type (cell iii )
             :debug-logging  :true
             :address-space  :local
             :access :read-write
             :range (0 2)))
             :size-expr :match-warp-tile

        ;; ------------------------------------------------------------------
        ;; Endeavor 137 (Chapter 1.5) — NVIDIA :block TMA CuTensorMap descriptor
        ;; ------------------------------------------------------------------
        ;; A :block async barrier that stages a global tile through the Tensor Memory
        ;; Accelerator needs a CUtensorMap: a 128-byte HOST-encoded descriptor of the SOURCE
        ;; tensor's layout plus the tile box.  Unlike a scratch handle (which the hoist just
        ;; cudaMallocs), the hoist must ENCODE this with cuTensorMapEncodeTiled, then — option A,
        ;; our first cut — copy it into a device global and pass its pointer as the implicit arg.
        ;; So this implicit-param carries a :kind discriminator plus everything the encode needs
        ;; that isn't already carried by the described tensor:
        ;;   :kind :tensor-map    — hoist runs cuTensorMapEncodeTiled (NOT cudaMalloc)
        ;;   :describes "a"       — the declared tensor this maps; the hoist reads ITS runtime
        ;;                          base pointer, extents (-> globalDim[]) and strides
        ;;                          (-> globalStride[]) straight from that arg's :range
        ;;   :element-type float  — encode dtype
        ;;   :rank 2
        ;;   :box-dims (4 4)      — compile-time SLM tile box = the per-transfer TMA shape
        ;;   :swizzle :none       — Hopper shared-memory swizzle mode (32/64/128B come later)
        ;;   :address-space :global — option A: the descriptor lives in device global memory
        ;;   :range spans ONE physical slot — the kernel just receives the descriptor pointer
        ;; There is one descriptor per distinct TMA-loaded SOURCE tensor (a matmul that TMA-loads
        ;; A and B has two; multiple load-tile sites against the same source SHARE one).  The
        ;; mbarrier that tracks the transfer is NOT represented here — it is a per-CTA
        ;; addrspace(3) shared global, self-contained in the PTX.
        ;;   (:name "a_tensormap_1"
        ;;    :kind :tensor-map
        ;;    :describes "a"
        ;;    :element-type float
        ;;    :rank 2
        ;;    :box-dims (4 4)
        ;;    :swizzle :none
        ;;    :address-space :global
        ;;    :range (12 12))
     )
     ;;
    (:name "rec_kernel"
     :source #P"path/to/some.crisp"
     (:output-targets ((:spv #P"path/to/some/.spv") (:ptx #P"path/to/some/.ptx")))
     (:physical-signature 
       ;; record is expanded
       (0 float) ; v-point.x
       (1 int)   ; v-point.y
     )
     (:declared-signature
       (:name "vp"
        :type v-point
        :range (0 1))
     )))


;; if there is an orchestration , it is inserted into the .metacrisp file
;; this is the default one.  
(def-orchestration just-vector_add
  (let ((K (my_kernel)) ;; or possibly "gen-my_kernel"
        (v (hoist-scalar K::v))
        (in (make-hoist-cell K::in))
        (out (make-hoist-cell K::out)))
  (launch-sequential (K v in out))
  (copy-back out)))