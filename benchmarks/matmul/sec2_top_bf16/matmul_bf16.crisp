;; Crisp bf16 matmul for §2 — the TOP-CONTENDERS entry.  PROMOTED from chap7_wgmma_bf16.
;;
;; §2 must hold Crisp's BEST kernel, not a convenient one.  It sat empty for bf16 on purpose:
;; the kernel previously here was a chapter-2-class sync-MMA matmul, which measured ~0.5% of
;; cuBLAS and read as "this is what Crisp can do" when it was the second rung of seven.  Rather
;; than leave a misleading number, the entry was removed until the ladder named a winner.
;;
;; It has.  Measured on an H100 PCIe (endeavour 160), verified bit-exact against a host reference:
;;     N=1024   52.8 TFLOPS
;;     N=4096  367.7 TFLOPS  =  67.2% of cuBLAS (547.3)
;; against chapter 4's 76.3 at the same size -- a 4.8x lift from the wgmma rung, and squarely in
;; the band tf32's chapter 7 occupies (67-90%).
;;
;; WHY THIS KERNEL AND NOT chapter 6.  Endeavour 159 found the 16-bit ladder does NOT rank like
;; tf32 -- plain TMA beat warp specialization by 40% at 4096, and the ring was the slowest of the
;; three.  So the winner was measured, not assumed.  wgmma changes that ordering decisively.
;;
;; IT IS A COPY, DELIBERATELY, NOT A REFERENCE.  §2 entries are pinned artifacts: a chapter kernel
;; is free to change as its chapter is explored, and §2 must not silently follow it -- a
;; top-contenders number whose kernel moved under it is not reproducible.  If chapter 7 improves,
;; promoting it again is an explicit act.
;;
;; KNOWN LIMIT AT TIME OF PROMOTION: the harness verified this bit-exact only where N % 3 == 1
;; (1024, 2560, 4096) because of a B-orientation bug in bench_harness.cu -- the kernel reads B as
;; N x K while the reference read it as K x N.  That is a HARNESS defect, not a kernel one (a
;; wrong kernel is not bit-exact at three sizes), and it is fixed; the fix is pending hardware
;; confirmation.

(def-type a-mat (matrix bfloat16 :address-space :global :align :compact :contiguous-term :row-major))
(def-type b-mat (matrix bfloat16 :address-space :global :align :compact :contiguous-term :col-major))
(def-type c-mat (matrix float    :address-space :global :align :compact :contiguous-term :row-major))

(def-kernel matmul (A B &out C)
  (declare #'(a-mat b-mat &out c-mat)
           (local-size :set-to 160))          ; 4 consumer warps (warpgroup 0) + 1 producer warp
  (let ((A-ring (make-scratch-matrix-ring bfloat16 (64 64)  :ring-count 2))   ; 2 x 64(M) x 64(K)
        (B-ring (make-scratch-matrix-ring bfloat16 (256 64) :ring-count 2))   ; 2 x 256(N) x 64(K) B^T
        (D      (make-wgmma-accumulator float (64 256) 0.0))
        (K      (inner-dimension A B))
        (empty  (make-async-barrier-ring :ring-count 2 :mode :block :arrivals 4 :initial-state :signaled))
        (full   (make-async-barrier-ring :ring-count 2 :mode :block :arrivals 2 :initial-state :waiting)))
    (tile-stride C (64 256) (grid-y grid-x)
      (with-warp-specialization (:consumer 4 :producer 1)
        (:consumer
          (set! D (make-wgmma-accumulator float (64 256) 0.0))
          (dotimes (grid-k (/ (to-ulong K) (to-ulong 64)))
            (let ((slot (mod grid-k (to-ulong 2))))
              (await (ring-get full slot))
              (wgmma-accumulate-via-tile (64 256 64) D (ring-get A-ring slot) (ring-get B-ring slot)
                                         :swizzle :128b)
              (signal (ring-get empty slot))))
          (store-tile D C (grid-y grid-x)))
        (:producer
          (dotimes (grid-k (/ (to-ulong K) (to-ulong 64)))
            (let ((slot (mod grid-k (to-ulong 2))))
              (await (ring-get empty slot))
              (load-tile A (ring-get A-ring slot) (grid-y grid-k) :barrier (ring-get full slot) :swizzle :128b)
              (load-tile B (ring-get B-ring slot) (grid-x grid-k) :barrier (ring-get full slot) :swizzle :128b))))))))
