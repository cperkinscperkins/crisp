;; ROOFLINE PROBE B2 — LOADS + PREFETCH AT DISTANCE 2.  probe_loads with a 2D block
;; prefetch running 2 K-steps ahead.  Same 16 block reads per K-iteration; the only change is
;; 24 added prefetch instructions per iteration.
;;
;; WHAT IT TESTS.  The roofline probe showed fetch and math are ALREADY ~95% overlapped, so
;; prefetch cannot pay by hiding loads behind math -- that already happens.  The only way it can
;; pay is by raising memory-level parallelism AMONG THE LOADS, i.e. by making T_loads itself
;; smaller.  This arm measures exactly that: watch T_loads, not T_full.
;;
;; NEVER TRIED AT THIS GEOMETRY.  Every existing prefetch kernel (_kdepth/pf*.crisp) is the
;; SINGLE-subgroup 32x64 shape.  The measurements that retired prefetch (distance 3 = 1.38x,
;; distance 4 = 0.80x) were taken there AND on Windows -- and the levers doc's own Layer 4 rule
;; says a screen on one platform is not evidence about the other.  This is 16 subgroups on Linux.
;;
;; PREFETCH TILING.  A 16-bit 2D prefetch block is at most 16 COLUMNS wide (an illegal :size
;; fails at MODULE BUILD, not at Crisp compile -- see _kdepth/pf1_k32.crisp).  So per K-step:
;;     A  128 rows x  32 cols ->  4 row-blocks x  2 col-blocks =  8 prefetches
;;     B   32 rows x 256 cols ->  1 row-block  x 16 col-blocks = 16 prefetches
;; Coordinates are in units of the :size block. Byte cover is EXACT and was checked against the
;; load footprint: A 8*32*16*2 = 8192 = 128*32*2, B 16*32*16*2 = 16384 = 32*256*2.
;;
;; THIS KERNEL IS NUMERICALLY WRONG BY CONSTRUCTION.  Diagnostic probe only -- see README.md.
(declaim (precision fast))
(def-type a-mat (matrix half :address-space :global :align :compact :contiguous-term :row-major))
(def-type b-mat (matrix half :address-space :global :align :compact :contiguous-term :row-major))
(def-type c-mat (matrix float :address-space :global :align :compact :contiguous-term :row-major))

(def-kernel matmul (A B &out C)
  (declare #'(a-mat b-mat &out c-mat)
           (global-size :derive-from C :strategy :strided)
           (local-size :set-to 256))
  (let ((A-tile (make-register-tile half (128 32) 0.0 :operand :a :warps '(true true true true true true true true true true true true true true true true)))
        (B-tile (make-register-tile half (32 256) 0.0 :operand :b :warps '(true true true true true true true true true true true true true true true true)))
        (C-tile (make-register-tile float (128 256) 0.0 :warps '(true true true true true true true true true true true true true true true true)))
        (n-k-steps (/ (to-ulong (inner-dimension A B)) (to-ulong 32))))
    (tile-stride C (128 256) (grid-y grid-x)
      (progn
        (dotimes (grid-k n-k-steps)
          (let ((prefetch-k (+ grid-k (to-ulong 2))))
            (when (< prefetch-k n-k-steps)
              (prefetch-tile A ((+ (* grid-y (to-ulong 4)) (to-ulong 0)) (+ (* prefetch-k (to-ulong 2)) (to-ulong 0))) :size (32 16))
              (prefetch-tile A ((+ (* grid-y (to-ulong 4)) (to-ulong 0)) (+ (* prefetch-k (to-ulong 2)) (to-ulong 1))) :size (32 16))
              (prefetch-tile A ((+ (* grid-y (to-ulong 4)) (to-ulong 1)) (+ (* prefetch-k (to-ulong 2)) (to-ulong 0))) :size (32 16))
              (prefetch-tile A ((+ (* grid-y (to-ulong 4)) (to-ulong 1)) (+ (* prefetch-k (to-ulong 2)) (to-ulong 1))) :size (32 16))
              (prefetch-tile A ((+ (* grid-y (to-ulong 4)) (to-ulong 2)) (+ (* prefetch-k (to-ulong 2)) (to-ulong 0))) :size (32 16))
              (prefetch-tile A ((+ (* grid-y (to-ulong 4)) (to-ulong 2)) (+ (* prefetch-k (to-ulong 2)) (to-ulong 1))) :size (32 16))
              (prefetch-tile A ((+ (* grid-y (to-ulong 4)) (to-ulong 3)) (+ (* prefetch-k (to-ulong 2)) (to-ulong 0))) :size (32 16))
              (prefetch-tile A ((+ (* grid-y (to-ulong 4)) (to-ulong 3)) (+ (* prefetch-k (to-ulong 2)) (to-ulong 1))) :size (32 16))
              (prefetch-tile B (prefetch-k (+ (* grid-x (to-ulong 16)) (to-ulong 0))) :size (32 16))
              (prefetch-tile B (prefetch-k (+ (* grid-x (to-ulong 16)) (to-ulong 1))) :size (32 16))
              (prefetch-tile B (prefetch-k (+ (* grid-x (to-ulong 16)) (to-ulong 2))) :size (32 16))
              (prefetch-tile B (prefetch-k (+ (* grid-x (to-ulong 16)) (to-ulong 3))) :size (32 16))
              (prefetch-tile B (prefetch-k (+ (* grid-x (to-ulong 16)) (to-ulong 4))) :size (32 16))
              (prefetch-tile B (prefetch-k (+ (* grid-x (to-ulong 16)) (to-ulong 5))) :size (32 16))
              (prefetch-tile B (prefetch-k (+ (* grid-x (to-ulong 16)) (to-ulong 6))) :size (32 16))
              (prefetch-tile B (prefetch-k (+ (* grid-x (to-ulong 16)) (to-ulong 7))) :size (32 16))
              (prefetch-tile B (prefetch-k (+ (* grid-x (to-ulong 16)) (to-ulong 8))) :size (32 16))
              (prefetch-tile B (prefetch-k (+ (* grid-x (to-ulong 16)) (to-ulong 9))) :size (32 16))
              (prefetch-tile B (prefetch-k (+ (* grid-x (to-ulong 16)) (to-ulong 10))) :size (32 16))
              (prefetch-tile B (prefetch-k (+ (* grid-x (to-ulong 16)) (to-ulong 11))) :size (32 16))
              (prefetch-tile B (prefetch-k (+ (* grid-x (to-ulong 16)) (to-ulong 12))) :size (32 16))
              (prefetch-tile B (prefetch-k (+ (* grid-x (to-ulong 16)) (to-ulong 13))) :size (32 16))
              (prefetch-tile B (prefetch-k (+ (* grid-x (to-ulong 16)) (to-ulong 14))) :size (32 16))
              (prefetch-tile B (prefetch-k (+ (* grid-x (to-ulong 16)) (to-ulong 15))) :size (32 16)))
            (load-tile A A-tile (grid-y grid-k))
            (load-tile B B-tile (grid-k grid-x))))
        :epilogue
        (store-tile C-tile C (grid-y grid-x))))))
