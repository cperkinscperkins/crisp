;; Pacing probe: 16 subgroups, workgroup tile 128x256 (32x64 per subgroup), K=32, SPLIT sync-workgroup straddling the K-loop body.
;;
;; QUESTION: does keeping subgroups in step improve L1 reuse on this hardware?  SYCL-TLA straddles
;; its K-loop body with barrier_arrive/barrier_wait (SPV_INTEL_split_barrier) -- that is the
;; "L1Staged" in MainloopXeL1Staged.  It synchronises no data (its kernel has no SLM at all); it
;; stops subgroups drifting apart in K so a line fetched by one is still warm for the other 31.
;;
;; This is the SPLIT twin of mg16_sync.  The rendezvous is announced before the loads and only
;; blocked on after the MMA, so the loads and the dpas chain sit INSIDE the window and can
;; overlap the wait instead of queueing behind it.  Every other knob is identical to the fused
;; twin, so the difference between the two numbers is the overlap and nothing else.
;;
;; Per-warp register demand is ~448 -- the sweet spot the tile x K sweep found (32x32=256 too
;; little work in flight, 640 spills off a cliff).
(declaim (precision fast))
(def-type a-mat (matrix bfloat16 :address-space :global :align :compact :contiguous-term :row-major))
(def-type b-mat (matrix bfloat16 :address-space :global :align :compact :contiguous-term :row-major))
(def-type c-mat (matrix float :address-space :global :align :compact :contiguous-term :row-major))

(def-kernel matmul (A B &out C)
  (declare #'(a-mat b-mat &out c-mat)
           (global-size :derive-from C :strategy :strided)
           (local-size :set-to 256))
  (let ((A-tile (make-register-tile bfloat16 (128 32) 0.0 :operand :a :warps '(true true true true true true true true true true true true true true true true)))
        (B-tile (make-register-tile bfloat16 (32 256) 0.0 :operand :b :warps '(true true true true true true true true true true true true true true true true)))
        (C-tile (make-register-tile float (128 256) 0.0 :warps '(true true true true true true true true true true true true true true true true)))
        (K (inner-dimension A B)))
    (tile-stride C (128 256) (grid-y grid-x)
      (progn
        (dotimes (grid-k (/ (to-ulong K) (to-ulong 32)))
          (sync-workgroup :arrive)
          (load-tile A A-tile (grid-y grid-k))
          (load-tile B B-tile (grid-k grid-x))
          (mma-accumulate-via-tile (8 16 16) C-tile A-tile B-tile)
          (sync-workgroup :wait))
        :epilogue
        (store-tile C-tile C (grid-y grid-x))))))
