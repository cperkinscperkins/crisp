;; Crisp Naive Matmul for INTEL BMG (SPIR-V / L0): C[M x N] = A[M x K] . B[K x N]
;; Section 1, Chapter 0 baseline: Pure scalar element-wise loop across all threads (no XMX tensor cores).

(def-type a-mat (matrix float :address-space :global :align :compact :contiguous-term :row-major))
(def-type b-mat (matrix float :address-space :global :align :compact :contiguous-term :row-major))
(def-type c-mat (matrix float :address-space :global :align :compact :contiguous-term :row-major))

(def-kernel matmul (A B &out C)
  (declare #'(a-mat b-mat &out c-mat => nil)
           (global-size :derive-from C :strategy :one-thread-per)
           (local-size :set-to (16 16)))
  (let ((row (to-int (get-global-id 0)))
        (col (to-int (get-global-id 1)))
        (K   (to-int (inner-dimension A B))))
    (let ((acc 0.0))
      (dotimes (k K)
        (set! acc (+ acc (* (~ A row k) (~ B k col)))))
      (set! (~ C row col) acc))))
