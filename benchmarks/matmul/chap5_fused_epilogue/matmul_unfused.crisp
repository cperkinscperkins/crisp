;; Chapter 5 (Endeavor 150) — UNFUSED baseline, NVIDIA / PTX, tf32.
;;
;; THIS FILE IS THE MEASUREMENT'S CONTROL, and it is why the chapter has four contenders
;; rather than the usual three.
;;
;; The question "does fusing an epilogue pay?" cannot be answered by comparing Crisp against
;; cuBLAS alone, because two effects are superimposed: the fusion win, and Crisp's matmul
;; being ~67% of cuBLAS at scale (endeavour 141).  A single number moves under both and can be
;; read either way.  Running Crisp AGAINST ITSELF separates them:
;;
;;     fusion speedup  =  matmul_unfused  /  matmul_relu      <- fusion alone, matmul cancels
;;     end-to-end      =  (cuBLAS + relu) /  matmul_relu      <- the practical question
;;
;; The matmul kernel below is byte-for-byte matmul_relu.crisp's, MINUS the map-elements! line.
;; The activation is then a SECOND KERNEL over C — a second launch, a full read and write of
;; the C matrix through HBM.  That round trip is exactly what fusion removes, and pricing it
;; is the whole point.
;;
;; Compile: crisp-compile.exe --ir-target=ptx matmul_unfused.crisp
;; The harness launches `matmul` then `relu_pass` and times the PAIR.

(def-type a-mat (matrix float :address-space :global :align :compact :contiguous-term :row-major))
(def-type b-mat (matrix float :address-space :global :align :compact :contiguous-term :col-major))
(def-type c-mat (matrix float :address-space :global :align :compact :contiguous-term :row-major))

(def-function relu (x)
  (declare #'(float => float))
  (if (> x 0.0) x 0.0))

;; --- Kernel 1: the matmul, with NO epilogue.  Identical to matmul_relu.crisp otherwise. ---
(def-kernel matmul (A B &out C)
  (declare #'(a-mat b-mat &out c-mat)
           (local-size :set-to 32))
  (let ((A-tile (make-scratch-matrix float (64 8)))
        (B-tile (make-scratch-matrix float (8 64)))
        (C-tile (make-register-tile float (64 64) 0.0))
        (K      (inner-dimension A B))
        (bar    (make-async-barrier :mode :linear)))
    (matrix-multiply-tile-stride C C-tile K 8 (grid-y grid-x grid-k)
      (when (= grid-k (to-ulong 0)) (fill-tile C-tile 0.0))
      (load-tile A A-tile (grid-y grid-k) :barrier bar)
      (load-tile B B-tile (grid-k grid-x) :barrier bar)
      (await bar)
      (mma-accumulate-via-tile (16 8 8) C-tile A-tile B-tile)
      (sync-workgroup)
      :epilogue
      (store-tile C-tile C (grid-y grid-x)))))

;; --- Kernel 2: the activation as its own pass over C.  This is the HBM round trip. ---
(def-kernel relu_pass (&out C)
  (declare #'(&out c-mat))
  (tensor-stride C (y x)
    (set! (~ C y x) (relu (~ C y x)))))
