;; Chapter 5 (Endeavor 150) — FUSED EPILOGUE, NVIDIA / PTX, tf32.
;;
;; This is chap1_async_linear/matmul_async.crisp with ONE LINE ADDED: the activation is
;; applied to the completed C-tile while it is still in registers, before the store.
;;
;;     (map-elements! C-tile #'relu)
;;
;; That line is the whole chapter.  Everything else — the 64x64 register tile, the (16 8 8)
;; tf32 MMA, B col-major, the :linear async barrier — is byte-for-byte the Chapter 1 kernel,
;; so any difference this benchmark measures is attributable to the fusion and nothing else.
;;
;; WHAT IT IS BEING COMPARED AGAINST, and why there are four contenders and not two:
;;
;;   matmul_unfused.crisp   Crisp matmul + a SECOND Crisp kernel applying relu over C.
;;                          Isolates the fusion win from Crisp's matmul quality: without this
;;                          point, a loss to cuBLAS cannot be attributed.
;;   cublaslt_fused.cu      cuBLASLt with CUBLASLT_EPILOGUE_RELU — the STRONG baseline.
;;                          Beating "cuBLAS + a separate kernel" at plain relu would be a
;;                          strawman, because cuBLASLt can fuse relu itself.
;;   cublas_optimal.cu      cuBLAS + separate kernel — the honest baseline for an activation
;;                          that is NOT on cuBLASLt's fixed menu.
;;   cuda_apples.cu         the same algorithm hand-fused in CUDA.
;;
;; NOTE ON `relu`: it is an ORDINARY CRISP FUNCTION defined right here, not a compiler
;; builtin and not an entry in a fixed epilogue enum.  Swapping it for anything else — gelu,
;; a clamp, a leaky variant — is a source edit with no compiler change.  That is the property
;; this whole chapter exists to price.
;;
;; Compile: crisp-compile.exe --ir-target=ptx matmul_relu.crisp

(def-type a-mat (matrix float :address-space :global :align :compact :contiguous-term :row-major))
(def-type b-mat (matrix float :address-space :global :align :compact :contiguous-term :col-major))
(def-type c-mat (matrix float :address-space :global :align :compact :contiguous-term :row-major))

;; Plain relu, matching CUBLASLT_EPILOGUE_RELU's semantics exactly so the comparison is like
;; for like.  (The endeavour's SPEC kernels use a thresholded variant instead — that shift
;; exists only to make the activation observable against a non-negative test fill, and would
;; be wrong here, where the baseline must compute the same function.)
(def-function relu (x)
  (declare #'(float => float))
  (if (> x 0.0) x 0.0))

(def-kernel matmul (A B &out C)
  (declare #'(a-mat b-mat &out c-mat)
           (local-size :set-to 32))
  (let ((A-tile (make-scratch-matrix float (64 8)))
        (B-tile (make-scratch-matrix float (8 64)))
        (C-tile (make-register-tile float (64 64) 0.0))
        (K      (inner-dimension A B))
        (bar    (make-async-barrier :mode :linear)))
    (matrix-multiply-tile-stride C C-tile K 8 (grid-y grid-x grid-k)
      (when (= grid-k (to-ulong 0)) (fill-tile C-tile 0.0))  ; grid-strided: reset per output tile
      (load-tile A A-tile (grid-y grid-k) :barrier bar)
      (load-tile B B-tile (grid-k grid-x) :barrier bar)
      (await bar)
      (mma-accumulate-via-tile (16 8 8) C-tile A-tile B-tile)
      (sync-workgroup)
      :epilogue
      (map-elements! C-tile #'relu)                          ; <-- the entire chapter
      (store-tile C-tile C (grid-y grid-x)))))
