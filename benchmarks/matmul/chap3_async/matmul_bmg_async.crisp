;; Crisp tiled matmul for INTEL BMG — ASYNC twin of matmul_bmg.crisp (L0 / SPV), tf32.
;; Endeavor 136 (Chapter 1): the K-step A/B staging goes through an async barrier —
;; `:mode :linear` on SPIR-V lowers each 2D strided load-tile to per-row OpGroupAsyncCopy
;; (events chained through the barrier) and (await) to OpGroupWaitEvents.  Everything else
;; is byte-for-byte matmul_bmg.crisp (32x32 register tile, (8 16 8) XMX, B row-major).
;;
;; Compile: crisp-compile.exe --hardware-profile=bmg --ir-target=spv matmul_bmg_async.crisp

;; Endeavor 144 Phase 0 (D2): `bmg` is now a Crisp BUILTIN hardware profile (queried on an
;; Arc B580), so the inline 2-key definition that used to live here is gone.  That inline copy
;; is why Phase 4's large-GRF win reached only the prefetch chapter: each kernel carried its
;; own profile and they drifted.  The builtin carries :max-registers-per-thread (128 256).

(def-type a-mat (matrix float :address-space :global :align :compact :contiguous-term :row-major))
(def-type b-mat (matrix float :address-space :global :align :compact :contiguous-term :row-major))
(def-type c-mat (matrix float :address-space :global :align :compact :contiguous-term :row-major))

(def-kernel matmul (A B &out C)
  (declare #'(a-mat b-mat &out c-mat)
           (local-size :set-to 16))          ; one sub-group
  (let ((A-tile (make-scratch-matrix float (32 8)))
        (B-tile (make-scratch-matrix float (8 32)))
        (C-tile (make-register-tile float (32 32) 0.0))
        (K      (inner-dimension A B))
        (bar    (make-async-barrier :mode :linear)))
    (matrix-multiply-tile-stride C C-tile K 8 (grid-y grid-x grid-k)
      (load-tile A A-tile (grid-y grid-k) :barrier bar)   ; async-stage A[grid-y*32:+32, grid-k*8:+8]
      (load-tile B B-tile (grid-k grid-x) :barrier bar)   ; async-stage B[grid-k*8:+8, grid-x*32:+32]
      (await bar)                                         ; OpGroupWaitEvents
      (mma-accumulate-via-tile (8 16 8) C-tile A-tile B-tile)
      (sync-workgroup)
      :epilogue
      (store-tile C-tile C (grid-y grid-x)))))
