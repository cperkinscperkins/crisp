;; Section 3 (alternatives) — MMA LOWERING: :coop-matrix vs :xe-native, Intel BMG, bfloat16.
;;
;; Four kernels, ONE variable at a time.  All four are 32x64, one subgroup, bfloat16, (8 16 16).
;; The BARE pair has no register-tile ring and no prefetch.  The TUNED pair adds ring depth 2 and
;; prefetch distance 2 -- i.e. the TUNED :coop-matrix kernel is byte-for-byte the shipped
;; benchmarks/matmul/sec2_top_bf16 kernel.  Within each pair the ONLY difference is the lowering.
;;
;; WHAT THIS CHAPTER EXISTS TO SHOW, and it is not a simple win:
;;
;;   BARE    :xe-native is FASTER  -- +13% at N=2048, +9% at N=4096 (endeavour 156).
;;   TUNED   :xe-native is SLOWER  -- 50.0 vs 60.4 TFLOPS at N=2048.
;;
;; The lowering is better in isolation and does NOT compose with the ring.  A single row comparing
;; only the tuned kernels would say ":xe-native is worse" and a single row comparing only the bare
;; ones would say ":xe-native is better"; both would be true and both would mislead.  That is why
;; all four are here.
;;
;; :coop-matrix  SPV_KHR_cooperative_matrix -- opaque cooperative-matrix values, pointer-form loads,
;;               CooperativeMatrixMulAddKHR.  Portable; the default on every backend.
;; :xe-native    SubgroupMatrixMultiplyAccumulateINTEL over concrete vectors, 2D block loads, and
;;               the VNNI-packing TRANSFORM load for the B operand (DPAS requires B packed).
;;               Intel SPIR-V only.  42 machine instructions per dpas against :coop-matrix's 57.
;;
;; OPEN, and the reason the tuned pair loses: something in the :xe-native load path degrades with
;; LIVE FRAGMENT COUNT -- a 32x128 tile collapses to 5.6 TFLOPS, and a ring multiplies fragment
;; count the same way.  It is NOT register spill; the ISA shows zero spill, zero fill, zero scratch.
;;
;; See docs/topology.md `mma-lowering`, and tests/spec/156-workgroup-cooperation/.
;;
;; THIS FILE: lowering :xe-native, TUNED (ring depth 2, prefetch distance 2).
;;
(declaim (precision fast))
(def-type a-mat (matrix bfloat16 :address-space :global :align :compact :contiguous-term :row-major))
(def-type b-mat (matrix bfloat16 :address-space :global :align :compact :contiguous-term :row-major))
(def-type c-mat (matrix float :address-space :global :align :compact :contiguous-term :row-major))

(def-kernel matmul (A B &out C)
  (declare #'(a-mat b-mat &out c-mat)
           (mma-lowering :xe-native)
           (global-size :derive-from C :strategy :strided)
           (local-size :set-to 16))
  (let ((K      (inner-dimension A B))
        (n-k-steps (/ (inner-dimension A B) (to-ulong 16))))

    (tile-stride C (32 64) (grid-y grid-x)
      (let ((A-ring (make-register-tile-ring bfloat16 (32 16) :ring-count 2 :operand :a))
            (B-ring (make-register-tile-ring bfloat16 (16 64) :ring-count 2 :operand :b))
            (C-tile (make-register-tile float (32 64) 0.0)))
      (prefetch-tile A (grid-y 0) :size (32 16))
      (prefetch-tile B (0 (* grid-x (to-ulong 4))) :size (16 16))
      (prefetch-tile B (0 (+ (* grid-x (to-ulong 4)) (to-ulong 1))) :size (16 16))
      (prefetch-tile B (0 (+ (* grid-x (to-ulong 4)) (to-ulong 2))) :size (16 16))
      (prefetch-tile B (0 (+ (* grid-x (to-ulong 4)) (to-ulong 3))) :size (16 16))
      (prefetch-tile A (grid-y 1) :size (32 16))
      (prefetch-tile B (1 (* grid-x (to-ulong 4))) :size (16 16))
      (prefetch-tile B (1 (+ (* grid-x (to-ulong 4)) (to-ulong 1))) :size (16 16))
      (prefetch-tile B (1 (+ (* grid-x (to-ulong 4)) (to-ulong 2))) :size (16 16))
      (prefetch-tile B (1 (+ (* grid-x (to-ulong 4)) (to-ulong 3))) :size (16 16))
      (load-tile A (ring-get A-ring 0) (grid-y 0))
      (load-tile B (ring-get B-ring 0) (0 grid-x))

      (dotimes (grid-k n-k-steps)
        (let ((next-k (+ grid-k (to-ulong 1)))
              (prefetch-k (+ grid-k (to-ulong 2))))

          (when (< prefetch-k n-k-steps)
            (prefetch-tile A (grid-y prefetch-k) :size (32 16))
            (prefetch-tile B (prefetch-k (* grid-x (to-ulong 4))) :size (16 16))
            (prefetch-tile B (prefetch-k (+ (* grid-x (to-ulong 4)) (to-ulong 1))) :size (16 16))
            (prefetch-tile B (prefetch-k (+ (* grid-x (to-ulong 4)) (to-ulong 2))) :size (16 16))
            (prefetch-tile B (prefetch-k (+ (* grid-x (to-ulong 4)) (to-ulong 3))) :size (16 16)))

          (when (< next-k n-k-steps)
            (load-tile A (ring-get A-ring (mod (+ grid-k (to-ulong 1)) (to-ulong 2))) (grid-y next-k))
            (load-tile B (ring-get B-ring (mod (+ grid-k (to-ulong 1)) (to-ulong 2))) (next-k grid-x)))

          (mma-accumulate-via-tile (8 16 16) C-tile
                                   (ring-get A-ring (mod grid-k (to-ulong 2)))
                                   (ring-get B-ring (mod grid-k (to-ulong 2))))))
      :epilogue
      (store-tile C-tile C (grid-y grid-x))))))
