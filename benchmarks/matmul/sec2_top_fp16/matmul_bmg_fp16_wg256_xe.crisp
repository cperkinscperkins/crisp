;; :XE-NATIVE at the peer geometry (256x256 over 32 subgroups), no prefetch.
;;
;; THE MOST PROMISING UNTESTED COMBINATION, and the levers doc has said so for two endeavours.
;; :xe-native emits Intel's SubgroupMatrixMultiplyAccumulateINTEL with 2D block loads directly:
;; 42 machine instructions per dpas against :coop-matrix's 57.  That attacks the INSTRUCTION
;; STREAM, which is where the remaining gap lives -- at 8192 we are at 88.0 against a math-only
;; ceiling near 106, so memory work is worth at most ~20% and SYCL-TLA's ~241 is more than 2x
;; PAST that ceiling.  Only a leaner instruction stream gets there.
;;
;; ITS TWO KNOWN FAILURE MODES DO NOT APPLY HERE, which is why this is worth re-trying now:
;;   * "does not compose with a register-tile ring" -- this kernel has no ring.
;;   * "degrades with live fragment count (32x128 -> 5.6 TFLOPS, and NOT from spill)" -- our
;;     per-subgroup tile is 32x64, which is the shape where :xe-native measured +21% BARE.
;;
;; Previously measured at the single-subgroup 32x64 geometry: +21% bare, -9.6% to -23.7% once a
;; ring was added.  Never tried at 16 subgroups, let alone 32 with warp-partitioned prefetch.
(declaim (precision fast))
(def-type a-mat (matrix half :address-space :global :align :compact :contiguous-term :row-major))
(def-type b-mat (matrix half :address-space :global :align :compact :contiguous-term :row-major))
(def-type c-mat (matrix float :address-space :global :align :compact :contiguous-term :row-major))

(def-kernel matmul (A B &out C)
  (declare #'(a-mat b-mat &out c-mat)
           (global-size :derive-from C :strategy :strided)
           (mma-lowering :xe-native)
           (local-size :set-to 512))
  (let ((A-tile (make-register-tile half (256 32) 0.0 :operand :a :warps '(true true true true true true true true true true true true true true true true true true true true true true true true true true true true true true true true)))
        (B-tile (make-register-tile half (32 256) 0.0 :operand :b :warps '(true true true true true true true true true true true true true true true true true true true true true true true true true true true true true true true true)))
        (C-tile (make-register-tile float (256 256) 0.0 :warps '(true true true true true true true true true true true true true true true true true true true true true true true true true true true true true true true true)))
        (n-k-steps (/ (to-ulong (inner-dimension A B)) (to-ulong 32))))
    (tile-stride C (256 256) (grid-y grid-x)
      (progn
        (dotimes (grid-k n-k-steps)
          (load-tile A A-tile (grid-y grid-k))
          (load-tile B B-tile (grid-k grid-x))
          (mma-accumulate-via-tile (8 16 16) C-tile A-tile B-tile))
        :epilogue
        (store-tile C-tile C (grid-y grid-x))))))
