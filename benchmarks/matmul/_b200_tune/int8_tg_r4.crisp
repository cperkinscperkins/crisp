;; Section 2, B200 (sm_100a) -- s8 x s8 operands, s32 accumulator and C (kind::i8).  Endeavour 209.
;;
;; GENERATED from ONE template by scripts/crisp_bench/gen_b200.py, so a difference between two
;; B200 lanes is the FORMAT and nothing else.  Endeavour 208's kernel (spec 11's shape): warp-specialized
;; :epilogue 4 / :producer 1 / :mma 1, a TMA ring of A and B^T tiles (128-byte swizzle), tcgen05 with the
;; accumulator in tensor memory.
;;
;; TILE GRID: one CTA per output tile, one accumulator (the chapter-7 shape).
;; Ring depth 4: 4 x (128 + 256) x 128 elements of A/B per stage.
;; Requires sm_100a.

(def-type a-mat (matrix char :address-space :global :align :compact :contiguous-term :row-major))
(def-type b-mat (matrix char :address-space :global :align :compact :contiguous-term :col-major))
(def-type c-mat (matrix int :address-space :global :align :compact :contiguous-term :row-major))

(def-kernel matmul (A B &out C)
  (declare #'(a-mat b-mat &out c-mat)
           (global-size :derive-from C :strategy :strided)
           (local-size :set-to 192))                 ; epilogue warpgroup + producer warp + mma warp
  (let ((A-ring    (make-scratch-matrix-ring char (128 128) :ring-count 4))
        (B-ring    (make-scratch-matrix-ring char (256 128) :ring-count 4))   ; B^T: N x K
        (D         (make-tcgen05-accumulator int (128 256) 0))
        (K         (inner-dimension A B))
        (empty     (make-async-barrier-ring :ring-count 4 :mode :block :arrivals 1 :initial-state :signaled))
        (full      (make-async-barrier-ring :ring-count 4 :mode :block :arrivals 2 :initial-state :waiting))
        (acc-full  (make-async-barrier-ring :ring-count 1 :mode :block :arrivals 1 :initial-state :waiting))
        (acc-empty (make-async-barrier-ring :ring-count 1 :mode :block :arrivals 4 :initial-state :signaled)))
    (tile-stride C (128 256) (grid-y grid-x)
      (with-warp-specialization (:epilogue 4 :producer 1 :mma 1)
          (:epilogue
            (await (ring-get acc-full 0))
            (store-tile D C (grid-y grid-x))
            (signal (ring-get acc-empty 0)))
          (:producer
            (dotimes (grid-k (/ (to-ulong K) (to-ulong 128)))
              (let ((slot (mod grid-k (to-ulong 4))))
                (await (ring-get empty slot))
                (load-tile A (ring-get A-ring slot) (grid-y grid-k) :barrier (ring-get full slot) :swizzle :128b)
                (load-tile B (ring-get B-ring slot) (grid-x grid-k) :barrier (ring-get full slot) :swizzle :128b))))
          (:mma
            (await (ring-get acc-empty 0))
            (set! D (make-tcgen05-accumulator int (128 256) 0))
            (dotimes (grid-k (/ (to-ulong K) (to-ulong 128)))
              (let ((slot (mod grid-k (to-ulong 4))))
                (await (ring-get full slot))
                (tcgen05-accumulate-via-tile (128 256 128) D (ring-get A-ring slot) (ring-get B-ring slot)
                                             :swizzle :128b :on-complete (ring-get empty slot))))
            (tcgen05-commit (ring-get acc-full 0)))))))
