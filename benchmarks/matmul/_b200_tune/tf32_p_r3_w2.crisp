;; Section 2, B200 (sm_100a) -- tf32 (fp32 operands, tf32 MMA), fp32 C.  Endeavour 209.
;;
;; GENERATED from ONE template by scripts/crisp_bench/gen_b200.py, so a difference between two
;; B200 lanes is the FORMAT and nothing else.  Endeavour 208's kernel (spec 11's shape): warp-specialized
;; :epilogue 4 / :producer 1 / :mma 1, a TMA ring of A and B^T tiles (128-byte swizzle), tcgen05 with the
;; accumulator in tensor memory.
;;
;; PERSISTENT: (global-size :set-to 28416) is one workgroup per SM (148 x 192); tile-stride
;; walks ONE flat tile index over them (F-209-3), and the accumulator is a 2-slot RING in tensor memory
;; (2 x 256 columns, all 512), so the epilogue stores tile t while the MMA warp computes tile t+1.
;; Tile visit: column strips 2 tiles wide (endeavour 144's grouped walk), for L2 reuse.
;; BENCH-TILE-VISIT: grouped:2
;; Ring depth 3: 3 x (128 + 256) x 32 elements of A/B per stage.
;; Requires sm_100a.

(def-type a-mat (matrix float :address-space :global :align :compact :contiguous-term :row-major))
(def-type b-mat (matrix float :address-space :global :align :compact :contiguous-term :col-major))
(def-type c-mat (matrix float :address-space :global :align :compact :contiguous-term :row-major))

(def-kernel matmul (A B &out C)
  (declare #'(a-mat b-mat &out c-mat)
           (global-size :set-to 28416)
           (local-size :set-to 192))                 ; epilogue warpgroup + producer warp + mma warp
  (let ((A-ring    (make-scratch-matrix-ring float (128 32) :ring-count 3))
        (B-ring    (make-scratch-matrix-ring float (256 32) :ring-count 3))   ; B^T: N x K
        (acc       (make-tcgen05-accumulator-ring float (128 256) :ring-count 2))
        (K         (inner-dimension A B))
        (tiles     (to-ulong 0))
        (empty     (make-async-barrier-ring :ring-count 3 :mode :block :arrivals 1 :initial-state :signaled))
        (full      (make-async-barrier-ring :ring-count 3 :mode :block :arrivals 2 :initial-state :waiting))
        (acc-full  (make-async-barrier-ring :ring-count 2 :mode :block :arrivals 1 :initial-state :waiting))
        (acc-empty (make-async-barrier-ring :ring-count 2 :mode :block :arrivals 4 :initial-state :signaled)))
    (tile-stride C (128 256) (grid-y grid-x)
      (let ((s (mod tiles (to-ulong 2))))
        (with-warp-specialization (:epilogue 4 :producer 1 :mma 1)
          (:epilogue
            (await (ring-get acc-full s))
            (store-tile (ring-get acc s) C (grid-y grid-x))
            (signal (ring-get acc-empty s)))
          (:producer
            (dotimes (grid-k (/ (to-ulong K) (to-ulong 32)))
              (let ((slot (mod grid-k (to-ulong 3))))
                (await (ring-get empty slot))
                (load-tile A (ring-get A-ring slot) (grid-y grid-k) :barrier (ring-get full slot) :swizzle :128b)
                (load-tile B (ring-get B-ring slot) (grid-x grid-k) :barrier (ring-get full slot) :swizzle :128b))))
          (:mma
            (await (ring-get acc-empty s))
            (let ((D (ring-get acc s)))
              (dotimes (grid-k (/ (to-ulong K) (to-ulong 32)))
                (let ((slot (mod grid-k (to-ulong 3))))
                  (await (ring-get full slot))
                  (tcgen05-accumulate-via-tile (128 256 32) D (ring-get A-ring slot) (ring-get B-ring slot)
                                               :swizzle :128b :on-complete (ring-get empty slot)))))
            (tcgen05-commit (ring-get acc-full s)))))
      (set! tiles (+ tiles (to-ulong 1))))))
