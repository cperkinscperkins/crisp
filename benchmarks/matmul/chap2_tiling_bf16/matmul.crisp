;; Crisp Tiled MMA Matmul (bf16) on NVIDIA: C[M x N] = A[M x K] . B[K x N], f32 accumulate.
;; Section 1, Chapter 2 — the second rung of the NVIDIA 16-bit ladder.
;;
;; WHAT THIS ADDS OVER CHAPTER 1: the matrix-multiply-tile-stride macro replaces chapter 1's
;; hand-rolled K loop.  Same geometry, same instruction; the macro is the thing under test.
;;
;; THIS KERNEL WAS ORIGINALLY WRITTEN INTO sec2_top_bf16/, AND THAT WAS A PLACEMENT ERROR.
;; §2 is the TOP-CONTENDERS table -- the place for Crisp's best kernel against cuBLAS and CUTLASS.
;; A chapter-2-class kernel there reads as "this is what Crisp can do", when it is in fact the
;; second rung of seven: no cp.async, no ring, no warp specialization, no wgmma.  Measured on an
;; H100 NVL it came in around 0.5% of cuBLAS, which is the honest number for THIS RUNG and a
;; misleading one for the section it was sitting in.  §2 should point at whichever rung wins.
;;
;; DELIBERATELY A MINIMAL PORT of chap2_tiling/matmul.crisp -- same structure, same tile geometry,
;; same macro; only the operand element type and the K-step differ, so a difference between this
;; row and the tf32 row is the FORMAT rather than a different kernel.
;;
;; K-STEP IS 16, NOT 8.  The Hopper ladder is m16n8k8 (tf32) -> m16n8k16 (bf16/fp16): K doubles,
;; M and N do not -- the reason the 16-bit ceiling is ~2x tf32 rather than 4x.
;;
;; OPERANDS STAGE THROUGH SHARED MEMORY, and must: endeavour 142's register-resident operand path
;; is Intel-only (Subgroup2DBlockLoadINTEL), a compile-time refusal on NVIDIA.
;;
;; THE ACCUMULATOR IS f32 -- every 16-bit MMA here accumulates in fp32.
;;
;; WHY NOT wgmma: it is not a choice available at 16 bits.  %check-wgmma-shape hard-errors on
;; K != 8 (src/mma.lisp:2069) and %emit-nvvm-wgmma pins m64n{N}k8.f32.tf32.tf32 (:2173), so a
;; 16-bit wgmma kernel does not compile.  chap7_wgmma_bf16 is blocked on that compiler work.
;; chap6 (warp specialization) is NOT -- it uses the sync MMA, so it is reachable today.

(def-type a-mat (matrix bfloat16  :address-space :global :align :compact :contiguous-term :row-major))
(def-type b-mat (matrix bfloat16  :address-space :global :align :compact :contiguous-term :col-major))
(def-type c-mat (matrix float :address-space :global :align :compact :contiguous-term :row-major))

(def-kernel matmul (A B &out C)
  (declare #'(a-mat b-mat &out c-mat)
           (global-size :derive-from C :strategy :strided)
           (local-size :set-to 32))
  (let ((A-tile (make-scratch-matrix bfloat16  (64 16)))   ; M x K, one bf16 K-step
        (B-tile (make-scratch-matrix bfloat16  (16 64)))   ; K x N
        (C-tile (make-register-tile float (64 64) 0.0))
        (K      (inner-dimension A B)))
    (matrix-multiply-tile-stride C C-tile K 16 (grid-y grid-x grid-k)
      :body
      (load-tile-at A A-tile ((* grid-y (to-ulong 64)) (* grid-k (to-ulong 16))))
      (load-tile-at B B-tile ((* grid-k (to-ulong 16)) (* grid-x (to-ulong 64))))
      (sync-workgroup)
      (mma-accumulate-via-tile (16 8 16) C-tile A-tile B-tile)
      (sync-workgroup)
      :epilogue
      ;; WITHOUT THIS THE KERNEL COMPUTES AND DISCARDS.  The template this was ported from
      ;; (chap2_tiling/matmul.crisp) has no store-tile, and that is the defect behind the L0
      ;; fixture's opening example: chap2_tiling "posted the second-best tf32 number in its
      ;; section while storing nothing at all -- the compiler warned on every build and a sweep
      ;; run with --log-level=off never showed it."  The warning is still emitted today.
      (store-tile C-tile C (grid-y grid-x)))))
