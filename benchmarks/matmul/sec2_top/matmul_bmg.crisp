;; Section 2 top MMA kernel — Intel BMG, tf32 (32-bit operands, K=8 DPAS).
;;
;; TILE WIDTH IS THE TUNED PARAMETER, and it was retuned for the same reason the 16-bit kernels
;; were: 32x32 was inherited, not measured.  Endeavour 155, N=4096, MMA_CORRECT throughout:
;;
;;     32x32     16.00 TFLOPS      (what shipped; matches the previous kernel's 15.72)
;;     32x64     27.85             <- 1.74x
;;     32x128     2.02             spills, collapses
;;
;; For reference oneMKL tf32 measures 14.31 at the same size, so this puts Crisp at roughly
;; 1.95x the vendor library in tf32.
;;
;; A MATCHED tf32-vs-bf16 comparison (same tile, same pipelining, only the element type varying)
;; gives 2.08x at 32x32 and 1.90x at 32x64 — i.e. exactly the DPAS K doubling (8 -> 16) and no
;; more.  That is the evidence that Crisp's 16-bit lowering is sound and that the remaining gap to
;; oneMKL's bf16 is STRUCTURAL (operand sharing across subgroups), not a per-instruction deficit.
;;
;; CONSTRAINTS worth knowing before re-tuning this (both learned by silent failure):
;;   - TN must be a POWER-OF-TWO multiple of 16.  48/80/96/112 compile, run, and are WRONG.
;;   - a prefetch block may be at most 32 ROWS; taller names a nonexistent builtin and fails at
;;     module load.  TM > 32 therefore needs the A prefetch split into 32-row blocks.
(declaim (precision fast))
(def-type a-mat (matrix float :address-space :global :align :compact :contiguous-term :row-major))
(def-type b-mat (matrix float :address-space :global :align :compact :contiguous-term :row-major))
(def-type c-mat (matrix float :address-space :global :align :compact :contiguous-term :row-major))

(def-kernel matmul (A B &out C)
  (declare #'(a-mat b-mat &out c-mat)
           (global-size :derive-from C :strategy :strided)
           (local-size :set-to 16))
  (let ((K      (inner-dimension A B))
        (n-k-steps (/ (inner-dimension A B) (to-ulong 8))))

    (tile-stride C (32 64) (grid-y grid-x)
      (let ((A-ring (make-register-tile-ring float (32 8) :ring-count 2 :operand :a))
            (B-ring (make-register-tile-ring float (8 64) :ring-count 2 :operand :b))
            (C-tile (make-register-tile float (32 64) 0.0)))

      (prefetch-tile A (grid-y 0) :size (32 8))
      (prefetch-tile B (0 (* grid-x (to-ulong 4))) :size (8 16))
      (prefetch-tile B (0 (+ (* grid-x (to-ulong 4)) (to-ulong 1))) :size (8 16))
      (prefetch-tile B (0 (+ (* grid-x (to-ulong 4)) (to-ulong 2))) :size (8 16))
      (prefetch-tile B (0 (+ (* grid-x (to-ulong 4)) (to-ulong 3))) :size (8 16))
      (prefetch-tile A (grid-y 1) :size (32 8))
      (prefetch-tile B (1 (* grid-x (to-ulong 4))) :size (8 16))
      (prefetch-tile B (1 (+ (* grid-x (to-ulong 4)) (to-ulong 1))) :size (8 16))
      (prefetch-tile B (1 (+ (* grid-x (to-ulong 4)) (to-ulong 2))) :size (8 16))
      (prefetch-tile B (1 (+ (* grid-x (to-ulong 4)) (to-ulong 3))) :size (8 16))
      (load-tile A (ring-get A-ring 0) (grid-y 0))
      (load-tile B (ring-get B-ring 0) (0 grid-x))

      (dotimes (grid-k n-k-steps)
        (let ((next-k (+ grid-k (to-ulong 1)))
              (prefetch-k (+ grid-k (to-ulong 2))))
          (when (< prefetch-k n-k-steps)
            (prefetch-tile A (grid-y prefetch-k) :size (32 8))
            (prefetch-tile B (prefetch-k (* grid-x (to-ulong 4))) :size (8 16))
            (prefetch-tile B (prefetch-k (+ (* grid-x (to-ulong 4)) (to-ulong 1))) :size (8 16))
            (prefetch-tile B (prefetch-k (+ (* grid-x (to-ulong 4)) (to-ulong 2))) :size (8 16))
            (prefetch-tile B (prefetch-k (+ (* grid-x (to-ulong 4)) (to-ulong 3))) :size (8 16)))
          (when (< next-k n-k-steps)
            (load-tile A (ring-get A-ring (mod (+ grid-k (to-ulong 1)) (to-ulong 2))) (grid-y next-k))
            (load-tile B (ring-get B-ring (mod (+ grid-k (to-ulong 1)) (to-ulong 2))) (next-k grid-x)))
          (mma-accumulate-via-tile (8 16 8) C-tile
                                   (ring-get A-ring (mod grid-k (to-ulong 2)))
                                   (ring-get B-ring (mod grid-k (to-ulong 2)))))) 
      :epilogue
      (store-tile C-tile C (grid-y grid-x))))))
