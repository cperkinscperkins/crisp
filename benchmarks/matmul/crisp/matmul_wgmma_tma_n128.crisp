;; Crisp tiled matmul (grid-stride) — Hopper WGMMA m64n128k8 tf32 + TMA 128B-swizzle.  Endeavor 140
;; Chapter 4, Step 4b: BIGGER TILE (64x128 output, m64n128) to raise the compute:load ratio for the
;; large-N regime where single-buffered m64n64 plateaued and depth-2 pipelining regressed (occupancy).
;; One warpgroup (128 threads) now holds 64 f32 accumulators/thread (64x128).  Single-buffered K-loop.
(def-type a-mat (matrix float :address-space :global :align :compact :contiguous-term :row-major))
(def-type b-mat (matrix float :address-space :global :align :compact :contiguous-term :col-major))
(def-type c-mat (matrix float :address-space :global :align :compact :contiguous-term :row-major))

(def-kernel matmul (A B &out C)
  (declare #'(a-mat b-mat &out c-mat)
           (local-size :set-to 128))
  (let ((A-tile (make-scratch-matrix float (64 32)))    ; 64(M) x 32(K)
        (B-tile (make-scratch-matrix float (128 32)))   ; 128(N) x 32(K) B^T
        (D      (make-wgmma-accumulator float (64 128) 0.0))
        (bar    (make-async-barrier :mode :block))
        (K      (inner-dimension A B)))
    (tile-stride C (64 128) (grid-y grid-x)
      (set! D (make-wgmma-accumulator float (64 128) 0.0))
      (dotimes (grid-k (/ (to-ulong K) (to-ulong 32)))
        (load-tile A A-tile (grid-y grid-k) :barrier bar :swizzle :128b)
        (load-tile B B-tile (grid-x grid-k) :barrier bar :swizzle :128b)
        (await bar)
        (wgmma-accumulate-via-tile (64 128 32) D A-tile B-tile :swizzle :128b)
        (sync-workgroup))
      (store-tile D C (grid-y grid-x)))))
