;; Crisp tiled matmul (grid-stride) — Hopper WGMMA (m64n64k8 tf32), Endeavor 140 Chapter 4.
;; One warpgroup (local-size 128) computes a 64x64 output tile.  Each K-step scatter-loads the
;; 64x8 A-slice and 8x64 B-slice into flat SMEM tiles in CORE-MATRIX order, then a synchronous
;; wgmma accumulates into D (scaleD=1).  Simple (non-async, non-TMA) loading — the FIRST measurement
;; of raw wgmma throughput vs the 139 mma.sync kernels; async + TMA staging are later optimizations.
(def-type a-mat (matrix float :address-space :global :align :compact :contiguous-term :row-major))
(def-type b-mat (matrix float :address-space :global :align :compact :contiguous-term :col-major))
(def-type c-mat (matrix float :address-space :global :align :compact :contiguous-term :row-major))

(def-kernel matmul (A B &out C)
  (declare #'(a-mat b-mat &out c-mat)
           (local-size :set-to 128))
  (let ((A-tile (make-scratch-vector float 512))
        (B-tile (make-scratch-vector float 512))
        (D      (make-wgmma-accumulator float (64 64) 0.0))
        (K      (inner-dimension A B)))
    (tile-stride C (64 64) (grid-y grid-x)
      (set! D (make-wgmma-accumulator float (64 64) 0.0))     ; reset per output tile
      (let ((llid (+ (* (to-int (warp-id)) 32) (to-int (warp-lane)))))
        (dotimes (kk (/ (to-ulong K) (to-ulong 8)))
          (dotimes (i 4)
            (let ((li (+ (* i 128) llid)))
              (let ((r (/ li 8)) (k (rem li 8)))
                (let ((core (+ (+ (+ (* (/ r 8) 64) (* (/ k 4) 32)) (* (rem r 8) 4)) (rem k 4)))
                      (gy (+ (* (to-int grid-y) 64) r)))
                  (let ((gk (+ (* (to-int kk) 8) k))
                        (gx (+ (* (to-int grid-x) 64) r)))
                    (set! (~ A-tile core) (~ A gy gk))         ; A[gy][kk*8+k]
                    (set! (~ B-tile core) (~ B gk gx)))))))    ; B[kk*8+k][gx]
          (sync-workgroup)
          (wgmma-accumulate-via-tile (64 64 8) D A-tile B-tile)
          (sync-workgroup)))
      (store-tile D C (grid-y grid-x)))))
