;; Crisp tiled matmul (grid-stride) — Hopper WGMMA (m64n64k8 tf32) + TMA 128B-swizzle + PIPELINING.
;; Endeavor 140 Chapter 4, Step 4.  This is matmul_wgmma_tma.crisp (single-buffered) with the single
;; barrier + single pair of SLM tiles replaced by DEPTH-2 RINGS, so stage k+2's TMA transfer is in
;; flight while stage k's wgmma runs — killing the exposed TMA latency that capped the single-buffered
;; version at ~130 TFLOPS (2.3x behind cuBLAS).  Ports 138/04's ring pipeline to the wgmma path.
;; K-block = 32 (128B swizzle innermost); ring slot = (mod grid-k 2); :arrivals 2 (A-load + B-load
;; per stage).  B is :col-major (K-contiguous global, what the wgmma descriptor reads).
(def-type a-mat (matrix float :address-space :global :align :compact :contiguous-term :row-major))
(def-type b-mat (matrix float :address-space :global :align :compact :contiguous-term :col-major))
(def-type c-mat (matrix float :address-space :global :align :compact :contiguous-term :row-major))

(def-kernel matmul (A B &out C)
  (declare #'(a-mat b-mat &out c-mat)
           (local-size :set-to 128))
  (let ((A-ring (make-scratch-matrix-ring float (64 32) :ring-count 2))   ; 2 x 64(M) x 32(K)
        (B-ring (make-scratch-matrix-ring float (64 32) :ring-count 2))   ; 2 x 64(N) x 32(K) B^T
        (D      (make-wgmma-accumulator float (64 64) 0.0))
        (K      (inner-dimension A B))
        (bars   (make-async-barrier-ring :ring-count 2 :mode :block :arrivals 2)))
    (tile-stride C (64 64) (grid-y grid-x)
      (set! D (make-wgmma-accumulator float (64 64) 0.0))         ; reset per output tile

      ;; PROLOGUE — put both stages' TMA transfers in flight before any math.
      (dotimes (i 2)
        (load-tile A (ring-get A-ring (to-ulong i)) (grid-y (to-ulong i))
                   :barrier (ring-get bars (to-ulong i)) :swizzle :128b)
        (load-tile B (ring-get B-ring (to-ulong i)) (grid-x (to-ulong i))
                   :barrier (ring-get bars (to-ulong i)) :swizzle :128b))

      ;; MAIN K-LOOP — await stage k, wgmma it, prefetch stage k+2 into the freed slot.
      (dotimes (grid-k (/ (to-ulong K) (to-ulong 32)))
        (let ((slot (mod grid-k (to-ulong 2))))
          (await (ring-get bars slot))
          (wgmma-accumulate-via-tile (64 64 32) D (ring-get A-ring slot) (ring-get B-ring slot)
                                     :swizzle :128b)
          (sync-workgroup)                                        ; done reading slot before reuse
          (let ((next-k (+ grid-k (to-ulong 2))))
            (let ((more-k? (to-workgroup-uniform (< next-k (/ (to-ulong K) (to-ulong 32))))))
              (when more-k?
                (load-tile A (ring-get A-ring slot) (grid-y next-k)
                           :barrier (ring-get bars slot) :swizzle :128b)
                (load-tile B (ring-get B-ring slot) (grid-x next-k)
                           :barrier (ring-get bars slot) :swizzle :128b))))))
      (store-tile D C (grid-y grid-x)))))
