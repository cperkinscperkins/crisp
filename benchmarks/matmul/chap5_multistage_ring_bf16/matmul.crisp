;; Crisp Multistage-Ring Matmul (bf16) on NVIDIA: C[M x N] = A[M x K] . B[K x N], f32 accumulate.
;; Section 1 Chapter 5 — a 2-slot ring: await stage k while stage k+1 is still landing, so the
;; TMA transfer overlaps the MMA instead of blocking it.  Chapter 6 then splits producer and
;; consumer across warps so the bookkeeping itself stops competing with the math.
;;
;; DELIBERATELY A LINE-FOR-LINE PORT of its tf32 twin.  Only the operand element type and the
;; K-step differ, so a difference between this row and the tf32 row is the FORMAT rather than a
;; different kernel wearing the same name.
;;
;; K-STEP IS 16, NOT 8 (Hopper: m16n8k8 tf32 -> m16n8k16 bf16/fp16; K doubles, M and N do not).
;; That HALVES the K-iteration count for a given K, so each staged transfer is twice the size and
;; there are half as many of them -- the pipelining behaviour is not identical to the tf32 rung
;; even though the code shape is.
;;
;; THE FETCH IS TMA (`:mode :block`), NOT plain cp.async -- which is why this rung is reachable at
;; 16 bits at all.  cp.async is 4/8/16-byte granular in HARDWARE (the limit endeavour 159 Phase A
;; measured from the other side: the CUDA control staged single 2-byte elements, never took the
;; accelerated path, and read a flat ~3.4 TFLOPS at every size).  cp.async.bulk.tensor is
;; descriptor-driven and its tensormap encodes bf16 directly.  Crisp refused 2-byte elements here
;; only because of a byte table that listed 4 and 8 and nothing else; endeavour 159 widened it.
;;
;; THE ACCUMULATOR IS f32 -- a 16-bit MMA accumulates in fp32; only A and B are bf16.

(def-type a-mat (matrix bfloat16 :address-space :global :align :compact :contiguous-term :row-major))
(def-type b-mat (matrix bfloat16 :address-space :global :align :compact :contiguous-term :col-major))
(def-type c-mat (matrix float    :address-space :global :align :compact :contiguous-term :row-major))

(def-kernel matmul (A B &out C)
  (declare #'(a-mat b-mat &out c-mat)
           (local-size :set-to 32))          ; one warp / tile
  (let ((A-ring (make-scratch-matrix-ring bfloat16 (64 16) :ring-count 2))  ; SLM: 2 x (64 x k-step)
        (B-ring (make-scratch-matrix-ring bfloat16 (16 64) :ring-count 2))  ; SLM: 2 x (k-step x 64)
        (C-tile (make-register-tile float (64 64) 0.0))
        (K      (inner-dimension A B))
        (bars   (make-async-barrier-ring :ring-count 2 :mode :block :arrivals 2)))
    (tile-stride C (64 64) (grid-y grid-x)
      ;; per-output-tile: grid-strided reuse means we must reset the register C-tile each tile.
      (fill-tile C-tile 0.0)

      ;; 1. PROLOGUE — put both stages' transfers in flight before any math.
      (dotimes (i 2)
        (load-tile A (ring-get A-ring (to-ulong i)) (grid-y (to-ulong i)) :barrier (ring-get bars (to-ulong i)))
        (load-tile B (ring-get B-ring (to-ulong i)) ((to-ulong i) grid-x) :barrier (ring-get bars (to-ulong i))))

      ;; 2. MAIN K-LOOP — await stage k while stage k+1 is still landing.
      (dotimes (grid-k (/ (to-ulong K) (to-ulong 16)))
        (let ((slot (mod grid-k (to-ulong 2))))
          (await (ring-get bars slot))
          (mma-accumulate-via-tile (16 8 16) C-tile (ring-get A-ring slot) (ring-get B-ring slot))
          (sync-workgroup)                    ; every thread done reading the slot before we refill it
          (let ((next-k (+ grid-k (to-ulong 2))))
            (let ((more-k? (to-workgroup-uniform (< next-k (/ (to-ulong K) (to-ulong 16))))))
              (when more-k?
                (load-tile A (ring-get A-ring slot) (grid-y next-k) :barrier (ring-get bars slot))
                (load-tile B (ring-get B-ring slot) (next-k grid-x) :barrier (ring-get bars slot)))))))

      ;; 3. EPILOGUE — C-tile complete.
      (store-tile C-tile C (grid-y grid-x)))))
