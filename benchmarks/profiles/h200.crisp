;;;; H100 and which no query can answer.  Absent means linear, which is safe.
;;;; Results compiled against it are stamped profile_provenance="auto".
;;;;
;;;; To PROMOTE it to a validated builtin: sweep the measured keys, add them here, move
;;;; the form into register-builtin-hardware-profiles (src/mma.lisp) and add the device
;;;; to DEVICE_PROFILE_MAP in this directory's hwprofile.py.

(def-hardware-profile h200
  ;; queried on this device (sxm, sm_90)
  ;; QUERIED = from this device.  ARCH = ISA fact, look it up.
  ;; MEASURED = sweep it or omit it; a guess can be worse than nothing.
  :simd-width 32                          ; QUERIED
  :compute-units 132                      ; QUERIED -- OVERRIDES the device SM
                                         ;   query in the generated launch grid,
                                         ;   so a wrong value mis-sizes EVERY
                                         ;   dispatch.  PCIe 114 / SXM-NVL 132.
  :max-registers-per-cu 65536              ; QUERIED
  :max-registers-per-thread 255          ; ARCH; a SCALAR on NVIDIA (D4) -- unlike
                                         ;   Intel, the file is not a JIT choice.
  :max-total-threads-per-block 1024       ; QUERIED
  :max-work-group-dims '(1024 1024 64)     ; QUERIED
  :max-shared-memory-per-block 227KB     ; QUERIED: the OPT-IN cap, NOT the 48KB
                                         ;   default.  Kernels over 48KB need it.
  :l2-cache-size 60MB                     ; QUERIED
  :native-cache-line-size 128            ; ARCH
  :mma-shapes '((16 8 8)                 ; ARCH: tf32 -- MANDATORY, see header
                (16 8 4)                 ;   tf32 short-K
                (16 8 16)                ;   fp16 / bf16
                (:double 8 8 4))         ;   fp64 DMMA -- TYPED entry.  Omitting
                                         ;   it makes `double` resolve to a
                                         ;   non-intrinsic shape that emits an
                                         ;   .extern .func call with NO error.
  ; :wgmma-shapes                        ; OPTIONAL.  Absent => the generic sm_90a
  ;                                      ;   constraints (M=64, N mult of 8 in
  ;                                      ;   [8,256]) are enforced instead.
  ; :tile-visit-strip-width <N>          ; MEASURED -- OMIT IT unless you have swept
  ;                                      ;   it.  Measured HARMFUL on H100 (-8.3% at
  ;                                      ;   W=4, -14.4% at W=16).  Absent => linear.
  )
