(with-template-type (T)
  (def-struct point 
    (x T) 
    (y T)))

(with-template-type (T)
  (def-function test (x y)
    (declare #'(T T => (point T)))
    (make-point x y)))


(def-function test-of-gen ()
    (declare #'( => (point long)))
    (gen-test long)
    (test (as-long 1) (as-long 2))) 

(def-function test-of-inference ()
    (declare #'( => (point int)))
    (test (as-int 1) (as-int 2)))