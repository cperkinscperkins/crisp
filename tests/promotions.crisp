;;; tests/promotions.crisp

(def-function int_to_float (i f)
  (declare #'(int float => float))
  (+ i f))

(def-function uint_to_float (u f)
  (declare #'(uint float => float))
  (+ u f))

(def-function char_to_int (c i)
  (declare #'(char int => int))
  (+ c i))

(def-function float_to_double (f d)
  (declare #'(float double => double))
  (+ f d))