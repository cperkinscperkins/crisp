(def-struct point 
  (x float) 
  (y int))

(def-setter x~ (p v)
    (declare #'(point float => nil))
    (set! (~x~ p) (+ 10 v)))

(def-setter y~ (p v)
    (declare #'(point int => nil))
    (set! (~y~ p) (+ 20 v)))

(def-function test-overrides ()
    (declare #'( => float int))
    (let ((p (make-point 1.0 2)))
        (set! (x~ p) 3.0)
        (set! (y~ p) 4)
        (return (x~ p) (y~ p)))) ;; should return (13 24)

#|
;; another negative test for tests/errors
;; this should fail to compile.
(def-setter ~y~ (p v)
    (declare #'(point int => nil))
    (set! (~y~ p) (+ 20 v)))
|#