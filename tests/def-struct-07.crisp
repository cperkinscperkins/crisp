(def-struct point 
  (x float) 
  (y int))

(def-function test (xf yi)
    (declare #'(float int => point))
    (let ((p (make-point xf yi)))
       (set! (x~ p) (+ (x~ p) 1.1))
       (set! (y~ p) (+ (y~ p) 2))
       p))

(def-function test-of-test ()
    (declare #'( => float int))
    (let ((p (test 1.0 2)))
      (return (x~ p) (y~ p))))