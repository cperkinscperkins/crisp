(with-template-type (T)
  (def-struct point 
    (x T) 
    (y T)))

(def-function test-gen ()
    (declare #'( => (point float)))
    (gen-point float)
    (make-point 1.0 2.0))

(def-function test-type-infer ()
    (declare #'( => (point int)))
    (make-point (as-int 1) (as-int 2))) 





