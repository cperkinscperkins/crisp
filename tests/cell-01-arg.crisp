;; cell is a parameterized type. 
(def-function test-cell-as-arg (c)
    (declare #'((cell long) => nil))
    (return))

(with-template-type (T)
    (def-function test-templated-cell-as-arg (c)
        (declare #'((cell T) => nil))
        (return)))

(gen-test-templated-cell-as-arg float)