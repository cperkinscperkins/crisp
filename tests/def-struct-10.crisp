(def-struct point 
  (x float) 
  (y int))

(def-function x~ (p)
    (declare #'(point => float))
    (+ 1 (~x~ p)))

(def-function y~ (p)
    (declare #'(point => int))
    (+ 2 (~y~ p)))

(def-function test-overrides ()
    (declare #'( => float int))
    (let ((p (make-point 1.0 2)))
        (return (x~ p) (y~ p)))) ;; should return (2 4)

(def-function test-of-test-overrides ()
    (declare #'( => float int))
    (let ((p (make-point 1.0 2)))
        (set! (x~ p) 3.0)
        (set! (y~ p) 4)
        (return (x~ p) (y~ p))))

#|
;; this should be a negative test in tests/errors
(def-function ~x~ (p)
    (declare #'(point => float))
    (+ 1 (x~ p)))

|#