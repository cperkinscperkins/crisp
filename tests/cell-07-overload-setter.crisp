;; overloading ~ setter on cell is a bad idea.
;; use def-derived-type to derive a custom type
;; and overload for that type instead. BUT
;; bad idea or not, we need to support and test.

(def-setter ~ (c v)
    (declare #'((cell long) long => nil))
    ;; Note: aref is not a Crisp form. ~ref~ is the non-overloadable form Crisp uses for accessing cells, vectors, matrices and tensors.
    ;; Obviously, ~ is the main overloadable form.  Those overloads use ~ref~ to avoid recursion.
    (set! (~ref~ c) (- v 10)))

;; great to check that this compiles and all.
;; but stunts like this probably need to be a unit test
;; so we can vet the IR.
(def-function test-overloaded-setter (c v)
    (declare #'((cell long) long => long))
    (set! (~ c) v)
    ;; this should be 10 less than v
    (~ c))