;; SKIP-WITH[--differentiate]: "Tensor AD not yet supported"
;; TEST-HOIST[L0]: validate-l0-compile-only

;; Validates that a :std140 vector parameter hoists to compilable C++.
;; With :std140 and 4 elements, the stride is 4 (each float padded to vec4),
;; so the kernel receives: stride_0=4, extent_0=4, total=16 floats allocated.

(def-type std-vec-t (vector float :address-space :global :access :read-write :align :std140))

(def-kernel vec_set_first_std140 (val &out v)
    (declare #'(float std-vec-t => nil))
  (set! (~ v 0) val))
