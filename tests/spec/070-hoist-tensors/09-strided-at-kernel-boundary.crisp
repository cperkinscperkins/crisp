;; SKIP-WITH[--differentiate]: "Tensor AD not yet supported"

;; Validates that :strided is accepted at a kernel boundary without error.
;; A :strided tensor has unknown stride pattern at compile time — the kernel
;; uses runtime stride values, same codepath as :compact.
;; The hoist harness always generates :compact example code regardless.

(def-type strided-vec-t (vector long :address-space :global :access :read-write :align :strided))

(def-kernel vec_strided_read (v)
    (declare #'(strided-vec-t => nil))
  (let ((x (~ v 0)))
    (set! (~ v 0) (+ x 1))))
