;; SKIP-WITH[--differentiate]: "Tensor AD not yet supported"
;; TEST-HOIST[L0]: validate-l0-compile-only

;; Validates that a kernel with a rank-3 tensor parameter hoists to compilable C++.
;; The generated C++ sets 13 kernel args: val(0) + 12 tensor slots for vol (3*3+3).

(def-type vol-t (tensor float 3 :address-space :global :access :read-write :align :compact))

(def-kernel vol_fill (val &out vol)
    (declare #'(float vol-t => nil))
  (set! (~ vol 0 0 0) val))
