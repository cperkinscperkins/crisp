;; def-kernel-exact with keyword-form marshall-tensor for N=3 (general path).
;;
;; marshall-tensor keyword form:
;;   (marshall-tensor type byte-size ptr
;;     :offsets  (o0 o1 o2)
;;     :strides  (s0 s1 s2)
;;     :extents  (e0 e1 e2)
;;     :length   len)

(def-type vol-t (tensor float 3 :address-space :global :align :compact))

(def-kernel-exact vol_set_origin
    (byte-size ptr o0 o1 o2 s0 s1 s2 e0 e1 e2 length val)
    (declare #'(ulong voidp ulong ulong ulong ulong ulong ulong ulong ulong ulong ulong float))
    (let ((vol (marshall-tensor vol-t byte-size ptr
                  :offsets (o0 o1 o2)
                  :strides (s0 s1 s2)
                  :extents (e0 e1 e2)
                  :length  length)))
        (set! (~ vol 0 0 0) val)))
