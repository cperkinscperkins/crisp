;; Templated def-kernel-exact with marshall-vector.
;; gen- requires a third arg (the C-style name string).

(with-template-type (T)
    (def-type out-vec-t (vector T :address-space :global :align :compact))

    (def-kernel-exact vec_fill (byte-size ptr offset_0 stride_0 extent_0 length val)
        (declare #'(ulong voidp ulong ulong ulong ulong T))
        (let ((v (marshall-vector (out-vec-t T) byte-size ptr offset_0 stride_0 extent_0 length)))
            (set! (~ v 0) val))))

(gen-vec_fill long "vec_fill_long")
(gen-vec_fill float "vec_fill_float")
