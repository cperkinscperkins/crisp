;; CHECK-FAIL: "requires --ir-target"

;; request-load-tile-coords lowers to fundamentally different IR on SPV
;; (async_work_group_copy + event_t) vs PTX (cp.async + commit/wait), so
;; using it without an --ir-target is a compile-time error -- same gating
;; pattern 087 uses for the GPU built-ins.

(def-type vec-t  (vector ulong :address-space :global :align :compact))
(def-type tile-t (vector ulong :address-space :local  :align :compact))

(def-kernel rltc_no_target (V &out OUT)
  (declare #'(vec-t &out vec-t => nil)
           (global-size :set-to 4)
           (local-size  :set-to 4))
  (let ((tile (make-scratch-vector ulong 4)))
    (let ((tok (request-load-tile-coords V tile (0))))
      (await-request tok)
      (workgroup-stride tile (lx)
        (set! (~ OUT lx) (~ tile lx))))))
