;; CHECK-FAIL: "stmatrix moves 16-bit elements"
;; CHECK-FAIL-FLAGS: --ir-target=ptx --ir-target-arch=sm_90
;; Endeavour 199 -- the f32 accumulator stored unconverted: :via :tma needs (to-half D) or (to-bfloat16 D).
(def-type a-mat (matrix half :address-space :global :align :compact :contiguous-term :row-major))
(def-type b-mat (matrix half :address-space :global :align :compact :contiguous-term :col-major))
(def-type c-mat (matrix float :address-space :global :align :compact :contiguous-term :row-major))
(def-kernel e199_one (A B &out C)
  (declare #'(a-mat b-mat &out c-mat) (global-size :set-to 128) (local-size :set-to 128))
  (let ((A-tile (make-scratch-matrix half (64 64)))
        (B-tile (make-scratch-matrix half (64 64)))
        (D      (make-wgmma-accumulator float (64 64) 0.0)))
    (wgmma-accumulate-via-tile (64 64 64) D A-tile B-tile :swizzle :128b)
    (store-tile-at D C (0 0) :via :tma)))
