;; Endeavour 199 rung 01 -- (store-tile-at (to-half D) C (ROW COL) :via :tma): a 64x128 wgmma
;; accumulator leaves through shared memory and the Tensor Memory Accelerator.
;;
;; WHY.  The direct store is 64 st.global.v2.b16 per thread (N = 256), each half-filling a 32-byte
;; sector, with ~5 integer instructions of address math apiece -- and the whole CTA stops computing
;; while it runs.  On the H100 contest kernel that path cost ~28 us of 257 (and 480 bytes of spills).
;; :via :tma converts pairs (cvt.rn.f16x2.f32), writes them with stmatrix.x4 into a per-warp 4 KB
;; staging slice laid out as two 128B-swizzled 16x64 boxes, and lane 0 issues one TMA store per box
;; through a C tensor map (box {64, 16}, SWIZZLE_128B).  Only warp-level syncs.
;;
;; THE VALIDATOR: 8 stmatrix.x4 (N = 128: 16 n8 blocks x 2 row halves = 32 pairs per thread, 4 per
;; stmatrix), one TMA store per 64-column box (2), a commit, a read-wait and the async-proxy fence,
;; 32 cvt.rn.f16x2.f32, and NO st.global -- the accumulator never goes out element by element.
;; Metal: the H100 contest kernel, bit-exact (tma-store.md).
;;
;; SKIP-DEFAULT-PASS
;; TEST-WITH[--ir-target=ptx --ir-target-arch=sm_90] : validate-ptx-tma-store-half
;; SKIP-WITH[--differentiate]: "GAP D-196-12: autodiff refuses a converted store source (store-tile (to-half D) ...) -- the accumulator backward does not yet see through the conversion"
(def-type a-mat (matrix half :address-space :global :align :compact :contiguous-term :row-major))
(def-type b-mat (matrix half :address-space :global :align :compact :contiguous-term :col-major))
(def-type c-mat (matrix half :address-space :global :align :compact :contiguous-term :row-major))

(def-kernel wgmma_tma_store_half (A B &out C)
  (declare #'(a-mat b-mat &out c-mat)
           (global-size :set-to 128) (local-size :set-to 128))
  (let ((A-tile (make-scratch-matrix half (64 64)))
        (B-tile (make-scratch-matrix half (128 64)))
        (D      (make-wgmma-accumulator float (64 128) 0.0))
        (bar    (make-async-barrier :mode :block)))
    (load-tile A A-tile (0 0) :barrier bar :swizzle :128b)
    (load-tile B B-tile (0 0) :barrier bar :swizzle :128b)
    (await bar)
    (wgmma-accumulate-via-tile (64 128 64) D A-tile B-tile :swizzle :128b)
    (store-tile-at (to-half D) C (0 0) :via :tma)))
