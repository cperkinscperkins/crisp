;; CHECK-FAIL: "accumulate into (accum q-a), not (accum q-b)"
;; CHECK-FAIL-FLAGS: --ir-target=ptx --ir-target-arch=sm_90a --hardware-profile=h100
;; Endeavour 207 follow-up -- the qint rule on the Hopper wgmma path: q-a operands into a
;; make-wgmma-accumulator of (accum q-b) are refused, exactly as on the register-tile path.

(def-qint q-a :base char :accum int)
(def-qint q-b :base char :accum int)
(def-type a-mat (matrix q-a :address-space :global :align :compact :contiguous-term :row-major))
(def-type c-mat (matrix (accum q-b) :address-space :global :align :compact :contiguous-term :row-major))

(def-kernel k (A B &out C)
  (declare #'(a-mat a-mat &out c-mat) (global-size :set-to 128) (local-size :set-to 128))
  (let ((A-tile (make-scratch-matrix q-a (64 32)))
        (B-tile (make-scratch-matrix q-a (64 32)))
        (D      (make-wgmma-accumulator (accum q-b) (64 64) 0)))
    (load-tile A A-tile (0 0))
    (load-tile B B-tile (0 0))
    (wgmma-accumulate-via-tile (64 64 32) D A-tile B-tile)
    (store-tile-at D C (0 0))))
