;; TEST-WITH[--ir-target=ptx --ir-target-arch=sm_80 --hardware-profile=h100] : validate-ptx-int8-sync-mma
;; SKIP-DEFAULT-PASS
;; FAIL-WITH[--differentiate]: "integer MMA has no backward"
;;
;; Endeavour 207 -- NVIDIA sync int8: char x char -> int through mma.sync m16n8k32 (A100 / Ada).
;; One warp, one 16x8 output fragment, K walked 32 at a time (one MMA deep).  The validator
;; matches the FULL mnemonic: a wrong NVVM spelling emits no instruction yet leaves an
;; "mma...m16n8k32" substring behind.

(def-type a-mat (matrix char :address-space :global :align :compact :contiguous-term :row-major))
(def-type b-mat (matrix char :address-space :global :align :compact :contiguous-term :col-major))
(def-type c-mat (matrix int :address-space :global :align :compact :contiguous-term :row-major))

(def-kernel sync_int8 (A B &out C)
  (declare #'(a-mat b-mat &out c-mat)
           (global-size :set-to 32)
           (local-size  :set-to 32))          ; one warp
  (let ((A-tile (make-scratch-matrix char (16 32)))   ; SLM: M x 32 (one int8 K-step of A)
        (B-tile (make-scratch-matrix char (32 8)))    ; SLM: 32 x N
        (C-tile (make-register-tile int (16 8) 0))
        (K      (inner-dimension A B)))
    (matrix-multiply-tile-stride C C-tile K 32 (grid-y grid-x grid-k)
      (load-tile A A-tile (grid-y grid-k))
      (load-tile B B-tile (grid-k grid-x))
      (mma-accumulate-via-tile (16 8 32) C-tile A-tile B-tile)
      :epilogue
      (store-tile C-tile C (grid-y grid-x)))))
