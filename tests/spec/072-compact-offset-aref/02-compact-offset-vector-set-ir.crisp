;; SKIP-WITH[--differentiate]: "Tensor AD not yet supported"
;; TEST-WITH[--ir-target=llvmir]: crisp.compiler::validate-072-02-compact-offset-vector-set-ir

;; Verifies the SET path for :compact-offset vector:
;;   - Reads the offset field (field index 1 of the tensor struct)
;;   - Does NOT read the stride field
;; Tests the write (set!) path specifically.

(def-type cov-t (vector long :address-space :global :access :read-write :align :compact-offset))

(def-kernel compact_offset_vec_set (i val v)
    (declare #'(long long cov-t => nil))
  (set! (~ v i) val))
