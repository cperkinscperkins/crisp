;; TEST-EXPECT: PASS
;; TEST-WITH[--ir-target=spv]
;; dotimes with a ulong limit: the loop variable takes the type of the limit.
;; This matters for 093-loop-vector-stride where the limit comes from length~,
;; which returns ulong.

(def-type cell-t (cell ulong :address-space :global :access :read-write))

(def-kernel dotimes_ulong (n &out result)
  (declare #'(ulong &out cell-t => nil) forward-only)
  (dotimes (i n)
    (set! (~ result) (+ (~ result) i))))
