;; TEST-EXPECT: PASS
;; TEST-WITH[--ir-target=spv]
;; dotimes with an explicit stride: (dotimes (i N stride) body).
;; With stride 2, i takes values 0, 2, 4, ... up to N-1.
;; Accumulates only the even-numbered indices.

(def-type cell-t (cell int :address-space :global))

(def-kernel dotimes_stride (n &out result)
  (declare #'(int &out cell-t => nil))
  (dotimes (i n 2)
    (set! (~ result) (+ (~ result) i))))
