;; TEST-EXPECT: PASS
;; TEST-WITH[--ir-target=spv]
;; dotimes basic: loop var starts at 0, increments to limit-1.
;; Accumulates a running sum into a scratch cell — tests that the
;; loop variable is accessible in the body and that iteration happens.

(def-type cell-t (cell int :address-space :global :access :read-write))

(def-kernel dotimes_basic (n &out result)
  (declare #'(int &out cell-t => nil))
  (dotimes (i n)
    (set! (~ result) (+ (~ result) i))))
