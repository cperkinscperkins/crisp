;; CHECK-FAIL: "integer"
;; dotimes limit must be an integer type.
;; A float limit is a type error.

(def-type cell-t (cell float :address-space :global :access :read-write))

(def-kernel bad_limit (n &out result)
  (declare #'(float &out cell-t => nil))
  (dotimes (i n)
    (set! (~ result) (+ (~ result) 1.0))))
