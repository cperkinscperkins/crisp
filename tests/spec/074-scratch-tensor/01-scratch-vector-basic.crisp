;; TEST-EXPECT: PASS
;; (validator will be added during implementation)

;; Basic scratch vector tests. No kernel — just verifying that
;; make-scratch-vector is syntactically and semantically accepted
;; and returns the right type.

(def-type local-float-vec (vector float :address-space :local :access :read-write :align :compact))

;; Phase 1: make-scratch-vector returned directly
(def-function scratch-vec-direct ()
    (declare #'(=> local-float-vec))
  (make-scratch-vector float :match-workgroup-size))

;; Phase 2: make-scratch-vector bound and returned
(def-function scratch-vec-bound ()
    (declare #'(=> local-float-vec))
  (let ((sv (make-scratch-vector float :match-workgroup-size)))
    sv))

;; Phase 3: using a full tensor-type alias as the first arg
(def-function scratch-vec-type-arg ()
    (declare #'(=> local-float-vec))
  (let ((sv (make-scratch-vector local-float-vec :match-workgroup-size)))
    sv))

;; Phase 4: scratch matrix (N=2 sugar)
(def-type local-float-mat (matrix float :address-space :local :access :read-write :align :compact))

(def-function scratch-mat-bound ()
    (declare #'(=> local-float-mat))
  (let ((sm (make-scratch-matrix float :match-warp-tile)))
    sm))

;; Phase 5: scratch tensor (general N)
(def-type local-float-t3 (tensor float 3 :address-space :local :access :read-write :align :compact))

(def-function scratch-tensor-bound ()
    (declare #'(=> local-float-t3))
  (let ((st (make-scratch-tensor float 3 :match-workgroup-size)))
    st))

;; Phase 6: using a full tensor-type alias as the first arg
(def-function scratch-tensor-type-arg ()
    (declare #'(=> local-float-t3))
  (let ((sv (make-scratch-vector local-float-t3 :match-workgroup-size)))
    sv))
