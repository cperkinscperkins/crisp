;; tensor, like the cell Storage Handle, is a parameterized type.
;; It's type declaration uses &key for :address-space.
;; The minimal type declaration has element type and arity.


(def-function test-tensor-as-arg (t1 )
    (declare #'((tensor int 4) => nil))
    (return))

(with-template-type (T)
    (def-function test-templated-tensor-as-arg (t1)
        (declare #'((tensor T 4) => nil))
        (return)))

(with-template-type (T N)
    (def-function test-templated-arity-tensor-as-arg (t1)
        (declare #'((tensor T N) => nil))
        (return)))

(gen-test-templated-tensor-as-arg float)

(gen-test-templated-arity-tensor-as-arg long 5)