
;; Tensors Accessors require both element-type and arity to be usable.
;; compiler will error otherwise.


(def-function test-tensor-accessor (m y x)
    (declare #'((tensor long 2) ulong ulong => long))
    (~ m y x))

(with-template-type (T)
    (def-function test-templated-tensor-accessor (v x)
        (declare #'((tensor T 1) ulong => T))
        (~ v x)))

(gen-test-templated-tensor-accessor float)