;; TEST-EXPECT: PASS
;; COMPILE-WITH[--hardware-profile=bmg --ir-target=spv]: PASS
;; COMPILE-WITH[--hardware-profile=bmg --ir-target=spv --differentiate]: PASS
;; SKIP-DEFAULT-PASS
;; HOIST-HARDWARE-PROFILE: bmg
;; VERIFY-AUTODIFF: A=4x16@1:0.1 at.A=0,15 expect.A=16.0 atol=1e-1 h=0.01 group=64 output-mat=4x16
;;
;; ENDEAVOUR 177 Phase 1b -- a DEPENDENT reduce-warp differentiates through its combiner's reduction-vjp.
;;
;; argmax over each 16-lane bmg warp; every lane writes the maximum, so per warp sum(C) = 16 * max.  Row 0
;; holds 1.0 .. 2.5 rising, so A[0,15] = 2.5 is the winner: d/dA[0,15] = 16.0.  h is small (0.01) so the
;; finite difference never perturbs the winner out of first place.
;;
;; How it lowers (Phase 1a made it possible): the backward re-runs the reduction on copies, so it holds
;; both this lane's own (v, i) and the result; the result's adjoint is a + all-reduce of every lane's
;; adjoint (16 here, one per writer); argmax-local-vjp gives it to the lane whose index won.
;;
;; 02 is the non-winner (0.0).

(def-type mat-t (matrix float :address-space :global :align :compact :contiguous-term :row-major))

(def-function argmax-combine (val-a idx-a val-b idx-b)
  (declare #'(float ulong float ulong => float ulong)
           (reduction-vjp argmax-local-vjp))
  (if (or (> val-a val-b)
          (and (= val-a val-b) (< idx-a idx-b)))
      (return val-a idx-a)
      (return val-b idx-b)))

;; own state (v i), result (rv ri), result adjoint (rv-bar ri-bar) => own adjoint.  The winning lane
;; takes the value's adjoint; the index is piecewise constant and gets none.  Integer components have
;; FLOAT adjoints (the AD walk's type for every scalar local -- endeavour 177 Phase 0).
(def-function argmax-local-vjp (v i rv ri rv-bar ri-bar)
  (declare #'(float ulong float ulong float float => float float))
  (if (= i ri)
      (return rv-bar 0.0)
      (return 0.0 0.0)))

(def-kernel diff_rw_argmax_winner (A &out C)
  (declare #'(mat-t &out mat-t)
           (global-size :set-to 64)
           (local-size  :set-to 64))
  (let ((tid (to-int (get-local-linear-id))))
    (let ((row (/ tid 16))
          (col (rem tid 16)))
      (let ((v (~ A row col))
            (i (to-ulong col)))
        (reduce-warp #'argmax-combine
                     ((v (type-min float))
                      (i (type-max ulong))))
        ;; every lane holds the warp's maximum and writes it
        (set! (~ C row col) v)))))
