;; TEST-WITH[--ir-target=llvmir] : validate-scratch-cell-explosion-ir

;; temporary test 

;; Phase 1 and Phase 2 tests

(def-function call-scratch-directly ()
    ;; Scratch cells default to :local per design.
    (declare #'(=> (cell long :address-space :local)))
    (make-scratch-cell long))

(def-function scratch-cell-bound ()
    (declare #'(=> (cell float :address-space :local)))
  (let ((sc (make-scratch-cell float)))
    sc))




;; Phase 3 and Phase 4 tests

(def-function fun-D (sc)
    (declare #'((cell int) => int))
  ;; ignore sc for now.
  8)

(def-function fun-C (sc)
    (declare #'((cell int) => int))
  (+ 7 (fun-D sc)))

(def-function fun-B (i)
    (declare #'(int => int))
  (let ((sc (make-scratch-cell int)))
    (+ i (fun-C sc))))

(def-function fun-A (i)
    (declare #'(int => int))
  (fun-B i))

(def-function kernel (i)
    (declare #'(int => int))
  (fun-A i))

