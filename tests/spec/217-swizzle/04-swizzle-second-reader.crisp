;; Endeavour 217 rung 04 -- a swizzled tile with a SECOND reader that is not ldmatrix.
;;
;; WHAT THIS PINS (D-217-2, recommended answer).  Swizzling is only correct if EVERY access to the tile
;; uses the same mapping.  Here A-TILE feeds the MMAs (ldmatrix) and is also copied out to global memory
;; by store-tile-at, whose per-element reads go through the ordinary aref address path (%aref-tensor-ir).
;; The design makes that path swizzle-aware, so the tile STAYS swizzled and the echo reads the right
;; elements.  (The conservative alternative -- any non-ldmatrix use un-swizzles the tile -- would flip this
;; spec to "no xor"; see swizzle.md, D-217-2.)
;;
;; The PTX can show the tile is swizzled (xor.b) and that the echo still reads shared memory; that the
;; echo's values are RIGHT is a metal claim (the 217 correctness diag: AECHO must equal A's tile).
;;
;; SKIP-DEFAULT-PASS
;; TEST-WITH[--ir-target=ptx --ir-target-arch=sm_80 --hardware-profile=h100] : validate-ptx-217-second-reader
(def-type a-mat (matrix half :address-space :global :align :compact :contiguous-term :row-major))
(def-type b-mat (matrix half :address-space :global :align :compact :contiguous-term :row-major))
(def-type c-mat (matrix float :address-space :global :align :compact :contiguous-term :row-major))
(def-kernel swz_second_reader (A B &out C &out AECHO)
  (declare #'(a-mat b-mat &out c-mat &out a-mat)
           (local-size :set-to 32))
  (let ((A-tile (make-scratch-matrix half (64 32)))
        (B-tile (make-scratch-matrix half (32 64)))
        (C-tile (make-register-tile float (64 64) 0.0))
        (K      (inner-dimension A B))
        (bar    (make-async-barrier)))
    (matrix-multiply-tile-stride C C-tile K 32 (grid-y grid-x grid-k)
      (load-tile A A-tile (grid-y grid-k) :barrier bar)
      (load-tile B B-tile (grid-k grid-x) :barrier bar)
      (await bar)
      (mma-accumulate-via-tile (16 8 16) C-tile A-tile B-tile)
      (store-tile A-tile AECHO (grid-y grid-k))
      (sync-workgroup)
      :epilogue
      (store-tile C-tile C (grid-y grid-x)))))
