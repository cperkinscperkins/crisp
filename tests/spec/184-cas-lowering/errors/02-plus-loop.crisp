;; TEST-EXPECT: FAIL
;; CHECK-FAIL: "uniform trip count"
;; Endeavour 184 D2: a + loop promises every thread the same trip count; an early exit breaks it.

(def-type u-c (cell ulong :address-space :global))

(def-kernel k_b (&out out)
  (declare #'(&out u-c => nil)
           (global-size :set-to 1))
  (dotimes+ (i 10)
    (set! (~ out) (+ (~ out) 1ul))
    (when (= i 3)
      (return-from-loop))))
