;; TEST-EXPECT: PASS
;; TEST-HOIST[L0]: validate-l0-host-run
;; HOIST-EXPECT: BUFFER s1: 9080706
;; HOIST-EXPECT: BUFFER c1: 4
;; HOIST-EXPECT: BUFFER s2: 1248
;; HOIST-EXPECT: BUFFER c2: 4
;; SKIP-WITH[--differentiate]: "a loop that can exit early is not differentiable yet (184 D5) -- errors/04 pins the refusal"
;;
;; Endeavour 184 ON-METAL: (return-from-loop) in the 172 loop variants (D1).  Every variant
;; shares one bottom-tested codegen path, so a count-down and a count-up variant cover it.
;;
;;   1: (dec-times (i 10)), exit when i = 6           i = 9 8 7 6         s = 9080706   c = 4
;;   2: (do-power-step (i 100)), exit when i = 8      i = 1 2 4 8         s = 1248      c = 4
;;      (s = s*10 + i; the bound alone would run on to 16 32 64)

(def-type u-c (cell ulong :address-space :global))

(def-kernel early_exit_variants (&out s1 c1 s2 c2)
  (declare #'(&out u-c u-c u-c u-c => nil)
           (global-size :set-to 1))
  (let ((z (get-workgroup-id 0)))
    (set! (~ s1) 0ul) (set! (~ c1) 0ul)
    (set! (~ s2) 0ul) (set! (~ c2) 0ul)
    (dec-times (i (+ z 10ul))
      (set! (~ s1) (+ (* (~ s1) 100ul) i))
      (set! (~ c1) (+ (~ c1) 1ul))
      (when (= i 6ul)
        (return-from-loop)))
    (do-power-step (i (+ z 100ul))
      (set! (~ s2) (+ (* (~ s2) 10ul) i))
      (set! (~ c2) (+ (~ c2) 1ul))
      (when (= i 8ul)
        (return-from-loop)))))
