;; With def-kernel-exact realized
;; then def-kernel expands to the def-kernel-exact with args and marshalling of Storage Handles 
;; SKIP-WITH[--differentiate]: "fails without lax mode" 


(def-type out-c (cell long :address-space :global :access :read-write))

(def-kernel return_7 (c)
    (declare (type c out-c))
    (set! (~ c) 7))