;; TEST-EXPECT: PASS
;; TEST-HOIST[L0]: validate-l0-host-run
;; HOIST-EXPECT: BUFFER out: 43
;; transpose works on a compact (row-major) input.
;; Produces a new :strided view with swapped extents and strides.
;; Input: compact row-major 3x4. Result: 4x3. Encoded: 4*10+3 = 43.

(def-type int-vec-t (vector int :align :compact :address-space :global :access :read-write))
(def-type out-cell-t (cell int :address-space :global :access :read-write))

(def-kernel test_transpose_from_compact (v &out out)
  (declare #'(int-vec-t &out out-cell-t => nil))
  (let ((M  (make-matrix v int 4 3))
        (TM (transpose M)))
    (set! (~ out) (to-int (+ (* (num-rows TM) 10uc) (num-cols TM))))))
