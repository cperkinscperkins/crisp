;; TEST-EXPECT: PASS
;; TEST-HOIST[L0]: validate-l0-host-run
;; TEST-HOIST[CUDA]: validate-cuda-host-run
;; HOIST-EXPECT: BUFFER out: 1
;; get-layout on a default (row-major) matrix returns :row-major.
;; Row-major: strides=[4,1] for a 3x4 matrix.

(def-type int-vec-t (vector int :align :compact :address-space :global))
(def-type out-cell-t (cell int :address-space :global))

(def-kernel test_get_layout_row (v &out out)
  (declare #'(int-vec-t &out out-cell-t => nil))
  (let ((M (make-matrix v int 4 3)))
    (set! (~ out) (if (= (get-layout M) :row-major) 1 0))))
