;; TEST-EXPECT: PASS
;; col always returns :align :strided regardless of the source matrix alignment.
;; Verified by passing the result to a function that only accepts :strided vectors.
;; Source matrix is compact (the harder case).

(def-type int-vec-t (vector int :align :compact :address-space :global))

(def-function require-strided-vec (c)
  (declare #'((vector int :align :strided :address-space :global) => ulong))
  (length~ c))

(def-function test-col-is-strided (v)
  (declare #'(int-vec-t => ulong))
  (let ((M  (make-matrix v int 4 3))
        (c1 (col 1 M)))
    (require-strided-vec c1)))
