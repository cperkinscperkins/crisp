;; TEST-EXPECT: PASS
;; TEST-HOIST[L0]: validate-l0-host-run
;; HOIST-EXPECT: BUFFER out: 3
;;
;; E2E: read a single element through a row view.
;; Row-major 2x2 matrix, iota-initialized: [0,1,2,3].
;;   M[0][0]=0, M[0][1]=1, M[1][0]=2, M[1][1]=3
;;   row 1 = elements at (1,0), (1,1) = flat indices 2, 3.
;; Read col 1 of that row = flat index 3.

(def-type int-vec-t (vector int :align :compact :address-space :global :access :read-write))
(def-type out-cell-t (cell int :address-space :global :access :read-write))

(def-kernel test_row_access (v &out out)
  (declare #'(int-vec-t &out out-cell-t => nil))
  (let ((M  (make-matrix v int 2 2))
        (r1 (row 1 M)))
    (set! (~ out) (~ r1 1))))
