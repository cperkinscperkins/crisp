
;; CHECK-FAIL: "message"
;; FAIL-WITH[--differentiate]: "message"

;; this test causes a violation of the One Brand Name = One Underlying Type rule.
;; and should probably  fail even when we aren't ENFORCING branding. 

(with-template-type (T)
  (def-struct server
    ;; custom types
    (brand token-t T :subst :ancestor)
    
    ;; members
    (active-token token-t)
    (id int))

(def-function authenticate (s tok)
    (declare #'(server (token-t s) => int))
    1))



(def-kernel causes_confliction ()
    (declare (return-type nil))
    (gen-server float)
  (let ((s1 (make-server :active-token (as-float 12345.0) :id 1))
        (my-token (active-token~ s1)))
      (authenticate s1 my-token)))

#|
(def-kernel causes_strife ()
    (declare (return-type nil))
  (let ((s1 (make-server :active-token (as-ulong 12345) :id 1))
        (my-token (active-token~ s1)))
      (authenticate s1 my-token)))

      |#