
;; CHECK-FAIL: "Brand TOKEN-T: invalid :enforce mode NIL. Must be :always or :diff"
;; if :enforce key appears, it must have the value (:always or :differ)

(def-struct server
  ;; custom types
  (brand token-t ulong :subst :no :enforce)
  
  ;; members
  (active-token token-t)
  (id int))