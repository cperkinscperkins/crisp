;; CHECK-FAIL: "Brand name collision: METERS is already defined as a non-brand type"

(def-derived-type meters float :subst :ancestor)

(def-struct server
  ;; collision - meters already defined (would be ok if defined by another 'brand' though)
  (brand meters float :subst :ancestor :enforce :always)
  
  ;; members
  (active-meters meters)
  (id int))