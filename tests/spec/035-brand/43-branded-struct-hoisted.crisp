;; TEST-HOIST[L0]: validate-l0-host-run
;; HOIST-EXPECT: BUFFER c: 1 0

;; reusing existing validator


(def-struct point 
  ;; custom type
  (brand x-t int :subst :equal :enforce :always)
   (x x-t) 
   (y int))



(def-kernel struct_on_kernel_boundary (c)
    (declare (type c (cell point :address-space :global :access :read-write)) forward-only)
  (let ((loc-x (x~ (~ c))))
    (set! (x~ (~ c)) (+ loc-x 1))))