;; TEST-WITH[--metadata] : validate-04-basic-struct

;; reusing existing validator.

;; point should appear in the metadata by virtue of being used at the kernel param boundary.
(def-struct point 
  ;; custom type
  (brand x-t int :subst :equal :enforce :always)
   (x x-t) 
   (y int))



(def-kernel my_kernel (c)
    (declare (type c (cell point :address-space :global :access :read-write)) forward-only)
  (let ((loc-x (x~ (~ c))))
    (set! (x~ (~ c)) (+ loc-x 1))))
  