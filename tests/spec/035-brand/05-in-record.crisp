
;; TEST-WITH[--differentiate]

;; basic record with branded type. 
(def-record server
  ;; custom types
  (brand token-t ulong :subst :no)
  
  ;; members
  (active-token token-t)
  (id int))

(def-function instantiate-server ()
    (declare (return-type int))
  (let ((s (make-server :active-token 12345 :id 1)))
    (id~ s)))