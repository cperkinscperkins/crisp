;; TEST-EXPECT: PASS
;; TEST-WITH[--differentiate]
;; VERIFY-AUTODIFF: x=1.3 w=0.6 s=0.5 m=2.0 atol=1e-4 fd=off expect.x=4.0 expect.w=12.0 expect.s=-24.8 expect.m=3.0
;;
;; Endeavour 205: narrowing an accumulator.  p = a * b = 3, and y = round(p * m) = 6.
;;   dy/dm = p = 3, dy/dx = m * b / s = 4, dy/dw = m * a / s = 12
;;   dy/ds = m * (-5.2 - 7.2) = -24.8
(def-qint q-a :base char :accum int)
(def-qint q-o :base char :accum int)
(def-type fc (cell float :address-space :global))

(def-kernel k (x w s m &out y)
  (declare #'(fc fc fc fc &out fc => nil))
  (set! (~ y) (to-float (to-q-o (*! (to-q-a (~ x) (~ s)) (to-q-a (~ w) (~ s))) (~ m)) 1.0)))
