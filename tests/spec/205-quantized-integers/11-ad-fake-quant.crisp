;; TEST-EXPECT: PASS
;; TEST-WITH[--differentiate]
;; VERIFY-AUTODIFF: x=1.3 s=0.5 atol=1e-4 fd=off expect.x=1.0 expect.s=0.4
;;
;; Endeavour 205: the fake-quant pattern.  y = s * round(x / s).  Rounding is treated as if it were not
;; there, so dy/dx = s * 1/s = 1, and dy/ds = q - x/s = 3 - 2.6 = 0.4, the Learned Step Size gradient.
;; Finite differences see the true step function, which is why fd=off.
(def-qint q-a :base char :accum int)
(def-type fc (cell float :address-space :global))

(def-kernel k (x s &out y)
  (declare #'(fc fc &out fc => nil))
  (set! (~ y) (to-float (to-q-a (~ x) (~ s)) (~ s))))
