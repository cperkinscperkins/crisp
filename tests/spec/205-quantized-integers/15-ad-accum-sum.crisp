;; TEST-EXPECT: PASS
;; TEST-WITH[--differentiate]
;; VERIFY-AUTODIFF: x=1.3 w=0.6 s=0.5 atol=1e-4 fd=off expect.x=4.0 expect.w=2.0 expect.s=-12.8
;;
;; Endeavour 205: +!, widen and + on accumulators are linear.  y = (a + b) + a, with a = 3 and b = 1.
;;   dy/dx = 2 / s = 4, dy/dw = 1 / s = 2, dy/ds = 2 * -5.2 - 2.4 = -12.8
(def-qint q-a :base char :accum int)
(def-type fc (cell float :address-space :global))

(def-kernel k (x w s &out y)
  (declare #'(fc fc fc &out fc => nil))
  (let ((a (to-q-a (~ x) (~ s)))
        (b (to-q-a (~ w) (~ s))))
    (set! (~ y) (to-float (+ (+! a b) (widen a)) 1.0))))
