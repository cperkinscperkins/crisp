;; TEST-EXPECT: PASS
;; TEST-HOIST[L0]: validate-l0-host-run
;; TEST-HOIST[CUDA]: validate-cuda-host-run
;; HOIST-EXPECT: BUFFER o: 16 127 -128 4
;; HOIST-EXPECT: BUFFER p: 2 2 -2 -2
;;
;; Endeavour 205 ON-METAL: (to-q-a acc multiplier) narrows an accumulator: round(acc * m), saturating.
;;   -128 *! -128 = 16384, at 0.001 is 16.384, so 16; at 0.1 is 1638.4, so it saturates to 127
;;   -128 *!  127 = -16256, at 0.1 saturates to -128
;;   2 *! 2 = 4 at multiplier 1
;;   3 and 5 at 0.5 are 1.5 and 2.5: both round to 2, ties to even.  The negatives mirror them.
(def-qint q-a :base char :accum int)
(def-type iv (vector int :address-space :global :align :compact))

(def-kernel narrow_metal (&out o p)
  (declare #'(&out iv iv => nil) (global-size :set-to 1))
  (let ((g (to-int (get-global-id 0))))
    (let ((neg (to q-a (+ g -128)))
          (pos (to q-a (+ g 127)))
          (one (to q-a (+ g 1)))
          (two (to q-a (+ g 2)))
          (three (to q-a (+ g 3)))
          (five (to q-a (+ g 5)))
          (mone (to q-a (+ g -1))))
      (set! (~ o 0) (to int (to-q-a (*! neg neg) 0.001)))
      (set! (~ o 1) (to int (to-q-a (*! neg neg) 0.1)))
      (set! (~ o 2) (to int (to-q-a (*! neg pos) 0.1)))
      (set! (~ o 3) (to int (to-q-a (*! two two) 1.0)))
      (set! (~ p 0) (to int (to-q-a (*! three one) 0.5)))
      (set! (~ p 1) (to int (to-q-a (*! five one) 0.5)))
      (set! (~ p 2) (to int (to-q-a (*! three mone) 0.5)))
      (set! (~ p 3) (to int (to-q-a (*! five mone) 0.5))))))
