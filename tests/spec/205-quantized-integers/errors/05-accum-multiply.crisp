;; CHECK-FAIL: "accumulators add and subtract"
;; Endeavour 205 -- an accumulator only adds and subtracts.
(def-qint q-a :base char :accum int)
(def-type iv (vector int :address-space :global :align :compact))
(def-kernel e (&out o)
  (declare #'(&out iv => nil) (global-size :set-to 1))
  (let ((a (widen (to q-a 1))))
    (set! (~ o 0) (to int (* a a)))))
