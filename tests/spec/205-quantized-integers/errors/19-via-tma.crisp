;; CHECK-FAIL: "moves 16-bit elements"
;; CHECK-FAIL-FLAGS: --ir-target=ptx --ir-target-arch=sm_90
;; Endeavour 205 -- stmatrix has no 8-bit form.
(def-qint q-a :base char :accum int)
(def-type a-mat (matrix q-a :address-space :global :align :compact :contiguous-term :row-major))
(def-kernel e (A B &out C)
  (declare #'(a-mat a-mat &out a-mat) (global-size :set-to 128) (local-size :set-to 128))
  (let ((A-tile (make-scratch-matrix q-a (64 128)))
        (B-tile (make-scratch-matrix q-a (64 128)))
        (D      (make-wgmma-accumulator (accum q-a) (64 64) 0))
        (bar    (make-async-barrier :mode :block)))
    (load-tile A A-tile (0 0) :barrier bar :swizzle :128b)
    (load-tile B B-tile (0 0) :barrier bar :swizzle :128b)
    (await bar)
    (wgmma-accumulate-via-tile (64 64 128) D A-tile B-tile :swizzle :128b)
    (store-tile-at (to-q-a D 1.0) C (0 0) :via :tma)))
