;; CHECK-FAIL: "convert to float first"
;; Endeavour 205 -- a quotient of quantized values has no meaningful scale.
(def-qint q-a :base char :accum int)
(def-type iv (vector int :address-space :global :align :compact))
(def-kernel e (&out o)
  (declare #'(&out iv => nil) (global-size :set-to 1))
  (let ((a (to q-a 1)))
    (set! (~ o 0) (to int (/ a a)))))
