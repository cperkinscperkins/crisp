;; TEST-EXPECT: PASS
;; TEST-HOIST[L0]: validate-l0-host-run
;; TEST-HOIST[CUDA]: validate-cuda-host-run
;; HOIST-EXPECT: BUFFER o: 2 4 127 -128
;; HOIST-EXPECT: BUFFER p: 3 -3 0 2
;; HOIST-EXPECT: BUFFER f: 1.5 -1.5 0.75 -6
;;
;; Endeavour 205 ON-METAL: real = scale * q.
;;   2.5 and 3.5 at scale 1 round to 2 and 4: ties go to even
;;   1000 and -1000 saturate
;;   1.3 at scale 0.5 is 2.6, so 3; 0.2 is 0.4, so 0; 0.75 is 1.5, so 2
;;   to-float multiplies by whatever scale it is given
;; g = gid = 0 at runtime keeps the constant folder away from the operands.
(def-qint q-a :base char :accum int)
(def-type iv (vector int :address-space :global :align :compact))
(def-type fv (vector float :address-space :global :align :compact))

(def-kernel to_q_metal (&out o p f)
  (declare #'(&out iv iv fv => nil) (global-size :set-to 1))
  (let ((g (to-float (get-global-id 0))))
    (set! (~ o 0) (to int (to-q-a (+ g 2.5) 1.0)))
    (set! (~ o 1) (to int (to-q-a (+ g 3.5) 1.0)))
    (set! (~ o 2) (to int (to-q-a (+ g 1000.0) 1.0)))
    (set! (~ o 3) (to int (to-q-a (- g 1000.0) 1.0)))
    (set! (~ p 0) (to int (to-q-a (+ g 1.3) 0.5)))
    (set! (~ p 1) (to int (to-q-a (- g 1.3) 0.5)))
    (set! (~ p 2) (to int (to-q-a (+ g 0.2) 0.5)))
    (set! (~ p 3) (to int (to-q-a (+ g 0.75) 0.5)))
    (let ((three (to-q-a (+ g 1.3) 0.5))
          (minus (to-q-a (- g 1.3) 0.5)))
      (set! (~ f 0) (to-float three 0.5))
      (set! (~ f 1) (to-float minus 0.5))
      (set! (~ f 2) (to-float three 0.25))
      (set! (~ f 3) (to-float minus 2.0)))))
