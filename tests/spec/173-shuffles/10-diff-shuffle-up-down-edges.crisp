;; TEST-EXPECT: PASS
;; COMPILE-WITH[--hardware-profile=bmg --ir-target=spv]: PASS
;; COMPILE-WITH[--hardware-profile=bmg --ir-target=spv --differentiate]: PASS
;; SKIP-DEFAULT-PASS
;; HOIST-HARDWARE-PROFILE: bmg
;; VERIFY-AUTODIFF: A=4x16@0:0.01 B=4x16@0:0.01 at.A=0,0 expect.A=3.0 at.B=0,3 expect.B=7.0 group=64 h=0.5 atol=1e-2 output-mat=4x16
;;
;; Endeavour 173 A|D: shuffle-up and shuffle-down transpose into each other -- PLUS an edge
;; correction, which is the part that gets forgotten.
;;
;; A shift is not a permutation.  A lane whose source lies outside the warp (or outside its
;; segment, under a width) keeps its OWN value in the forward pass, so in the backward that
;; lane contributes to its own adjoint rather than to a neighbour's.  Both probe points here
;; sit ON an edge, because an interior probe cannot tell a correct backward from one that
;; simply dropped the edge term.
;;
;; Weight w(t) = col(t) + 1, as in 09, so that a misdelivered adjoint lands on a different
;; number rather than an identical one.
;;
;; A -- shuffle-up 1, full warp.  r[t] = v[t-1], except lane 0 which keeps v[0].
;;      A[0] is therefore read TWICE: by thread 1 (as its neighbour) and by thread 0
;;      (as itself, the edge).
;;        d sum(C)/dA[0] = w(1) + w(0) = 2 + 1 = 3.0
;;      Drop the edge term        -> 2.0
;;      Transpose the wrong way   -> w(1) alone via shuffle-down = 2.0
;;      Lane 0 is lane 0 under any sub-group width, so this probe is width-safe.
;;
;; B -- shuffle-down 1, WIDTH 4.  Segmenting is what makes the upper edge reachable: the top
;;      of a real warp is lane 15 here and lane 31 on NVIDIA, but the top of a quad is lane 3
;;      either way.  r[t] = u[t+1], except k=3 which keeps u[3].
;;      B[3] is read by thread 2 (as its neighbour) and by thread 3 (as itself, the edge).
;;        d sum(C)/dB[3] = w(2) + w(3) = 3 + 4 = 7.0
;;      Drop the edge term -> 3.0
;;      This also pins D8's claim that `width` passes through A|D unchanged: the adjoint is
;;      the opposite shift AT THE SAME WIDTH, and getting the width wrong moves the edge.
;;
;; Both shuffles are evaluated unconditionally by every lane (D6); nothing here is gated.

(def-type mat-t (matrix float :address-space :global :align :compact :contiguous-term :row-major))

(def-kernel diff_shuffle_up_down (A B &out C)
  (declare #'(mat-t mat-t &out mat-t)
           (global-size :set-to 64)
           (local-size  :set-to 64))
  (let ((tid (to-int (get-local-linear-id))))
    ;; Crisp's LET is already sequential; let* compiles forward but breaks the AD walk.
    (let ((row (/ tid 16))
          (col (rem tid 16)))
      (let ((v (~ A row col))
            (u (~ B row col))
            (w (to-float (+ col 1))))
        (let ((ru (shuffle-up   v 1ul))
              (rd (shuffle-down u 1ul 4)))
          (set! (~ C row col) (+ (* w ru) (* w rd))))))))
