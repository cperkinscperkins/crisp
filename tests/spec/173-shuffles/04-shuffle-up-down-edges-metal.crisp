;; TEST-EXPECT: PASS
;; HOIST-HARDWARE-PROFILE: bmg
;; TEST-HOIST[L0]: validate-l0-host-run
;; TEST-HOIST[CUDA]: validate-cuda-host-run
;; HOIST-EXPECT: BUFFER u1: 7 7 17 27
;; HOIST-EXPECT: BUFFER d1: 17 27 37 47
;;
;; Endeavour 173 ON-METAL: shuffle-up / shuffle-down and the LOWER edge.  See 02.
;;
;; The direction names describe where the DATA travels, not the arithmetic:
;;   shuffle-up   d  SUBTRACTS d from the lane id (data moves up to a higher lane)
;;   shuffle-down d  ADDS      d to the lane id (data moves down to a lower lane)
;;
;; A shift is not a permutation: a lane whose source falls outside the warp keeps its
;; OWN value.  That "else own value" rule is where the bugs live, and an aggregate sum
;; cannot see it -- so it is pinned directly.
;;
;; u1 = shuffle-up   v 1 -> lane 0 has no lane -1, so it KEEPS 7        ->  7  7 17 27
;;                          lanes 1..3 read lanes 0..2                      ^^ the edge
;; d1 = shuffle-down v 1 -> lanes 0..3 read lanes 1..4                  -> 17 27 37 47
;;
;; Only the LOWER edge is warp-size independent (it is always lane 0).  The UPPER edge
;; sits at lane 31 on NVIDIA and lane 15 on BMG, so it cannot be pinned portably here;
;; 06 uses (width 4) to pull an upper edge down into the first four lanes instead.

(def-type u-vec (vector ulong :address-space :global :align :compact))

(def-kernel shuffle_up_down_edges_metal (&out u1 d1)
  (declare #'(&out u-vec u-vec => nil)
           (global-size :set-to 32)
           (local-size  :set-to 32))
  (let ((lane (to-ulong (warp-lane)))
        (v    (+ (* lane 10ul) 7ul))
        (ru   (shuffle-up   v 1ul))
        (rd   (shuffle-down v 1ul)))
    (when (< lane 4ul)
      (set! (~ u1 lane) ru)
      (set! (~ d1 lane) rd))))
