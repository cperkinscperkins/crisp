;; TEST-EXPECT: FAIL
;; CHECK-FAIL: "only some WARPS take"
;;
;; Endeavour 194 (P3): a variable set inside a branch only some warps take is at best WARP-uniform
;; afterwards -- the other warps never saw the store.  So a barrier gated on it is reached by those
;; warps only.  Before 194 the set! left `flag` :uniform.

(def-type uvec-t (vector uint :address-space :global :align :compact))

(def-kernel refused_04 (&out out)
  (declare #'(&out uvec-t => nil)
           (global-size :set-to 64)
           (local-size  :set-to 64))
  (let ((flag 0u)
        (w0   (to-warp-uniform (< (get-local-id 0) 32ul))))
    (when w0
      (set! flag 1u))
    (when (= flag 1u)
      (sync-workgroup))
    (set! (~ out (get-local-id 0)) flag)))
