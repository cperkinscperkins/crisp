;; TEST-EXPECT: FAIL
;; CHECK-FAIL: "trip count is not uniform"
;;
;; Endeavour 194 (P1): a loop whose trip count differs between threads divides them exactly like a
;; branch.  Thread t runs t iterations, so each reaches the barrier a different number of times.
;; Before 194 a non-uniform bound only tainted variables; the barrier check never saw the loop.

(def-type uvec-t (vector uint :address-space :global :align :compact))

(def-kernel refused_02 (&out out)
  (declare #'(&out uvec-t => nil)
           (local-size :set-to 64))
  (dotimes (i (get-local-id 0))
    (sync-workgroup))
  (set! (~ out (get-local-id 0)) 1u))
