;; TEST-EXPECT: FAIL
;; CHECK-FAIL: "only some WARPS take"
;;
;; Endeavour 194 (F2): a warp-uniform condition is NOT workgroup-uniform.  Only the first warp(s) take
;; this branch, so the barrier inside is reached by part of the workgroup and the rest never arrive.
;; Before 194 to-warp-uniform answered :uniform and this compiled.

(def-type uvec-t (vector uint :address-space :global :align :compact))

(def-kernel refused_01 (&out out)
  (declare #'(&out uvec-t => nil)
           (global-size :set-to 64)
           (local-size  :set-to 64))
  (let ((w0 (to-warp-uniform (< (get-local-id 0) 32ul))))
    (when w0
      (sync-workgroup))
    (set! (~ out (get-local-id 0)) 1u)))
