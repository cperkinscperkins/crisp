;; TEST-EXPECT: PASS
;; HOIST-HARDWARE-PROFILE: bmg
;; TEST-HOIST[L0]: validate-l0-host-run
;; TEST-HOIST[CUDA]: validate-cuda-host-run
;; HOIST-EXPECT: BUFFER x: 17 7 37 27
;;
;; Endeavour 194 ON-METAL (D-194-15): "warp 0 does X", written the usual way -- wid = tid / 32 -- is
;; inferred WARP-uniform: in a 1-D workgroup warps are consecutive runs of the local index, and the warp
;; size divides 32 (32 on NVIDIA, 16 on BMG), so every lane of a warp computes the same wid.  So a call
;; to a function holding a shuffle is legal under (when (= wid 0ul) ...).  Before 194 this compiled only
;; because a callee's collective was never checked at the call site (F3); with the call-site check and
;; without the inference, every contest kernel written this way would be refused.
;;
;; Only the first 32 threads (warp 0 on NVIDIA, warps 0-1 on BMG) enter; the 173/02 fingerprint shuffle
;; gives lanes 0..3: 17 7 37 27.

(def-type u-vec (vector ulong :address-space :global :align :compact))

(def-function swap-pairs (x)
  (declare #'(ulong => ulong))
  (return (shuffle-xor x 1ul)))

(def-kernel first_warps (&out x)
  (declare #'(&out u-vec => nil)
           (global-size :set-to 64)
           (local-size  :set-to 64))
  (let ((tid  (to-ulong (get-local-id 0)))
        (wid  (/ tid 32ul))
        (lane (to-ulong (warp-lane))))
    (when (= wid 0ul)
      (let ((r (swap-pairs (+ (* lane 10ul) 7ul))))
        (when (< tid 4ul)
          (set! (~ x tid) r))))))
