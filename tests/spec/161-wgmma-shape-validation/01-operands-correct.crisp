;; Endeavour 161 rung 01 - the POSITIVE control: correctly shaped wgmma operands still compile.
;;
;; Every other rung in this endeavour is a refusal.  This one exists so that a bug in the new
;; check announces itself as a FAILING BUILD rather than as four happily passing error specs --
;; a check that refused everything would satisfy errors/01-04 perfectly.
;;
;; A is (M K) = (64 8) and B is (N K) = (64 8).  Both operands K-major, which is the layout
;; CUTLASS declares for every tf32 GMMA trait: smem_desc<GMMA::Major::K>, ABLayout<64,8>.
;;
;; SKIP-DEFAULT-PASS
;; TEST-WITH[--ir-target=ptx --ir-target-arch=sm_90]
(declaim (precision fast))
(def-type mt (matrix float :address-space :global :align :compact :contiguous-term :row-major))
(def-kernel wgmma_ok (&out C)
  (declare #'(&out mt) (global-size :set-to 128) (local-size :set-to 128))
  (let ((A-tile (make-scratch-matrix float (64 8)))    ; (M K)
        (B-tile (make-scratch-matrix float (64 8)))    ; (N K)
        (D (make-wgmma-accumulator float (64 64) 0.0)))
    (wgmma-accumulate-via-tile (64 64 8) D A-tile B-tile)
    (set! (~ C 0 0) 1.0)))
