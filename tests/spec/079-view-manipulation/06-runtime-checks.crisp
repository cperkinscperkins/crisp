;; TEST-WITH[--runtime-checks] : validate-has-die-check
;;
;; Verify that view mutations emit bounds checks when --runtime-checks is active.
;;
;; Under --runtime-checks, (set! (offset~ c) new-val) emits:
;;   icmp ult new-val, storage-capacity
;;   br i1 cmp, label ok, label die
;;   die: a CAS on the module-scope die record, then the thread returns (endeavour 193; it was
;;        llvm.trap, a silent no-op on L0 -- BUG 136)
;;
;; DEFAULT pass: compiles cleanly, no check emitted.
;; TEST-WITH pass: the die-record CAS must appear in the IR, and llvm.trap must not.

(def-type int-vec-t (vector int :align :compact :address-space :global))

(def-function test-rt-check-set-offset (v)
    (declare #'(int-vec-t => nil))
  (let ((c (make-cell v int)))
    (set! (offset~ c) 2)
    (return)))
