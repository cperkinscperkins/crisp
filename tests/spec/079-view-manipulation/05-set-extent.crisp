;; Set an individual extent element of a matrix view.
;; extents~ returns (array ulong N); mutate element 1 (width) via (set! (~ (extents~ m) 1) val).
;; Paired with 04: both test chained set! through virtual-array accessors.

(def-type int-mat-t (matrix int :align :compact :address-space :global))

(def-function test-set-extent (m)
    (declare #'(int-mat-t => ulong))
  (let ((view (make-matrix m int 4 4)))
    (set! (~ (extents~ view) 1) 8)
    (~ (extents~ view) 1)))
