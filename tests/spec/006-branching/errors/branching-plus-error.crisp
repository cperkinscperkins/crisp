;; CHECK-FAIL: "if+ requires a provably uniform condition"
;; Test: Branching + Variant Failure
;; This checks that if+ ERRORS if the condition is not known at compile time.

(def-function test-if-plus-error (a)
  (declare #'(int => int))
  ;; 'a' is a runtime value, so logic depending on it is not compile-time constant.
  ;; This should trigger a compile-time error.
  (if+ (> a 10)
       1
       0))

