;; VERIFY-AUTODIFF: input=1.5 atol=1e-3 expect.input=4.0
;;
;; The shadowing let sits inside a value-if branch: for x > 0, y = 2x + 1 and out = 2y, so
;; d/dx = 4.  The merged adjoint lost the gradient entirely -- AD reported 0.0, silently.
;; Graduated from tests/adversarial (ADV-002).

(def-type cell-float (cell float :address-space :global))

(def-kernel phi_shadowing_kernel (input &out out-res)
  (declare #'(cell-float &out cell-float))
  (let ((x (~ input)))
    (let ((y (if (> x 0.0)
                 (let ((x (* x 2.0)))
                   (+ x 1.0))
                 x)))
      (set! (~ out-res) (* y 2.0)))))
