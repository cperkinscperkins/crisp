;; TEST-EXPECT: PASS
;; TEST-WITH[--ir-target=spv]

;; Basic 2D tile-stride: tile shape (2 2) against a 4x4 default-extent
;; matrix → 4 tiles (tile-IDs {0,1}×{0,1}), no ragged edges.  Body runs
;; once per workgroup per tile; leader thread sentinel-writes the row
;; tile-ID into M[row-grid-y][col-grid-x] to prove the body reached each
;; tile (endeavor 135: bindings are GRID terms, not element origins).

(def-type mat-t (matrix ulong :address-space :global :align :compact))

(def-kernel mat_tile_origin_sentinel_2d (&out M)
  (declare #'(&out mat-t => nil))
  (tile-stride M (2 2) (row-grid-y col-grid-x)
    (when (= (get-local-linear-id) (to-ulong 0))
      (set! (~ M row-grid-y col-grid-x) row-grid-y))))
