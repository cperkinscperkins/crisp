;; TEST-EXPECT: PASS
;; TEST-WITH[--ir-target=spv]

;; tile-indices helper: returns WHICH tile the binding is in.
;; Semantics: tile-indices(x) = (floor x tile-size).
;;
;; With tile (2 2) on a 4x4 matrix, the idx-x value at each
;; (row-y, col-x) position should be (floor col-x 2).  Writing
;; idx-x into each cell yields the pattern:
;;   row 0: [0 0 1 1]
;;   row 1: [0 0 1 1]
;;   row 2: [0 0 1 1]
;;   row 3: [0 0 1 1]

(def-type mat-t (matrix ulong :address-space :global :align :compact))

(def-kernel mat_write_tile_indices_x (&out M)
  (declare #'(&out mat-t => nil))
  (tile-stride M (2 2) (row-y col-x)
    (let ((idx-y idx-x (tile-indices row-y col-x)))
      (set! (~ M row-y col-x) idx-x))))
