;; TEST-EXPECT: PASS
;; TEST-WITH[--ir-target=spv]

;; tile-stride bindings ARE the tile-indices (endeavor 135: GRID terms).
;; For a 4x4 matrix with tile (2 2), the bindings (row-grid-y col-grid-x)
;; take the tile-ID set { (0,0), (0,1), (1,0), (1,1) } directly.  The body
;; reconstructs the element origin by scaling each tile-ID by the tile
;; extent (2) → element set { (0,0), (0,2), (2,0), (2,2) }, all in-bounds.
;;
;; Leader thread writes the column tile-ID into M[row-grid-y*2][col-grid-x*2].

(def-type mat-t (matrix ulong :address-space :global :align :compact))

(def-kernel mat_tile_indices_sentinel (&out M)
  (declare #'(&out mat-t => nil))
  (tile-stride M (2 2) (row-grid-y col-grid-x)
    (when (= (get-local-linear-id) (to-ulong 0))
      (set! (~ M (* row-grid-y (to-ulong 2)) (* col-grid-x (to-ulong 2))) col-grid-x))))
