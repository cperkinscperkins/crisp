;; TEST-EXPECT: PASS
;; TEST-WITH[--ir-target=spv]

;; tile-stride variant that takes a <tile-tensor> argument instead of a
;; size-list.  The tile's extents are used as the tile shape — same arity
;; required as the problem tensor.  Here we use a scratch matrix sized
;; :match-warp-tile as the shape source.
;;
;; This test only verifies the tile-tensor form parses and emits a valid
;; outer-loop stride; cooperative loads/stores into the scratch tile are
;; deferred to the load-tile/store-tile feature.  Sentinel write via the
;; workgroup leader proves the body reached each tile origin.

(def-type mat-t (matrix ulong :address-space :global :align :compact))

(def-kernel mat_tile_tensor_sentinel (&out M)
  (declare #'(&out mat-t => nil))
  (let ((tile (make-scratch-matrix ulong :match-warp-tile)))
    (tile-stride M tile (row-grid-y col-grid-x)
      (when (= (get-local-linear-id) (to-ulong 0))
        (set! (~ M row-grid-y col-grid-x) row-grid-y)))))
