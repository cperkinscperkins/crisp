;; TEST-EXPECT: PASS
;; TEST-WITH[--ir-target=spv]

;; Strict tile-stride with :contiguous-first on a 3D tensor.  z-grid-x
;; (first binding) varies along the warp lane.  Tensor's static CT is
;; :first so the tag agrees.  Leader-thread sentinel write at each
;; tile origin.

(def-type ten3-t (tensor ulong 3 :address-space :global :align :compact :contiguous-term :first))

(def-kernel ten3_strict_cf_sentinel (&out T3)
  (declare #'(&out ten3-t => nil))
  (tile-stride T3 :contiguous-first (2 2 2) (z-grid y-grid x-grid)
    (when (= (get-local-linear-id) (to-ulong 0))
      (set! (~ T3 z-grid y-grid x-grid) z-grid))))
