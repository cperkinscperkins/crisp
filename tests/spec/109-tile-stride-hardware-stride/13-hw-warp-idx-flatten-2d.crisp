;; TEST-EXPECT: PASS
;; TEST-WITH[--ir-target=spv]

;; hardware-stride :warp-idx with a 2D global-size.  Per the chapter
;; doc, :warp-idx iterates over the FLATTENED global execution space by
;; warp width, regardless of global-size arity.  The binding count is
;; always exactly 1.
;;
;; Caveat: local_work_size should normally be a multiple of
;; (get-warp-size) to avoid warp-level operation deadlocks; (2 2) is used
;; here only because this is a compile-only test.  An on-metal warp-idx
;; test should size local appropriately.
;;
;; Leader thread writes the warp-index — tile-indices(warp-orig) — into V[warp-orig].

(def-type vec-t (vector ulong :address-space :global :align :compact))

(def-kernel hw_warp_flatten_2d (&out V)
  (declare #'(&out vec-t => nil)
           (global-size :set-to '(2 2))
           (local-size  :set-to '(2 2)))
  (hardware-stride V :warp-idx (warp-orig)
    (when (= (get-local-linear-id) (to-ulong 0))
      (set! (~ V warp-orig) (tile-indices warp-orig)))))
