;; TEST-EXPECT: PASS
;; TEST-WITH[--ir-target=spv]

;; hardware-stride :warp-idx — flatten semantic.
;; The chapter doc clarifies that :warp-idx iterates over the FLATTENED
;; global execution space by warp width, regardless of the global-size
;; arity.  The binding count is therefore always exactly 1, even when
;; the kernel's global-size has higher arity.
;;
;; This test demonstrates the flatten by enqueuing with a 2D global-size
;; but exposing only a single linear binding `i` to the body.  The body
;; writes tile-indices(i) — which warp this lane belongs to — into V[i].
;;
;; Caveat: local_work_size should normally be a multiple of
;; (get-warp-size) to avoid warp-level operation deadlocks; (2 2) is
;; used here only because this is a compile-only test.  An on-metal
;; warp-idx test should size local appropriately.

(def-type vec-t (vector ulong :address-space :global :align :compact))

(def-kernel hw_warp_flatten_2d (&out V)
  (declare #'(&out vec-t => nil)
           (global-size :set-to '(2 2))
           (local-size  :set-to '(2 2)))
  (hardware-stride V :warp-idx (i)
    (set! (~ V i) (tile-indices i))))
