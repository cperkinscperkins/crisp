;; TEST-EXPECT: PASS
;; TEST-WITH[--ir-target=spv]

;; Basic 2D tile-stride: fill every element of M with 7.
;; Twin of 105/02-basic-2d but using tile-stride.  Tile shape (2 2)
;; against a 4x4 default-extent matrix → 4 tiles, no ragged edges.
;; Body doesn't use the helpers yet — proves the macro parses
;; the size-list and produces a stride loop matching tensor-stride.

(def-type mat-t (matrix int :address-space :global :align :compact))

(def-kernel mat_fill_tile_2d (&out M)
  (declare #'(&out mat-t => nil))
  (tile-stride M (2 2) (row-y col-x)
    (set! (~ M row-y col-x) 7)))
