;; TEST-EXPECT: PASS
;; TEST-WITH[--ir-target=spv]

;; Strict hardware-stride: layout-tag goes between the tensor and the
;; hw-tag.  Combines :row-major static layout with :workgroup-idx
;; chunking + the surviving tile-indices helper.
;;
;; Under outer-loop semantics, tile-coords / tensor-coords no longer
;; exist; only the workgroup-level tile-indices identity remains.
;;
;; Leader thread writes an encoding that identifies which workgroup chunk:
;; (* idx-x 10) + col-orig — distinguishes both the chunk's column index
;; and the chunk's column-origin coord within the problem space.

(def-type mat-t (matrix ulong :address-space :global :align :compact))

(def-kernel mat_hw_strict (&out M)
  (declare #'(&out mat-t => nil)
           (global-size :set-to '(4 4))
           (local-size  :set-to '(2 2)))
  (hardware-stride M :row-major :workgroup-idx (row-orig col-orig)
    (when (= (get-local-linear-id) (to-ulong 0))
      (set! (~ M (* row-orig (to-ulong 2)) (* col-orig (to-ulong 2)))
            (+ (* col-orig (to-ulong 10)) (* col-orig (to-ulong 2)))))))
