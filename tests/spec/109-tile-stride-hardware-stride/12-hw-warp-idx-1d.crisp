;; TEST-EXPECT: PASS
;; TEST-WITH[--ir-target=spv]

;; hardware-stride with :warp-idx on a 1D vector.  Under outer-loop
;; semantics, the body runs once per warp with the binding bound to the
;; global origin coord of that warp's chunk.  Critical constraint
;; (per chapter doc): local_work_size MUST be a multiple of
;; (get-warp-size); here local-size 32 matches the conventional warp size.
;;
;; Leader thread writes the warp-index — tile-indices(warp-grid-x) with the
;; warp width as divisor — into V[warp-grid-x].

(def-type vec-t (vector ulong :address-space :global :align :compact))

(def-kernel vec_hw_warp_1d (&out V)
  (declare #'(&out vec-t => nil)
           (global-size :set-to 128)
           (local-size  :set-to 32))
  (hardware-stride V :warp-idx (warp-grid-x)
    (when (= (get-local-linear-id) (to-ulong 0))
      (set! (~ V (* warp-grid-x (to-ulong 32))) warp-grid-x))))
