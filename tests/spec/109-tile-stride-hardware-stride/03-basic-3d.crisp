;; TEST-EXPECT: PASS
;; TEST-WITH[--ir-target=spv]

;; Basic 3D tile-stride: fill every element of T3 with 9.
;; Tile shape (2 2 2) against a 4x4x4 default-extent tensor → 8 tiles.
;; Body doesn't use the helpers — proves 3D arity flows through
;; tile-stride's size-list / binding validation.

(def-type ten3-t (tensor int 3 :address-space :global :align :compact))

(def-kernel ten_fill_tile_3d (&out T3)
  (declare #'(&out ten3-t => nil))
  (tile-stride T3 (2 2 2) (z y x)
    (set! (~ T3 z y x) 9)))
