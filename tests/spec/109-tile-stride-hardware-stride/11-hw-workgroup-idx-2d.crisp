;; TEST-EXPECT: PASS
;; TEST-WITH[--ir-target=spv]

;; hardware-stride with :workgroup-idx on a 2D matrix.  Under outer-loop
;; semantics, the body runs once per workgroup with the binding bound to
;; the global origin coord of that workgroup's chunk.  For local-size (2 2)
;; and global-size (4 4), origins are { (0,0), (0,2), (2,0), (2,2) } — same
;; pattern as tile-stride with tile (2 2).
;;
;; Leader thread writes the column tile-index into M[row-orig][col-orig].

(def-type mat-t (matrix ulong :address-space :global :align :compact))

(def-kernel mat_hw_wg_2d (&out M)
  (declare #'(&out mat-t => nil)
           (global-size :set-to '(4 4))
           (local-size  :set-to '(2 2)))
  (hardware-stride M :workgroup-idx (row-orig col-orig)
    (when (= (get-local-linear-id) (to-ulong 0))
      (let ((idx-y idx-x (tile-indices row-orig col-orig)))
        (set! (~ M row-orig col-orig) idx-x)))))
