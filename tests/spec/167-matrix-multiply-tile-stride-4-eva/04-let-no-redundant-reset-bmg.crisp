;; Endeavor 167 — the macro must NOT emit a second reset on the :let path.
;;
;; 03 proves the reset HAPPENS.  This proves it happens exactly ONCE.
;;
;; Measured 2026-09-17: a register tile bound inside tile-stride already emits its zero
;; CompositeConstruct + store in the grid-x body, before the K loop.  If %mmts-lower also
;; emitted its BUG 036 fill-tile for a :let-bound tile, every converted benchmark would
;; carry a redundant full-tile zero-write on the hot path -- correct, invisible to
;; MMA_CORRECT, and pure cost.  Metal cannot catch it, so this is an IR assertion.
;;
;; THE ASSERTION LIVES IN THE UNIT TEST, not here.  A spec validator on this path is handed
;; the emitted MODULE PATH, and with --ir-target=spv that is a BINARY .spv -- the LLVM IR the
;; claim is about is never written to disk.  The unit test compiles this same kernel in
;; process and counts the zero-init in the IR string directly.  This spec's job is to keep
;; the kernel compiling; see matrix-multiply-tile-stride-4-eva.unit.lisp for the count.
;;
;; SKIP-DEFAULT-PASS
;; COMPILE-WITH[--hardware-profile=bmg --ir-target=spv]: PASS

(def-hardware-profile bmg :simd-width 16 :mma-shapes ((8 16 8)))

(def-type a-mat (matrix float :address-space :global :align :compact :contiguous-term :row-major))
(def-type b-mat (matrix float :address-space :global :align :compact :contiguous-term :row-major))
(def-type c-mat (matrix float :address-space :global :align :compact :contiguous-term :row-major))

(def-kernel let_single_reset (A B &out C)
  (declare #'(a-mat b-mat &out c-mat)
           (global-size :set-to 16)
           (local-size  :set-to 16))
  (let ((K (inner-dimension A B)))
    (matrix-multiply-tile-stride C C-tile K 8 (grid-y grid-x grid-k)
      :let ((A-tile (make-scratch-matrix float (8 8)))
            (B-tile (make-scratch-matrix float (8 16)))
            (C-tile (make-register-tile float (8 16) 0.0)))
      :body
      (load-tile A A-tile (grid-y grid-k))
      (load-tile B B-tile (grid-k grid-x))
      (sync-workgroup)
      (mma-accumulate-via-tile (8 16 8) C-tile A-tile B-tile)
      (sync-workgroup)
      :epilogue
      (store-tile C-tile C (grid-y grid-x)))))
