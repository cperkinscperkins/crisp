;; Endeavor 167 — the RESET spec: a :let register accumulator across TWO output tiles.
;;
;; 135/11 is the BUG 036 regression for a C-tile bound in the ENCLOSING let, where the
;; accumulator is initialised once per WORKGROUP (the zero store lands in the kernel's
;; entry block) and the macro must therefore emit a fill-tile per output tile.
;;
;; This spec is the same kernel with the tile moved into :let, and it asserts the OPPOSITE
;; lowering.  Measured on 2026-09-17 by compiling both shapes and reading the IR: a
;; register tile bound inside tile-stride has its zero CompositeConstruct + store emitted
;; in dt_body134 -- the grid-x body, after %grid-x is stored and before the K loop's
;; br %dt_check145.  That is once per OUTPUT TILE, in exactly the slot %mmts-lower puts
;; its fill-tile in.  So on the :let path the binding IS the reset and the macro must NOT
;; emit a second one.
;;
;; C is 8x32 against an 8x16 tile, so the stride body runs twice and a missing-or-doubled
;; reset is visible: without any reset the second tile reads C[0][16]=60 against a
;; reference of 30; there is no arrangement where an EXTRA fill is wrong, so what this
;; catches on metal is the missing case, and the redundancy is caught by 04.
;;
;; COMPILE-WITH[--hardware-profile=bmg --ir-target=spv]: PASS
;; SKIP-DEFAULT-PASS
;; COMPILE-WITH[--hardware-profile=bmg --ir-target=spv --differentiate]: PASS
;;
;; MMA-DIMS: 8 32 16
;; HOIST-HARDWARE-PROFILE: bmg
;; TEST-HOIST[L0]: validate-l0-mma-run
;; HOIST-EXPECT: MMA_CORRECT

(def-hardware-profile bmg :simd-width 16 :mma-shapes ((8 16 8)))

(def-type a-mat (matrix float :address-space :global :align :compact :contiguous-term :row-major))
(def-type b-mat (matrix float :address-space :global :align :compact :contiguous-term :row-major))
(def-type c-mat (matrix float :address-space :global :align :compact :contiguous-term :row-major))

(def-kernel let_multi_tile (A B &out C)
  (declare #'(a-mat b-mat &out c-mat)
           (global-size :set-to 16)
           (local-size  :set-to 16))
  (let ((K (inner-dimension A B)))
    (matrix-multiply-tile-stride C C-tile K 8 (grid-y grid-x grid-k)
      :let ((A-tile (make-scratch-matrix float (8 8)))
            (B-tile (make-scratch-matrix float (8 16)))
            (C-tile (make-register-tile float (8 16) 0.0)))
      :body
      (load-tile A A-tile (grid-y grid-k))
      (load-tile B B-tile (grid-k grid-x))
      (sync-workgroup)
      (mma-accumulate-via-tile (8 16 8) C-tile A-tile B-tile)
      (sync-workgroup)
      :epilogue
      (store-tile C-tile C (grid-y grid-x)))))
