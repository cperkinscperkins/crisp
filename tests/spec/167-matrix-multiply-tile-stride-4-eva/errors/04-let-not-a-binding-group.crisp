;; Endeavor 167 — negative: :let takes ONE binding group, not a form sequence.
;;
;; :let is the one section that does not hold statements, and the asymmetry is easy to trip
;; over: the other three take an implicit progn, so writing forms after :let reads natural
;; and is meaningless.  Lowered blindly it would produce (let (FORM) ...) and fail somewhere
;; well downstream, naming a binding the user never wrote.
;;
;; CHECK-FAIL: ":let"

(def-type mat-t (matrix float :address-space :global :align :compact :contiguous-term :row-major))

(def-kernel let_not_a_group (A B &out C)
  (declare #'(mat-t mat-t &out mat-t)
           (global-size :set-to 1)
           (local-size  :set-to 1))
  (let ((C-tile (make-scratch-matrix float (4 4)))
        (K      (inner-dimension A B)))
    (matrix-multiply-tile-stride C C-tile K 4 (grid-y grid-x grid-k)
      :let (fill-tile C-tile 0.0)                ; <-- a form, not a binding group
      :body
      (set! (~ C-tile 0 0) (+ (~ C-tile 0 0) 1.0))
      :epilogue
      (store-tile C-tile C (grid-y grid-x)))))
