;; Endeavor 167 — :prologue runs once per output tile, BEFORE the K loop.
;;
;; This is the shape that drove the whole endeavour.  Of the 84 single-K-loop matmul
;; benchmarks, 18 do per-tile setup before the reduction -- prefetch warm-up, ring
;; pre-seeding -- and had no way to say so, because the macro owned the K loop and offered
;; nothing before it.  Their only escape was to hand-write the macro's own expansion, which
;; is why 84 of them carry an inert :epilogue keyword inside a plain tile-stride today.
;;
;; The prefetch here is a warm-up for K-step 0, issued once per tile.  Correctness does not
;; depend on it (a prefetch is a hint), so what this spec asserts is that the form is
;; ACCEPTED in that position, lands before the loop, and the kernel still computes the right
;; answer -- i.e. the prologue did not accidentally end up inside the reduction.
;;
;; COMPILE-WITH[--hardware-profile=bmg --ir-target=spv]: PASS
;; SKIP-DEFAULT-PASS
;;
;; MMA-DIMS: 8 16 16
;; HOIST-HARDWARE-PROFILE: bmg
;; TEST-HOIST[L0]: validate-l0-mma-run
;; HOIST-EXPECT: MMA_CORRECT

(def-hardware-profile bmg :simd-width 16 :mma-shapes ((8 16 8)))

(def-type a-mat (matrix float :address-space :global :align :compact :contiguous-term :row-major))
(def-type b-mat (matrix float :address-space :global :align :compact :contiguous-term :row-major))
(def-type c-mat (matrix float :address-space :global :align :compact :contiguous-term :row-major))

(def-kernel prologue_warm_up (A B &out C)
  (declare #'(a-mat b-mat &out c-mat)
           (global-size :set-to 16)
           (local-size  :set-to 16))
  (let ((K (inner-dimension A B)))
    (matrix-multiply-tile-stride C C-tile K 8 (grid-y grid-x grid-k)
      :let ((A-tile (make-scratch-matrix float (8 8)))
            (B-tile (make-scratch-matrix float (8 16)))
            (C-tile (make-register-tile float (8 16) 0.0)))
      :prologue
      (prefetch-tile A (grid-y 0) :size (8 8))
      (prefetch-tile B (0 grid-x) :size (8 16))
      :body
      (load-tile A A-tile (grid-y grid-k))
      (load-tile B B-tile (grid-k grid-x))
      (sync-workgroup)
      (mma-accumulate-via-tile (8 16 8) C-tile A-tile B-tile)
      (sync-workgroup)
      :epilogue
      (store-tile C-tile C (grid-y grid-x)))))
