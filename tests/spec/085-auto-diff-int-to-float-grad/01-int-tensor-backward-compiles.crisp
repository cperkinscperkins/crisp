;; TEST-EXPECT: PASS
;; A kernel operating on integer tensors can be differentiated.
;; The backward kernel compiles successfully; A_GRAD and C_GRAD are float-typed.
;; The backward body is a no-op (zero gradient — correct for integer arithmetic).

(def-type in-vec  (vector int :address-space :global  :align :compact))
(def-type out-vec (vector int :address-space :global :align :compact))

(def-kernel int_copy (A &out C)
  (declare #'(in-vec &out out-vec))
  (set! (~ C 0) (~ A 0)))
