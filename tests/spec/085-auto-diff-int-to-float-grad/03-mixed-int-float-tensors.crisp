;; TEST-EXPECT: PASS
;; A kernel with both float and integer tensor inputs.
;; The float tensor (weights) participates in the backward walk normally.
;; The integer tensor (indices) gets a float-typed _GRAD output but contributes
;; zero gradient — it plays no role in the backward walk.

(def-type idx-vec    (vector int   :address-space :global  :align :compact))
(def-type float-vec  (vector float :address-space :global :align :compact))

(def-kernel scale_add (indices weights &out out)
  (declare #'(idx-vec float-vec &out float-vec))
  (set! (~ out 0) (~ weights 0)))
