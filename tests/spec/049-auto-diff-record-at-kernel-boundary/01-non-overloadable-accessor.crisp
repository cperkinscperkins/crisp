;; TEST-WITH[--ir-target=llvmir --differentiate] : validate-rec-kb-non-overloadable
;; VERIFY-AUTODIFF: vp.x=3.0 vp.y=4.0 atol=1e-3 expect.vp.x=4.0 expect.vp.y=3.0
;;
;; C = vp.x * vp.y  =>  df/dvp.x = vp.y = 4.0,  df/dvp.y = vp.x = 3.0
;; Uses raw accessor (~x~) which is always system-generated.

(def-record v-point (x float) (y float))


(def-type out-c (cell float :address-space :global))

(def-kernel non_overloadable_accessor_k (vp &out c)
    (declare #'(v-point &out out-c))
    (set! (~ c) (* (~x~ vp) (~y~ vp))))