;; SKIP-WITH[--differentiate] : "TODO: differentiate sub-functions, or decide to only support flat kernels, in which case error."


;; should this just be an error? Or disabled until we can differentiate sub-functions?
;; skip for now, I guess

(def-record v-point (x float) (y float))

(def-type out-c (cell float :address-space :global))

(def-function x~ (vp)
  (declare #'(v-point => float))
  (- 0f (~x~ vp)))

;; x~ overloaded, y~ not.

(def-kernel record_on_boundary_k (vp &out c)
    (declare #'(v-point &out out-c))
    (set! (~ c) (* (x~ vp) (y~ vp))))