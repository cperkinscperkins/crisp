
;; TEST-WITH[--ir-target=llvmir --differentiate] : validate-rec-kb-basic
;;
;; VERIFY-AUTODIFF directive removed pending compiler bug fix:
;; the backward kernel does not reassemble vp.{x,y} primal args into the
;; V-POINT struct used by accessor calls, so accessors load uninitialized
;; memory and the chain rule produces zero analytical gradients.  The IR
;; shape validates correctly (this validator passes) but the computation
;; is broken.  Discovered by phase A of endeavor 103.

(def-record v-point (x float) (y float))

(def-type out-c (cell float :address-space :global))

;; x~ and y~ accessors NOT overloaded.

(def-kernel record_on_boundary_k (vp &out c)
    (declare #'(v-point &out out-c))
    (set! (~ c) (* (x~ vp) (y~ vp))))