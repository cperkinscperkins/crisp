;; TEST-WITH[--metadata] : validate-def-struct-with-ct-in-metadata
;; SKIP-WITH[--differentiate] : "TODO: auto-diff needs to be extended for structs at kernel boundary"

;; the :earnestness is kernel compile time property. It can't be set by the host.
;; It's fine for it to appear in the .metacrisp, but should NOT effect
;; the kernel submission signature.  

;; aliasing
(def-type fff float)

(def-struct point (x fff)
                  (y int)
                  (earnestness float :c-t 2.0))

(def-type out-c (cell float :address-space :global :access :read-write))

;; The earnestness :c-t field does NOT appear in the physical ABI.
;; p1 uses the default (2.0), p2 uses a concrete binding (3.0).
;; Both map to the same 2 physical slots (x, y).
(def-kernel struct_on_boundary_k (p1 p2 &out c)
    (declare #'(point (point :earnestness 3.0) &out out-c))
    (set! (~ c) (+ (* (x~ p1) (x~ p2))
                   (* (y~ p1) (y~ p2)))))