;; TEST-WITH[--metadata] : validate-def-struct-with-ct-in-metadata

;; VERIFY-AUTODIFF directive omitted pending broader IGC SROA workaround.
;;
;; The backward kernel here has 7 chain-rule intermediate adj allocas
;; (anf-t-1_adj .. anf-t-7_adj) on top of the four per-struct-field leaf adjs
;; (p1_x/y_adj, p2_x/y_adj).  Crisp's IGC SROA-aliasing workaround currently
;; marks only the leaf-adj reads at the shadow-struct write as `load volatile`,
;; which is enough for 056/01 (3 chain-rule intermediates) but not for this
;; test: the intermediates still alias under IGC SROA, breaking the chain
;; rule before it reaches the leaves.  Symptom: p1.x analytical reads back as
;; 1.0 (= seed_grad) instead of 5.0, and p2's grad cell is garbage.
;;
;; The same Crisp IR compiles correctly via NVPTX (verified by translating
;; the .ll with `llc -mtriple=nvptx64-...`).  See
;; put_temp_files_here/igc-bug-report/ for the minimal reproducer.
;; Re-tag when IGC ships the fix.

;; the :earnestness is kernel compile time property. It can't be set by the host.
;; It's fine for it to appear in the .metacrisp, but should NOT effect
;; the kernel submission signature.  

;; aliasing
(def-type fff float)

(def-struct point (x fff)
                  (y int)
                  (earnestness float :c-t 2.0))

(def-type out-c (cell float :address-space :global))

;; The earnestness :c-t field does NOT appear in the physical ABI.
;; p1 uses the default (2.0), p2 uses a concrete binding (3.0).
;; Both map to the same 2 physical slots (x, y).
(def-kernel struct_on_boundary_k (p1 p2 &out c)
    (declare #'(point (point :earnestness 3.0) &out out-c))
    (set! (~ c) (+ (* (x~ p1) (x~ p2))
                   (* (y~ p1) (y~ p2)))))