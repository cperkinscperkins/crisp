;; TEST-WITH[--metadata] : validate-nested-struct-in-metadata
;; SKIP-WITH[--differentiate] : "nested structs: shadow-struct AD needs recursive per-field-of-nested-shadow adj tracking. Records work via SROA recursion (048/04) but structs don't SROA, so this needs separate recursive shadow handling."

;; rect is on the kernel boundary.
;; by virtue of that, point will also appear in the metadata.

(def-struct point (x int) (y int))

(def-struct rect (top-left point) (bottom-right point))

(def-type out-c (cell int :address-space :global))

(def-kernel rect_on_boundary_k (r &out c)
    (declare #'(rect &out out-c))
    (set! (~ c) (* (x~ (top-left~ r))
                   (y~ (bottom-right~ r)))))