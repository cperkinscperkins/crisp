;; TEST-HOIST[L0] : validate-l0-host-run
;; HOIST-EXPECT: BUFFER c: 7

;; the :earnestness is kernel compile time property. It can't be set by the host.
;; It's fine for it to appear in the .metacrisp, but should NOT effect
;; the kernel submission signature.  

;; aliasing
(def-type fff float)

(def-struct point (x fff) 
                    (y int)
                    (earnestness float :c-t 2.0f))

(def-type out-c (cell float :address-space :global))

(def-kernel struct_with_ct_on_boundary_k (p1 p2 &out c)
    (declare #'(point (point :earnestness 3.0) &out out-c))
    (let ((c-factor (* (earnestness~ p1) (earnestness~ p2))))
      (set! (~ c) (+ c-factor (* (x~ p1) (x~ p2))))))