;; CHECK-FAIL: "message"

(def-struct point (x float) (y float))

(def-function modify-point (p)
    (declare #'(point => nil))
    (set! (x~ p) 12.0)) 

(def-function modify-arg (p)
    (declare #'(point => nil))
    (modify-point p))

(def-kernel direct_struct_immutable (p)
    (declare (type p point))
    (let ((q (make-point :x 11.0 :y 13.0)))
        (modify-arg q)   ;; perfectly fine
        (modify-arg p))) ;; immutable. 