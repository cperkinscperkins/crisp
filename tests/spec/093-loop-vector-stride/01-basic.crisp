;; TEST-EXPECT: PASS
;; TEST-WITH[--ir-target=spv]
;; SKIP-WITH[--differentiate]: "integer-only kernel, no differentiable params"
;; Basic loop-vector-stride: copy every element of A into B.
;; Validates that the macro expands correctly and generates valid IR.

(def-type vec-t (vector int :address-space :global :align :compact))

(def-kernel vec_copy (A &out B)
  (declare #'(vec-t &out vec-t => nil) forward-only)
  (loop-vector-stride A (i)
    (set! (~ B i) (~ A i))))
