;; TEST-EXPECT: PASS
;; HOIST-HARDWARE-PROFILE: bmg
;; TEST-HOIST[L0]: validate-l0-host-run
;; TEST-HOIST[CUDA]: validate-cuda-host-run
;; HOIST-EXPECT: BUFFER x: 17 7 37 27
;; HOIST-EXPECT: BUFFER y: 27 37 7 17
;; HOIST-EXPECT: BUFFER its: 4 4 4 4
;;
;; Endeavour 212 ON-METAL: a vote's result is the same in every lane of the warp, so it is INFERRED
;; warp-uniform (endeavour 194's third level) -- no to-warp-uniform needed.  Here that decides three
;; things a per-lane value would make illegal:
;;   * x: a branch on (warp-any? ..) holds a shuffle                     -> 173/02's fingerprint 17 7 37 27
;;   * y: a branch on a ballot MASK holds a shuffle (xor 2)              -> 27 37 7 17
;;   * its: a loop holding a shuffle exits early on (warp-all? ..)     -> leaves at i = 3: 4 iterations
;; Without the inference each condition is :unknown and each shuffle is refused ("warp collective").

(def-type u-vec (vector ulong :address-space :global :align :compact))

(def-kernel vote_uniform (&out x y its)
  (declare #'(&out u-vec u-vec u-vec => nil)
           (global-size :set-to 32)
           (local-size  :set-to 32))
  (let ((lid  (get-local-id 0))
        (lane (to-ulong (warp-lane)))
        (hit  (warp-any? (= lane 3ul)))
        (bits (warp-ballot (< lane 2ul)))
        (n    0ul)
        (r    0ul)
        (q    0ul))
    (when hit
      (set! r (shuffle-xor (+ (* lane 10ul) 7ul) 1ul)))
    (when (= bits 3u)
      (set! q (shuffle-xor (+ (* lane 10ul) 7ul) 2ul)))
    (dotimes (i 8ul)
      (let ((s (shuffle-xor (+ lane i) 1ul)))
        (set! n (+ n (- (+ s 1ul) s))))
      (when (warp-all? (>= i 3ul))
        (return-from-loop)))
    (when (< lid 4ul)
      (set! (~ x lid) r)
      (set! (~ y lid) q))
    (when (= (* (/ lid 8ul) 8ul) lid)
      (set! (~ its (/ lid 8ul)) n))))
