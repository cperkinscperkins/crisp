;; TEST-EXPECT: PASS
;; TEST-HOIST[L0]: validate-l0-host-run
;; HOIST-EXPECT: BUFFER q: 2 4 -2 -4
;; HOIST-EXPECT: BUFFER r: 1 -1 -1 1
;;
;; Endeavour 185 P0 -- (round a b) TIES round half to EVEN (IEEE 754), chapter 32/06:
;;   (round 5 2)  =  2.5 ->  2, r  1
;;   (round 7 2)  =  3.5 ->  4, r -1
;;   (round -5 2) = -2.5 -> -2, r -1
;;   (round -7 2) = -3.5 -> -4, r  1
;; Operands are built on the run-time 0 from (get-workgroup-id 0) so nothing constant-folds.

(def-type i-vec (vector int :address-space :global :align :compact))

(def-kernel int_div_round_ties (&out q r)
  (declare #'(&out i-vec i-vec => nil)
           (global-size :set-to 1))
  (let ((z (to-int (get-workgroup-id 0))))
    (let ((q0 r0 (round (+ z 5)  (+ z 2)))) (set! (~ q 0) q0) (set! (~ r 0) r0))
    (let ((q1 r1 (round (+ z 7)  (+ z 2)))) (set! (~ q 1) q1) (set! (~ r 1) r1))
    (let ((q2 r2 (round (+ z -5) (+ z 2)))) (set! (~ q 2) q2) (set! (~ r 2) r2))
    (let ((q3 r3 (round (+ z -7) (+ z 2)))) (set! (~ q 3) q3) (set! (~ r 3) r3))))
