;; TEST-EXPECT: PASS
;; TEST-HOIST[L0]: validate-l0-host-run
;; HOIST-EXPECT: BUFFER th: 0.462117 -0.462117 0 1
;; HOIST-EXPECT: BUFFER e: 0.5205 -0.5205 0 1
;; HOIST-EXPECT: BUFFER p: 8 0.5 1 1024
;;
;; Endeavour 185 P3 -- tanh, erf, exp2 (decision D5).  On SPIR-V: OpenCL tanh / erf, llvm.exp2.
;;   th: tanh 0.5 -0.5 0 10 -> 0.462117 -0.462117 0 1   (printed to 6 significant digits)
;;   e:  erf  0.5 -0.5 0 4  -> 0.5205 -0.5205 0 1        (erf 0.5 = 0.52049988)
;;   p: exp2 3 = 8   exp2 -1 = 0.5   exp2 0 = 1   exp2 10 = 1024
;; The PTX path (libdevice __nv_tanhf / __nv_erff / __nv_exp2f) needs a CUDA host to verify.

(def-type f-vec (vector float :address-space :global :align :compact))

(def-kernel tanh_erf_exp2 (&out th e p)
  (declare #'(&out f-vec f-vec f-vec => nil)
           (global-size :set-to 1))
  (let ((z (to-float (get-workgroup-id 0))))
    (set! (~ th 0) (tanh (+ z 0.5)))
    (set! (~ th 1) (tanh (+ z -0.5)))
    (set! (~ th 2) (tanh (+ z 0.0)))
    (set! (~ th 3) (tanh (+ z 10.0)))
    (set! (~ e 0) (erf (+ z 0.5)))
    (set! (~ e 1) (erf (+ z -0.5)))
    (set! (~ e 2) (erf (+ z 0.0)))
    (set! (~ e 3) (erf (+ z 4.0)))
    (set! (~ p 0) (exp2 (+ z 3.0)))
    (set! (~ p 1) (exp2 (+ z -1.0)))
    (set! (~ p 2) (exp2 (+ z 0.0)))
    (set! (~ p 3) (exp2 (+ z 10.0)))))
