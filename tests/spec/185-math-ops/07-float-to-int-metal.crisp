;; TEST-EXPECT: PASS
;; TEST-HOIST[L0]: validate-l0-host-run
;; HOIST-EXPECT: BUFFER c1: 2 -3 3 -2
;; HOIST-EXPECT: BUFFER c2: 2 4 -2 -2
;;
;; Endeavour 185 P0 -- ONE-argument floor / ceil / round / truncate are float -> int conversions
;; (decision D2); they are told apart from integer division by arity.
;;   c1: (floor 2.5) 2   (floor -2.5) -3   (ceil 2.1) 3    (ceil -2.5) -2
;;   c2: (round 2.5) 2   (round 3.5)  4    (round -2.5) -2 (truncate -2.7) -2
;; round is half-to-even.  Operands are built on the run-time 0 from (get-workgroup-id 0).

(def-type i-vec (vector int :address-space :global :align :compact))

(def-kernel float_to_int (&out c1 c2)
  (declare #'(&out i-vec i-vec => nil)
           (global-size :set-to 1))
  (let ((z (to-float (get-workgroup-id 0))))
    (set! (~ c1 0) (floor (+ z 2.5)))
    (set! (~ c1 1) (floor (+ z -2.5)))
    (set! (~ c1 2) (ceil (+ z 2.1)))
    (set! (~ c1 3) (ceil (+ z -2.5)))
    (set! (~ c2 0) (round (+ z 2.5)))
    (set! (~ c2 1) (round (+ z 3.5)))
    (set! (~ c2 2) (round (+ z -2.5)))
    (set! (~ c2 3) (truncate (+ z -2.7)))))
