;; VERIFY-AUTODIFF: input=4.0 atol=1e-3 expect.input=-0.0625
;;
;; Endeavour 185 P1 -- autodiff of rsqrt: d/dx x^-1/2 = -0.5 x^-3/2 = -0.0625 at x = 4.

(def-type cell-float (cell float :address-space :global))

(def-kernel rsqrt_diff_k (input &out out)
  (declare #'(cell-float &out cell-float))
  (let ((x (~ input)))
    (set! (~ out) (rsqrt x))))
