;; TEST-HOIST[L0] : validate-l0-host-run
;; HOIST-EXPECT: BUFFER c: 3
;; SKIP-WITH[--differentiate] : "hoist has no support for differentiate pass (yet)"

;; def-record with an (array int 4) member, at kernel boundary.
;; The array field is SROA'd to 4 individual i32 scalar parameters — valid OpenCL/SPIR-V.
;; Host initializes counts[i]=i (iota); kernel computes counts[0]+counts[3] = 0+3 = 3.

(def-record data-rec (counts (array int 4)))

(def-type out-c (cell int :address-space :global :access :read-write))

(def-kernel record_arr_hoist_k (r &out c)
    (declare forward-only #'(data-rec &out out-c))
    (set! (~ c) (+ (~ (counts~ r) 0) (~ (counts~ r) 3))))
