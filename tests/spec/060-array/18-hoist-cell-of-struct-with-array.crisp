;; TEST-HOIST[L0] : validate-l0-compile-only
;; SKIP-WITH[--differentiate] : "hoist has no support for differentiate pass (yet)"

;; Cell wrapping a def-struct that has an (array int 4) member.
;; Kernel writes 42 to values[2] via: (set! (~ (values~ (~ c)) 2) 42).
;; Exercises %struct-emit-fields with array-typed fields through the cell pathway.
;;
;; NOTE: validate-l0-compile-only due to two compounding issues:
;;
;; (1) IGC bug (Crisp bug 028): IGC silently miscompiles functions returning array types
;;     (TypeArray in SPIR-V). The accessor values__data_block returns [4 x i32]; all
;;     elements read back as 0. Same root cause as test 15.
;;
;; (2) Compiler bug: (set! (~ (values~ (~ c)) 2) 42) stores to a local alloca, not back
;;     to the global USM pointer. The write never reaches GPU memory.
;;     Root: the cell-of-struct dereference loads the struct by-value; element write goes
;;     to the local copy. A fix requires store-back via the original pointer.
;;
;; The generated C++ host code is correct.
;; See plan/bugs.md #028 (IGC) and #029 (cell array write-back).

(def-struct data-block (values (array int 4)))

(def-type dat-c (cell data-block :address-space :global))

(def-kernel cell_struct_arr_hoist_k (c)
    (declare forward-only #'(dat-c))
    (set! (~ (values~ (~ c)) 2) 42))
