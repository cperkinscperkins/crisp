;; TEST-HOIST[L0] : validate-l0-host-run
;; HOIST-EXPECT: BUFFER c: 0 0 42 0
;; SKIP-WITH[--differentiate] : "hoist has no support for differentiate pass (yet)"

;; Cell wrapping a def-struct that has an (array int 4) member.
;; Host allocates sizeof(data-block) bytes, array initialized iota-style (values[i]=i).
;; Kernel writes 42 to values[2] via: (set! (~ (values~ (~ c)) 2) 42).
;; Hoist operator<< for data-block prints all 4 array elements: 0 1 42 3.
;; Exercises %struct-emit-fields with array-typed fields through the cell pathway.

(def-struct data-block (values (array int 4)))

(def-type dat-c (cell data-block :address-space :global :access :read-write))

(def-kernel cell_struct_arr_hoist_k (c)
    (declare forward-only #'(dat-c))
    (set! (~ (values~ (~ c)) 2) 42))
