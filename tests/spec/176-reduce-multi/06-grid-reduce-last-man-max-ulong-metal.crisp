;; TEST-EXPECT: PASS
;; TEST-HOIST[L0]: validate-l0-host-run
;; HOIST-HARDWARE-PROFILE: bmg
;; HOIST-EXPECT: BUFFER out: 255
;;
;; ENDEAVOUR 176 Phase 1 -- grid-reduce! with an EXPLICIT :strategy :last-man-standing, a non-+
;; operator, and a non-float type.  TDD.
;;
;; #'max over the ulong global linear ids 0..255 is 255.  The identity 0ul is visibly ulong, so the
;; implicit scratch (local sweep vector and global partials) is ulong too.  Last-man WRITES the result
;; rather than accumulating, so the cell's pre-fill does not matter.

(def-type out-c (cell ulong :address-space :global))

(def-kernel grid_reduce_last_man_max (&out out)
  (declare #'(&out out-c => nil)
           (global-size :set-to 256)
           (local-size  :set-to 64))
  (let ((m (get-global-linear-id)))
    (grid-reduce! #'max m 0ul out :strategy :last-man-standing)))
