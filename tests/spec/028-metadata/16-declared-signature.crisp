;; TEST-WITH[--metadata :validator crisp.compiler::validate-16-declared-signature]

#|
Now we add the declared signature as well.

(:kernels 
    ("complex_signature_kernel" 
      :source "path/to/some.crisp"
      (:output-targets nil)
        (:physical-signature 

        ;; "v"
        ;; simple scalar
        (0 float)

        ;; "c"
        ;; cell
        ;; container
        (1 ulong) ;; byte-size
        (2 voidp) ;; data pointer
        ;; offset
        (3 ulong)

        ;; "d"
        ;; cell
        ;; container
        (4 ulong) ;; byte-size
        (5 voidp) ;; data pointer
        ;; offset
        (6 ulong))
        
    (:declared-signature 
        ;; simple scalar
        (v :type float 
            :range (0 0))
        ;; cell
        (in :type (cell float ) 
            :address-space :global 
 
            :range (1 3))
        ;; cell
        (out :type (cell float ) 
            :address-space :global 
 
            :range (4 6)))))

|#

(def-kernel complex_signature_kernel (v c &out d)
    (declare (type c d (cell float :address-space :global))
             (type v float))
  (let ((f (~ c)))
    (set! (~ d) (+ f v))))