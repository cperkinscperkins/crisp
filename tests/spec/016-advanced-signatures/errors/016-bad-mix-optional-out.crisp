;; CHECK-FAIL: "&out cannot appear after &optional."

;; &out should come before  &optional 
;; it is an error to appear reversed

(def-function optional-then-out (a &optional b c &out res )
    (declare #'(int &optional int int &out (cell int)  => nil))
    (let ((sum a))
        (when (is-set? b)
            (set! sum (+ sum b))
            (when+ (is-set? c)
                (set! sum (* sum c))))
        (set! (~ res) sum)))

(def-kernel exorcise_o_a (a r b)
    (declare #'(int (cell int :global :write-only) int => nil))
    (out-and-optional a b r))

    