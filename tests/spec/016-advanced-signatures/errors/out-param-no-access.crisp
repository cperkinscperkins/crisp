
;; CHECK-FAIL: "Illegal access: Cannot read from Output Parameter 'OUT-C'. Output parameters are write-only"

;; the compile time contract — we don't allow reading of &out params.

(def-function no-tocar (&out out-c)
    (declare #'(&out (cell int :global) => nil))
    (let ((initial (~ out-c)))    ;; <-- read access s.b. a compile time error.
        (set! (~ out-c) (+ initial 1))))

;; Note: once we add support for inc!/dec! and friends, be sure to add more tests for those.