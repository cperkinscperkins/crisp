
;; &out must come before &key
;; it is an error if that order is reversed
#|
(def-function key-then-out (a &key d e &out res )
    (declare #'(int &key :d int :e int &out (cell int)  => nil))
    (let ((sum a))
        (when (is-set? d)
            (set! sum (+ sum d)))
        (when+ (is-set? e)
            (set! sum (* sum e)))
        (set! (~ res) sum)))

(def-kernel expertise-o-k (a r e)
    (declare #'(int &out (cell int :global :write-only)  int => nil))
    (out-and-key a :e e r ))

    |#