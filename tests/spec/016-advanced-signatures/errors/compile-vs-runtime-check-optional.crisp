
;; CHECK-FAIL: "IF+ condition failed to evaluate at compile time"

;; this should fail because when+ demands a compile-time known value.
(def-function add-some-runtime (a &optional b c)
    (declare #'(int &optional int int => int))
    (let ((sum a))
        (when+ (and (is-set? b) (> b 0))
            (set! sum (+ sum b))
            (when+ (and (is-set? c) (> c 10)) 
              (set! sum (+ sum c))))
        sum))