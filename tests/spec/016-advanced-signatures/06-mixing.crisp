
;; Like in Common Lisp, &optional comes before &key 
(def-function option-and-keys (a &optional b c &key d e )
    (declare #'(int &optional int int &key :d int :e int => int)) ;; <-- whooo
    (let ((sum a))
    ;; this pattern seems like a good defmacro opportunity.
        (when (is-set? b)
            (set! sum (+ sum b))
            (when+ (is-set? c)
                (set! sum (+ sum c))))
        (when (is-set? d)
            (set! sum (+ sum d)))
        (when (is-set? e)
            (set! sum (+ sum e)))
        sum))

;; kernels will NOT support optional or key (but WILL support &out)
;; ATM def-kernel implementation is minimal, so these rules may or may not be enforced yet
;; this is not yet the time for that.
(def-kernel exercise-o-k (a b d)
    (declare #'(int int int => nil))
    (option-and-keys a b :d d))  ;; return value ignored.


;; &out comes before either &optional or &key
(def-function out-and-optional (a &out res &optional b c)
    (declare #'(int &out (cell int) &optional int int => nil))
    (let ((sum a))
        (when (is-set? b)
            (set! sum (+ sum b))
            (when+ (is-set? c)
                (set! sum (* sum c))))
        (set! (~ res) sum)))

;; kernels also require COMPLETE storage handle types.
;; But, again, out implemention at this time is minimal, and this is likely not enforced (yet),
;; and doing so would be premature at this time.
(def-kernel exorcise-o-a (a r b)
    (declare #'(int (cell int :global :write-only) int => nil))
    (out-and-optional a r b))


(def-function out-and-key (a &out res &key d e)
    (declare #'(int &out (cell int) &key :d int :e int => nil))
    (let ((sum a))
        (when (is-set? d)
            (set! sum (+ sum d)))
        (when+ (is-set? e)
            (set! sum (* sum e)))
        (set! (~ res) sum)))

(def-kernel expertise-o-k (a r e)
    (declare #'(int (cell int :global :write-only)  int => nil))
    (out-and-key a r :e e))


;; shebang
(def-function shebang (a &out res &optional b c &key d e)
    (declare #'(int &out (cell int) &optional int int &key :d int :e int => nil))
    (let ((sum a))
        (when (is-set? b)
            (set! sum (+ sum b))
            (when (is-set? c)
                (set! sum (+ sum c))))
        (when (is-set? d)
            (set! sum (+ sum d)))
        (when (is-set? e)
            (set! sum (* sum e)))
        (set! (~ res) sum)))

(def-kernel excise (a r b e)
    (declare #'(int (cell int :global :read-write) int int => nil))
    (shebang a r b :e e))

