
;; Like in Common Lisp, &optional comes before &key 
;; and when both are used, every optional argument must be realized.

;; SKIP-WITH[--differentiate]: "kernel has no &out param, not differentiable"

(def-function option-and-keys (a &optional b  &key d e )
    (declare #'(int &optional int  &key :d int :e int => int)) ;; <-- whooo
    (let ((sum a))
    ;; this pattern seems like a good defmacro opportunity.
        (when (is-set? b)
            (set! sum (+ sum b)))
            
        (when (is-set? d)
            (set! sum (+ sum d)))
        (when (is-set? e)
            (set! sum (+ sum e)))
        sum))

;; kernels will NOT support optional or key (but WILL support &out)
;; ATM def-kernel implementation is minimal, so these rules may or may not be enforced yet
;; this is not yet the time for that.
(def-kernel exercise_o_k (a b d)
    (declare #'(int int int => nil))
    (option-and-keys a b :d d)
    (return))  ;; return value has to match for functions.


;; &out comes before either &optional or &key.
;; Note: with the strict storage-handle policy, generic-function templates
;; (those with &optional / &key) don't yet implement implicit-template
;; monomorphization on incomplete cell types — so &out cells must be complete.
(def-function out-and-optional (a &out res &optional b c)
    (declare #'(int &out (cell int :address-space :global) &optional int int => nil))
    (let ((sum a))
        (when (is-set? b)
            (set! sum (+ sum b))
            (when+ (is-set? c)
                (set! sum (* sum c))))
        (set! (~ res) sum)
        (return)))

;; kernels also require COMPLETE storage handle types.
(def-kernel exorcise_o_a (a r b)
    (declare #'(int (cell int :address-space :global) int => nil))
    (out-and-optional a r b)
    (return))


(def-function out-and-key (a &out res &key d e)
    (declare #'(int &out (cell int :address-space :global) &key :d int :e int => nil))
    (let ((sum a))
        (when (is-set? d)
            (set! sum (+ sum d)))
        (when+ (is-set? e)
            (set! sum (* sum e)))
        (set! (~ res) sum)
        (return)))

(def-kernel expertise_o_k (a r e)
    (declare #'(int (cell int :address-space :global)  int => nil))
    (out-and-key a r :e e)
    (return))


;; shebang
(def-function shebang (a &out res &optional b  &key d e)
    (declare #'(int &out (cell int :address-space :global) &optional int &key :d int :e int => nil))
    (let ((sum a))
        (when (is-set? b)
            (set! sum (+ sum b)))

        (when (is-set? d)
            (set! sum (+ sum d)))
        (when (is-set? e)
            (set! sum (* sum e)))
        (set! (~ res) sum)
        (return)))

(def-kernel excise (a r b e)
    (declare #'(int (cell int :address-space :global) int int => nil))
    (shebang a r b :e e)
    (return))

