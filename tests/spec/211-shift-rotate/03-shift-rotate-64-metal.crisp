;; TEST-EXPECT: PASS
;; TEST-HOIST[L0]: validate-l0-host-run
;; HOIST-EXPECT: BUFFER ul: 1099511627776 1 15 9223372036854775808
;; HOIST-EXPECT: BUFFER rl: 3 9223372036854775808 4294967296 1
;; HOIST-EXPECT: BUFFER sl: -16 -1 -1 4
;;
;; Endeavour 211 -- the four forms on 64-bit operands: the count is taken modulo 64.  The count's own
;; type is free (here an int); it is converted to the operand's type first, which cannot change the
;; low six bits, so "mod 64" holds for a negative int count too.
;;   ul: (shift-left 1ul 40) 1099511627776   (shift-left 1ul 64) 1
;;       (shift-right 18446744073709551615ul 60) 15   (shift-left 1ul -1) 9223372036854775808
;;   rl: (rotate-left 9223372036854775809ul 1) 3   (rotate-right 1ul 1) 9223372036854775808
;;       (rotate-left 1ul 96) 4294967296 [96 mod 64 = 32]   (rotate-right 2ul -63) 1 [-63 mod 64 = 1]
;;   sl (long): (shift-right -256 4) -16   (shift-right -1 63) -1   (rotate-left -1 17) -1
;;              (shift-left 1 66) 4

(def-type ul-vec (vector ulong :address-space :global :align :compact))
(def-type l-vec  (vector long  :address-space :global :align :compact))

(def-kernel shift_rotate_64 (&out ul rl sl)
  (declare #'(&out ul-vec ul-vec l-vec => nil)
           (global-size :set-to 1))
  (let ((z (to-int (get-workgroup-id 0))))
    (set! (~ ul 0) (shift-left 1ul (+ z 40)))
    (set! (~ ul 1) (shift-left 1ul (+ z 64)))
    (set! (~ ul 2) (shift-right 18446744073709551615ul (+ z 60)))
    (set! (~ ul 3) (shift-left 1ul (+ z -1)))
    (set! (~ rl 0) (rotate-left 9223372036854775809ul (+ z 1)))
    (set! (~ rl 1) (rotate-right 1ul (+ z 1)))
    (set! (~ rl 2) (rotate-left 1ul (+ z 96)))
    (set! (~ rl 3) (rotate-right 2ul (+ z -63)))
    (set! (~ sl 0) (shift-right (to-long -256) (+ z 4)))
    (set! (~ sl 1) (shift-right (to-long -1) (+ z 63)))
    (set! (~ sl 2) (rotate-left (to-long -1) (+ z 17)))
    (set! (~ sl 3) (shift-left (to-long 1) (+ z 66)))))
