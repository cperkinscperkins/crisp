(def-enumeration color :blue :brown :black)


(def-struct shirt
    (size int)
    (fabric-c color :c-t)
    (stitching-c color :c-t))

(def-record pants
    (size int)
    (fabric-c color :c-t)
    (stitching-c color :c-t))

;; each of these five type declarations should compile correctly. 
(def-function five-shirts (complete b c d e)
    (declare (type complete (shirt :fabric-c :blue :stitching-c :black))
             (type b (shirt :fabric-c :brown))
             (type c (shirt :stitching-c :blue))
             (type d (shirt))
             (type e shirt)
             (return-type int))
    ;; we don't have variadic + yet.
    (   (+ (+ (size~ e) (size~ d))
           (+ (size~ c) (size~ b)))
        (size~ complete)))

(def-function five-pants (complete b c d e)
    (declare (type complete (pants :fabric-c :blue :stitching-c :black))
             (type b (pants :fabric-c :brown))
             (type c (pants :stitching-c :blue))
             (type d (pants))
             (type e pants)
             (return-type int))
    ;; we don't have variadic + yet.
    (   (+ (+ (size~ e) (size~ d))
           (+ (size~ c) (size~ b)))
        (size~ complete)))