(def-enumeration color :blue :brown :black)


(def-struct shirt
    (size int)
    (fabric-c color :c-t)
    (stitching-c color :c-t))

(def-record pants
    (size int)
    (fabric-c color :c-t)
    (stitching-c color :c-t))

;; each of these five type declarations should compile correctly. 
(def-function five-shirts (complete b c d e)
    (declare (type (shirt :fabric-c :blue :stitching-c :black) complete)
             (type (shirt :fabric-c :brown) b)
             (type (shirt :stitching-c :blue) c)
             (type (shirt) d)
             (type shirt e)
             (return-type int))
    ;; we don't have variadic + yet.
    (+ (+ (+ (size~ e) (size~ d))
          (+ (size~ c) (size~ b)))
       (size~ complete)))

(def-function five-pants (complete b c d e)
    (declare (type (pants :fabric-c :blue :stitching-c :black) complete)
             (type (pants :fabric-c :brown) b)
             (type (pants :stitching-c :blue) c)
             (type (pants) d)
             (type pants e)
             (return-type int))
    ;; we don't have variadic + yet.
    (+ (+ (+ (size~ e) (size~ d))
          (+ (size~ c) (size~ b)))
       (size~ complete)))