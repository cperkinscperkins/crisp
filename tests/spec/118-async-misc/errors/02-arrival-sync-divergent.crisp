;; TEST-EXPECT: FAIL
;; SKIP-WITH[--differentiate]: "kernel has no &out param, not differentiable"
;; CHECK-FAIL: "SYNC-WORKGROUP cannot appear inside a thread-divergent conditional"
;;
;; Endeavour 183 (BUG 082): the refusal used to come from the mem-fence in sync-wait's spin loop, with
;; a message about an internal sync-workgroup.  Fences now go free; the divergent wait is still refused,
;; by the workgroup barrier its expansion ends in.


(def-kernel test_arrival_sync_divergent ()
  (declare #'( => nil)
           (global-size :set-to 128)
           (local-size  :set-to 64))
  
  (let ((sync (make-arrival-sync 128)))
    (sync-arrive sync)
    (when (> (get-global-id 0) (to-ulong 10))
      (sync-wait sync))))
