;; TEST-EXPECT: PASS
;; TEST-HOIST[L0]: validate-l0-strategy-content
;; STRATEGY-EXPECT[L0]: zeKernelSetGroupSize(kernel, 16, 1, 1)
;; Endeavor 143: this kernel declares :tile-shape (16), so the grid is now the rank-N TILE
;; GRID -- ceil(in_ext0/16) blocks, one per tile -- not an occupancy-sized 1-D grid.  The
;; occupancy preamble is correctly no longer emitted on either backend.
;; STRATEGY-EXPECT[L0]: uint32_t _gx = (uint32_t)(((uint64_t)in_ext0 + 15) / 16);
;; STRATEGY-EXPECT[L0]: ze_group_count_t groupCount = { _gx, 1, 1 };
;; STRATEGY-EXPECT[L0]: zeKernelSetArgumentValue(kernel, 0, 64ULL, nullptr);
;; TEST-HOIST[CUDA]: validate-cuda-strategy-content
;; STRATEGY-EXPECT[CUDA]: unsigned int gridX = (unsigned int)(((unsigned long long)in_ext0 + 15) / 16);

(def-type vec-t (vector float :address-space :global :align :compact))
(def-type tile-t (vector float :address-space :local :align :compact))

(def-kernel async_hoist_demo (IN &out OUT)
    (declare (type IN  vec-t)
             (type OUT vec-t)
             ;; Declare block-size and tile-shape
             (local-size :set-to 16)
             (global-size :derive-from IN
                          :strategy :strided
                          :tile-shape (16)))
  
  (let ((tile (make-scratch-vector float 16)))
    ;; tile-stride iterates over the global grid, pulling 16-element tiles
    (tile-stride IN (16) (grid-x)
      (let ((barrier (make-async-barrier :mode :linear)))
        ;; load-tile uses the implicit grid-x to fetch a tile into local memory
        (load-tile IN tile (grid-x) :barrier barrier)
        (await barrier)
        
        ;; Process locally using workgroup-stride
        (workgroup-stride tile (lx)
          (set! (~ tile lx) (* (~ tile lx) 2.0)))
        
        ;; Ensure all threads are done processing the tile before writing back
        (sync-workgroup)

        ;; store-tile uses the implicit grid-x to write back
        (store-tile tile OUT (grid-x) :barrier barrier)
        (await barrier)))))
