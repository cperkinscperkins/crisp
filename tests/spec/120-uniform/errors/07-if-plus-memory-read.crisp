;; TEST-EXPECT: FAIL
;; CHECK-FAIL: "UNKNOWN"

;; Endeavor 120: a memory read is :unknown (not provably uniform), so if+ must
;; reject it -- and the message must say UNKNOWN (distinct from the DIVERGENT
;; case, which gets no "declare uniform" suggestion).

(def-type vec-t (vector float :address-space :global :align :compact))

(def-kernel if_plus_mem (IN OUT)
  (declare #'(vec-t vec-t => nil))
  (if+ (< (~ IN 0) 5.0)
    (set! (~ OUT (get-global-id 0)) 1.0)
    (set! (~ OUT (get-global-id 0)) 0.0)))
