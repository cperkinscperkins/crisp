;; TEST-EXPECT: FAIL
;; CHECK-FAIL: "if+ requires a provably uniform condition"

(def-type vec-t (vector float :address-space :global :align :compact))

(def-kernel divergent_if_plus (OUT)
  (declare #'(vec-t => nil))
  (if+ (= (get-local-id 0) (to-ulong 0))
    (set! (~ OUT (get-global-id 0)) 1.0)
    (set! (~ OUT (get-global-id 0)) 0.0)))
