;; ASYNC + MMA together — numeric proof of the combination.
;;
;; Spec 15 verified async staging with a SCALAR body; specs 09 and 12 verified the MMA and
;; scalar VJP lowerings with SYNCHRONOUS staging.  This is the one combination none of them
;; covers: async staging feeding a real tensor-core MMA.  It is the pattern of
;; 136/01-async-tiled-matmul-cuda, which is PTX-only and therefore cannot be gradient-checked
;; on this machine — so the combination is pinned here on BMG instead of assumed from the parts.
;;
;; Kt=16 keeps the MMA fast path admissible (Kt % lcm(M_n,N_n) = 16 % 16), so this exercises
;; async + the MMA lowering rather than async + the scalar fallback.
;;
;; THE CHECK is identical to spec 09's (same shapes, same f, same seed), so any divergence is
;; attributable to async staging alone: dA[1,0] = 0.01 * sum_{n=0..15} n = 1.2.
;;
;; COMPILE-WITH[--hardware-profile=bmg --ir-target=spv]: PASS
;; COMPILE-WITH[--hardware-profile=bmg --ir-target=spv --differentiate]: PASS
;; SKIP-DEFAULT-PASS
;; SKIP-WITH[--debug]: "pre-existing --debug c-t-accessor codegen bug (plan/bugs.md #033)"
;; HOIST-HARDWARE-PROFILE: bmg
;; VERIFY-AUTODIFF: A=8x16@0:0.01 B=16x16@0:0.01 at.A=1,0 group=16 h=0.5 atol=2e-2 expect.A=1.2 output-mat=8x16

(def-hardware-profile bmg :simd-width 16 :mma-shapes ((8 16 8)))

(def-type a-mat (matrix float :address-space :global :align :compact :contiguous-term :row-major))
(def-type b-mat (matrix float :address-space :global :align :compact :contiguous-term :row-major))
(def-type c-mat (matrix float :address-space :global :align :compact :contiguous-term :row-major))

(def-kernel async_mma_matmul (A B &out C)
  (declare #'(a-mat b-mat &out c-mat)
           (global-size :set-to 16)
           (local-size  :set-to 16))          ; one Intel SG16 sub-group
  (let ((A-tile (make-scratch-matrix float (8 16)))    ; Mt x Kt
        (B-tile (make-scratch-matrix float (16 16)))   ; Kt x Nt
        (C-tile (make-register-tile float (8 16) 0.0))
        (bar    (make-async-barrier :mode :linear)))
    (load-tile-at A A-tile (0 0) :barrier bar)
    (load-tile-at B B-tile (0 0) :barrier bar)
    (await bar)
    (mma-accumulate-via-tile (8 16 8) C-tile A-tile B-tile)
    (store-tile C-tile C (0 0))))
