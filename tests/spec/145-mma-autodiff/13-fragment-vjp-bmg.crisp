;; FRAGMENT-level VJP — numeric proof.
;;
;; This is the "hello mma" shape: raw fragment forms, no tiles at all.
;;     C-acc  <- make-register-fragment
;;     A-frag <- load-fragment-a A (0 0)
;;     B-frag <- load-fragment-b B (0 0)
;;     store-fragment (mma-accumulate C-acc A-frag B-frag) C (0 0)
;;
;; This document previously asserted that a fragment-level backward was IMPOSSIBLE: dA[m,k] =
;; sum_n dD[m,n]*B[k,n] contracts over n, but a lane holds only part of the accumulator, so the
;; reduction spans lanes and would need warp shuffles.  That argued from ONE realisation
;; (keep everything in registers) to a claim about the mathematics — the same error that
;; produced the "K-tile contract".  Route the adjoints through MEMORY, exactly as the
;; tile-level VJP already routes dC, and the lane problem never arises.
;;
;; The VJP is FUSED rather than compositional, and that is forced by the ANF, not chosen for
;; convenience.  Measured, the walk receives the whole chain as ONE statement —
;;     (STORE-FRAGMENT (MMA-ACCUMULATE C-ACC A-FRAG B-FRAG) C (0 0))
;; because store-fragment is opaque to ANF, so its value argument is never split into its own
;; binding.  There is no intermediate variable on which to hang a fragment-valued adjoint.
;;
;; SCOPE, stated plainly: this covers store-fragment applied DIRECTLY to an mma-accumulate.
;; An accumulator held in registers across a loop and stored later is NOT covered and still
;; reports "no VJP registered".  load-fragment-a/b return :inert only when their fragment feeds
;; such a fused chain, and DECLINE otherwise — so an unsupported shape errors loudly instead of
;; silently yielding a zero gradient, which is the failure mode this endeavor hit three times.
;;
;; THE CHECK.  f(A,B) = sum(A.B) over one 8x16 accumulator block, so dC is all ones and
;; dA[m,k] = sum_n B[k,n].  With B[i][j] = 0.01*(i*16+j), dA[1,0] = 0.01 * sum_{n=0..15} n = 1.2.
;; Scattered with atomic-add!, the same discipline %load-tile-at-bwd uses.
;;
;; COMPILE-WITH[--hardware-profile=bmg --ir-target=spv]: PASS
;; COMPILE-WITH[--hardware-profile=bmg --ir-target=spv --differentiate]: PASS
;; SKIP-DEFAULT-PASS
;; SKIP-WITH[--debug]: "pre-existing --debug c-t-accessor codegen bug (plan/bugs.md #033)"
;; HOIST-HARDWARE-PROFILE: bmg
;; VERIFY-AUTODIFF: A=8x8@0:0.01 B=8x16@0:0.01 at.A=1,0 group=16 h=0.5 atol=2e-2 expect.A=1.2 output-mat=8x16

(def-hardware-profile bmg :simd-width 16 :mma-shapes ((8 16 8)))

(def-type a-mat (matrix float :address-space :global :align :compact :contiguous-term :row-major))
(def-type b-mat (matrix float :address-space :global :align :compact :contiguous-term :row-major))
(def-type c-mat (matrix float :address-space :global :align :compact :contiguous-term :row-major))

(def-kernel frag_mma (A B &out C)
  (declare #'(a-mat b-mat &out c-mat)
           (global-size :set-to 16)
           (local-size  :set-to 16))          ; one Intel SG16 sub-group
  (let ((C-acc  (make-register-fragment 16 8 0.0))
        (A-frag (load-fragment-a A (0 0)))
        (B-frag (load-fragment-b B (0 0))))
    (store-fragment (mma-accumulate C-acc A-frag B-frag) C (0 0))))
