;; P3a (MMA autodiff) — `mma-accumulate-via-tile` must walk K WITHIN a staged tile.
;;
;; This is a FORWARD capability, but it is a hard prerequisite for the backward, and it
;; also fixes a latent forward bug.  Both fall out of the K-tile contract.
;;
;; WHY THE BACKWARD NEEDS IT.  With a workgroup tile (Mt x Nt) accumulating over K in
;; steps of Kt, the three GEMMs are:
;;     forward   C-tile  += A-tile . B-tile      -> (Mt, Nt, Kt)
;;     backward  dA-tile  = dC-tile . B-tileT    -> (Mt, Kt, Nt)
;;     backward  dB-tile  = A-tileT . dC-tile    -> (Kt, Nt, Mt)
;; Each must tile into native (M_n, N_n, K_n) steps.  Everything the two backward GEMMs
;; require is already implied by the forward EXCEPT `Kt % N_n` (from dA) and `Kt % M_n`
;; (from dB) — i.e.
;;
;;     Kt % lcm(M_n, N_n) == 0
;;
;; which is 16 on BOTH supported profiles (NVIDIA (16 8 8) via dB; Intel BMG (8 16 8) via
;; dA).  Since K_n = 8, a differentiable tile therefore spans at least TWO native K-steps.
;;
;; WHY IT IS ALSO A FORWARD BUG.  Today `mma-accumulate-via-tile` fires exactly ONE native
;; K-step per fragment position: %emit-per-frag-accumulate reads its operands at a hardcoded
;; K tile-index 0 (`(load-fragment-a A (mi 0))`, `(load-fragment-b B (0 nj))`).  Every
;; shipped forward kernel gets away with it by staging Kt = K_n = 8 and running the K-loop
;; externally.  Stage anything WIDER and the surplus is silently ignored — no error, no
;; warning, just a wrong answer.  Measured: an 8x16 A-tile emits ONE MulAdd, not two.
;;
;; THIS KERNEL is the smallest thing that distinguishes the two behaviours.  It stages the
;; ENTIRE K=16 in one shot and issues a SINGLE via-tile call — no external K-loop at all:
;;     A-tile 8x16  (Mt x Kt, two native K-steps)
;;     B-tile 16x16 (Kt x Nt)
;;     C-tile 8x16  (Mt x Nt, register)
;; If only one K-step fires, C = A[:,0:8].B[0:8,:] — exactly HALF the required sum — and the
;; --mma-test host reference (which checks the full C = A.B over K=16 with a non-uniform
;; fill) reports MMA_WRONG.  So this spec fails loudly before P3a and passes after, on real
;; hardware rather than by IR inspection.
;;
;; The K-step count is COMPILE-TIME: scratch tile dims are compile-time constants, so the
;; expansion is `Kt / K_n` unrolled MMAs per fragment position.  No new syntax.
;;
;; COMPILE-WITH[--hardware-profile=bmg --ir-target=spv]: PASS
;; SKIP-DEFAULT-PASS
;;
;; MMA-DIMS: 8 16 16
;; HOIST-HARDWARE-PROFILE: bmg
;; TEST-HOIST[L0]: validate-l0-mma-run
;; HOIST-EXPECT: MMA_CORRECT

(def-hardware-profile bmg :simd-width 16 :mma-shapes ((8 16 8)))

(def-type a-mat (matrix float :address-space :global :align :compact :contiguous-term :row-major))
(def-type b-mat (matrix float :address-space :global :align :compact :contiguous-term :row-major))
(def-type c-mat (matrix float :address-space :global :align :compact :contiguous-term :row-major))

(def-kernel k16_matmul (A B &out C)
  (declare #'(a-mat b-mat &out c-mat)
           (global-size :set-to 16)
           (local-size  :set-to 16))          ; one Intel SG16 sub-group
  (let ((A-tile (make-scratch-matrix float (8 16)))    ; Mt x Kt — TWO native K-steps
        (B-tile (make-scratch-matrix float (16 16)))   ; Kt x Nt
        (C-tile (make-register-tile float (8 16) 0.0)))
    (load-tile-at A A-tile (0 0))
    (load-tile-at B B-tile (0 0))
    (sync-workgroup)
    (mma-accumulate-via-tile (8 16 8) C-tile A-tile B-tile)   ; must fire BOTH K-steps
    (store-tile C-tile C (0 0))))
