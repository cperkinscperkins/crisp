;; VJP REGISTRY — numeric proof of the SCALAR lowering.
;;
;; This kernel deliberately uses Kt=8, which does NOT admit the MMA backward on BMG (8 16 8):
;; the dA accumulator would be Mt x Kt = 8x8, and 8 is less than one 8x16 accumulator fragment.
;; Until the registry landed that was a hard compile error ("the K-tile contract"), and before
;; THAT it silently emitted a backward with one of its two GEMMs missing entirely.
;;
;; Both were wrong.  dA = dC.B^T and dB = A^T.dC hold at every shape; only the MMA REALISATION
;; of them needs the tile dims to divide into whole hardware fragments.  So the VJP now picks
;; the lowering — MMA when the shapes admit it, plain scalar loops otherwise — and the shape
;; condition became a PERFORMANCE predicate instead of a correctness gate.
;;
;; This spec exists because "it compiles" is not "it is correct".  That mistake was made twice
;; in this endeavor (the silently-dropped K-step in P3a, and the half-missing backward above),
;; so the scalar path gets a NUMERIC on-metal check of its own rather than an IR inspection.
;;
;; Companion to 09, which pins the MMA path at Kt=16 with the same f and seed.  Together they
;; show the two lowerings agree on the mathematics.
;;
;; THE CHECK.  f(A,B) = sum(A.B), so dC is all ones and dA[m,k] = sum_n B[k,n].  With
;; B[i][j] = 0.01*(i*16+j), dA[1,0] = 0.01 * sum_{n=0..15} n = 1.2.
;;
;; Note the scalar lowering multiplies in plain fp32, NOT tf32 — so its gradient should track
;; the finite difference more closely than 09's MMA path does, not less.
;;
;; COMPILE-WITH[--hardware-profile=bmg --ir-target=spv]: PASS
;; COMPILE-WITH[--hardware-profile=bmg --ir-target=spv --differentiate]: PASS
;; SKIP-DEFAULT-PASS
;; SKIP-WITH[--debug]: "pre-existing --debug c-t-accessor codegen bug (plan/bugs.md #033)"
;; HOIST-HARDWARE-PROFILE: bmg
;; VERIFY-AUTODIFF: A=8x8@0:0.01 B=8x16@0:0.01 at.A=1,0 group=16 h=0.5 atol=2e-2 expect.A=1.2 output-mat=8x16

(def-hardware-profile bmg :simd-width 16 :mma-shapes ((8 16 8)))

(def-type a-mat (matrix float :address-space :global :align :compact :contiguous-term :row-major))
(def-type b-mat (matrix float :address-space :global :align :compact :contiguous-term :row-major))
(def-type c-mat (matrix float :address-space :global :align :compact :contiguous-term :row-major))

(def-kernel scalar_vjp_matmul (A B &out C)
  (declare #'(a-mat b-mat &out c-mat)
           (global-size :set-to 16)
           (local-size  :set-to 16))          ; one Intel SG16 sub-group
  (let ((A-tile (make-scratch-matrix float (8 8)))     ; Mt x Kt — Kt=8, MMA path NOT admissible
        (B-tile (make-scratch-matrix float (8 16)))    ; Kt x Nt
        (C-tile (make-register-tile float (8 16) 0.0)))
    (load-tile-at A A-tile (0 0))
    (load-tile-at B B-tile (0 0))
    (sync-workgroup)
    (mma-accumulate-via-tile (8 16 8) C-tile A-tile B-tile)
    (store-tile C-tile C (0 0))))
