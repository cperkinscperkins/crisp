;; P8 (MMA autodiff) — MULTI-WORKGROUP: cross-workgroup gradient accumulation, and the
;; `matrix-multiply-tile-stride` macro under --differentiate.
;;
;; WHY MULTI-WORKGROUP IS ITS OWN PHASE.  The forward parallelises over (m,n) and reduces over
;; k.  The backward's reductions run along DIFFERENT axes: dA reduces over n (the forward's
;; grid-x) and dB over m (grid-y).  So a workgroup owning C-tile (gy,gx) produces only a
;; PARTIAL dA for every (gy,k) — the rest comes from the workgroups holding the other gx.
;; Several workgroups therefore add into the same gradient tile, and the scatter has to be
;; atomic or contributions are lost.
;;
;; That part turned out to need NO new work: `%load-tile-at-bwd` (endeavor 111) has always
;; scattered a tile adjoint into its global gradient with an atomic add, and each workgroup
;; accumulates into its OWN :local SLM adjoint tile first.  Verified in the emitted SPIR-V —
;; the backward carries 2 AtomicFAdd (one per input gradient) and the forward none.
;;
;; WHAT DID BREAK: `matrix-multiply-tile-stride` was mangled by ANF.  The endeavor-107 AD
;; pre-pass knows tile-stride / grid-stride / workgroup-stride and friends, but not the
;; endeavor-135 matmul macro — so it survived into ANF, which treated it as an ordinary call
;; and normalised its arguments.  The BINDING-NAME LIST became a function call:
;;     (%ANF-T-1 (GRID-Y GRID-X GRID-K))     -> "Function GRID-Y is not differentiable"
;; and every body form was hoisted into a temp OUTSIDE the loop that binds those very names.
;; Fixed by pre-lowering the macro before the AD pre-pass, exactly as the forward path already
;; does before analysis.
;;
;; Two smaller AD-path gaps fell out of the same kernel, both fixed generically: a tile
;; load/store in ANF VALUE position (the macro's `:epilogue` ends with `store-tile`, so it
;; arrives as `(%t (store-tile-at ...))` rather than a bare statement), and the same for
;; `mma-accumulate-via-tile`.  These forms are void, so the walk now unwraps the temp and
;; re-dispatches — which repairs the scratch-tile path as well as the register one.
;;
;; ROUTED AROUND BUG 036.  This spec deliberately does NOT use the
;; `matrix-multiply-tile-stride` macro, even though that is the natural way to write it.  The
;; macro never resets the register C-tile accumulator between output tiles, so ANY matmul wider
;; than one output tile is silently wrong — the second tile comes back with the first tile's
;; partial sums added on top (measured: C[0][16]=60 ref 30).  That is PRE-EXISTING and
;; reproduces with the shipped 135/04 spec unmodified; see plan/bugs.md #036.  Writing the
;; tile-stride out by hand with an explicit `(fill-tile C-tile 0.0)` per tile keeps this spec
;; about AUTODIFF rather than about that bug, and keeps the forward fix separately reviewable.
;;
;; THE CHECK.  C is 8x32 = TWO 8x16 output tiles, dispatched to `groups=2`, so both workgroups
;; contribute to dA(0,k) and the atomics are load-bearing — with a lost-update bug the
;; gradient would come out low.  f = sum(A.B) so dA[m,k] = sum_n B[k,n]; with
;; B[i][j] = 0.01*(i*32+j), dA[1,0] = 0.01 * sum_{n=0..31} n = 4.96.
;;
;; h is large because f is exactly bilinear (no truncation error) and f ~ 6.1e3 needs a step
;; big enough to survive fp32; atol is loose enough for tf32's 10-bit mantissa.
;;
;; COMPILE-WITH[--hardware-profile=bmg --ir-target=spv]: PASS
;; COMPILE-WITH[--hardware-profile=bmg --ir-target=spv --differentiate]: PASS
;; SKIP-DEFAULT-PASS
;; HOIST-HARDWARE-PROFILE: bmg
;; VERIFY-AUTODIFF: A=8x16@0:0.01 B=16x32@0:0.01 at.A=1,0 group=16 groups=2 h=0.5 atol=5e-2 expect.A=4.96 output-mat=8x32

(def-hardware-profile bmg :simd-width 16 :mma-shapes ((8 16 8)))

(def-type a-mat (matrix float :address-space :global :align :compact :contiguous-term :row-major))
(def-type b-mat (matrix float :address-space :global :align :compact :contiguous-term :row-major))
(def-type c-mat (matrix float :address-space :global :align :compact :contiguous-term :row-major))

(def-kernel mw_matmul (A B &out C)
  (declare #'(a-mat b-mat &out c-mat)
           (global-size :set-to 32)
           (local-size  :set-to 16))          ; two SG16 sub-groups
  (let ((A-tile (make-scratch-matrix float (8 16)))    ; Mt x Kt
        (B-tile (make-scratch-matrix float (16 16)))   ; Kt x Nt
        (C-tile (make-register-tile float (8 16) 0.0))
        (K      (to-int (inner-dimension A B))))
    (tile-stride C (8 16) (grid-y grid-x)
      (fill-tile C-tile 0.0)                   ; per-tile reset — see BUG 036
      (dotimes (grid-k (/ K 16))
        (load-tile A A-tile (grid-y grid-k))
        (load-tile B B-tile (grid-k grid-x))
        (sync-workgroup)
        (mma-accumulate-via-tile (8 16 8) C-tile A-tile B-tile)
        (sync-workgroup))
      (store-tile C-tile C (grid-y grid-x)))))
