;; EXPECT-STDERR[--hardware-profile=derated]: "reserves 128 of 200 registers/thread"
;; SKIP-DEFAULT-PASS
;;
;; Endeavor 146: "wgmma is forward-only (no autodiff)" was false — wgmma differentiates (140/03).
;; The EXPECT-STDERR occupancy warning is the assertion here, and it is AD-independent.
;;
;; (SKIP-DEFAULT-PASS as in every 140-wgmma spec: the default pass validates GENERIC LLVM IR,
;; which cannot digest the NVVM wgmma intrinsics.  EXPECT-STDERR carries the real assertion —
;; it invokes the binary directly and only requires exit 0 plus the warning on stderr.)
;;
;; Endeavor 144 Phase 2 — wgmma accumulator register accounting, WARNING tier.
;;
;; Occupancy is NOT a correctness bound, so a costly-but-legal accumulator must WARN, never
;; error — endeavor 144 decision D3.  (Erroring would break kernels that work today; chap3
;; ships an m64n256 accumulator and is our fastest NVIDIA kernel at 63.6% of cuBLAS.)
;;
;; The warning fires when the accumulator alone occupies >= half the per-thread register
;; budget (*wgmma-acc-occupancy-warn-fraction*).  m64n256 = 128 registers/thread, so:
;;   - default budget 255 -> 50.2%, warns
;;   - m64n128 = 64 registers/thread -> 25%, silent
;; so the advisory fires precisely on the tile widths where occupancy, not fit, binds.
;;
;; The profile here pins :max-registers-per-thread to 200 rather than 255 SPECIFICALLY so
;; the asserted substring ("128 of 200") can only be produced by reading the PROFILE — a
;; test against 255 would pass even if the profile were ignored and the default used.
;;
;; Like endeavor 126's precision warnings, this is emitted with a raw `format` to
;; *error-output* (not log4cl), so it survives --log-level=off and EXPECT-STDERR can see it.

(def-hardware-profile derated :simd-width 32 :max-registers-per-thread 200)

(def-type mt (matrix float :address-space :global :align :compact :contiguous-term :row-major))

(def-kernel wgmma_acc_occupancy (&out C)
  (declare #'(&out mt)
           (global-size :set-to 128)
           (local-size :set-to 128))          ; one warpgroup
  (let ((A-tile (make-scratch-matrix float (64 8)))
        (B-tile (make-scratch-matrix float (8 256)))
        (D      (make-wgmma-accumulator float (64 256) 0.0)))
    (wgmma-accumulate-via-tile (64 256 8) D A-tile B-tile)
    (store-tile D C (0 0))))
