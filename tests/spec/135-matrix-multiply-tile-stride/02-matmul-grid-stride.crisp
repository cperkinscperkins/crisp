;; Endeavor 135 — matrix-multiply-tile-stride: GRID-STRIDE + DUAL-BACKEND correctness.
;;
;; This is the macro's own divergence-catcher: ONE source file run on BOTH metals
;; (TEST-HOIST[CUDA] and TEST-HOIST[L0]), verifying C = A·B via the 134 --mma-test
;; stride-agnostic host reference.  The body is deliberately BACKEND-NEUTRAL — a plain
;; scalar accumulate, no tensor cores, C-tile an SLM scratch matrix — so the ONLY thing
;; under test is the macro's own codegen (gy/gx derivation, K/k-step loop, auto-store).
;; If the macro miscompiles on one backend but not the other, this catches it.
;;
;; GRID-STRIDE (OQ3): C is 8x8 with a 4x4 tile => 2x2 = 4 output tiles, but we launch a
;; SINGLE workgroup (global=local=1), so that one workgroup must STRIDE over all four
;; C-tiles.  This exercises the multi-tile-per-workgroup path, not the degenerate
;; grid==#tiles case.  K=8, k-step=4 => 2 grid-k reduction steps per tile.
;;
;; ASSUMPTION (endeavor 135 design): grid-y/grid-x/grid-k are ulong tile indices, and the
;; macro does NOT auto-reset a scratch accumulator — the body clears C-tile on grid-k==0
;; via (fill-tile C-tile 0.0) (the accumulator-reset sugar).
;;
;;   (145 / BUG 037: differentiates. Staged-tile primals are read back from their
;;    original global source, since a backward replays bindings but not statements.)
;;
;; MMA-DIMS: 8 8 8
;; TEST-HOIST[CUDA]: validate-cuda-mma-run
;; TEST-HOIST[L0]: validate-l0-mma-run
;; HOIST-EXPECT: MMA_CORRECT

(def-type mat-t (matrix float :address-space :global :align :compact :contiguous-term :row-major))

(def-kernel mm_grid_stride (A B &out C)
  (declare #'(mat-t mat-t &out mat-t)
           (global-size :set-to 1)
           (local-size  :set-to 1))
  (let ((A-tile (make-scratch-matrix float (4 4)))
        (B-tile (make-scratch-matrix float (4 4)))
        (C-tile (make-scratch-matrix float (4 4)))
        (K      (inner-dimension A B)))
    (matrix-multiply-tile-stride C C-tile K 4 (grid-y grid-x grid-k)
      (when (= grid-k (to-ulong 0))
        (fill-tile C-tile 0.0))                ; reset accumulator at the start of each tile
      (load-tile A A-tile (grid-y grid-k))     ; A block at tile (grid-y, grid-k)
      (load-tile B B-tile (grid-k grid-x))     ; B block at tile (grid-k, grid-x)
      (dotimes (i 4)
        (dotimes (j 4)
          (dotimes (kk 4)
            (set! (~ C-tile i j)
                  (+ (~ C-tile i j)
                     (* (~ A-tile i kk) (~ B-tile kk j)))))))
      :epilogue
      (store-tile C-tile C (grid-y grid-x)))))
