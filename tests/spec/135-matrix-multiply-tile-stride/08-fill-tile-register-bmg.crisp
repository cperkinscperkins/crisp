;; Endeavor 135 — fill-tile on a REGISTER tile, in a grid-stride matmul where the reset matters.
;;
;; C is 8x32 = TWO 8x16 output tiles; one sub-group strides over both (grid-y=0, grid-x∈{0,1}).
;; The register C-tile (8x16) is REUSED across the two tiles, so it MUST be reset between them
;; — (fill-tile C-tile 0.0) on grid-k==0.  Without the reset, the 2nd tile would accumulate on
;; top of the 1st and MMA_WRONG.  This exercises the register-tile fill path (per-fragment
;; make-register-fragment via the SROA explosion) AND register grid-stride on BMG.
;;
;; BMG XMX shape (8 16 8), B row-major.  MMA-DIMS 8 32 16 => K=16 => 2 K-steps per tile.
;;
;; COMPILE-WITH[--hardware-profile=bmg --ir-target=spv --differentiate]: PASS
;;   (145: differentiates. The VJP picks its lowering — MMA where the tile dims
;;    decompose into whole fragments, plain scalar loops otherwise.)
;; COMPILE-WITH[--hardware-profile=bmg --ir-target=spv]: PASS
;; SKIP-DEFAULT-PASS
;; SKIP-WITH[--debug]: "pre-existing --debug c-t-accessor codegen bug (plan/bugs.md #033)"
;;
;; MMA-DIMS: 8 32 16
;; HOIST-HARDWARE-PROFILE: bmg
;; TEST-HOIST[L0]: validate-l0-mma-run
;; HOIST-EXPECT: MMA_CORRECT

(def-hardware-profile bmg :simd-width 16 :mma-shapes ((8 16 8)))

(def-type a-mat (matrix float :address-space :global :align :compact :contiguous-term :row-major))
(def-type b-mat (matrix float :address-space :global :align :compact :contiguous-term :row-major))
(def-type c-mat (matrix float :address-space :global :align :compact :contiguous-term :row-major))

(def-kernel matmul_gs_reg (A B &out C)
  (declare #'(a-mat b-mat &out c-mat)
           (global-size :set-to 16)
           (local-size  :set-to 16))          ; one sub-group, strides the 2 C-tiles
  (let ((A-tile (make-scratch-matrix float (8 8)))
        (B-tile (make-scratch-matrix float (8 16)))
        (C-tile (make-register-tile float (8 16) 0.0))
        (K      (inner-dimension A B)))
    (matrix-multiply-tile-stride C C-tile K 8 (grid-y grid-x grid-k)
      (when (= grid-k (to-ulong 0))
        (fill-tile C-tile 0.0))                ; reset the reused register accumulator per tile
      (load-tile A A-tile (grid-y grid-k))
      (load-tile B B-tile (grid-k grid-x))
      (sync-workgroup)
      (mma-accumulate-via-tile (8 16 8) C-tile A-tile B-tile)
      (sync-workgroup)
      :epilogue
      (store-tile C-tile C (grid-y grid-x)))))
