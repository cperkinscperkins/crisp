;; Endeavour 210 item 2 (F-210-1) -- the Intel twin of 05: (store-tile C-tile C (0 0) :transformF
;; #'shifted-relu) on a BMG register tile (two XMX cooperative-matrix fragments).  150/04's kernel with
;; the activation moved to the store.  Each fragment's store becomes "copy the cooperative matrix
;; into a variable, map-elements! it (the OpCooperativeMatrixLengthKHR loop), store it".
;;
;; THE EXPECTATION is 150/04's, measured on a BMG: 0 6 0.  The harness's plain A.B reference will
;; report a mismatch (non-linear function); only the BUFFER line is asserted.
;;
;; SKIP-DEFAULT-PASS
;; COMPILE-WITH[--hardware-profile=bmg --ir-target=spv]: PASS
;; SKIP-WITH[--differentiate]: "GAP F-210-2: a store's :transformF has no backward yet -- --differentiate refuses it by name"
;;
;; MMA-DIMS: 16 16 8
;; HOIST-HARDWARE-PROFILE: bmg
;; TEST-HOIST[L0]: validate-l0-mma-run
;; HOIST-EXPECT: BUFFER c: 0 6 0
(def-hardware-profile bmg :simd-width 16 :mma-shapes ((8 16 8)))

(def-type a-mat (matrix float :address-space :global :align :compact :contiguous-term :row-major))
(def-type b-mat (matrix float :address-space :global :align :compact :contiguous-term :row-major))
(def-type c-mat (matrix float :address-space :global :align :compact :contiguous-term :row-major))

(def-function shifted-relu (x)
  (declare #'(float => float))
  (let ((y (- x 12.0)))
    (if (> y 0.0) y 0.0)))

(def-kernel rt_store_xform_bmg (A B &out C)
  (declare #'(a-mat b-mat &out c-mat)
           (global-size :set-to 16)
           (local-size  :set-to 16))          ; one sub-group
  (let ((C-tile (make-register-tile float (16 16) 0.0)))   ; 2 XMX fragments
    (mma-accumulate-via-tile (8 16 8) C-tile A B (acc)
      (accum-op))
    (store-tile C-tile C (0 0) :transformF #'shifted-relu)))
