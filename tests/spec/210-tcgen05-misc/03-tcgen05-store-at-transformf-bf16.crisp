;; Endeavour 210 item 2 -- (store-tile-at (to-bfloat16 D) C (0 0) :transformF #'triple) on a tcgen05
;; accumulator: the transform composes with a narrowing conversion.  The function sees the f32
;; element; the conversion narrows its result (f first, then to-bfloat16), as a fused activation
;; followed by an output cast must.
;;
;; The values are small integers (A = i%5, B = i%3, K = 64: at most 3 * 64 * 4 * 2 = 1536, all
;; multiples of 3 below 2048); bf16 holds the ones the reference produces to its own tolerance.
;;
;; SKIP-DEFAULT-PASS
;; TEST-WITH[--ir-target=ptx --ir-target-arch=sm_100a] : validate-ptx-transform-scale3
;; SKIP-WITH[--differentiate]: "tcgen05 has no backward yet (D-208-8)"
;;
;; MMA-DIMS: 128 128 64
;; MMA-SCALE: 3
;; HOIST-ARCH: sm_100a
;; TEST-HOIST[CUDA]: validate-cuda-mma-run
;; HOIST-EXPECT: MMA_CORRECT

(def-type a-mat (matrix bfloat16 :address-space :global :align :compact :contiguous-term :row-major))
(def-type b-mat (matrix bfloat16 :address-space :global :align :compact :contiguous-term :col-major))
(def-type c-mat (matrix bfloat16 :address-space :global :align :compact :contiguous-term :row-major))

(def-function triple (x)
  (declare #'(float => float))
  (* x 3.0))

(def-kernel tcgen05_store_at_xform (A B &out C)
  (declare #'(a-mat b-mat &out c-mat)
           (global-size :set-to 128) (local-size :set-to 128))
  (let ((A-tile (make-scratch-matrix bfloat16 (128 64)))
        (B-tile (make-scratch-matrix bfloat16 (128 64)))
        (D      (make-tcgen05-accumulator float (128 128) 0.0))
        (bar    (make-async-barrier :mode :block)))
    (load-tile A A-tile (0 0) :barrier bar :swizzle :128b)
    (load-tile B B-tile (0 0) :barrier bar :swizzle :128b)
    (await bar)
    (tcgen05-accumulate-via-tile (128 128 64) D A-tile B-tile :swizzle :128b)
    (store-tile-at (to-bfloat16 D) C (0 0) :transformF #'triple)))
