;; Endeavour 210 item 2 (F-209-2, F-210-1) -- (store-tile D C (0 0) :transformF #'triple) on a tcgen05
;; accumulator.  208/07's tf32 kernel; the store applies the user's function to every element as it
;; leaves tensor memory (after each 32-column tcgen05.ld, before the st.global).
;;
;; Before 210 the option was silently DROPPED on every accumulator store: this kernel compiled to PTX
;; byte-identical to the plain store (put_temp_files_here/210/item2/findings.md).
;;
;; THE CHECK.  triple is linear, so the harness's C = A.B reference times 3 (MMA-SCALE) must match
;; every element -- all 128 rows, all four 32-column chunks -- whatever the layout.  Locally the
;; validator counts the multiplications by 3.0 (0f40400000) in the PTX.
;;
;; SKIP-DEFAULT-PASS
;; TEST-WITH[--ir-target=ptx --ir-target-arch=sm_100a] : validate-ptx-transform-scale3
;; SKIP-WITH[--differentiate]: "tcgen05 has no backward yet (D-208-8)"
;;
;; MMA-DIMS: 128 128 32
;; MMA-SCALE: 3
;; HOIST-ARCH: sm_100a
;; TEST-HOIST[CUDA]: validate-cuda-mma-run
;; HOIST-EXPECT: MMA_CORRECT
(declaim (precision fast))

(def-type a-mat (matrix float    :address-space :global :align :compact :contiguous-term :row-major))
(def-type b-mat (matrix float    :address-space :global :align :compact :contiguous-term :col-major))
(def-type c-mat (matrix float    :address-space :global :align :compact :contiguous-term :row-major))

(def-function triple (x)
  (declare #'(float => float))
  (* x 3.0))

(def-kernel tcgen05_store_xform (A B &out C)
  (declare #'(a-mat b-mat &out c-mat)
           (global-size :set-to 128) (local-size :set-to 128))
  (let ((A-tile (make-scratch-matrix float (128 32)))
        (B-tile (make-scratch-matrix float (128 32)))
        (D      (make-tcgen05-accumulator float (128 128) 0.0))
        (bar    (make-async-barrier :mode :block)))
    (load-tile A A-tile (0 0) :barrier bar :swizzle :128b)
    (load-tile B B-tile (0 0) :barrier bar :swizzle :128b)
    (await bar)
    (tcgen05-accumulate-via-tile (128 128 32) D A-tile B-tile :swizzle :128b)
    (store-tile D C (0 0) :transformF #'triple)))
