;; CHECK-FAIL: "needs X to be an MMA accumulator"
;; CHECK-FAIL-FLAGS: --ir-target=ptx --ir-target-arch=sm_90
;;
;; Endeavour 196 (D-196-3).  (to-half X) as a store source is the fused narrowing of an f32 MMA
;; ACCUMULATOR.  X here is a scratch matrix, which has no f32 fragment to narrow; refuse at analysis,
;; naming the rule, instead of letting the generic store treat (to-half X) as a scalar cast of a
;; whole tile and fail later with an unrelated message.
(def-type h-mat (matrix half :address-space :global :align :compact :contiguous-term :row-major))
(def-kernel narrow_source_kind (A &out C)
  (declare #'(h-mat &out h-mat)
           (global-size :set-to 128) (local-size :set-to 128))
  (let ((S (make-scratch-matrix half (64 64))))
    (load-tile A S (0 0))
    (sync-workgroup)
    (store-tile (to-half S) C (0 0))))
