;; CHECK-FAIL: "exceeding the register budget"
;; CHECK-FAIL-FLAGS: --ir-target=ptx --ir-target-arch=sm_80 --hardware-profile=h100
;; SKIP-WITH[--differentiate]: "GAP D-196-12: autodiff refuses a converted store source (store-tile (to-half D) ...) -- the accumulator backward does not yet see through the conversion"
;;
;; Endeavour 196 (D-196-10), the other side of rung 06: WITHOUT :warps, one thread would hold all 128
;; fragments of a 128x128 accumulator (512 registers), and that is still refused.
(def-type a-mat (matrix half :address-space :global :align :compact :contiguous-term :row-major))
(def-type b-mat (matrix half :address-space :global :align :compact :contiguous-term :row-major))
(def-type c-mat (matrix half :address-space :global :align :compact :contiguous-term :row-major))
(def-kernel one_warp_big (A B &out C)
  (declare #'(a-mat b-mat &out c-mat)
           (local-size :set-to 32))
  (let ((A-tile (make-scratch-matrix half (128 16)))
        (B-tile (make-scratch-matrix half (16 128)))
        (C-tile (make-register-tile float (128 128) 0.0))
        (K      (inner-dimension A B)))
    (matrix-multiply-tile-stride C C-tile K 16 (grid-y grid-x grid-k)
      (load-tile A A-tile (grid-y grid-k))
      (load-tile B B-tile (grid-k grid-x))
      (sync-workgroup)
      (mma-accumulate-via-tile (16 8 16) C-tile A-tile B-tile)
      (sync-workgroup)
      :epilogue
      (store-tile (to-half C-tile) C (grid-y grid-x)))))
