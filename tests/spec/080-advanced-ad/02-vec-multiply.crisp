;; TEST-WITH[--ir-target=llvmir --differentiate]: validate-vec-multiply-grad
;;
;; Product rule through vector elements: C[idx] = A[idx] * B[idx]
;;
;; Expected backward kernel vec_mult_grad:
;;   adj(tmp_c) += (~ C_GRAD idx)
;;   adj(tmp_a) += tmp_b * adj(tmp_c)   ; d/dA of A*B = B
;;   adj(tmp_b) += tmp_a * adj(tmp_c)   ; d/dB of A*B = A
;;   (set! (~ A_GRAD idx) (+ (~ A_GRAD idx) adj(tmp_a)))
;;   (set! (~ B_GRAD idx) (+ (~ B_GRAD idx) adj(tmp_b)))
;;
;; Backward IR must contain 'fmul' (for the product-rule scaling) and 'fadd'.

(def-type in-vec  (vector float :address-space :global :access :read-only  :align :compact))
(def-type out-vec (vector float :address-space :global :access :read-write :align :compact))

(def-kernel vec_mult (A B idx &out C)
  (declare #'(in-vec in-vec ulong &out out-vec))
  (set! (~ C idx) (* (~ A idx) (~ B idx))))
