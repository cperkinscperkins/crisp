;; P4 (MMA fundamentals) — synchronous tiled matmul (single workgroup).
;;
;; One warp computes a 16x8 output tile: C[16x8] = A[16xK] . B[Kx8], K a runtime
;; multiple of 8.  Each K-step (K-tile = the MMA shape's K = 8) is staged from global
;; into SLM via sync load-tile-at, then mma-accumulate-via-tile adds its A·B into
;; the register C-tile.  Accumulation across the K-loop is automatic (mma = A·B + C).
;;
;; SKIP-WITH[--differentiate]: "K-tile 8 violates the K % lcm(M_n,N_n) == 16 AD contract (145); the backward dA/dB GEMMs need at least two native K-steps"
;; TEST-WITH[--ir-target=spv]
;; SKIP-DEFAULT-PASS
;; SKIP-WITH[--debug]: "pre-existing --debug c-t-accessor codegen bug (plan/bugs.md #033)"

(def-type a-mat (matrix float :address-space :global :align :compact :contiguous-term :row-major))
(def-type b-mat (matrix float :address-space :global :align :compact :contiguous-term :col-major))
(def-type c-mat (matrix float :address-space :global :align :compact :contiguous-term :row-major))

(def-kernel tiled_matmul (A B &out C)
  (declare #'(a-mat b-mat &out c-mat)
           (global-size :set-to 32)
           (local-size  :set-to 32))          ; one warp
  (let ((A-tile (make-scratch-matrix float (16 8)))     ; SLM: M×8 (one K-step of A)
        (B-tile (make-scratch-matrix float (8 8)))      ; SLM: 8×N (one K-step of B)
        (C-tile (make-register-tile float (16 8) 0.0))
        (K      (to-int (inner-dimension A B))))
    (dotimes (kt (/ K 8))
      (load-tile-at A A-tile (0 (* kt 8)))      ; stage A[:, kt*8 : kt*8+8]
      (load-tile-at B B-tile ((* kt 8) 0))      ; stage B[kt*8 : kt*8+8, :]
      (sync-workgroup)
      (mma-accumulate-via-tile (16 8 8) C-tile A-tile B-tile)
      (sync-workgroup))
    (store-tile C-tile C (0 0))))
