;; CHECK-FAIL: "B tile must be (K N)"
;; Endeavour 198 -- with :b-major :mn the B tile must be (K N); a (N K) tile under :mn is the
;; orientation mix-up the keyword exists to make explicit, and is refused.
(declaim (precision fast))
(def-type mt (matrix float :address-space :global :align :compact :contiguous-term :row-major))
(def-kernel e198_five (&out C)
  (declare #'(&out mt) (global-size :set-to 128) (local-size :set-to 128))
  (let ((A-tile (make-scratch-matrix half (64 64)))
        (B-tile (make-scratch-matrix half (128 64)))
        (D (make-wgmma-accumulator float (64 128) 0.0)))
    (wgmma-accumulate-via-tile (64 128 64) D A-tile B-tile :swizzle :128b :b-major :mn)
    (set! (~ C 0 0) 1.0)))
