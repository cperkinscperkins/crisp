;; Endeavour 198 rung 02 -- the contest geometry: a (64 256) bf16 B tile in a RING (ring-get), four
;; 64x64 TMA boxes per load, wgmma m64n256k16 with transB=1.
;;
;; The ring matters: the box split needs the tile's static dims, and a ring slot is (ring-get RING SLOT),
;; which resolves through the enclosing let's published dims.  If it did not, the descriptor box would be
;; narrowed (resolve-tma-descriptors reads the ring's declared dims) while the load issued ONE copy --
;; three quarters of B never loaded.  The validator's copy count (A + 4 B boxes = 5) catches that.
;;
;; SKIP-DEFAULT-PASS
;; TEST-WITH[--ir-target=ptx --ir-target-arch=sm_90] : validate-ptx-wgmma-transb-ring
(def-type a-mat (matrix bfloat16 :address-space :global :align :compact :contiguous-term :row-major))
(def-type b-mat (matrix bfloat16 :address-space :global :align :compact :contiguous-term :row-major))
(def-type c-mat (matrix float :address-space :global :align :compact :contiguous-term :row-major))

(def-kernel wgmma_b_mn_ring (A B &out C)
  (declare #'(a-mat b-mat &out c-mat)
           (global-size :set-to 128) (local-size :set-to 128))
  (let ((A-ring (make-scratch-matrix-ring bfloat16 (64 64)  :ring-count 2))
        (B-ring (make-scratch-matrix-ring bfloat16 (64 256) :ring-count 2))
        (D      (make-wgmma-accumulator float (64 256) 0.0))
        (full   (make-async-barrier-ring :ring-count 2 :mode :block :arrivals 2)))
    (load-tile A (ring-get A-ring 0) (0 0) :barrier (ring-get full 0) :swizzle :128b)
    (load-tile B (ring-get B-ring 0) (0 0) :barrier (ring-get full 0) :swizzle :128b)
    (await (ring-get full 0))
    (wgmma-accumulate-via-tile (64 256 64) D (ring-get A-ring 0) (ring-get B-ring 0)
                               :swizzle :128b :b-major :mn)
    (store-tile-at D C (0 0))))
