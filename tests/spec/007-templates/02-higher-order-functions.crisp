
;;; ============================================================================
;;; Higher-Order Functions Test Suite
;;; Consolidates hof-01 to hof-05
;;; ============================================================================

;; Common Helpers
(def-function simple-binop (x)
  (declare #'(int => int))
  (+ x 1))

(def-function my-add (a b)
  (declare #'(int int => int))
  (+ a b))

;;; ----------------------------------------------------------------------------
;;; HOF-01: Basic Funcall with Primitive
;;; ----------------------------------------------------------------------------
(def-function basic-funcall (a b)
  (declare #'(int int => int))
  (funcall #'+ a b))

;;; ----------------------------------------------------------------------------
;;; HOF-02: Compile-time Determined Funcall (Local Variable)
;;; ----------------------------------------------------------------------------
(def-function compile-time-determined-funcall (a b)
  (declare #'(int int => int))
  (let ((f #'my-add))
    (funcall f a b)))

;;; ----------------------------------------------------------------------------
;;; HOF-03: Nested Signatures (Function as Argument Type)
;;; ----------------------------------------------------------------------------
(def-function nested-signatures (f a b)
  (declare #'(#'(int => int) int int => int))
  ;; f is unused, just testing signature parsing
  (+ a b))

;;; ----------------------------------------------------------------------------
;;; HOF-04: Implicit Templating (Monomorphism)
;;; ----------------------------------------------------------------------------
;; Implicit template: f is a function type parameter
(def-function add-via-f-implicit (f x y)
  (declare #'(#'(int => int) int int => int))
  (+ (funcall f x) y))

(def-function intermediary (f x)
  (declare #'(#'(int => int) int => int))
  (add-via-f-implicit f x 10))

;; Root function triggering instantiation of implicit templates
(def-function root-implicit-test (x)
  (declare #'(int => int))
  (add-via-f-implicit #'simple-binop x 20))

(def-function root-intermediary-test (x)
  (declare #'(int => int))
  (intermediary #'simple-binop x))

;;; ----------------------------------------------------------------------------
;;; HOF-05: Pre-existing Explicit Templates
;;; ----------------------------------------------------------------------------

;; Explicit template definition
(with-template-type (T)
    (def-function add-via-f-explicit (f x y)
        (declare #'(#'(T => T) T T => T))
        (+ (funcall f x) y)))

;; Function triggering instantiation of explicit template
(def-function root-explicit-test (x)
    (declare #'(int => int))
    (add-via-f-explicit #'simple-binop x 20))
