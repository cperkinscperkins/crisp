;; Endeavor 138 / BUG 040 — an MMA whose OPERANDS ARE RING SLOTS, on BMG metal.
;;
;; Deliberately the one-variable twin of 145-mma-autodiff/09: same shapes, same staging, same
;; expected product — differing only in that the two SLM tiles are RING SLOTS rather than plain
;; scratch matrices.  A difference between them therefore isolates the ring.
;;
;; WHY THIS SPEC EXISTS.  This kernel returned MMA_WRONG (C[0][0]=11 against a reference of 30)
;; and the cause was NOT the addressing bug that BUG 040 hypothesised.  The operand's K EXTENT
;; was not compile-time resolvable through a `ring-get`, so %mma-k-steps took its fallback of ONE
;; native K-step and the MMA contracted over K=0..7 of 0..15 — it computed HALF the dot product.
;; That is why the wrong values were "small and plausible" rather than garbage.
;;
;; Kt = 16 with the BMG instruction's K_n = 8 is the point of the shape: it spans TWO native
;; K-steps, so a regression to the one-step fallback halves the answer and this spec goes red.
;; Staging Kt = K_n = 8 (what every earlier ring kernel did, incl. 138/04 on H100) cannot detect
;; it — the fallback is accidentally correct there, which is exactly how this hid.
;;
;; TEETH: with the BUG 040 fix reverted this reports MMA_WRONG.
;;
;; COMPILE-WITH[--hardware-profile=bmg --ir-target=spv]: PASS
;; SKIP-DEFAULT-PASS
;; MMA-DIMS: 8 16 16
;; HOIST-HARDWARE-PROFILE: bmg
;; TEST-HOIST[L0]: validate-l0-mma-run
;; HOIST-EXPECT: MMA_CORRECT

(def-hardware-profile bmg :simd-width 16 :mma-shapes ((8 16 8)))

(def-type a-mat (matrix float :address-space :global :align :compact :contiguous-term :row-major))
(def-type b-mat (matrix float :address-space :global :align :compact :contiguous-term :row-major))
(def-type c-mat (matrix float :address-space :global :align :compact :contiguous-term :row-major))

(def-kernel ring_mma_operand (A B &out C)
  (declare #'(a-mat b-mat &out c-mat)
           (global-size :set-to 16)
           (local-size  :set-to 16))
  (let ((A-ring (make-scratch-matrix-ring float (8 16)  :ring-count 2))
        (B-ring (make-scratch-matrix-ring float (16 16) :ring-count 2))
        (C-tile (make-register-tile float (8 16) 0.0)))
    (load-tile-at A (ring-get A-ring (to-ulong 0)) (0 0))
    (load-tile-at B (ring-get B-ring (to-ulong 0)) (0 0))
    (sync-workgroup)
    (mma-accumulate-via-tile (8 16 8) C-tile
                             (ring-get A-ring (to-ulong 0))
                             (ring-get B-ring (to-ulong 0)))
    (store-tile C-tile C (0 0))))
