;; Endeavor 138 (Chapter 2) — a :linear barrier RING is not yet implemented on SPIR-V (it would
;; need per-slot spirv.Event chaining + per-slot OpGroupWaitEvents).  A non-ring
;; (make-async-barrier :mode :linear) IS fine on SPV; only a genuine ring (ring-count > 1) is
;; rejected — and only on the SPV backend.  The GENERIC default pass has no backend and compiles
;; fine (the ring lowers to the no-op await fallback), mirroring 137/02's :block-on-Intel guard.
;;
;; AUTODIFF: differentiable as of endeavor 145 (2026-08-01).  The skip here read "ring/
;; pipelining is forward-only; tile AD is a later chapter" -- that chapter is now.  A ring is
;; rank+1 scratch and `ring-get` a pure view selector, so the rule is just THE ADJOINT OF A
;; VIEW IS THE SAME VIEW OF THE ADJOINT: (ring-get R i) has adjoint (ring-get R_ADJ i), and
;; the existing %load-tile-at-bwd / %store-tile-at-bwd edges then apply unchanged.
;; Proven NUMERICALLY by 145/18-ring-staged-vjp-bmg (analytical 1.0 vs finite-difference 1.0
;; on BMG) -- not by this spec compiling, which would prove nothing (135/01 compiled, had the
;; right atomics, and returned 0.0).
;; SKIP-WITH[--debug]: "pre-existing --debug DIBuilder memory-fault; ring-get/make-view surfaces it (plan/bugs.md #033)"
;; COMPILE-WITH[--ir-target=spv]: FAIL "not yet implemented on SPIR-V"

(def-type mat-t (matrix float :address-space :global :align :compact :contiguous-term :row-major))

(def-kernel spv_linear_ring (A &out C)
  (declare #'(mat-t &out mat-t)
           (global-size :set-to 4)
           (local-size  :set-to 4))
  (let ((tiles (make-scratch-matrix-ring float (4 4) :ring-count 2))
        (bars  (make-async-barrier-ring :ring-count 2 :mode :linear :arrivals 1)))
    (load-tile A (ring-get tiles 0) (0 0) :barrier (ring-get bars 0))
    (await (ring-get bars 0))
    (store-tile (ring-get tiles 0) C (0 0))))
