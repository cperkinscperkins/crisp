;; Endeavour 216 rung 01 -- 16-bit mma.sync operand fragments come from shared memory by ldmatrix.
;;
;; WHAT THIS PINS.  load-fragment-a / -b (what mma-accumulate-via-tile expands to) read every fp16
;; fragment element with its own ld.shared.b16 -- 8 per A fragment, 4 per B fragment -- and then
;; re-packed them in pairs for the mma.  On an A100 that was the gap to cuBLAS (matmul_v2, 12% of #1).
;; Now a fragment whose source is a shared-memory (scratch) ROW-MAJOR matrix with a 16-byte-multiple row
;; pitch is ONE instruction:
;;   A (16x16)            ldmatrix.sync.aligned.m8n8.x4.shared.b16        -- Ra0..Ra3 in mma order
;;   B (16x8, (K N) tile) ldmatrix.sync.aligned.m8n8.x2.trans.shared.b16  -- .trans pairs K, not N
;;
;; One warp, a 64x64 register tile, K = 16 per stage: 4 A fragments and 8 B fragments feed 32 MMAs.
;; The validator is two-sided: those ldmatrix counts, the 32 m16n8k16 MMAs, and NO ld.shared.b16 left.
;;
;; The lane mapping cannot be proved by reading PTX; it was proved on an A100 by GPU MODE's bit-exact
;; matmul_v2 check (contests/gpu-mode/06-matmul-v2/diag_ampere_216_sub.py).
;;
;; C is float so the kernel differentiates: the backward's MMAs read materialized transposes (A-TILE_BWT,
;; B-TILE_BWT) and a staged dC (C-TILE_BWDC) -- compact row-major shared tiles -- so they are ldmatrix too.
;;
;; SKIP-DEFAULT-PASS
;; TEST-WITH[--ir-target=ptx --ir-target-arch=sm_80 --hardware-profile=h100] : validate-ptx-216-ldmatrix-fp16
(def-type a-mat (matrix half :address-space :global :align :compact :contiguous-term :row-major))
(def-type b-mat (matrix half :address-space :global :align :compact :contiguous-term :row-major))
(def-type c-mat (matrix float :address-space :global :align :compact :contiguous-term :row-major))
(def-kernel frag_fp16 (A B &out C)
  (declare #'(a-mat b-mat &out c-mat)
           (local-size :set-to 32))
  (let ((A-tile (make-scratch-matrix half (64 16)))
        (B-tile (make-scratch-matrix half (16 64)))
        (C-tile (make-register-tile float (64 64) 0.0))
        (K      (inner-dimension A B))
        (bar    (make-async-barrier)))
    (matrix-multiply-tile-stride C C-tile K 16 (grid-y grid-x grid-k)
      (load-tile A A-tile (grid-y grid-k) :barrier bar)
      (load-tile B B-tile (grid-k grid-x) :barrier bar)
      (await bar)
      (mma-accumulate-via-tile (16 8 16) C-tile A-tile B-tile)
      (sync-workgroup)
      :epilogue
      (store-tile C-tile C (grid-y grid-x)))))
