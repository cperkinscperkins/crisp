;; CHECK-FAIL: "2-byte"
;; CHECK-FAIL-FLAGS: --ir-target=spv --hardware-profile=bmg
;; Refusal 3 of 3.  The legal 2D block prefetch shape is ELEMENT-WIDTH dependent -- a 16-bit block
;; is at most 16 columns wide, and other widths have their own limits.  An illegal :size resolves
;; to an IGC builtin that does not exist and fails at MODULE BUILD, long after compilation, with a
;; message about a missing symbol rather than about the kernel.  Crisp refuses rather than guess.
(declaim (precision fast))
(def-type a-mat (matrix float :address-space :global :align :compact :contiguous-term :row-major))
(def-type c-mat (matrix float :address-space :global :align :compact :contiguous-term :row-major))

(def-kernel float_operand (A &out C)
  (declare #'(a-mat &out c-mat)
           (global-size :derive-from C :strategy :strided)
           (local-size :set-to 256))
  (let ((A-tile (make-register-tile float (128 32) 0.0 :operand :a :warps '(true true true true true true true true true true true true true true true true)))
        (C-tile (make-register-tile float (128 256) 0.0 :warps '(true true true true true true true true true true true true true true true true)))
        (n-k-steps (to-ulong 8)))
    (tile-stride C (128 256) (grid-y grid-x)
      (progn
        (dotimes (grid-k n-k-steps)
          (prefetch-tile A (grid-y grid-k) :size (128 32) :warp-partitioned true)
          (load-tile A A-tile (grid-y grid-k)))
        :epilogue
        (store-tile C-tile C (grid-y grid-x))))))
