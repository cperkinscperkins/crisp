;; CHECK-FAIL: "is not a lowering Crisp knows"
;;
;; Endeavour 156: a lowering NAME the compiler has never heard of is caught before any profile
;; question is asked, and the message lists the names that exist.  Distinguishing "unknown name"
;; from "known but unavailable here" matters: the first is a typo, the second is a portability
;; decision, and they want different fixes.
;; COMPILE-WITH[--ir-target=spv --hardware-profile=bmg]
(def-hardware-profile bmg :simd-width 16 :mma-shapes ((8 16 8) (8 16 16)))
(def-type a-mat (matrix bfloat16 :address-space :global :align :compact :contiguous-term :row-major))
(def-type c-mat (matrix float :address-space :global :align :compact :contiguous-term :row-major))

(def-kernel lowering_unknown (A &out C)
  (declare #'(a-mat &out c-mat)
           (mma-lowering :cuda-tensor-core)
           (global-size :derive-from C :strategy :strided)
           (local-size :set-to 16))
  (set! (~ C 0 0) 1.0))
