;; CHECK-FAIL: "Cannot operate on Q-C and CHAR"
;; Endeavour 202 -- :subst :no refuses the original type through a handle too.
(def-derived-type q-c char :subst :no)
(def-type qc (cell q-c :address-space :global))
(def-type cc (cell char :address-space :global))

(def-kernel k (a b &out r)
  (declare #'(qc cc &out qc => nil))
  (set! (~ r) (+ (~ a) (~ b))))
