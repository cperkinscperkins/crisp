;; TEST-EXPECT: PASS
;; Endeavour 202 -- comparison on derived values read through a cell.
(def-derived-type q-c char :subst :no)
(def-type qc (cell q-c :address-space :global))
(def-type ic (cell int :address-space :global))

(def-kernel k (a b &out r)
  (declare #'(qc qc &out ic => nil))
  (set! (~ r) (if (< (~ a) (~ b)) 1 0)))
