;; TEST-EXPECT: PASS
;; TEST-WITH[--hardware-profile=bmg --ir-target=spv]
;;
;; ENDEAVOUR 180 / BUG 107 -- a module with more than 100 metadata nodes still compiles to SPIR-V.
;; inject-spir-kernel-metadata used to number the OpenCL kernel-arg metadata from a fixed !100, so a
;; module already past !99 got a duplicate id and llvm-as refused it ("Metadata id is already used").
;; Every annotated loop adds a distinct loop ID, so 110 of them push the module well past 100.
;; (--debug reached the same failure through debug-info nodes.)

(def-type in-vec (vector float :address-space :global :align :compact))
(def-type out-c  (cell float :address-space :global))

(def-kernel many_loops (A &out out)
  (declare #'(in-vec &out out-c => nil))
  (let ((acc 0.0))
    (dotimes (k0 4) (declare (unroll 2)) (set! acc (+ acc (~ A k0))))
    (dotimes (k1 4) (declare (unroll 2)) (set! acc (+ acc (~ A k1))))
    (dotimes (k2 4) (declare (unroll 2)) (set! acc (+ acc (~ A k2))))
    (dotimes (k3 4) (declare (unroll 2)) (set! acc (+ acc (~ A k3))))
    (dotimes (k4 4) (declare (unroll 2)) (set! acc (+ acc (~ A k4))))
