;; TEST-EXPECT: PASS
;; TEST-WITH[--ir-target=spv --differentiate]
;; TODO[112-phase-1c.2.f]: enable VERIFY-AUTODIFF once the L0 runner can
;;   bind :local-addrspace scratch vector descriptors (tile + tile_ADJ).
;;   With the L0 port complete, the underlying ABI issue is no longer
;;   "kernel rejects args" but "kernel runs with NULL/zero scratch ptrs
;;   and silently produces zero gradients."

;; Sub-step 1c: AD of load-tile-coords / store-tile-coords (identity path).
;;
;; Forward kernel: C = A (copy through a local tile).
;;   tile  ← A[0..3]   via load-tile-coords
;;   C[0..3] ← tile    via store-tile-coords
;;
;; Backward computes df/dA[k] = 1.0 for each k:
;;   - tile_ADJ ← C_GRAD          via %store-tile-coords-bwd (plain accumulate)
;;   - A_GRAD  += tile_ADJ        via %load-tile-coords-bwd  (atomic-add!)
;;
;; Compile-only verification.  Both forward and backward kernels compile;
;; backward IR contains the atomic-add scatter into A_GRAD.  Runtime
;; VERIFY-AUTODIFF deferred: the backward kernel signature includes two
;; :local-addrspace scratch vector descriptors (`tile` and the AD-minted
;; `tile_ADJ` shadow) that the verify-autodiff runner does not yet know
;; how to bind.  Tracked in the 112 endeavor's Phase 1c.2.f section.

(def-type vec-t (vector float :address-space :global :align :compact))

(def-kernel ad_identity_via_tile_1d (A &out C)
  (declare #'(vec-t &out vec-t => nil)
           (global-size :set-to 4)
           (local-size  :set-to 4))
  (let ((tile (make-scratch-vector float 4)))
    (load-tile-coords A tile (0))
    (store-tile-coords tile C (0))))
