;; Deliberate confirmation of GRID vs ABSOLUTE tile coordinates — 3-D.
;;
;; load-tile scales EACH grid coord by that dimension's tile extent; load-tile-at is absolute.
;; V is a 4x4x4 iota tensor (V[i][j][k] = i*16 + j*4 + k), tile is 2x2x2, coordinate (1 1 1):
;;   load-tile    V t (1 1 1) -> block at (1*2,1*2,1*2)=(2,2,2): t[0][0][0..1] = V[2][2][2..3] = [42,43]
;;   load-tile-at V t (1 1 1) -> block at (1,1,1):               t[0][0][0..1] = V[1][1][1..2] = [21,22]
;; All THREE dimensions are scaled by the tile extent (2) for the grid form: coord (1 1 1) lands
;; on element (2,2,2)=42 for grid vs (1,1,1)=21 for absolute — demonstrably distinct.
;;
;; TEST-HOIST[L0]: validate-l0-host-run
;; TEST-HOIST[CUDA]: validate-cuda-host-run
;; HOIST-EXPECT: BUFFER out: 42 43 21 22

(def-type vol-t (tensor ulong 3 :address-space :global :align :compact))
(def-type vec-t (vector ulong :address-space :global :align :compact))

(def-kernel grid_vs_abs_3d (V &out OUT)
  (declare #'(vol-t &out vec-t => nil)
           (global-size :set-to 4)
           (local-size  :set-to 4))
  (let ((tileG (make-scratch-tensor ulong 3 (2 2 2)))
        (tileA (make-scratch-tensor ulong 3 (2 2 2))))
    (load-tile    V tileG (1 1 1))    ; GRID (1,1,1)     -> V[2][2][2..3] = [42,43]
    (load-tile-at V tileA (1 1 1))    ; ABSOLUTE (1,1,1) -> V[1][1][1..2] = [21,22]
    (set! (~ OUT (to-ulong 0)) (~ tileG 0 0 0))
    (set! (~ OUT (to-ulong 1)) (~ tileG 0 0 1))
    (set! (~ OUT (to-ulong 2)) (~ tileA 0 0 0))
    (set! (~ OUT (to-ulong 3)) (~ tileA 0 0 1))))
