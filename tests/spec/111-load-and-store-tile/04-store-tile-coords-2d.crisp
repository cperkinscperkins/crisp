;; TEST-EXPECT: PASS
;; TEST-WITH[--ir-target=spv]

;; Basic store-tile-at on a 2D matrix.  Fill a 4x4 :local tile with
;; (ly * 10 + lx) via workgroup-stride, then store back to global at
;; origin (0,0).  Expected: OUT[y][x] == y*10 + x.

(def-type mat-t  (matrix ulong :address-space :global :align :compact))
(def-type tile-t (matrix ulong :address-space :local  :align :compact))

(def-kernel stc_basic_2d (&out OUT)
  (declare #'(&out mat-t => nil)
           (global-size :set-to '(4 4))
           (local-size  :set-to '(4 4)))
  (let ((tile (make-scratch-matrix ulong 4)))
    (workgroup-stride tile (ly lx)
      (set! (~ tile ly lx) (+ (* ly (to-ulong 10)) lx)))
    (store-tile-at tile OUT (0 0))))
