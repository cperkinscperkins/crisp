;; TEST-EXPECT: FAIL
;; CHECK-FAIL: "divergent"

;; Bare load-tile inside a divergent (when ...) inside a tile-stride.
;; The body walker rewrites the bare form to (load-tile-coords ...) using
;; the tile-stride binding as origin.  The analyzer then fires the
;; divergence check and rejects.  Verifies both the bare-form path and
;; the divergence detection in one test.

(def-type vec-t  (vector ulong :address-space :global :align :compact))
(def-type tile-t (vector ulong :address-space :local  :align :compact))

(def-kernel bare_load_in_divergent_when (V &out OUT)
  (declare #'(vec-t &out vec-t => nil)
           (global-size :set-to 4)
           (local-size  :set-to 4))
  (let ((tile (make-scratch-vector ulong 4)))
    (tile-stride V (4) (orig)
      (when (= (get-local-id 0) (to-ulong 0))
        (load-tile V tile))
      (workgroup-stride tile (lx)
        (set! (~ OUT (+ orig lx)) (~ tile lx))))))
