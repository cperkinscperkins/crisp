;; TEST-EXPECT: FAIL
;; CHECK-FAIL: "warp-idx"

;; load-tile is a workgroup-cooperative primitive (ends with local-barrier
;; over all workgroup threads).  Using it inside hardware-stride :warp-idx
;; — where only one warp processes each chunk — would deadlock at the
;; barrier (other warps in the workgroup don't hit it).  The compiler
;; should reject this with a clear error pointing the user toward a future
;; warp-cooperative primitive.

(def-type vec-t  (vector ulong :address-space :global :align :compact))
(def-type tile-t (vector ulong :address-space :local  :align :compact))

(def-kernel hw_load_in_warp (V &out OUT)
  (declare #'(vec-t &out vec-t => nil)
           (global-size :set-to 32)
           (local-size  :set-to 32))
  (let ((tile (make-scratch-vector ulong 32)))
    (hardware-stride V :warp-idx (orig)
      (load-tile V tile))))
