;; TEST-EXPECT: FAIL
;; CHECK-FAIL: "divergent"

;; load-tile-at inside a thread-divergent (when ...) would cause some
;; threads to enter the cooperative loop + sync-workgroup and others to skip,
;; deadlocking at the barrier.  The compiler should reject this.

(def-type vec-t  (vector ulong :address-space :global :align :compact))
(def-type tile-t (vector ulong :address-space :local  :align :compact))

(def-kernel ltc_in_divergent_when (V &out OUT)
  (declare #'(vec-t &out vec-t => nil)
           (global-size :set-to 4)
           (local-size  :set-to 4))
  (let ((tile (make-scratch-vector ulong 4)))
    ;; Divergent: condition is per-thread (get-local-id 0).
    (when (= (get-local-id 0) (to-ulong 0))
      (load-tile-at V tile (0)))
    (workgroup-stride tile (lx)
      (set! (~ OUT lx) (~ tile lx)))))
