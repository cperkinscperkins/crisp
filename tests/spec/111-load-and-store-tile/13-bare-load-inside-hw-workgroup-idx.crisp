;; TEST-EXPECT: PASS
;; TEST-WITH[--ir-target=spv]
;; SKIP-WITH[--differentiate]: "AD rules for load-tile-coords land in sub-step 1c"

;; Sub-step 1b: bare load-tile inside hardware-stride :workgroup-idx.
;; Same rewrite mechanism as tile-stride; the binding sym (orig) is
;; injected as the origin coord list.

(def-type vec-t  (vector ulong :address-space :global :align :compact))
(def-type tile-t (vector ulong :address-space :local  :align :compact))

(def-kernel hw_bare_load (V &out OUT)
  (declare #'(vec-t &out vec-t => nil)
           (global-size :set-to 4)
           (local-size  :set-to 4))
  (let ((tile (make-scratch-vector ulong 4)))
    (hardware-stride V :workgroup-idx (orig)
      (load-tile V tile)
      (workgroup-stride tile (lx)
        (set! (~ OUT (+ orig lx)) (~ tile lx))))))
