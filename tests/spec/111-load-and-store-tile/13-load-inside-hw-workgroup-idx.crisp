;; TEST-EXPECT: PASS
;; TEST-WITH[--ir-target=spv]

;; load-tile inside hardware-stride :workgroup-idx.  The binding (grid-x) is a
;; GRID term (chunk-ID); load-tile scales it by the tile extent.  When the body
;; indexes OUT by hand it must do the same scaling — element = grid-x*chunk + lx
;; (endeavor 135).  Here it's single-chunk (chunk = local-size = 4, V = 4), so
;; grid-x = 0, but the scaled form is written to be correct for any chunk count.

(def-type vec-t  (vector ulong :address-space :global :align :compact))
(def-type tile-t (vector ulong :address-space :local  :align :compact))

(def-kernel hw_bare_load (V &out OUT)
  (declare #'(vec-t &out vec-t => nil)
           (global-size :set-to 4)
           (local-size  :set-to 4))
  (let ((tile (make-scratch-vector ulong 4)))
    (hardware-stride V :workgroup-idx (grid-x)
      (load-tile V tile (grid-x))
      (workgroup-stride tile (lx)
        (set! (~ OUT (+ (* grid-x (get-local-work-size 0)) lx)) (~ tile lx))))))
