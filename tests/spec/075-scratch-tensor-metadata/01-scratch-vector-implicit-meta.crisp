;; SKIP-WITH[--differentiate]: "scratch tensor not yet differentiated"
;; TEST-WITH[--metadata]: crisp.compiler::validate-075-01-scratch-vector-implicit-meta
;;
;; Validates the .metacrisp output for a kernel that carries a scratch vector
;; through an implicit side channel.
;;
;; Expected metacrisp for kernel_a:
;;   :physical-signature — 7 fully-exploded scalars:
;;     (0 (C-POINTER :ADDRESS-SPACE :LOCAL))   ; scratch ptr (local addrspace)
;;     (1 ULONG)                               ; byte-size
;;     (2 ULONG)                               ; offset[0]
;;     (3 ULONG)                               ; strides[0]
;;     (4 ULONG)                               ; extents[0]
;;     (5 ULONG)                               ; length
;;     (6 INT)                                 ; explicit n
;;
;;   :implicit-params — one entry with:
;;     :type      (tensor int 1 :address-space :local :align :compact)
;;     :size-expr :match-warp-tile     ; whatever the user passed to make-scratch-vector
;;     :range     (0 5)   ; 6 physical slots (3N+3 = 3*1+3 = 6)
;;
;;   :declared-signature — explicit n at range (6 6)
;;
;; Call tree: kernel_a => fun-B => fun-C!!! => fun-D(sv) => fun-E(sv)

(def-type sc-vec-int (vector int :address-space :local :align :compact))

(def-function fun-e-meta (sv n)
    (declare #'(sc-vec-int int => int))
  (+ n (~ sv 0)))

(def-function fun-d-meta (sv n)
    (declare #'(sc-vec-int int => int))
  (+ 1 (fun-e-meta sv n)))

(def-function fun-c-meta (n)
    (declare #'(int => int))
  (let ((sv (make-scratch-vector int :match-warp-tile)))
    (fun-d-meta sv n)))

(def-function fun-b-meta (n)
    (declare #'(int => int))
  (fun-c-meta n))

(def-kernel kernel_a (n)
    (declare #'(int))
  (fun-b-meta n))
