;; Endeavor 142 Phase A CAPSTONE — register-resident MMA on Intel BMG.
;; Block-load A[16x8] and B[8x16] from global straight into register-tiles (Subgroup2DBlockLoadINTEL),
;; then one DPAS via mma-accumulate-via-tile reads those register operands (no re-load from SLM),
;; and store C[16x16].  This is the SYNCHRONOUS baseline (no ring, no prefetch) that the Phase-B
;; pipeline builds on.  Differs from 133-mma-spv/11 (which hands global A/B to the mma directly) by
;; staging the operands explicitly in the GRF first — the split that later lets us pipeline the loads.
;;
;; COMPILE-WITH[--hardware-profile=bmg --ir-target=spv]: PASS
;; COMPILE-WITH[--hardware-profile=bmg --ir-target=spv --differentiate]: PASS
;; SKIP-DEFAULT-PASS
;; SKIP-WITH[--debug]: "pre-existing --debug c-t-accessor codegen bug (plan/bugs.md #033)"
;;
;; On-metal correctness (host-reference C = A.B via the hoist's --mma-test):
;; MMA-DIMS: 16 16 8
;; HOIST-HARDWARE-PROFILE: bmg
;; TEST-HOIST[L0]: validate-l0-mma-run
;; HOIST-EXPECT: MMA_CORRECT
;;
;; Endeavor 146 Gap 4 — the NUMERIC gradient proof, and the thesis stated as a measurement.
;; This kernel is the REGISTER-RESIDENT twin of 145/12: same f(A,B) = sum(A.B), same shapes,
;; same Kt=8 (so the same scalar lowering), differing ONLY in where the operands are staged —
;; GRF here, SLM there.  Staging is a schedule, not mathematics, so the gradient must be the
;; SAME NUMBER.  dA[m,k] = sum_n B[k,n]; with B[i][j] = 0.01*(i*16+j),
;;     dA[1,0] = 0.01 * sum_{n=0..15} n = 1.2
;; which is exactly 145/12's expectation.
;; VERIFY-AUTODIFF: A=16x8@0:0.01 B=8x16@0:0.01 at.A=1,0 group=16 h=0.5 atol=2e-2 expect.A=1.2 output-mat=16x16

(def-hardware-profile bmg :simd-width 16 :mma-shapes ((8 16 8)))

(def-type a-mat (matrix float :address-space :global :align :compact :contiguous-term :row-major))
(def-type b-mat (matrix float :address-space :global :align :compact :contiguous-term :row-major))
(def-type c-mat (matrix float :address-space :global :align :compact :contiguous-term :row-major))

(def-kernel matmul (A B &out C)
  (declare #'(a-mat b-mat &out c-mat)
           (global-size :set-to 16) (local-size :set-to 16))
  (let ((A-tile (make-register-tile float (16 8) 0.0 :operand :a))    ; Use-0 A fragments
        (B-tile (make-register-tile float (8 16) 0.0 :operand :b))    ; Use-1 B fragments
        (C-tile (make-register-tile float (16 16) 0.0)))             ; Use-2 accumulator (default)
    (load-tile A A-tile (0 0))                              ; global -> GRF (per-fragment load, Phase A)
    (load-tile B B-tile (0 0))
    (mma-accumulate-via-tile (8 16 8) C-tile A-tile B-tile) ; DPAS on the register-resident operands
    (store-tile C-tile C (0 0))))
