;; Endeavor 142 (Intel MMA prefetch) Phase A — load-tile OVERLOADED on a register-tile destination.
;; When the dest of load-tile is a make-register-tile (not a scratch-matrix), on the SPV/Intel target
;; it lowers to Subgroup2DBlockLoadINTEL: a hardware-async block load global -> GRF, tracked by the
;; hardware scoreboard (NO :barrier — that's a NVIDIA SLM-staging concept).  This is the dispatch-on-
;; destination decision (Q2).  Compile-only here: 01 loads + verifies C=A.B on BMG.
;;
;; The Intel register-pipeline forms REQUIRE a hardware profile (02 covers the no-profile error).
;;
;; COMPILE-WITH[--hardware-profile=bmg --ir-target=spv]: PASS
;; SKIP-DEFAULT-PASS
;; SKIP-WITH[--differentiate]: "forward-only block load / MMA"
;; SKIP-WITH[--debug]: "pre-existing --debug c-t-accessor codegen bug (plan/bugs.md #033)"
;;
;; TODO(green): strengthen to an IR-grep validator (validate-spv-block-load) asserting the
;; Subgroup2DBlockLoad opcode actually appears — PASS alone could hide a cooperative-loop fallback.

(def-hardware-profile bmg :simd-width 16 :mma-shapes ((8 16 8)))

(def-type mat (matrix float :address-space :global :align :compact :contiguous-term :row-major))

(def-kernel block_load (A &out C)
  (declare #'(mat &out mat) (global-size :set-to 16) (local-size :set-to 16))
  (let ((A-tile (make-register-tile float (16 8) 0.0)))
    (load-tile A A-tile (0 0))       ; global A[16x8] -> GRF via Subgroup2DBlockLoadINTEL (no :barrier)
    (store-tile A-tile C (0 0))))    ; keep A-tile live so the load isn't dead-code-eliminated
