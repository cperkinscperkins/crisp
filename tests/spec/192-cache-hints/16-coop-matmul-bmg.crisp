;; COMPILE-WITH[--hardware-profile=bmg --ir-target=spv]: PASS
;; SKIP-DEFAULT-PASS
;; TEST-WITH[--ir-target=spv --hardware-profile=bmg] : validate-spv-cache-coop-streaming
;;
;; Endeavour 192.  Intel block / cooperative-matrix operations honour the TYPE-level hint: the global
;; pointers of the XMX operand loads (and the C store) carry CacheControlLoadINTEL / StoreINTEL
;; Streaming, decorated on the pointer's defining instruction (the placement IGC accepted in the
;; 2026-08-27 probe).  Kernel and on-metal expectation are 133/11's.
;;
;; MMA-DIMS: 16 16 8
;; HOIST-HARDWARE-PROFILE: bmg
;; TEST-HOIST[L0]: validate-l0-mma-run
;; HOIST-EXPECT: MMA_CORRECT

(def-hardware-profile bmg :simd-width 16 :mma-shapes ((8 16 8)))

(def-type a-mat (matrix float :address-space :global :align :compact :contiguous-term :row-major :cache :streaming))
(def-type b-mat (matrix float :address-space :global :align :compact :contiguous-term :row-major :cache :streaming))
(def-type c-mat (matrix float :address-space :global :align :compact :contiguous-term :row-major :cache :streaming))

(def-kernel cache_coop_matmul (A B &out C)
  (declare #'(a-mat b-mat &out c-mat)
           (global-size :set-to 16) (local-size :set-to 16))
  (let ((C-tile (make-register-tile float (16 16) 0.0)))
    (mma-accumulate-via-tile (8 16 8) C-tile A B)
    (store-tile C-tile C (0 0))))
