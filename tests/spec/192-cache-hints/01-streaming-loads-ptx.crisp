;; TEST-EXPECT: PASS
;; TEST-WITH[--ir-target=ptx --ir-target-arch=sm_90] : validate-ptx-cache-streaming-loads
;;
;; Endeavour 192.  `:cache :streaming` on the INPUT types: every load of A and B is
;; ld.global[.nc].L1::no_allocate.L2::evict_first, the store to C (no :cache) carries no hint, and the
;; module's PTX ISA is >= 7.4 (eviction priorities need it).

(def-type s-vec (vector float :address-space :global :align :compact :cache :streaming))
(def-type f-vec (vector float :address-space :global :align :compact))

(def-kernel cache_stream_loads (A B &out C)
  (declare #'(s-vec s-vec &out f-vec => nil)
           (global-size :derive-from A :strategy :strided))
  (loop-vector-stride A (i)
    (set! (~ C i) (+ (~ A i) (~ B i)))))
