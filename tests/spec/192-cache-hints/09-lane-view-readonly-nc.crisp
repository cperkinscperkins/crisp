;; TEST-EXPECT: PASS
;; TEST-WITH[--ir-target=ptx --ir-target-arch=sm_90] : validate-ptx-view-loads-nc
;;
;; Endeavour 192 / BUG 134.  No :cache at all: a float4 view of a read-only input, used lane by lane.
;; Codegen tags the view load !invariant.load, but -O3 narrows it to scalar lane loads and drops the
;; tag, so before 192 these were plain ld.global.v4.  The post-opt pass re-applies !invariant.load to
;; loads traced to a read-only argument: every load here is ld.global.nc.

(def-type f-vec (vector float :address-space :global :align :compact))

(def-kernel lane_view_readonly (A &out C)
  (declare #'(f-vec &out f-vec => nil)
           (global-size :derive-from A :strategy :strided))
  (let ((n  (length~ A))
        (n4 (/ n 4ul))
        (a4 (make-vector A float4 :length n4)))
    (loop-vector-stride a4 (i)
      (let ((v (~ a4 i)))
        (set! (~ C i) (+ (+ (x~ v) (y~ v)) (+ (z~ v) (w~ v))))))))
