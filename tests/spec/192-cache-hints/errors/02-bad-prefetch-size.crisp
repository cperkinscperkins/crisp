;; CHECK-FAIL: ":prefetch must be 64, 128 or 256"
;;
;; Endeavour 192.  the L2 prefetch size is one of the hardware's three (L2::64B / 128B / 256B).

(def-type e-vec (vector float :address-space :global :align :compact :cache (:streaming :prefetch 100)))
(def-type o-vec (vector float :address-space :global :align :compact))

(def-kernel refused_one (A &out B)
  (declare #'(e-vec &out o-vec => nil)
           (global-size :derive-from A :strategy :strided))
  (loop-vector-stride A (i)
    (set! (~ B i) (~ A i))))
