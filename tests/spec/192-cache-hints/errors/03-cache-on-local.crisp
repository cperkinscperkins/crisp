;; CHECK-FAIL: ":cache does not apply to :local"
;;
;; Endeavour 192.  L1/L2 hints mean nothing for shared (:local) memory; refuse rather than silently drop.

(def-type e-vec (vector float :address-space :local :align :compact :cache :streaming))
(def-type o-vec (vector float :address-space :global :align :compact))

(def-kernel refused_one (A &out B)
  (declare #'(e-vec &out o-vec => nil)
           (global-size :derive-from A :strategy :strided))
  (loop-vector-stride A (i)
    (set! (~ B i) (~ A i))))
