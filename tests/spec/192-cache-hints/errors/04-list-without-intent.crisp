;; CHECK-FAIL: ":cache list must start with an intent"
;;
;; Endeavour 192.  the list form is (INTENT :prefetch N); write (:default :prefetch 256) for prefetch alone.

(def-type e-vec (vector float :address-space :global :align :compact :cache (:prefetch 256)))
(def-type o-vec (vector float :address-space :global :align :compact))

(def-kernel refused_one (A &out B)
  (declare #'(e-vec &out o-vec => nil)
           (global-size :derive-from A :strategy :strided))
  (loop-vector-stride A (i)
    (set! (~ B i) (~ A i))))
