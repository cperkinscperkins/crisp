;; TEST-WITH[--metadata]: validate-placeholder

(def-type in-ish (cell float :address-space :global :access :read-only))
(def-type out-ish (cell float :address-space :global :access :write-only))

(def-kernel cell_mult (A B &out C)
  (declare #'(in-ish in-ish &out out-ish))
  (set! (~ C) (* (~ A) (~ B))))

;; we expect the backward kernel to be named cell_mult_grad
;; and we expect the signature to be (A B C C_grad &out A_grad B_grad)
