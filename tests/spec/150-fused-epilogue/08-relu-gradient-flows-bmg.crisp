;; Endeavor 150 rung 8 — a FUSED ACTIVATION DIFFERENTIATES: gradient flows where the
;; pre-activation is above the kink.  Numeric on-metal check, Intel BMG.
;;
;; TDD: expected to FAIL until P0/P1 (the primitive) and P2 (its VJP) exist.
;;
;; PAIR THIS RUNG WITH 09.  On its own it is NECESSARY BUT NOT SUFFICIENT, and it is important
;; to be honest about why: it probes a point where the activation is saturated ON, so the
;; correct answer is the SAME 1.2 that the un-fused 145/09 produces at the same kind of point.
;; An implementation that simply IGNORED the activation in the backward would also print 1.2.
;; Rung 09 is the discriminator — same kernel, same data, a point below the kink, where the
;; correct answer is 0.0 and "ignored the activation" gives 1.2.  Neither rung means much
;; alone; together they pin the derivative on both sides.
;;
;; WHY THE PAIR IS ALSO THE ANSWER TO THE ZERO-SEED HAZARD.  A rung whose expectation is 0.0
;; passes trivially if the whole harness is returning zeros (the trap 145 P2 documented).  This
;; rung is 09's control: same kernel, same launch, a NON-ZERO expectation.
;;
;; ============================ CHOOSING THE PROBE POINT ============================
;; The kink is the whole difficulty: finite differences straddling a discontinuous derivative
;; are meaningless, so the threshold must sit far from every value the FD can reach.
;;
;; With A[m][k] = 0.01*(16m+k) and B[k][n] = 0.01*(16k+n), summing k = 0..15:
;;
;;     C[m][n] = 1e-4 * (30720m + 256mn + 19840 + 120n)
;;
;; which separates cleanly by output ROW:
;;
;;     row 0:  1.984 .. 2.164
;;     row 1:  5.056 .. 5.620      <- entirely BELOW the threshold  (rung 09 probes here)
;;     row 2:  8.128 .. 9.076      <- entirely ABOVE the threshold  (this rung probes here)
;;     row 7: 23.488 .. 26.356
;;
;; A threshold of 7.0 lands in the gap: 1.38 above row 1's maximum, 1.128 below row 2's
;; minimum.  Perturbing A[m][0] by h=0.5 moves C[m][n] by at most 0.5 * max_n B[0][n] = 0.075,
;; so NOTHING crosses the kink and the FD measures the same branch the analytical side does.
;; That is why h can stay at 145/09's 0.5 rather than being shrunk into fp32 noise.
;; =================================================================================
;;
;; THE CHECK.  f(A,B) = sum(g(A.B)) with g(x) = max(x - 7, 0), so
;;     dA[m,k] = sum_n g'(C[m][n]) * B[k][n]
;; At m=2 every C[2][n] > 7, so every g' = 1 and
;;     dA[2,0] = sum_{n=0..15} 0.01*n = 1.2
;; `expect.A` pins the ABSOLUTE value, so this is not merely FD-vs-analytical agreement (which
;; can pass with both sides wrong in the same way) — it is the same 1.2 that 145/09 computes
;; without an activation, which is exactly right: a saturated-on ReLU is transparent.
;;
;; Kt=16 with a native K of 8 means via-tile walks TWO K-steps inside this ONE call (145 P3a),
;; so `acc` after (accum-op) is the COMPLETE contraction and fusing on it is correct.  Contrast
;; errors/07, where the K-loop is the MACRO's and acc would be a partial sum.
;;
;; COMPILE-WITH[--hardware-profile=bmg --ir-target=spv]: PASS
;; SKIP-DEFAULT-PASS
;; HOIST-HARDWARE-PROFILE: bmg
;; VERIFY-AUTODIFF: A=8x16@0:0.01 B=16x16@0:0.01 at.A=2,0 group=16 h=0.5 atol=2e-2 expect.A=1.2 output-mat=8x16

(def-hardware-profile bmg :simd-width 16 :mma-shapes ((8 16 8)))

(def-type a-mat (matrix float :address-space :global :align :compact :contiguous-term :row-major))
(def-type b-mat (matrix float :address-space :global :align :compact :contiguous-term :row-major))
(def-type c-mat (matrix float :address-space :global :align :compact :contiguous-term :row-major))

;; The activation under test.  An ordinary Crisp function — the AD engine must walk INTO it and
;; produce its derivative (a step function), not treat it as an opaque callee.
(def-function shifted-relu-7 (x)
  (declare #'(float => float))
  (let ((y (- x 7.0)))
    (if (> y 0.0) y 0.0)))

(def-kernel relu_grad_flows (A B &out C)
  (declare #'(a-mat b-mat &out c-mat)
           (global-size :set-to 16)
           (local-size  :set-to 16))
  (let ((A-tile (make-scratch-matrix float (8 16)))    ; Mt x Kt
        (B-tile (make-scratch-matrix float (16 16)))   ; Kt x Nt
        (C-tile (make-register-tile float (8 16) 0.0)))
    (load-tile-at A A-tile (0 0))
    (load-tile-at B B-tile (0 0))
    (sync-workgroup)
    (mma-accumulate-via-tile (8 16 8) C-tile A-tile B-tile (acc)
      (accum-op)                                       ; both K-steps -> acc is COMPLETE
      (map-elements! acc #'shifted-relu-7))
    (store-tile C-tile C (0 0))))
