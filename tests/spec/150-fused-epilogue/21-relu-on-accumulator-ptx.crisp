;; Endeavor 150 rung 21 — NVIDIA twin of rung 04: a real ACTIVATION fused on the accumulator,
;; checked against hand-computed values on metal.
;;
;; THE SAME TRAP APPLIES, and for the same reason: the MMA harness fills A[i] = i%5 and
;; B[i] = i%3 (src/hoist-cuda/main.lisp:812 — byte-identical to the L0 hoist's fill), both
;; NON-NEGATIVE, so A.B >= 0 everywhere and a plain relu would be the IDENTITY on this data.
;; The activation therefore carries its own threshold, exactly as in rung 04.
;;
;; THE ARITHMETIC.  A is 16x8 and B is 8x8, and B IS INDEXED ROW-MAJOR — 8k + j — even though
;; b-mat is declared :col-major.  That was MEASURED on an H100, not assumed: the first version
;; of this spec predicted a col-major index (k + 8j) and was wrong, which is exactly what the
;; hand-computed expectation is for.  See the note below.
;;
;;     A[0][k] = k % 5              -> [0, 1, 2, 3, 4, 0, 1, 2]
;;     B[k][j] = (8k + j) % 3
;;
;;     C[0][0] = 0*0 + 1*2 + 2*1 + 3*0 + 4*2 + 0*1 + 1*0 + 2*2 = 16
;;     C[0][1] = 0*1 + 1*0 + 2*2 + 3*1 + 4*0 + 0*2 + 1*1 + 2*0 =  8
;;     C[0][2] = 0*2 + 1*1 + 2*0 + 3*2 + 4*1 + 0*0 + 1*2 + 2*1 = 15
;;
;; so the pre-activation row is 16, 8, 15 repeating.  After relu(x - 12): 16 -> 4, 8 -> 0,
;; 15 -> 3.
;;
;;     epilogue never fired      -> 16 8 15
;;     plain relu, no threshold  -> 16 8 15   (identical — hence the shift)
;;     correct                   ->  4 0  3
;;
;; NOTE ON THE LAYOUT, recorded because it is counter-intuitive and cost one pod cycle.  The
;; declared :col-major on b-mat selects the MMA variant; it does NOT change the stride the test
;; harness lays B out with, which is row-major.  Nothing is inconsistent — the kernel and the
;; --mma-test host reference use the SAME strides, which is why rungs 01 and 20 report
;; MMA_CORRECT — but a hand-computed expectation has to follow the strides actually in use,
;; not the declared contiguous-term.
;;
;; All values are small integers, exact in fp32 and in tf32's 10-bit mantissa, so there is no
;; tolerance question.
;;
;; COMPILE-WITH[--ir-target=ptx]: PASS
;; COMPILE-WITH[--ir-target=ptx --differentiate]: PASS
;; TEST-WITH[--ir-target=ptx]
;; SKIP-DEFAULT-PASS
;;
;; NOTE: MMA_WRONG will appear in this spec's output and is EXPECTED — the harness always emits
;; its C = A.B reference under --mma-test and this kernel deliberately computes something else.
;; Only the BUFFER expectation below is asserted.
;;
;; MMA-DIMS: 16 8 8
;; TEST-HOIST[CUDA]: validate-cuda-mma-run
;; HOIST-EXPECT: BUFFER c: 4 0 3

(def-type a-mat (matrix float :address-space :global :align :compact :contiguous-term :row-major))
(def-type b-mat (matrix float :address-space :global :align :compact :contiguous-term :col-major))
(def-type c-mat (matrix float :address-space :global :align :compact :contiguous-term :row-major))

;; Identical source to rung 04's activation — the SAME user code must fuse on both vendors.
(def-function shifted-relu (x)
  (declare #'(float => float))
  (let ((y (- x 12.0)))
    (if (> y 0.0) y 0.0)))

(def-kernel relu_on_acc_ptx (A B &out C)
  (declare #'(a-mat b-mat &out c-mat)
           (global-size :set-to 32)
           (local-size  :set-to 32))          ; one warp
  (let ((C-tile (make-register-tile float (16 8) 0.0)))
    (mma-accumulate-via-tile (16 8 8) C-tile A B (acc)
      (accum-op)                               ; K = 8 = ONE native step -> acc is COMPLETE
      (map-elements! acc #'shifted-relu))
    (store-tile C-tile C (0 0))))
