;; Endeavor 150 rung 9 — THE DISCRIMINATOR: the fused activation must BLOCK the gradient where
;; the pre-activation is below the kink.  Numeric on-metal check, Intel BMG.
;;
;; TDD: expected to FAIL until P0/P1 (the primitive) and P2 (its VJP) exist.
;;
;; THIS IS THE RUNG THAT MAKES RUNG 08 MEAN SOMETHING.  08 probes a point where the activation
;; is saturated ON, so its correct answer (1.2) is the same one an implementation that ignored
;; the activation entirely would print.  Here the correct answer is 0.0 and the
;; ignored-the-activation answer is 1.2 — the two rungs share a kernel and differ only in which
;; row they probe, so between them the derivative is pinned on BOTH sides of the kink.
;;
;; NOTE THE EXACT COINCIDENCE WITH 145/09.  That shipped spec probes at.A=1,0 on this same data
;; and expects 1.2.  This rung probes THE SAME POINT on THE SAME DATA and expects 0.0.  The
;; entire difference is the fused activation's derivative.  If this rung reports 1.2 it has
;; reproduced the un-fused answer, which is the single most likely failure mode and the reason
;; the probe point was chosen to collide with 145/09 rather than to avoid it.
;;
;; HONEST ABOUT THE WEAKNESS: an expectation of 0.0 passes trivially if the harness is returning
;; zeros for everything — the zero-seed hazard 145 P2 documented, and the reason a zero seed
;; could not settle the fragment layout question.  Rung 08 is the control for exactly this: same
;; kernel, same launch, same data, a NON-ZERO expectation.  Run them together or neither number
;; means much.
;;
;; WHY 0.0 IS THE RIGHT ANSWER.  f(A,B) = sum(g(A.B)) with g(x) = max(x - 7, 0), so
;;     dA[m,k] = sum_n g'(C[m][n]) * B[k][n]
;; Output row 1 spans C[1][n] = 5.056 .. 5.620, entirely BELOW the threshold of 7, so every
;; g'(C[1][n]) = 0 and the whole sum vanishes:
;;     dA[1,0] = 0.0
;; regardless of B — which is the point of an activation: it gates the gradient.
;;
;; The FD side agrees for the same reason and stays valid: perturbing A[1][0] by h=0.5 moves
;; C[1][n] by at most 0.075, so row 1's maximum reaches 5.695, still well below 7.  f does not
;; change at all, so the finite difference is a true 0 rather than a straddled kink.  (The full
;; derivation of the row bounds is in rung 08's header.)
;;
;; COMPILE-WITH[--hardware-profile=bmg --ir-target=spv]: PASS
;; SKIP-DEFAULT-PASS
;; HOIST-HARDWARE-PROFILE: bmg
;; VERIFY-AUTODIFF: A=8x16@0:0.01 B=16x16@0:0.01 at.A=1,0 group=16 h=0.5 atol=2e-2 expect.A=0.0 output-mat=8x16

(def-hardware-profile bmg :simd-width 16 :mma-shapes ((8 16 8)))

(def-type a-mat (matrix float :address-space :global :align :compact :contiguous-term :row-major))
(def-type b-mat (matrix float :address-space :global :align :compact :contiguous-term :row-major))
(def-type c-mat (matrix float :address-space :global :align :compact :contiguous-term :row-major))

;; Identical to rung 08's activation — the rungs differ ONLY in the probe point.
(def-function shifted-relu-7 (x)
  (declare #'(float => float))
  (let ((y (- x 7.0)))
    (if (> y 0.0) y 0.0)))

(def-kernel relu_grad_blocked (A B &out C)
  (declare #'(a-mat b-mat &out c-mat)
           (global-size :set-to 16)
           (local-size  :set-to 16))
  (let ((A-tile (make-scratch-matrix float (8 16)))    ; Mt x Kt
        (B-tile (make-scratch-matrix float (16 16)))   ; Kt x Nt
        (C-tile (make-register-tile float (8 16) 0.0)))
    (load-tile-at A A-tile (0 0))
    (load-tile-at B B-tile (0 0))
    (sync-workgroup)
    (mma-accumulate-via-tile (8 16 8) C-tile A-tile B-tile (acc)
      (accum-op)                                       ; both K-steps -> acc is COMPLETE
      (map-elements! acc #'shifted-relu-7))
    (store-tile C-tile C (0 0))))
