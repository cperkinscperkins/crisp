;; Endeavor 150 rung 24 — NVIDIA twin of rung 09, THE DISCRIMINATOR: the fused activation must
;; BLOCK the gradient where the pre-activation is below the kink.
;;
;; THIS IS THE RUNG THAT MAKES RUNG 23 MEAN SOMETHING.  23 probes where the activation is
;; saturated on, so its correct answer (0.28) is also what an implementation that ignored the
;; activation entirely would print.  Here the correct answer is 0.0 and the
;; ignored-the-activation answer is 0.28 — the two rungs share a kernel and differ only in which
;; row they probe, so between them the derivative is pinned on BOTH sides of the kink.
;;
;; AND THE WEAKNESS IS REAL, so state it: an expectation of 0.0 passes trivially if the harness
;; is returning zeros.  On Intel that was not hypothetical — the first working version of this
;; VJP recomputed the primal from the forward-staged tiles, which are EMPTY in a backward
;; kernel, so the primal came back all zeros, f'(0 - 5 < 0) = 0, and rung 09 went GREEN ON THE
;; BUG while its non-zero twin failed.  Run 23 and 24 together or neither number means much.
;;
;; WHY 0.0 IS THE RIGHT ANSWER.  f(A,B) = sum(g(A.B)) with g(x) = max(x - 5, 0), so
;;     dA[m,k] = sum_n g'(C[m][n]) * B[k][n]
;; Output row 1 spans C[1][n] = 2.528 .. 2.791, entirely BELOW the threshold of 5, so every
;; g'(C[1][n]) = 0 and the sum vanishes regardless of B — which is what an activation is for.
;; The FD agrees for the same reason: perturbing A[1][0] by h=1.0 moves C[1][n] by at most
;; 0.07, so row 1 tops out at 2.861, still far below 5, and f does not change at all.
;;
;; The full derivation of the row bounds and the shape/layout choices is in rung 23's header,
;; including what to suspect first if these come back wrong.
;;
;; COMPILE-WITH[--ir-target=ptx]: PASS
;; SKIP-DEFAULT-PASS
;; VERIFY-AUTODIFF[CUDA]: A=16x16@0:0.01 B=16x8@0:0.01 at.A=1,0 group=32 h=1.0 atol=2e-2 expect.A=0.0 output-mat=16x8

(def-type a-mat (matrix float :address-space :global :align :compact :contiguous-term :row-major))
(def-type b-mat (matrix float :address-space :global :align :compact :contiguous-term :row-major))
(def-type c-mat (matrix float :address-space :global :align :compact :contiguous-term :row-major))

;; Identical to rung 23's activation — the rungs differ ONLY in the probe point.
(def-function shifted-relu-5 (x)
  (declare #'(float => float))
  (let ((y (- x 5.0)))
    (if (> y 0.0) y 0.0)))

(def-kernel relu_grad_blocked_ptx (A B &out C)
  (declare #'(a-mat b-mat &out c-mat)
           (global-size :set-to 32)
           (local-size  :set-to 32))          ; exactly one warp
  (let ((A-tile (make-scratch-matrix float (16 16)))   ; Mt x Kt
        (B-tile (make-scratch-matrix float (16 8)))    ; Kt x Nt
        (C-tile (make-register-tile float (16 8) 0.0)))
    (load-tile-at A A-tile (0 0))
    (load-tile-at B B-tile (0 0))
    (sync-workgroup)
    (mma-accumulate-via-tile (16 8 8) C-tile A-tile B-tile (acc)
      (accum-op)                                       ; all K-steps -> acc is COMPLETE
      (map-elements! acc #'shifted-relu-5))
    (store-tile C-tile C (0 0))))
