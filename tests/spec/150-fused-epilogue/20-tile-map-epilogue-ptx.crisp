;; Endeavor 150 rung 20 — NVIDIA twin of rung 03: a whole register TILE mapped in the
;; :epilogue of a staged matrix-multiply-tile-stride.
;;
;; WHY A SEPARATE FILE RATHER THAN A FLAG.  The shapes genuinely diverge — NVIDIA tf32 is
;; (16 8 8) with B COL-major, Intel XMX is (8 16 8) with B row-major — and that divergence
;; lives in the kernel BODY, not in the macro.  Same split as 135/03 vs 135/04.
;;
;; THIS IS STILL THE PLACEMENT RUNG, for the same reason rung 03 is: MMA-DIMS 16 8 16 gives
;; K=16 walked in k-step 8, so there are TWO K-steps and the C-tile is a partial sum between
;; them.  With p1/p2 the two contributions, a correctly-placed epilogue gives 2*(p1+p2) while a
;; map wrongly spliced into the reduction body gives 4*p1 + 2*p2.  MMA-SCALE 2 separates them.
;; (Writing the map in the reduction body is now a compile-time refusal — see errors/07 — but
;; this rung still checks that the ACCEPTED placement lands where it should.)
;;
;; COMPILE-WITH[--ir-target=ptx]: PASS
;; COMPILE-WITH[--ir-target=ptx --differentiate]: PASS
;; TEST-WITH[--ir-target=ptx]
;; SKIP-DEFAULT-PASS
;;
;; C[16x8] = 2*(A[16x16].B[16x8]); NVIDIA tf32 shape (16 8 8), 2 K-steps through SLM.
;; MMA-DIMS: 16 8 16
;; MMA-SCALE: 2
;; TEST-HOIST[CUDA]: validate-cuda-mma-run
;; HOIST-EXPECT: MMA_CORRECT

(def-type a-mat (matrix float :address-space :global :align :compact :contiguous-term :row-major))
(def-type b-mat (matrix float :address-space :global :align :compact :contiguous-term :col-major))
(def-type c-mat (matrix float :address-space :global :align :compact :contiguous-term :row-major))

;; The same ordinary Crisp function rungs 01 and 03 fuse — unchanged across vendors.
(def-function double-val (x)
  (declare #'(float => float))
  (* x 2.0))

(def-kernel tile_map_epilogue_ptx (A B &out C)
  (declare #'(a-mat b-mat &out c-mat)
           (global-size :set-to 32)
           (local-size  :set-to 32))          ; one warp
  (let ((A-tile (make-scratch-matrix float (16 8)))    ; SLM: M x 8 (one K-step of A)
        (B-tile (make-scratch-matrix float (8 8)))     ; SLM: 8 x N (one K-step of B)
        (C-tile (make-register-tile float (16 8) 0.0))
        (K      (inner-dimension A B)))
    (matrix-multiply-tile-stride C C-tile K 8 (grid-y grid-x grid-k)
      (load-tile A A-tile (grid-y grid-k))
      (load-tile B B-tile (grid-k grid-x))
      (sync-workgroup)
      (mma-accumulate-via-tile (16 8 8) C-tile A-tile B-tile)
      (sync-workgroup)
      :epilogue
      ;; K-loop done — C-tile is COMPLETE.  The one correct site in the staged pattern.
      (map-elements! C-tile #'double-val)
      (store-tile C-tile C (grid-y grid-x)))))
