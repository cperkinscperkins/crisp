;; Endeavor 150 rung 3 — the SECOND fusion site: a whole register TILE, in the :epilogue.
;;
;; TDD: expected to FAIL until the P0/P1 primitive exists.  See rung 01 for the failure text
;; and the provisional-syntax note.
;;
;; WHAT THIS ADDS OVER RUNGS 1-2.  They fuse on `acc`, a single warp-collective FRAGMENT,
;; inside the via-tile body.  This fuses on `C-tile`, a whole REGISTER TILE, in the
;; :epilogue splice of matrix-multiply-tile-stride.  Same form, different altitude — which is
;; the endeavour's central design claim (one primitive, three sites) and the thing that would
;; quietly not be true if the fragment path and the tile path were built separately.
;;
;; THIS IS THE PLACEMENT RUNG, and that is why it is built on the STAGED pattern rather than
;; the simpler shape of rungs 1-2.  MMA-DIMS 8 16 16 gives K=16, and the macro walks it in
;; k-step 8 — so there are TWO K-steps, and the C-tile is a PARTIAL sum in between.  Write p1
;; and p2 for the two K-steps' contributions:
;;
;;     correct   (map runs ONCE, post-reduction, in the epilogue):
;;                 C = p1 + p2, then x2      ->  2*p1 + 2*p2      = MMA-SCALE 2   CORRECT
;;
;;     misplaced (map spliced into the REDUCTION body, per K-step):
;;                 k=0:  C = p1,        x2   ->  2*p1
;;                 k=1:  C = 2*p1 + p2, x2   ->  4*p1 + 2*p2                      MMA_WRONG
;;
;; Those differ whenever p1 is non-zero, so the host reference separates a correctly-placed
;; epilogue from one that ran per K-step.  A one-K-step kernel could not tell them apart, and
;; would pass with the placement wrong — the same trap 149's rung 05 was built to avoid.
;;
;; Note that x2 is LINEAR and still catches this.  A non-linear function would catch it too,
;; but would additionally be WRONG-BY-CONSTRUCTION in the misplaced case (see rung 07): fusing
;; an activation on a partial sum is the error this endeavour also makes a compile-time
;; refusal.  Using a linear function here keeps rung 03 about PLACEMENT and lets rung 07 be
;; about the refusal, one thing each.
;;
;; COMPILE-WITH[--hardware-profile=bmg --ir-target=spv]: PASS
;; COMPILE-WITH[--hardware-profile=bmg --ir-target=spv --differentiate]: PASS
;;   (RED until P2 — see rung 01's note on declaring the intended end state.)
;; SKIP-DEFAULT-PASS
;;
;; On-metal correctness via the hoist's --mma-test host reference:
;; C[8x16] = 2*(A[8x16].B[16x16]); Intel XMX shape (8 16 8), 2 K-steps through SLM.
;; MMA-DIMS: 8 16 16
;; MMA-SCALE: 2
;; HOIST-HARDWARE-PROFILE: bmg
;; TEST-HOIST[L0]: validate-l0-mma-run
;; HOIST-EXPECT: MMA_CORRECT

(def-hardware-profile bmg :simd-width 16 :mma-shapes ((8 16 8)))

(def-type a-mat (matrix float :address-space :global :align :compact :contiguous-term :row-major))
(def-type b-mat (matrix float :address-space :global :align :compact :contiguous-term :row-major))
(def-type c-mat (matrix float :address-space :global :align :compact :contiguous-term :row-major))

;; The same ordinary Crisp function rungs 01 and 02 fuse on a fragment, here fused on a tile.
(def-function double-val (x)
  (declare #'(float => float))
  (* x 2.0))

(def-kernel tile_map_epilogue (A B &out C)
  (declare #'(a-mat b-mat &out c-mat)
           (global-size :set-to 16)
           (local-size  :set-to 16))          ; one sub-group
  (let ((A-tile (make-scratch-matrix float (8 8)))     ; SLM: M x 8 (one K-step of A)
        (B-tile (make-scratch-matrix float (8 16)))    ; SLM: 8 x N (one K-step of B)
        (C-tile (make-register-tile float (8 16) 0.0))
        (K      (inner-dimension A B)))
    (matrix-multiply-tile-stride C C-tile K 8 (grid-y grid-x grid-k)
      (load-tile A A-tile (grid-y grid-k))
      (load-tile B B-tile (grid-k grid-x))
      (sync-workgroup)
      (mma-accumulate-via-tile (8 16 8) C-tile A-tile B-tile)
      (sync-workgroup)
      :epilogue
      ;; K-loop done — C-tile is COMPLETE.  This is the one correct place for a fused
      ;; epilogue in the staged pattern.
      (map-elements! C-tile #'double-val)
      (store-tile C-tile C (grid-y grid-x)))))
