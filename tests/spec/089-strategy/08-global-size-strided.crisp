;;
;; Metadata: (global-size :derive-from (n) :strategy :strided).

(def-type result-t (cell int :address-space :global))

(def-kernel global_strided (n &out result)
    (declare (type n ulong)
             (type result result-t)
             (global-size :derive-from (n) :strategy :strided))
  (set! (~ result) 0))
