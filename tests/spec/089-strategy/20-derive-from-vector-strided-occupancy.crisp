;; TEST-HOIST[L0]: validate-l0-strategy-content
;; STRATEGY-EXPECT: zeDeviceGetComputeProperties
;; STRATEGY-EXPECT: zeKernelGetProperties
;; STRATEGY-EXPECT: spillMemSize
;; SKIP-WITH[--differentiate]: "forward-only stride test"
;;
;; L0 :strided strategy must emit zeKernelGetProperties for register-pressure-aware
;; occupancy calculation (derate by 2x if kernel spilled to private memory).

(def-type in-vec-t  (vector float :address-space :global :align :compact))
(def-type out-cell-t (cell float :address-space :global))

(def-kernel l0_occupancy_test (input &out result)
  (declare #'(in-vec-t &out out-cell-t => nil))
  (declare (global-size :derive-from input :strategy :strided)
           (local-size  :set-to 128))
  (set! (~ result) 0.0f))
