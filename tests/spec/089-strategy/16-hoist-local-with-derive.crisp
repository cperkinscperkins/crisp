;; TEST-HOIST[L0]: validate-l0-strategy-content
;; STRATEGY-EXPECT: zeKernelSetGroupSize(kernel, 64, 1, 1)
;; STRATEGY-EXPECT: n_arg + 63) / 64
;;
;; Hoist: local-size=64 + global :one-thread-per from (n) =>
;;        workgroup=(64,1,1), groupCount=(ceil(n/64), 1, 1).

(def-type result-t (cell int :address-space :global))

(def-kernel hoist_local_derive (n &out result)
    (declare (type n ulong)
             (type result result-t)
             (global-size :derive-from (n) :strategy :one-thread-per)
             (local-size :set-to 64))
  (set! (~ result) 0))
