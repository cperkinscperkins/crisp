;; SKIP-DEFAULT-PASS: hoist-only spec; the GENERIC pass has no dispatch to inspect
;; COMPILE-WITH[--ir-target=ptx]: PASS
;; SKIP-WITH[--differentiate]: "dispatch-shape spec, nothing to differentiate"
;; TEST-HOIST[L0]: validate-l0-strategy-content
;; STRATEGY-EXPECT[L0]: uint32_t _gx = (uint32_t)(((uint64_t)c_ext0 + 63) / 64);
;; STRATEGY-EXPECT[L0]: uint32_t _gy = (uint32_t)(((uint64_t)c_ext1 + 63) / 64);
;;
;; Endeavor 143 — an EXPLICIT :tile-shape always beats the inferred one.
;;
;; The body strides in (32 32) but the declaration says (64 64), so the emitted grid must use
;; 64 — inference fills a gap, it never overrides the author.  The compiler also logs a warning
;; naming both values, since one of them is wrong; this spec pins which one the host obeys.
;; (Deliberately a disagreement: if inference silently won here, a user could not correct a
;; mis-inferred shape at all.)

(def-type mat (matrix float :address-space :global :align :compact :contiguous-term :row-major))

(def-kernel tile_shape_explicit (A &out C)
  (declare #'(mat &out mat)
           (global-size :derive-from C :strategy :strided :tile-shape (64 64))
           (local-size :set-to 16))
  (tile-stride C (32 32) (grid-y grid-x)
    (set! (~ C grid-y grid-x) 1.0f)))
