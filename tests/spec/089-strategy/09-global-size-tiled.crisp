;; SKIP-WITH[--differentiate]: "kernel has no differentiable float parameters"
;; TEST-WITH[--metadata]: crisp.compiler::validate-089-09-global-size-tiled
;;
;; Metadata: (global-size :derive-from (width height) :strategy :tiled :tile-shape (16 16)).

(def-type result-t (cell int :address-space :global :access :read-write))

(def-kernel tiled_kernel (width height &out result)
    (declare (type width height ulong)
             (type result result-t)
             (global-size :derive-from (width height) :strategy :tiled :tile-shape (16 16)))
  (set! (~ result) 0))
