;; TEST-HOIST[CUDA]: validate-cuda-strategy-content
;; STRATEGY-EXPECT: cuOccupancyMaxActiveBlocksPerMultiprocessor
;; STRATEGY-EXPECT: CU_DEVICE_ATTRIBUTE_MULTIPROCESSOR_COUNT
;; STRATEGY-EXPECT: _blocksPerSM
;; STRATEGY-EXPECT: _numSMs
;; SKIP-WITH[--differentiate]: "forward-only stride test"
;;
;; CUDA :strided strategy must emit cuOccupancyMaxActiveBlocksPerMultiprocessor
;; for compute-aware occupancy on NVIDIA hardware.

(def-type in-vec-t  (vector float :address-space :global :align :compact))
(def-type out-cell-t (cell float :address-space :global))

(def-kernel cuda_occupancy_test (input &out result)
  (declare #'(in-vec-t &out out-cell-t => nil))
  (declare (global-size :derive-from input :strategy :strided)
           (local-size  :set-to 256))
  (set! (~ result) 0.0f))
