;; TEST-EXPECT: FAIL
;; CHECK-FAIL: "no target multiplies blocks"
;; CHECK-FAIL-FLAGS: --ir-target=ptx
;;
;; Endeavour 206 -- the native block-scaled multiply is a later endeavour, so *! is refused and points at
;; the float path.

(def-microfloat-block mf :base fp4 :scale fp8-e4m3 :accum float :shape (16))

(def-kernel k_e (c s &out y)
  (declare #'(mf-codes mf-scales &out mf-floats) (global-size :derive-from y :strategy :strided))
  (let ((w (make-mf :codes c :scales s)))
    (loop-vector-stride y (i)
      (set! (~ y i) (to-float (*! w w))))))
