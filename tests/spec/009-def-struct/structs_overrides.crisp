;; Consolidated test for Struct Accessor/Setter Overrides
;; Covers: Overriding Accessors, Overriding Setters
;; Originally from def-struct-10 through 11

(def-struct point 
  (x float) 
  (y int))

;; 1. Overriding Accessors
(def-function x~ (p)
    (declare #'(point => float))
    (+ 1.0 (~x~ p)))

(def-function y~ (p)
    (declare #'(point => int))
    (+ 2 (~y~ p)))

;; 2. Overriding Setters
(def-setter x~ (p v)
    (declare #'(point float => nil))
    (set! (~x~ p) (+ 10.0 v)))

(def-setter y~ (p v)
    (declare #'(point int => nil))
    (set! (~y~ p) (+ 20 v)))

;; Test Function
(def-function test-overrides ()
    (declare #'( => float int))
    (let ((p (make-point :x 1.0 :y 2)))
        ;; Setters should add 10/20 to value
        (set! (x~ p) 3.0)  ;; assigns 13.0 to raw x
        (set! (y~ p) 4)    ;; assigns 24 to raw y
        
        ;; Accessors should add 1 or 2 to raw value
        ;; x: 13.0 + 1.0 = 14.0
        ;; y: 24 + 2 = 26
        (return (x~ p) (y~ p))))
