;; TEST-EXPECT: PASS
;; TEST-HOIST[L0]: validate-l0-host-run
;; TEST-HOIST[CUDA]: validate-cuda-host-run
;; HOIST-EXPECT: BUFFER y: 0 3 6 9
;; VERIFY-AUTODIFF: x=[1.0 2.0 3.0 4.0] atol=1e-3 at.x=1 expect.x=3.0 output-vec=4 group=4 groups=1
;;
;; Endeavour 195 D-195-7: an INTEGER atomic-store! carries no derivative, so it is inert and a kernel
;; that publishes an int flag still differentiates.  y = 3x, so d(sum y)/dx[1] = 3.
;;
;; The flag lives in workgroup scratch, not in a second output: the autodiff harness allocates, seeds
;; and reads exactly ONE output (the BUG 102 note in plan/bugs.md).  A uint second output dies with an
;; L0 device-lost there whether it is written by atomic-store! or by plain set! (probed 2026-10-27).
;; Scratch also exercises the backward rule's other type lookup: the element type comes from the
;; make-scratch-vector binding, not from a parameter.
;;
;; The harness launches its own geometry, not the kernel's global-size, so a kernel indexed by
;; get-global-id needs group= / groups= / output-vec= spelled out (without them: device-lost, or a 0.0
;; gradient from the elements no thread covered -- probed 2026-10-27 on a kernel with no atomics).
;;
;; (atomic-load is refused under the differentiate flag for EVERY type -- the backward launch cannot
;; reproduce the value it read -- so this kernel only publishes.)

(def-type f-vec (vector float :address-space :global :align :compact))

(def-kernel scale_and_flag (x &out y)
  (declare #'(f-vec &out f-vec => nil)
           (global-size :set-to 4)
           (local-size  :set-to 4))
  (let ((flags (make-scratch-vector uint :match-workgroup-size))
        (l (to-ulong (get-local-id 0)))
        (i (get-global-id 0)))
    (set! (~ y i) (* 3.0 (~ x i)))
    (atomic-store! (~ flags l) 1u)))
