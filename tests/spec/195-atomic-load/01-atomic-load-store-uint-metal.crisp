;; TEST-EXPECT: PASS
;; TEST-WITH[--ir-target=ptx] : validate-ptx-relaxed-load-store
;; TEST-WITH[--ir-target=spv] : validate-spv-relaxed-load-store
;; TEST-HOIST[L0]: validate-l0-host-run
;; TEST-HOIST[CUDA]: validate-cuda-host-run
;; HOIST-EXPECT: BUFFER a: 7 8 9 10
;; HOIST-EXPECT: BUFFER b: 8 9 10 11
;;
;; Endeavour 195: (atomic-store! place v) and (atomic-load place) on a uint element.  Each thread
;; stores i + 7, loads it back atomically and writes load + 1 to b.  Both are RELAXED at DEVICE scope
;; (the 184 rule): PTX ld.relaxed.gpu / st.relaxed.gpu with no atom.* RMW anywhere; SPIR-V
;; OpAtomicLoad / OpAtomicStore with scope Device and semantics Relaxed.

(def-type u-vec (vector uint :address-space :global :align :compact))

(def-kernel atomic_load_store_uint (&out a b)
  (declare #'(&out u-vec u-vec => nil)
           (global-size :set-to 4))
  (let ((i (get-global-id 0)))
    (atomic-store! (~ a i) (+ (to-uint i) 7u))
    (set! (~ b i) (+ (atomic-load (~ a i)) 1u))))
