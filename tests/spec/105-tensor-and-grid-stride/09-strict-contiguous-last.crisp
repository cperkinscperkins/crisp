;; TEST-EXPECT: PASS
;; TEST-WITH[--ir-target=spv]

;; Strict tensor-stride with :contiguous-last on a 3D tensor.
;; Last binding (x) varies along the warp lane.  Generalization of :row-major
;; beyond 2D.

(def-type ten3-t (tensor int 3 :address-space :global :align :compact :contiguous-term :last))

(def-kernel ten3_fill_cl (&out T3)
  (declare #'(&out ten3-t => nil) forward-only)
  (tensor-stride T3 :contiguous-last (z y x)
    (set! (~ T3 z y x) 11)))
