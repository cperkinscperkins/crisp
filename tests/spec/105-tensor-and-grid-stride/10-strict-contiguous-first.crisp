;; TEST-EXPECT: PASS
;; TEST-WITH[--ir-target=spv]

;; Strict tensor-stride with :contiguous-first on a 3D tensor.
;; First binding (z) varies along the warp lane.  Generalization of
;; :col-major beyond 2D.

(def-type ten3-t (tensor int 3 :address-space :global :align :compact :contiguous-term :first))

(def-kernel ten3_fill_cf (&out T3)
  (declare #'(&out ten3-t => nil))
  (tensor-stride T3 :contiguous-first (z y x)
    (set! (~ T3 z y x) 13)))
