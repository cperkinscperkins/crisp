;; CHECK-FAIL: "tensor-stride: layout-tag :ROW-MAJOR implies contiguous-term :LAST but the tensor's static type has contiguous-term :FIRST"
;; Strict layout-tag that disagrees with the tensor's static contiguous-term
;; must error at compile time.

(def-type mat-cf-t (matrix int :address-space :global :align :compact :contiguous-term :first))

(def-kernel strict_contradict (&out M)
  (declare #'(&out mat-cf-t => nil) forward-only)
  (tensor-stride M :row-major (row-y col-x)
    (set! (~ M row-y col-x) 0)))
