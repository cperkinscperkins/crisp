;; CHECK-FAIL: "Malformed grid-stride: expected (grid-stride (SIZE ...) (BINDING ...) BODY...) with size and binding arity matching"
;; grid-stride size-list and bindings must have matching arity.

(def-type out-c (cell int :address-space :global))

(def-kernel grid_arity_bad (&out C)
  (declare #'(&out out-c => nil) forward-only)
  (grid-stride (4 4) (i)
    (set! (~ C) (to-int i))))
