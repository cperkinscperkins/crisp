;; TEST-EXPECT: PASS
;; TEST-WITH[--ir-target=spv]

;; 3D grid-stride.  Iterates over a 2x3x4 virtual grid; writes a flat index
;; encoding to C.  Validates the 3D decode chain.

(def-type out-c (cell int :address-space :global))

(def-kernel grid_3d_smoke (&out C)
  (declare #'(&out out-c => nil))
  (grid-stride (2 3 4) (z y x)
    (set! (~ C) (to-int (+ (* z 12ul) (+ (* y 4ul) x))))))
