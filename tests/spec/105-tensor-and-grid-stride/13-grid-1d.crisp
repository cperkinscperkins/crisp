;; TEST-EXPECT: PASS
;; TEST-WITH[--ir-target=spv]

;; Basic 1D grid-stride: mathematical iteration with no tensor argument.
;; Each thread writes its single-D index into the output cell on the iteration
;; where i = 0 (so only one final write).  Validates the macro expansion.

(def-type out-c (cell int :address-space :global))

(def-kernel grid_1d_smoke (&out C)
  (declare #'(&out out-c => nil))
  (grid-stride (16) (i)
    (set! (~ C) (to-int i))))
