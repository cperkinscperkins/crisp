;; TEST-EXPECT: PASS
;; TEST-WITH[--ir-target=spv --differentiate]
;; VERIFY-AUTODIFF: A=[1.0 2.0 3.0 4.0] at.A=2 atol=5e-3 expect.A=1.0
;;
;; Single-thread sum reduction over A via tensor-stride.
;; f(A) = sum_i A[i].  df/dA[k] = 1.0 for each k.
;;
;; Complement to 107/01 (per-element vector output): this is the
;; tensor-stride / SCALAR-output AD path.  Endeavor 107 made the
;; backward walk structure-preserving, so AD now walks INTO the
;; dotimes body emitted by the stride macro.

(def-type vec-t (tensor float 1 :address-space :global :align :compact :contiguous-term :last))
(def-type out-c (cell float :address-space :global))

(def-kernel ten_sum (A &out C)
    (declare #'(vec-t &out out-c)
             (global-size :set-to 1))
  (tensor-stride A (i)
    (set! (~ C) (+ (~ C) (~ A i)))))
