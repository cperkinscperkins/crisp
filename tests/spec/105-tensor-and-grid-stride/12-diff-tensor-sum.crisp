;; TEST-EXPECT: PASS
;; TEST-WITH[--ir-target=spv]
;;
;; Kernel that exercises tensor-stride.  Compiles cleanly under
;; --differentiate as of endeavor 107 (stride macros now pre-expand
;; before the AD pre-pass).  Note: VERIFY-AUTODIFF directive omitted —
;; AD generates a backward kernel but doesn't walk INTO the dotimes
;; body, so analytical grads for the body's computation come back zero.
;; The AD-of-loops case still needs solving separately.

(def-type vec-t (tensor float 1 :address-space :global :align :compact :contiguous-term :last))
(def-type out-c (cell float :address-space :global))

(def-kernel ten_double_a2 (A &out C)
    (declare #'(vec-t &out out-c))
  (tensor-stride A (i)
    (set! (~ C) (* 2.0f (~ A 2)))))
