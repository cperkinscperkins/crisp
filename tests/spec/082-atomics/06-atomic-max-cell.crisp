;; TEST-EXPECT: PASS
;; Tests atomic-max! — stores the maximum, returns the old value.
;; Signed integer: LLVMAtomicRMWBinOpMax.
;; Expected IR: atomicrmw max i32 ... seq_cst

(def-type max-vec (vector int :address-space :global :access :read-write))

(def-function test-atomic-max (v candidate)
  (declare #'(max-vec int => int))
  (atomic-max! (~ v 0) candidate))
