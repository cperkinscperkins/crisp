;; TEST-EXPECT: PASS
;; Tests atomic-add! with float element type.
;; Float type requires LLVMAtomicRMWBinOpFAdd (not the integer Add).
;; Expected IR: atomicrmw fadd float ... seq_cst

(def-type float-acc (vector float :address-space :global :access :read-write))

(def-function test-atomic-add-float (v delta)
  (declare #'(float-acc float => float))
  (atomic-add! (~ v 0) delta))
