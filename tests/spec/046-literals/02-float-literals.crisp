;; TEST-WITH[--ir-target=llvmir] : validate-float-literals-ir

;; Verifies that float numeric suffixes produce the correct LLVM float types.
;; half (h), float (f), and bfloat16 (bf) are all distinct LLVM types.

(def-function ret-half     () (declare (return-type half))     1.5h)
(def-function ret-float    () (declare (return-type float))    1.5f)
(def-function ret-bfloat16 () (declare (return-type bfloat16)) 1.5bf)
