;; TEST-WITH[--ir-target=llvmir] : validate-integer-literals-ir

;; Verifies that integer numeric suffixes produce the correct LLVM integer types.
;; Each function returns a suffixed literal with a matching declared return type,
;; so any type mismatch would also be caught as a compile error.

(def-function ret-uchar  () (declare (return-type uchar))  200uc)
(def-function ret-char   () (declare (return-type char))   100c)
(def-function ret-short  () (declare (return-type short))  100s)
(def-function ret-ushort () (declare (return-type ushort)) 60000us)
(def-function ret-uint   () (declare (return-type uint))   42U)
(def-function ret-long   () (declare (return-type long))   1000L)
(def-function ret-ulong  () (declare (return-type ulong))  1000UL)
