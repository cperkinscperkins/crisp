;; Endeavour 208 phase 1 -- the smallest tcgen05 kernel: ONE CTA, one warpgroup, one 128x128 tile.
;;
;; A (128 x 64) and B (128 x 64, i.e. (N K)) bf16 tiles arrive by TMA with the 128-byte swizzle, then ONE
;; synchronous tcgen05-accumulate-via-tile does D += A.B over K = 64: four kind::f16 MMAs of K = 16 each,
;; issued by one thread into tensor memory.  store-tile reads D back with tcgen05.ld and writes C.
;;
;; What the PTX must show (validate-ptx-tcgen05-sync):
;;   tcgen05.alloc + relinquish_alloc_permit at entry, 128 columns (one f32 128x128 accumulator);
;;   4 x tcgen05.mma.cta_group::1.kind::f16, then tcgen05.commit to the compiler's mbarrier;
;;   tcgen05.ld.sync.aligned.32x32b + tcgen05.wait::ld in the store;
;;   tcgen05.dealloc before ret.
;;
;; The descriptors are runtime values ptxas does not check, so only the metal run proves them.
;;
;; SKIP-DEFAULT-PASS
;; TEST-WITH[--ir-target=ptx --ir-target-arch=sm_100a] : validate-ptx-tcgen05-sync
;; SKIP-WITH[--differentiate]: "tcgen05 has no backward yet (D-208-8)"
;;
;; MMA-DIMS: 128 128 64
;; HOIST-ARCH: sm_100a
;; TEST-HOIST[CUDA]: validate-cuda-mma-run
;; HOIST-EXPECT: MMA_CORRECT

(def-type a-mat (matrix bfloat16 :address-space :global :align :compact :contiguous-term :row-major))
(def-type b-mat (matrix bfloat16 :address-space :global :align :compact :contiguous-term :col-major))
(def-type c-mat (matrix float    :address-space :global :align :compact :contiguous-term :row-major))

(def-kernel tcgen05_single (A B &out C)
  (declare #'(a-mat b-mat &out c-mat)
           (global-size :set-to 128) (local-size :set-to 128))
  (let ((A-tile (make-scratch-matrix bfloat16 (128 64)))
        (B-tile (make-scratch-matrix bfloat16 (128 64)))
        (D      (make-tcgen05-accumulator float (128 128) 0.0))
        (bar    (make-async-barrier :mode :block)))
    (load-tile A A-tile (0 0) :barrier bar :swizzle :128b)
    (load-tile B B-tile (0 0) :barrier bar :swizzle :128b)
    (await bar)
    (tcgen05-accumulate-via-tile (128 128 64) D A-tile B-tile :swizzle :128b)
    (store-tile D C (0 0))))
