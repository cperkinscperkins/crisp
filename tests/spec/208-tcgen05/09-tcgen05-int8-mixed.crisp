;; TEST-WITH[--ir-target=ptx --ir-target-arch=sm_100a]: validate-ptx-tcgen05-int8-mixed
;; SKIP-DEFAULT-PASS
;; SKIP-WITH[--differentiate]: "integer MMA has no backward"
;;
;; Endeavour 208 phase 3 -- uchar x char: the signs of A and B are independent.  On tcgen05 they are not
;; part of the mnemonic, as on mma.sync / wgmma, but two 3-bit fields of the instruction descriptor
;; (a_format UINT8 = 0, b_format INT8 = 1).  The harness fills A with 200..204, which a signed read would
;; see as negative, and B straddles zero, so a swapped format cannot pass the exact compare.
;;
;; MMA-DIMS: 128 128 128
;; HOIST-ARCH: sm_100a
;; TEST-HOIST[CUDA]: validate-cuda-mma-run
;; HOIST-EXPECT: MMA_CORRECT

(def-type a-mat (matrix uchar :address-space :global :align :compact :contiguous-term :row-major))
(def-type b-mat (matrix char  :address-space :global :align :compact :contiguous-term :col-major))
(def-type c-mat (matrix int   :address-space :global :align :compact :contiguous-term :row-major))

(def-kernel tcgen05_u8s8 (A B &out C)
  (declare #'(a-mat b-mat &out c-mat)
           (global-size :set-to 128) (local-size :set-to 128))
  (let ((A-tile (make-scratch-matrix uchar (128 128)))
        (B-tile (make-scratch-matrix char  (128 128)))
        (D      (make-tcgen05-accumulator int (128 128) 0))
        (bar    (make-async-barrier :mode :block)))
    (load-tile A A-tile (0 0) :barrier bar :swizzle :128b)
    (load-tile B B-tile (0 0) :barrier bar :swizzle :128b)
    (await bar)
    (tcgen05-accumulate-via-tile (128 128 128) D A-tile B-tile :swizzle :128b)
    (store-tile-at D C (0 0))))
