;; CHECK-FAIL: "must be signed"
;; CHECK-FAIL-FLAGS: --ir-target=ptx --ir-target-arch=sm_100a
;; Endeavour 208 phase 3 -- 204's sign rule on tcgen05: a product involving a signed operand can be
;; negative, so a uint accumulator is refused.  With an int accumulator it compiles (spec 08).

(def-type a-mat (matrix char :address-space :global :align :compact :contiguous-term :row-major))
(def-type b-mat (matrix char :address-space :global :align :compact :contiguous-term :col-major))
(def-type c-mat (matrix uint :address-space :global :align :compact :contiguous-term :row-major))

(def-kernel k (A B &out C)
  (declare #'(a-mat b-mat &out c-mat)
           (global-size :set-to 128) (local-size :set-to 128))
  (let ((A-tile (make-scratch-matrix char (128 128)))
        (B-tile (make-scratch-matrix char (128 128)))
        (D      (make-tcgen05-accumulator uint (128 128) 0))
        (bar    (make-async-barrier :mode :block)))
    (load-tile A A-tile (0 0) :barrier bar :swizzle :128b)
    (load-tile B B-tile (0 0) :barrier bar :swizzle :128b)
    (await bar)
    (tcgen05-accumulate-via-tile (128 128 128) D A-tile B-tile :swizzle :128b)
    (store-tile-at D C (0 0))))
