;; CHECK-FAIL: "tcgen05 multiplies NVFP4"
;; CHECK-FAIL-FLAGS: --ir-target=ptx --ir-target-arch=sm_100a
;; Endeavour 208 phase 4 -- fp4 with an e8m0 scale per 16 is a block no tcgen05 kind multiplies (MXFP4 is per 32,
;; NVFP4 is e4m3 per 16).  As nvfp4 it compiles (spec 13).

(def-microfloat-block odd :base fp4 :scale fp8-e8m0 :accum float :shape (16))
(def-type a-mat (matrix odd :address-space :global :align :compact :contiguous-term :row-major))
(def-type b-mat (matrix odd :address-space :global :align :compact :contiguous-term :col-major))
(def-type sa-vec (vector (scale odd) :address-space :global :align :compact))
(def-type sb-vec (vector (scale odd) :address-space :global :align :compact))
(def-type c-mat (matrix float :address-space :global :align :compact :contiguous-term :row-major))

(def-kernel k (A SA B SB &out C)
  (declare #'(a-mat sa-vec b-mat sb-vec &out c-mat)
           (global-size :set-to 128) (local-size :set-to 128)
           (scale-layout SA :of A :blocked-128x4)
           (scale-layout SB :of B :blocked-128x4))
  (let ((A-tile (make-scratch-matrix odd (128 256)))
        (B-tile (make-scratch-matrix odd (128 256)))
        (D      (make-tcgen05-accumulator float (128 128) 0.0))
        (bar    (make-async-barrier :mode :block)))
    (load-tile A A-tile (0 0) :scales SA :barrier bar :swizzle :128b)
    (load-tile B B-tile (0 0) :scales SB :barrier bar :swizzle :128b)
    (await bar)
    (tcgen05-accumulate-via-tile (128 128 256) D A-tile B-tile :swizzle :128b)
    (store-tile-at D C (0 0))))
