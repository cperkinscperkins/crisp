;; CHECK-FAIL: "accumulate into (accum q-a), not (accum q-b)"
;; CHECK-FAIL-FLAGS: --ir-target=ptx --ir-target-arch=sm_100a
;; Endeavour 208 phase 3 -- 207's qint rule on the tcgen05 path: q-a operands into a tensor-memory
;; accumulator of (accum q-b) are refused, exactly as on the register-tile and wgmma paths.  With
;; (accum q-a) it compiles (spec 11 is the ring form of that).

(def-qint q-a :base char :accum int)
(def-qint q-b :base char :accum int)
(def-type a-mat (matrix q-a :address-space :global :align :compact :contiguous-term :row-major))
(def-type b-mat (matrix q-a :address-space :global :align :compact :contiguous-term :col-major))
(def-type c-mat (matrix (accum q-b) :address-space :global :align :compact :contiguous-term :row-major))

(def-kernel k (A B &out C)
  (declare #'(a-mat b-mat &out c-mat)
           (global-size :set-to 128) (local-size :set-to 128))
  (let ((A-tile (make-scratch-matrix q-a (128 128)))
        (B-tile (make-scratch-matrix q-a (128 128)))
        (D      (make-tcgen05-accumulator (accum q-b) (128 128) 0))
        (bar    (make-async-barrier :mode :block)))
    (load-tile A A-tile (0 0) :barrier bar :swizzle :128b)
    (load-tile B B-tile (0 0) :barrier bar :swizzle :128b)
    (await bar)
    (tcgen05-accumulate-via-tile (128 128 128) D A-tile B-tile :swizzle :128b)
    (store-tile-at D C (0 0))))
