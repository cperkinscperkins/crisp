;; TEST-WITH[--ir-target=ptx --ir-target-arch=sm_100a]: validate-ptx-tcgen05-mxfp8
;; SKIP-DEFAULT-PASS
;; SKIP-WITH[--differentiate]: "tcgen05 has no backward yet (D-208-8)"
;;
;; Endeavour 208 phase 4 -- MXFP8 (e4m3 codes, a ue8m0 scale per 32): kind::mxf8f6f4.block_scale (scale_vec::1X).
;; A matrix of a def-microfloat-block holds its packed codes, (M K) in elements (D-208-10); its scales are
;; a separate vector in the declared :blocked-128x4 layout (D-208-11).  The source rewrite turns each block
;; tile into a uchar codes tile plus a hidden scales tile; load-tile .. :scales bulk-copies the tile's scale
;; atoms before the codes' TMA load; the accumulate copies them into tensor memory (tcgen05.cp) and issues
;; four block-scaled MMAs.  K = 128 is four K = 32 instructions sharing ONE atom, at byte SF_ID 0..3.
;;
;; MMA-DIMS: 128 128 128
;; HOIST-ARCH: sm_100a
;; TEST-HOIST[CUDA]: validate-cuda-mma-run
;; HOIST-EXPECT: MMA_CORRECT

(def-microfloat-block mxfp8 :base fp8-e4m3 :scale fp8-e8m0 :accum float :shape (32))
(def-type a-mat (matrix mxfp8 :address-space :global :align :compact :contiguous-term :row-major))
(def-type b-mat (matrix mxfp8 :address-space :global :align :compact :contiguous-term :col-major))
(def-type s-vec (vector (scale mxfp8) :address-space :global :align :compact))
(def-type c-mat (matrix float :address-space :global :align :compact :contiguous-term :row-major))

(def-kernel tcgen05_mxfp8 (A SA B SB &out C)
  (declare #'(a-mat s-vec b-mat s-vec &out c-mat)
           (global-size :set-to 128) (local-size :set-to 128)
           (scale-layout SA :of A :blocked-128x4)
           (scale-layout SB :of B :blocked-128x4))
  (let ((A-tile (make-scratch-matrix mxfp8 (128 128)))
        (B-tile (make-scratch-matrix mxfp8 (128 128)))
        (D      (make-tcgen05-accumulator float (128 128) 0.0))
        (bar    (make-async-barrier :mode :block)))
    (load-tile A A-tile (0 0) :scales SA :barrier bar :swizzle :128b)
    (load-tile B B-tile (0 0) :scales SB :barrier bar :swizzle :128b)
    (await bar)
    (tcgen05-accumulate-via-tile (128 128 128) D A-tile B-tile :swizzle :128b)
    (store-tile-at D C (0 0))))
