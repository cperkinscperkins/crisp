;; TEST-WITH[--ir-target=ptx --ir-target-arch=sm_100a]: validate-ptx-tcgen05-qint-narrow
;; SKIP-DEFAULT-PASS
;; SKIP-WITH[--differentiate]: "integer MMA has no backward"
;;
;; Endeavour 208 phase 3 -- a quantized matmul stored straight into an 8-bit matrix: 205's wgmma spec 09
;; on tcgen05.  q-act (uchar) x q-wt (char) accumulate into their declared product's (accum q-act q-wt),
;; the s32 tensor-memory accumulator; (to-q-out D 1.0) requantizes each element as the epilogue stores
;; it, saturating to char.  The harness reference clamps the exact product to the output's range.
;;
;; MMA-DIMS: 128 128 128
;; HOIST-ARCH: sm_100a
;; TEST-HOIST[CUDA]: validate-cuda-mma-run
;; HOIST-EXPECT: MMA_CORRECT

(def-qint q-act :base uchar :accum int)
(def-qint q-wt :base char :accum int)
(def-qint q-out :base char :accum int)
(def-qint-product q-dot (q-act q-wt) :accum int)

(def-type a-mat (matrix q-act :address-space :global :align :compact :contiguous-term :row-major))
(def-type b-mat (matrix q-wt  :address-space :global :align :compact :contiguous-term :col-major))
(def-type c-mat (matrix q-out :address-space :global :align :compact :contiguous-term :row-major))

(def-kernel tcgen05_narrow (A B &out C)
  (declare #'(a-mat b-mat &out c-mat)
           (global-size :set-to 128) (local-size :set-to 128))
  (let ((A-tile (make-scratch-matrix q-act (128 128)))
        (B-tile (make-scratch-matrix q-wt (128 128)))
        (D      (make-tcgen05-accumulator (accum q-act q-wt) (128 128) 0))
        (bar    (make-async-barrier :mode :block)))
    (load-tile A A-tile (0 0) :barrier bar :swizzle :128b)
    (load-tile B B-tile (0 0) :barrier bar :swizzle :128b)
    (await bar)
    (tcgen05-accumulate-via-tile (128 128 128) D A-tile B-tile :swizzle :128b)
    (store-tile-at (to-q-out D 1.0) C (0 0))))
