;; Endeavour 208 phase 1 -- chapter 7's warp-specialized pipeline with tcgen05 in place of wgmma, and the
;; PRODUCER FIRST, so nothing about the tcgen05 roles is at warp 0:
;;
;;   warp 0       :producer  -- TMA loads into a 2-slot ring (A 128x64, B 256x64)
;;   warps 1..4   :consumer  -- the synchronous accumulate (issued by lane 0 of warp 1, D-208-7), then
;;                              the store: warps 1,2,3,4 read tensor-memory lane quarters 1,2,3,0
;;                              (warp mod 4), which together cover the 128 rows (D-208-6).
;;
;; The accumulate is synchronous, so the consumer signals `empty` only after the MMA has read the slot.
;; (The asynchronous form, :on-complete, is phase 2.)
;; 256 x 512 x 256: 4 output tiles of 128 x 256 over 2 CTAs, 4 K-steps each, two laps of the ring.
;;
;; SKIP-DEFAULT-PASS
;; TEST-WITH[--ir-target=ptx --ir-target-arch=sm_100a] : validate-ptx-tcgen05-warpspec
;; SKIP-WITH[--differentiate]: "tcgen05 has no backward yet (D-208-8)"
;;
;; MMA-DIMS: 256 512 256
;; HOIST-ARCH: sm_100a
;; TEST-HOIST[CUDA]: validate-cuda-mma-run
;; HOIST-EXPECT: MMA_CORRECT

(def-type a-mat (matrix bfloat16 :address-space :global :align :compact :contiguous-term :row-major))
(def-type b-mat (matrix bfloat16 :address-space :global :align :compact :contiguous-term :col-major))
(def-type c-mat (matrix float    :address-space :global :align :compact :contiguous-term :row-major))

(def-kernel tcgen05_ws (A B &out C)
  (declare #'(a-mat b-mat &out c-mat)
           (global-size :set-to 320) (local-size :set-to 160))      ; 1 producer warp + 1 warpgroup
  (let ((A-ring (make-scratch-matrix-ring bfloat16 (128 64) :ring-count 2))
        (B-ring (make-scratch-matrix-ring bfloat16 (256 64) :ring-count 2))
        (D      (make-tcgen05-accumulator float (128 256) 0.0))
        (K      (inner-dimension A B))
        (empty  (make-async-barrier-ring :ring-count 2 :mode :block :arrivals 4 :initial-state :signaled))
        (full   (make-async-barrier-ring :ring-count 2 :mode :block :arrivals 2 :initial-state :waiting)))
    (tile-stride C (128 256) (grid-y grid-x)
      (with-warp-specialization (:producer 1 :consumer 4)
        (:producer
          (dotimes (grid-k (/ (to-ulong K) (to-ulong 64)))
            (let ((slot (mod grid-k (to-ulong 2))))
              (await (ring-get empty slot))
              (load-tile A (ring-get A-ring slot) (grid-y grid-k) :barrier (ring-get full slot) :swizzle :128b)
              (load-tile B (ring-get B-ring slot) (grid-x grid-k) :barrier (ring-get full slot) :swizzle :128b))))
        (:consumer
          (set! D (make-tcgen05-accumulator float (128 256) 0.0))
          (dotimes (grid-k (/ (to-ulong K) (to-ulong 64)))
            (let ((slot (mod grid-k (to-ulong 2))))
              (await (ring-get full slot))
              (tcgen05-accumulate-via-tile (128 256 64) D (ring-get A-ring slot) (ring-get B-ring slot)
                                           :swizzle :128b)
              (signal (ring-get empty slot))))
          (store-tile D C (grid-y grid-x)))))))
