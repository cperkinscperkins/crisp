;; Endeavour 208 phase 4 -- the pipelined NVFP4 kernel: spec 04's three roles on block tiles.
;;
;; A-ring / B-ring are rings of nvfp4 tiles: each slot is a codes tile and a hidden scales tile, and the
;; producer's (load-tile .. :scales ..) fills both on the slot's barrier (the scale copy's expect_tx comes
;; first, from the same elected lane).  The MMA warp copies each step's scales into tensor memory and
;; frees the slot with :on-complete, as for 16-bit.  One K-step is 256 fp4 codes (128 bytes).  A slot is
;; 16 + 2 KB of A and 32 + 4 KB of B, so 4 slots take 216 KB.  The accumulator takes 256 columns and the
;; scales 48 more, so the kernel allocates 512.
;;
;; FOUR slots, not three: 4 K-steps per tile must be a multiple of the ring count.  The ring await's
;; parity comes from its own visit count (lap = visit div ring-count), which assumes slot = visit mod
;; ring-count; (mod grid-k R) restarts every tile, so with 3 slots the second tile waited on the wrong
;; phase and the kernel faulted on a B200 ("unspecified launch failure").  See bugs.md, BUG 156.
;;
;; 256 x 512 x 1024: 4 output tiles of 128 x 256 over 2 CTAs, 4 K-steps per tile.
;;
;; SKIP-DEFAULT-PASS
;; TEST-WITH[--ir-target=ptx --ir-target-arch=sm_100a] : validate-ptx-tcgen05-nvfp4-pipeline
;; SKIP-WITH[--differentiate]: "tcgen05 has no backward yet (D-208-8)"
;;
;; MMA-DIMS: 256 512 1024
;; HOIST-ARCH: sm_100a
;; TEST-HOIST[CUDA]: validate-cuda-mma-run
;; HOIST-EXPECT: MMA_CORRECT

(def-microfloat-block nvfp4 :base fp4 :scale fp8-e4m3 :accum float :shape (16))
(def-type a-mat (matrix nvfp4 :address-space :global :align :compact :contiguous-term :row-major))
(def-type b-mat (matrix nvfp4 :address-space :global :align :compact :contiguous-term :col-major))
(def-type s-vec (vector (scale nvfp4) :address-space :global :align :compact))
(def-type c-mat (matrix float :address-space :global :align :compact :contiguous-term :row-major))

(def-kernel tcgen05_nvfp4_pipe (A SA B SB &out C)
  (declare #'(a-mat s-vec b-mat s-vec &out c-mat)
           (global-size :set-to 384) (local-size :set-to 192)       ; epilogue wg + producer + mma
           (scale-layout SA :of A :blocked-128x4)
           (scale-layout SB :of B :blocked-128x4))
  (let ((A-ring    (make-scratch-matrix-ring nvfp4 (128 256) :ring-count 4))
        (B-ring    (make-scratch-matrix-ring nvfp4 (256 256) :ring-count 4))
        (D         (make-tcgen05-accumulator float (128 256) 0.0))
        (K         (inner-dimension A B))
        (empty     (make-async-barrier-ring :ring-count 4 :mode :block :arrivals 1 :initial-state :signaled))
        (full      (make-async-barrier-ring :ring-count 4 :mode :block :arrivals 2 :initial-state :waiting))
        (acc-full  (make-async-barrier-ring :ring-count 1 :mode :block :arrivals 1 :initial-state :waiting))
        (acc-empty (make-async-barrier-ring :ring-count 1 :mode :block :arrivals 4 :initial-state :signaled)))
    (tile-stride C (128 256) (grid-y grid-x)
      (with-warp-specialization (:epilogue 4 :producer 1 :mma 1)
        (:epilogue
          (await (ring-get acc-full 0))
          (store-tile D C (grid-y grid-x))
          (signal (ring-get acc-empty 0)))
        (:producer
          (dotimes (grid-k (/ (to-ulong K) (to-ulong 256)))
            (let ((slot (mod grid-k (to-ulong 4))))
              (await (ring-get empty slot))
              (load-tile A (ring-get A-ring slot) (grid-y grid-k) :scales SA :barrier (ring-get full slot) :swizzle :128b)
              (load-tile B (ring-get B-ring slot) (grid-x grid-k) :scales SB :barrier (ring-get full slot) :swizzle :128b))))
        (:mma
          (await (ring-get acc-empty 0))
          (set! D (make-tcgen05-accumulator float (128 256) 0.0))
          (dotimes (grid-k (/ (to-ulong K) (to-ulong 256)))
            (let ((slot (mod grid-k (to-ulong 4))))
              (await (ring-get full slot))
              (tcgen05-accumulate-via-tile (128 256 256) D (ring-get A-ring slot) (ring-get B-ring slot)
                                           :swizzle :128b :on-complete (ring-get empty slot))))
          (tcgen05-commit (ring-get acc-full 0)))))))
