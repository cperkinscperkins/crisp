;; Endeavor 152 rung 21 — `signal` on a `:mode :cluster` barrier is a REMOTE arrive.
;;
;; THIS IS THE RUNG THAT DEFINES `:mode :cluster`.  Everything else about a cluster barrier is
;; identical to `:block`: same mbarrier object, same local `await`, same `:arrivals` meaning.
;; The single difference is who may RELEASE it — and that difference lives entirely in `signal`.
;;
;; WHAT THE LOWERING MUST DO.  A `:block` signal arrives on the CALLING workgroup's own mbarrier
;; (`mbarrier.arrive.shared`).  A `:cluster` signal must arrive on a PEER's mbarrier, which on
;; Hopper means mapping the peer's shared-memory address into this workgroup's view (`mapa`) and
;; arriving with cluster scope (`mbarrier.arrive.shared::cluster`).
;;
;; WHY THIS CANNOT BE INFERRED FROM A PASSING RUN.  A `:cluster` signal that lowered as a local
;; arrive would release the WRONG barrier — the signaller's own, which nobody is waiting on —
;; while the peer waits forever.  In a one-workgroup launch (cluster extent 1) the two are the
;; same address, so such a bug passes every small test and hangs only at scale.  Reading the
;; emitted instruction is the only way to tell them apart.
;;
;; THE PATTERN THIS MODELS is the reverse (`empty`) barrier of a pipelined ring: consumers tell
;; the producer that a slot is free.  CUTLASS spreads those arrivals ALL-TO-ALL across the
;; multicast group rather than electing a leader (verified in sm90_pipeline.hpp — see
;; 00-verification-findings.md Q1c), so a correct lowering signals a peer, not just rank 0.
;;
;; NEW VALIDATOR REQUIRED: validate-ptx-cluster-remote-arrive
;;
;; COMPILE-WITH[--ir-target=ptx --ir-target-arch=sm_90]: PASS
;; TEST-WITH[--ir-target=ptx --ir-target-arch=sm_90] : validate-ptx-cluster-remote-arrive
;; SKIP-DEFAULT-PASS
;; SKIP-WITH[--differentiate]: "barrier-shape rung; AD for :mode :cluster is step 7 of the plan"

(def-type mat-t (matrix float :address-space :global :align :compact :contiguous-term :row-major))

(def-kernel cluster_bar_remote (A &out C)
  (declare #'(mat-t &out mat-t)
           (global-size :derive-from C :strategy :strided :tile-shape (2 4))
           (local-size  :set-to 32)
           (cluster-size :set-to (2 1)))
  (let ((tile  (make-scratch-matrix float (2 4)))
        (full  (make-async-barrier :mode :block))
        (empty (make-async-barrier :mode :cluster)))
    (tile-stride C (2 4) (grid-y grid-x)
      (load-tile A tile (0 grid-x) :barrier full :multicast true)
      (await full)
      (store-tile tile C (grid-y grid-x))
      ;; "this workgroup is done with the tile" — must reach a PEER's barrier, not our own.
      (signal empty))))
