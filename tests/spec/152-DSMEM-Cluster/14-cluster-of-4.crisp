;; Endeavor 152 rung 14 — a cluster of 4 workgroups, shape (2 2).
;;
;; Everything before this ran on a cluster of TWO, which is the smallest cluster that is a
;; cluster at all and therefore the weakest possible evidence: with two workgroups almost every
;; index is 0 or 1, so an off-by-one in a stride, a mask pattern or a rank calculation cannot
;; show itself.  This rung is a SQUARE 2x2 -- the shape a matmul actually wants, since it halves BOTH operands' traffic.
;;
;; WHAT IT PINS.  The declared shape must survive to the PTX as `.reqnctapercluster` with the
;; right product -- that is what the driver enforces the launch against, so a kernel whose
;; directive disagrees with its cluster-size would be rejected at load time rather than
;; computing something wrong.
;;
;; The multicast mask is asserted separately by rung 12; here the concern is purely that the
;; SHAPE survives, because the shape is what every other cluster mechanism is derived from.
;;
;; COMPILE-WITH[--ir-target=ptx --ir-target-arch=sm_90]: PASS
;; TEST-WITH[--ir-target=ptx --ir-target-arch=sm_90] : validate-ptx-cluster-extent-4
;; SKIP-DEFAULT-PASS

(def-type mat-t (matrix float :address-space :global :align :compact :contiguous-term :row-major))

(def-kernel cluster_of_4 (A &out C)
  (declare #'(mat-t &out mat-t)
           (global-size :derive-from C :strategy :strided :tile-shape (16 16))
           (local-size  :set-to 128)
           (cluster-size :set-to (2 2)))
  (let ((tile (make-scratch-matrix float (16 16)))
        (bar  (make-async-barrier :mode :block)))
    (tile-stride C (16 16) (grid-y grid-x)
      (load-tile A tile (grid-y 0) :barrier bar :multicast true)
      (await bar)
      (store-tile tile C (grid-y grid-x)))))
