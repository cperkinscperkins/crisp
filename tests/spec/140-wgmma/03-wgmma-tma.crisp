;; Endeavor 140 (Chapter 4) Step 3 — TMA + 128B swizzle wgmma.  One warpgroup loads a 64x32 A K-block
;; and a 64x32 B^T K-block via TMA (128B swizzle), then 4 wgmma.m64n64k8 iterate the K-slices.  This
;; is the fast path: hardware bulk load (no scatter) + wgmma-native swizzled layout.  Ports the
;; metal-verified wgmma_tma_swizzle_ref.cu recipe.
;;
;; SKIP-DEFAULT-PASS
;; TEST-WITH[--ir-target=ptx --ir-target-arch=sm_90] : validate-ptx-wgmma
;;
;; Endeavor 146 Gap 1: the old skip here read "wgmma is forward-only MMA", which was never a
;; property of wgmma -- it was the absence of any wiring.  "wgmma" appeared exactly ONCE in all
;; of src/autodiff.lisp, in a comment.  wgmma is Hopper's warpgroup-async way of computing
;; D += A.B; the asynchrony and the warpgroup scope are SCHEDULE, and the math is the same
;; multiply mma-accumulate-via-tile already has a VJP for.  The backward is now obtained by
;; canonicalizing wgmma to the sync MMA on the ANF entering the backward walk, so the ONE
;; existing VJP supplies the derivative.  A backward is under no obligation to use the same
;; instruction as its forward.
;;
;; NO NUMERIC PROOF HERE, DELIBERATELY.  wgmma is sm_90a-only and VERIFY-AUTODIFF runs on
;; SPV/L0, so gradient VALUES cannot be checked on this machine and there is no BMG analogue
;; to fall back on -- wgmma does not exist on Intel.  What is asserted is that it differentiates
;; and emits a backward.  Treat like 137/03: the values want a Hopper pod run before anyone
;; claims them.  (145/12 and 142/01 are the numeric proofs that the underlying tile VJP is
;; right; this spec adds only that wgmma reaches it.)
;;
;; MMA-DIMS: 64 64 32
;; HOIST-ARCH: sm_90
;; TEST-HOIST[CUDA]: validate-cuda-mma-run
;; HOIST-EXPECT: MMA_CORRECT
;; wgmma is tf32 — declare fast so the tf32/precision warning stays silent (see 126-precision/20).
(declaim (precision fast))
(def-type a-mat (matrix float :address-space :global :align :compact :contiguous-term :row-major))
(def-type b-mat (matrix float :address-space :global :align :compact :contiguous-term :col-major))
(def-type c-mat (matrix float :address-space :global :align :compact :contiguous-term :row-major))

(def-kernel wgmma_tma (A B &out C)
  (declare #'(a-mat b-mat &out c-mat)
           (global-size :set-to 128) (local-size :set-to 128))
  (let ((A-tile (make-scratch-matrix float (64 32)))
        (B-tile (make-scratch-matrix float (64 32)))
        (D      (make-wgmma-accumulator float (64 64) 0.0))
        (bar    (make-async-barrier :mode :block)))
    (load-tile A A-tile (0 0) :barrier bar :swizzle :128b)
    (load-tile B B-tile (0 0) :barrier bar :swizzle :128b)
    (await bar)
    (wgmma-accumulate-via-tile (64 64 32) D A-tile B-tile :swizzle :128b)
    (store-tile D C (0 0))))
