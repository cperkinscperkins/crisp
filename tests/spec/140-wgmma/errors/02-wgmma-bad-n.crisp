;; CHECK-FAIL: "multiple of 8"
;; Endeavor 140 — wgmma N must be a multiple of 8 in [8,256] (the m64nNk8 family).
(def-type mt (matrix float :address-space :global :align :compact :contiguous-term :row-major))
(def-kernel wgmma_bad_n (&out C)
  (declare #'(&out mt) (global-size :set-to 128) (local-size :set-to 128))
  (let ((A-tile (make-scratch-matrix float (64 8)))
        (B-tile (make-scratch-matrix float (60 8)))
        (D (make-wgmma-accumulator float (64 60) 0.0)))
    (wgmma-accumulate-via-tile (64 60 8) D A-tile B-tile)
    (set! (~ C 0 0) 1.0)))
