;; Endeavor 140 (Chapter 4) Step 1 — the minimal single m64n64k8 tf32 wgmma, METAL correctness.
;; One warpgroup (local-size 128).  A (64x8 row-major) and B (8x64 col-major) are scatter-loaded
;; into flat SMEM tiles in CORE-MATRIX order (8x4 tf32 cores, contiguous, K-major within), then one
;; wgmma.mma_async computes D = A*B, stored to C.  Ported from the metal-verified wgmma_ref.cu.
;;
;; SKIP-DEFAULT-PASS
;; SKIP-WITH[--differentiate]: "HAND-STAGED operand, not a wgmma limit.  A-tile/B-tile are a flat (make-scratch-vector float 512) scatter-filled in wgmma core order, so mma-accumulate-via-tile's VJP has neither a compile-time (Mt Kt) nor a load-tile-at source to recover.  Needs PRIMAL REPLAY: recompute the operand's staging into the backward and address it through the instruction's ABI layout.  Everything else in this kernel already differentiates -- see 140/03 for wgmma itself, and the note below."
;; TEST-WITH[--ir-target=ptx --ir-target-arch=sm_90] : validate-ptx-wgmma
;;
;; Endeavor 146: the old reason here read "wgmma is forward-only MMA".  That was never true
;; and is now demonstrably false -- 140/03 differentiates and emits a backward.  Measured
;; state of THIS kernel, so the next person does not re-derive it:
;;   - the SCATTER-FILL already differentiates.  Crisp's generic set!/~ backward reverses
;;     (set! (~ A-tile core) (~ A r k)) into A_ADJ[r][k] += A-TILE_ADJ[core] straight through
;;     the user's swizzled index expression -- no load-tile-at, no layout knowledge needed.
;;     Verified by compiling this kernel's staging on its own under --differentiate.
;;   - the index math (/ and rem) is clean as of 146 Gap 2, which gave rem/mod real
;;     derivatives instead of declaring them inert.
;;   - warp-id / warp-lane / warp-count are now registered thread coordinates (146), which
;;     is what previously stopped the staging from differentiating at all.
;; What remains is ONLY the tile multiply's VJP: it reads operand PRIMALS from their global
;; source, and a backward replays the forward's BINDINGS but not its STATEMENTS, so the
;; staged tile is empty there.  A hand-swizzled flat buffer has no source mapping to invert.
;; The fix is recompute -- replay the staging into the backward -- which is a general AD
;; capability, not a wgmma feature.  Un-skip when that exists.
;;
;; MMA-DIMS: 64 64 8
;; HOIST-ARCH: sm_90
;; TEST-HOIST[CUDA]: validate-cuda-mma-run
;; HOIST-EXPECT: MMA_CORRECT
;; wgmma is tf32 — declare fast so the tf32/precision warning stays silent (see 126-precision/20).
(declaim (precision fast))
(def-type a-mat (matrix float :address-space :global :align :compact :contiguous-term :row-major))
(def-type b-mat (matrix float :address-space :global :align :compact :contiguous-term :col-major))
(def-type c-mat (matrix float :address-space :global :align :compact :contiguous-term :row-major))

(def-kernel wgmma_single (A B &out C)
  (declare #'(a-mat b-mat &out c-mat)
           (global-size :set-to 128) (local-size :set-to 128))
  (let ((A-tile (make-scratch-vector float 512))     ; 64x8 core-matrix order
        (B-tile (make-scratch-vector float 512))     ; 64x8 (B^T) core-matrix order
        (D      (make-wgmma-accumulator float (64 64) 0.0)))
    (let ((llid (+ (* (to-int (warp-id)) 32) (to-int (warp-lane)))))   ; 0..127
      ;; scatter-fill both tiles: logical (r,k) -> core idx (r/8)*64 + (k/4)*32 + (r%8)*4 + (k%4)
      (dotimes (i 4)
        (let ((li (+ (* i 128) llid)))
          (let ((r (/ li 8)) (k (rem li 8)))
            (let ((core (+ (+ (+ (* (/ r 8) 64) (* (/ k 4) 32)) (* (rem r 8) 4)) (rem k 4))))
              (set! (~ A-tile core) (~ A r k))        ; A[r][k]
              (set! (~ B-tile core) (~ B k r)))))))   ; B^T[r][k] = B[k][r]
    (sync-workgroup)
    (wgmma-accumulate-via-tile (64 64 8) D A-tile B-tile)
    (store-tile D C (0 0))))
