;; TEST-EXPECT: PASS
;; TEST-HOIST[CUDA]: validate-cuda-host-run
;; HOIST-HARDWARE-PROFILE: h100
;; HOIST-EXPECT: BUFFER out: 6
;;
;; ENDEAVOUR 181 -- the CUDA twin of 06: reduce-vec on the occupancy grid.  The launcher computes
;; gridX from the occupancy query and the SM count at run time (thousands of blocks of 32 on an H100),
;; so the partials buffer must be allocated after gridX is known and before the launch.

(def-type in-vec (vector float :address-space :global :align :compact))
(def-type out-c  (cell float :address-space :global))

(def-kernel rv_sum_occupancy_cuda (A &out out)
  (declare #'(in-vec &out out-c => nil)
           (global-size :derive-from A :strategy :strided)
           (local-size  :set-to 32))
  (reduce-vec #'+ A 0.0 out))
