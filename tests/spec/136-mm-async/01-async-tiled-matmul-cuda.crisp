;; Endeavor 136 (mm-async, Chapter 1) — the ASYNC twin of 135/03.
;;
;; Byte-for-byte the synchronous tiled matmul of 135/03, plus the three async touches:
;;   - (make-async-barrier) bound once,
;;   - :barrier on each (load-tile ...) so the SLM staging is a non-blocking cp.async,
;;   - (await barrier) before the MMA so the tiles have landed.
;;
;; This is the exact kernel that used to produce MMA_WRONG / C=0 on metal (the 114/117
;; per-thread flat cp.async under-copied the 16x8 A-tile: 128 elements, 32 threads, so a
;; one-cp.async-per-thread copy left 3/4 of the tile stale).  Endeavor 136 replaced that
;; with a cooperative cp.async coop-loop + commit_group, and (await) -> wait_group(0).
;; If a future change regresses the copy back to the flat form, THIS test goes MMA_WRONG.
;;
;; The A-tile (16x8 = 128) is deliberately larger than the workgroup (32), so each thread
;; issues 4 cp.async copies through the coop loop — i.e. this exercises the many-elements-
;; per-thread case that the broken flat copy got wrong.
;;
;; One warp computes a single 16x8 output tile (grid == #tiles == 1: grid-y=grid-x=0).
;; k-step = 8 = the tiles' shared K-extent = the MMA shape's K.  MMA-DIMS 16 8 16 => K=16
;; => the macro loops K/8 = 2 K-steps through SLM.  NVIDIA MMA shape (16 8 8), B col-major.
;;
;;   (145: differentiates. Async staging is recovered like any other — the backward
;;    reads a staged tile's primal from its ORIGINAL GLOBAL source at the load-tile-at
;;    origin, and the :barrier key-args do not hide it. Verified NUMERICALLY on metal by
;;    145/15 (async scalar) and 145/16 (async + MMA), not merely by compiling.)
;; TEST-WITH[--ir-target=ptx]
;; SKIP-DEFAULT-PASS
;;
;; MMA-DIMS: 16 8 16
;; TEST-HOIST[CUDA]: validate-cuda-mma-run
;; HOIST-EXPECT: MMA_CORRECT

(def-type a-mat (matrix float :address-space :global :align :compact :contiguous-term :row-major))
(def-type b-mat (matrix float :address-space :global :align :compact :contiguous-term :col-major))
(def-type c-mat (matrix float :address-space :global :align :compact :contiguous-term :row-major))

(def-kernel tiled_matmul (A B &out C)
  (declare #'(a-mat b-mat &out c-mat)
           (global-size :set-to 32)
           (local-size  :set-to 32))          ; one warp
  (let ((A-tile   (make-scratch-matrix float (16 8)))    ; SLM: M×8 (one K-step of A)
        (B-tile   (make-scratch-matrix float (8 8)))     ; SLM: 8×N (one K-step of B)
        (C-tile   (make-register-tile float (16 8) 0.0))
        (K        (inner-dimension A B))
        ;; Explicit :type/:mode pins the cp.async LINEAR path even when a future
        ;; topology-aware default would pick :block on a modern arch (e.g. sm_90).
        (barrier  (make-async-barrier :mode :linear)))
    (matrix-multiply-tile-stride C C-tile K 8 (grid-y grid-x grid-k)
      (load-tile A A-tile (grid-y grid-k) :barrier barrier)   ; async-stage A[gy-block, gk-block]
      (load-tile B B-tile (grid-k grid-x) :barrier barrier)   ; async-stage B[gk-block, gx-block]
      (await barrier)                                         ; cp.async.wait_group 0
      (mma-accumulate-via-tile (16 8 8) C-tile A-tile B-tile)
      (sync-workgroup)
      :epilogue
      (store-tile C-tile C (grid-y grid-x)))))
