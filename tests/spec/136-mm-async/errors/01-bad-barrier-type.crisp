;; Endeavor 136 — negative: make-async-barrier :type must be one of the supported
;; interconnect types.  Only :global (global/local DMA) is implemented in Chapter 1;
;; :p2p / :pcie / :pgas-fabric are future topology work and must be rejected loudly
;; rather than silently ignored.
;;
;; CHECK-FAIL: ":type"

(def-type vec-t (vector float :address-space :global :align :compact))

(def-kernel bad_barrier_type (src &out dst)
  (declare #'(vec-t &out vec-t => nil)
           (global-size :set-to 8)
           (local-size  :set-to 8))
  (let ((bar   (make-async-barrier :type :pcie :mode :linear))
        (tile  (make-scratch-vector float 8))
        (wg-id (get-workgroup-id 0)))
    (load-tile src tile (wg-id) :barrier bar)
    (await bar)
    (store-tile tile dst (wg-id))))
