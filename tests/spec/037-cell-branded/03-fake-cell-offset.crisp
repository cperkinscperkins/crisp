
;; TEST-WITH[--differentiate]

;; This test makes a new def-record type called fake-cell that employs
;; branding for offset and value.  This allows us to test this works
;; before updating the "real" cell with branding.

(with-template-type (T addr)
    (def-record fake-cell
        ;; branded types
        (brand index-t ulong :subst :ancestor :enforce :diff)
        (brand value-t T :subst :ancestor :enforce :diff) ;; oh no, this brand, as declared, will break the "one brand == one underlying type rule" after template specializations
        ;; members
        (parent (storage addr))
        (offset index-t)
        ;(element-type type-spec :c-T T)
        (address-space address-space :c-t addr))

    (def-function ~ (c)
        (declare #'((fake-cell T :address-space addr) => (value-t c)))
        ;; do something with storage.
        (as T 1))

    (def-function set-~ (c v)
    ;; the setter function does not need to enforce brand / track provenance. That makes using the cell too difficult
    ;; and does not contribute to the A|D pass.
        (declare #'((fake-cell T :address-space addr) T => nil))
        ;; do something with storage
        (return)))




(def-function offset-fake-cell (fc delta)
    (declare #'((fake-cell int :global) ulong => nil))
    (let ((target (+ (offset~ fc) (as (index-t fc) delta))))
        (set! (offset~ fc) target)))
        
    

