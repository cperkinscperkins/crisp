;; TEST-EXPECT: PASS
;; KIP-WITH[--differentiate]: 'pending redesign — see comment block below'
;;
;; Under --differentiate this test originally expected:
;;   FAIL-WITH "Type mismatch for operator '+'"
;;
;; Why it's skipped under --differentiate (2026-05-05, :access removal endeavor):
;;   Same situation as errors/10-value-t-no-compose.crisp.  The cell
;;   brand is :subst :descendant (recessive) — under proper brand
;;   semantics, value-t<A> and value-t<B> should compose via substitution
;;   to the base type.  A no-compose / no-dominate test for the cell case
;;   needs a redesigned brand semantic that this endeavor doesn't address.

(def-type in-ish (cell int :address-space :global))
(def-type out-ish (cell int :address-space :global))

(def-kernel value_t_no_composes (A B &out C)
    (declare #'(in-ish in-ish &out out-ish => nil))
    (let ((v1 (* (~ A) 2))      ;; v1 is value-t<A>
          (v2 (* (~ B) 3))      ;; value-t<B>
          (v-final (+ v1 v2)))  ;; illegal when --differentiate (currently silently composes)
      (set! (~ C) v-final)))
