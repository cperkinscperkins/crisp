;; TEST-EXPECT: PASS 
;; FAIL-WITH[--differentiate]: "message"

(def-type in-ish (cell int :address-space :global :access :read-write))
(def-type out-ish (cell int :address-space :global :access :read-write))

(def-kernel value_t_no_composes (A B &out C)
    (declare #'(in-ish in-ish &out out-ish => nil))
    (let ((v1 (* (~ A) 2))      ;; v1 is value-t<A>
          (v2 (* (~ B) 3))      ;; value-t<B>
          (v-final (+ v1 v2)))  ;; illegal when --differentiate
      (set! (~ C) v-final)))