;;  branding on Storage Handles wasn't actually being used to for provenance during A|D passes.
;;  Instead we are simply walking the ANF transform. 
;;  So branding was removed.
;;  Therefore, this test IS differentiable now.  Awesome. 
;;  This test should probably be (re)moved. It's no longer an error at all.


(def-type in-ish (cell int :address-space :global))
(def-type out-ish (cell int :address-space :global))

(def-kernel value_t_no_composes (A B &out C)
    (declare #'(in-ish in-ish &out out-ish => nil))
    (let ((v1 (~ A))
          (v2 (~ B))
          (v-final (+ v1 v2)))
      (set! (~ C) v-final)))
