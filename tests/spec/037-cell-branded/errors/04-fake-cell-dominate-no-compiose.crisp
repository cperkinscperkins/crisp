;; TEST-EXPECT: PASS 
;; FAIL-WITH[--differentiate]: "message"


(with-template-type (T addr acc)
    (def-record fake-cell
        ;; branded types
        (brand index-t ulong :subst :ancestor :enforce :diff)
        (brand value-t T :subst :ancestor :enforce :diff) ;; oh no, this brand, as declared, will break the "one brand == one underlying type rule" after template specializations
        ;; members
        (parent (storage addr))
        (offset index-t)
        ;(element-type type-spec :c-T T)
        (address-space address-space :c-t addr)
        (access access :c-t acc))

    (def-function ~ (c)
        (declare #'((fake-cell T :address-space addr :access acc) => (value-t c)))
        ;; do something with storage.
        (as T 1))

    (def-function set-~ (c v)
    ;; the setter function does not need to enforce brand / track provenance. That makes using the cell too difficult
    ;; and does not contribute to the A|D pass. 
        (declare #'((fake-cell T :address-space addr :access acc) T => nil))
        ;; do something with storage
        (return)))


(def-type in-ish (cell int :address-space :global :access :read-write))
(def-type out-ish (cell int :address-space :global :access :read-write))

(def-kernel fake_value_t_no_composes (off-A off-B &out C)
    (declare #'(ulong ulong &out out-ish => nil))
    (gen-fake-cell int :global :read-write)
    (let ((A (make-fake-cell :parent (parent~ C) :offset off-A  :address-space :global :access :read-write))
          (B (make-fake-cell :parent (parent~ C) :offset off-B  :address-space :global :access :read-write))
          (v1 (* (~ A) 2))     ;; v1 is value-t<A>
          (v2 (* (~ B) 3))     ;; value-t<B>
          (v-final (+ v1 v2))) ;; :subst :ancestors should refuse to compile, no?
      (set! (~ C) v-final)))


