;; TEST-EXPECT: PASS
;; TEST-HOIST[L0]: validate-l0-host-run
;; TEST-HOIST[CUDA]: validate-cuda-host-run
;; HOIST-EXPECT: BUFFER outv: 1 3 1 3
;; HOIST-EXPECT: BUFFER outi: 11 13 11 13
;;
;; BUG 093 -- an IF whose two branches EACH return multiple values.
;;
;; `pick` is the argmax combiner's shape: keep whichever (value, index) pair has the larger value.
;; Before the fix the IF's result slot was sized from the FIRST value only (`alloca i32`), while
;; both branches built the full { i32, i64 } -- llvm-as rejected the module:
;;
;;     error: value doesn't match function result type '{ i32, i64 }'
;;
;; Inputs are the harness's pre-fill, xs = 0 1 2 3 (a b c d); the indices are 10..13 so they
;; cannot be confused with the values:
;;
;;     slot 0: (pick a 10 b 11) -> (1 11)
;;     slot 1: (pick d 13 c 12) -> (3 13)
;;     slot 2: (pick b 11 a 10) -> (1 11)
;;     slot 3: (pick c 12 d 13) -> (3 13)
;;
;; Each argument order appears both ways round, so a result that ignored the comparison and always
;; returned one branch would fail.

(def-type ivec-t (vector int   :address-space :global :align :compact))
(def-type uvec-t (vector ulong :address-space :global :align :compact))

(def-function pick (va ia vb ib)
  (declare #'(int ulong int ulong => int ulong))
  (if (> va vb)
      (return va ia)
      (return vb ib)))

(def-kernel mv_return_per_branch (xs &out outv outi)
  (declare #'(ivec-t &out ivec-t uvec-t => nil)
           (global-size :set-to 4)
           (local-size  :set-to 4))
  (let ((a (~ xs 0)) (b (~ xs 1)) (c (~ xs 2)) (d (~ xs 3)))
    (let ((v0 i0 (pick a (to-ulong 10) b (to-ulong 11))))
      (set! (~ outv 0) v0)
      (set! (~ outi 0) i0))
    (let ((v1 i1 (pick d (to-ulong 13) c (to-ulong 12))))
      (set! (~ outv 1) v1)
      (set! (~ outi 1) i1))
    (let ((v2 i2 (pick b (to-ulong 11) a (to-ulong 10))))
      (set! (~ outv 2) v2)
      (set! (~ outi 2) i2))
    (let ((v3 i3 (pick c (to-ulong 12) d (to-ulong 13))))
      (set! (~ outv 3) v3)
      (set! (~ outi 3) i3))))
