
(def-function first () 
  (declare (return-type int)) 
7)

(def-function second () 
  (declare (return-type float)) 
8.1)

(def-function adds (a b) 
  (declare (type a b int) (return-type int)) 
  (+ a b))


(def-function moar (a b) 
  (declare #'(int int => int)) 
  (+ a b))

(def-function call-another (a b)
  (declare #'(int int => int))
  (moar a b))


(def-function nested-calls (a b)
  (declare #'(int int => int))
  (+ a (+ b (first))))

(def-function wow-explicit-return () 
  (declare (return-type int)) 
 (return 7))
 

(def-function wow-return-mv () 
  (declare (return-type int int)) 
 (return 7 8))

(def-function bc-callee-returns-mv () 
  (declare (return-type int int)) 
 (wow-return-mv))

(def-function callee-returns-mv-but-us-only-one () 
  (declare (return-type int)) 
 (wow-return-mv))

 (def-function arrow-mv ()
  (declare #'(=> int int))
  (wow-return-mv))



#|
;; this should error
(def-function return-moar-types ()
  (declare #'(=> int int int))
  (wow-return-mv))

