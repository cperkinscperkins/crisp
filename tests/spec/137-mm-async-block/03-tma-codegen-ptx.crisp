;; Endeavor 137 (Chapter 1.5) Phase 2a — NVIDIA :block TMA codegen SHAPE.
;;
;; A :block barrier on a Hopper arch (sm_90+) lowers (load-tile ... :barrier bar) to the
;; Tensor Memory Accelerator path: an SLM mbarrier object (mbarrier.init) plus a bulk
;; descriptor-driven copy (cp.async.bulk.tensor...mbarrier::complete_tx::bytes) issued by a
;; single elected leader thread, with the wait side observing the mbarrier.
;;
;; This is the COMPILE-SHAPE test: it asserts the TMA opcodes reach the emitted PTX.  As of
;; Phase 2b this kernel is fully wired — a real CUtensorMap descriptor implicit arg (option A,
;; host cuTensorMapEncodeTiled emitted by crisp-hoist-cuda) + the nvcc-verified expect_tx /
;; try_wait.parity completion — and was metal-verified CORRECT on an H100 (sm_90a): the TMA
;; loaded A's 4x4 tile and C == A on read-back.  (NB: TMA requires the sm_90a target variant;
;; --ir-target-arch=sm_90 auto-upgrades the PTX .target to sm_90a.)  Automated metal is not in
;; CI (no Hopper runner), so this stays a compile+PTX-shape check.
;;
;; HOIST-ARCH: sm_90
;; TEST-WITH[--ir-target=ptx --ir-target-arch=sm_90] : validate-ptx-tma
;; VERIFY-AUTODIFF[CUDA]: A=4x4@1:1 at.A=1,2 h=0.5 atol=1e-3 expect.A=1.0 output-mat=4x4 group=4
;;
;; Endeavor 147: the SKIP-WITH[--differentiate] is GONE.  Its reason was
;; "VERIFY-AUTODIFF runs on SPV/L0 -- so the gradient VALUES cannot be checked
;; on this machine", and that is no longer true: the directive now has a CUDA
;; runtime, and it encodes the CUtensorMap descriptor this kernel's TMA path
;; needs (cuTensorMapEncodeTiled over A's buffer, from the :kind :tensor-map
;; implicit param in the .metacrisp).
;;
;; f(A) = sum_ij C[i][j] = sum_ij A[i][j] since C = A, so every element's
;; gradient is 1.0.  MEASURED on an H100 (sm_90a), not assumed -- which is
;; what the old skip note asked for, and for the reason it gave: 135/01
;; compiled with correct-looking atomics and still returned 0.0.
;;
;; h=0.5 because f is LINEAR: the central difference carries no truncation
;; error at any step, so a large h is strictly better -- it buys precision
;; against float32 cancellation on a sum of 136.  At the default h=1e-3 the FD
;; noise alone is ~7e-3, which has nothing to do with the gradient.

(def-type mat-t (matrix float :address-space :global :align :compact :contiguous-term :row-major))

(def-kernel tma_load (A &out C)
  (declare #'(mat-t &out mat-t)
           (global-size :set-to 4)
           (local-size  :set-to 4))
  (let ((A-tile (make-scratch-matrix float (4 4)))
        (bar    (make-async-barrier :mode :block)))
    (load-tile A A-tile (0 0) :barrier bar)   ;; TMA: cp.async.bulk.tensor + mbarrier
    (await bar)
    (store-tile A-tile C (0 0))))
