;; TEST-WITH[--ir-target=ptx]
;;
;; Endeavor 146: the old reason read "to-float has no AD rule -- an int->float conversion the
;; engine lacks a derivative for".  Accurate as a description, and now fixed rather than
;; described.  int -> float is the IDENTITY on value, so d/dx = 1 and the adjoint passes
;; straight through.
;;
;; The asymmetry with the integer conversions is mathematical, not a convenience: float -> int
;; TRUNCATES, which is a step function with d/dx = 0 almost everywhere, so
;; %backward-skip-fn-p-145p1 treating TO-<int-type> as gradient-inert is CORRECT — unlike the
;; rem/mod entries 146 Gap 2 had to remove, where the derivative is 1 and inertness was a lie.
;;
;; Here the argument is `(to-float M)` with M from outer-dimensions — a shape query that is
;; itself inert — so the adjoint flows into something the walk already skips and the answer is
;; a correct zero REACHED BY THE ANALYSIS rather than asserted by a special case.
;; SKIP-WITH[--debug]: "pre-existing --debug c-t-accessor codegen bug (plan/bugs.md #033)"
;;
;; F2 — outer-dimensions.  Companion to inner-dimension (=> K, the contraction extent).
;; (outer-dimensions A B) => M N, the two NON-contracted extents: M = A's outer/row extent
;; (A is M×K row-major → extents[0]), N = B's outer/col extent (B is K×N col-major →
;; extents[1]).  Returns TWO values, bound via a multi-value let (like (floor …)/(truncate …)).

(def-type a-mat (matrix float :address-space :global :align :compact :contiguous-term :row-major))
(def-type b-mat (matrix float :address-space :global :align :compact :contiguous-term :col-major))
(def-type c-mat (matrix float :address-space :global :align :compact :contiguous-term :row-major))

(def-kernel outer_dims (A B &out C)
  (declare #'(a-mat b-mat &out c-mat)
           (global-size :set-to 1)
           (local-size  :set-to 1))
  (let ((M N (outer-dimensions A B)))          ; M = rows(A), N = cols(B)
    (set! (~ C 0 0) (to-float M))
    (set! (~ C 0 1) (to-float N))))
