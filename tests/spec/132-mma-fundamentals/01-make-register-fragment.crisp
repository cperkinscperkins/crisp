;; P1 (MMA fundamentals) — make-register-fragment.
;;
;; make-register-fragment mints a WARP-COLLECTIVE accumulator fragment: a
;; register-backed record whose 16x8 = 128 elements are distributed across the 32
;; lanes of one warp (4 per lane).  Here we mint a 16x8 fp32 accumulator initialized
;; to a constant and store it back to a global 16x8 matrix so the value round-trips.
;;
;; NOTE: a UNIFORM constant only exercises init + store-touched-every-element; it does
;; NOT validate the element->lane layout (all values are equal).  Layout correctness
;; arrives in P2 via load-fragment on non-uniform data.
;;
;; SKIP-WITH[--differentiate]: "forward-only MMA fundamentals"
;; TEST-WITH[--ir-target=ptx]
;; SKIP-DEFAULT-PASS
;;   MMA fundamentals target PTX (tensor cores) — validate ONLY via the PTX pass.
;;   SKIP-DEFAULT-PASS opts out of the no-flags GENERIC run: MMA has no meaningful
;;   GENERIC lowering, and this keeps the spec off the GENERIC clang-verify path that
;;   trips the pre-existing --debug c-t-accessor bug (plan/bugs.md #033).

(def-type out-m (matrix float :address-space :global :align :compact :contiguous-term :row-major))

(def-kernel make_frag (&out C)
  (declare #'(&out out-m => nil)
           (global-size :set-to 32)
           (local-size  :set-to 32))          ; exactly one warp
  (let ((acc (make-register-fragment 16 8 7.0)))
    (store-fragment acc C (0 0))))
