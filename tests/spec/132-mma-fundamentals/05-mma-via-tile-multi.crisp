;; P3b (MMA fundamentals) — mma-accumulate-via-tile, MULTI-fragment tile.
;;
;; A 16x16 C-tile = two 16x8 fragments (N-frags = 16/8 = 2).  C = A[16x8] . B[8x16]
;; (K = 8, one K-step).  The walk unrolls to TWO mma.sync (one per N-fragment): A's
;; fragment is shared, B's fragment shifts by N-tile.  store-tile writes both fragments.
;;
;; COMPILE-WITH[--ir-target=ptx --differentiate]: PASS
;;   (145: differentiates. The VJP picks its lowering — MMA where the tile dims
;;    decompose into whole fragments, plain scalar loops otherwise.)
;; TEST-WITH[--ir-target=ptx]
;; SKIP-DEFAULT-PASS
;; SKIP-WITH[--debug]: "pre-existing --debug c-t-accessor codegen bug (plan/bugs.md #033)"
;;
;; Endeavor 134 — on-metal correctness (host-reference C=A·B) via the hoist's --mma-test.
;; C[16×16] = A[16×8]·B[8×16]; two 16×8 N-fragments, NVIDIA shape (16 8 8).
;; MMA-DIMS: 16 16 8
;; TEST-HOIST[CUDA]: validate-cuda-mma-run
;; HOIST-EXPECT: MMA_CORRECT

(def-type a-mat (matrix float :address-space :global :align :compact :contiguous-term :row-major))
(def-type b-mat (matrix float :address-space :global :align :compact :contiguous-term :col-major))
(def-type c-mat (matrix float :address-space :global :align :compact :contiguous-term :row-major))

(def-kernel via_tile_multi (A B &out C)
  (declare #'(a-mat b-mat &out c-mat)
           (global-size :set-to 32)
           (local-size  :set-to 32))          ; one warp
  (let ((C-tile (make-register-tile float (16 16) 0.0)))
    (mma-accumulate-via-tile (16 8 8) C-tile A B)
    (store-tile C-tile C (0 0))))
