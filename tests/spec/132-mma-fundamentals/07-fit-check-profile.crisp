;; TEST-EXPECT: PASS
;; COMPILE-WITH[--hardware-profile=small-regs]: FAIL "register budget"
;;
;; F1 fit-check, profile branch.  A 64×64 tile = (64/16)×(64/8) = 4×8 = 32 accumulator
;; fragments × 4 fp32 regs = 128 registers/thread.  That FITS the NVIDIA default budget
;; (255), so the plain compile passes — but a hardware profile pinning
;; :max-registers-per-thread to 100 rejects it.  Same tile, budget from the profile.

(def-hardware-profile small-regs :max-registers-per-thread 100)

(def-type out-m (matrix float :address-space :global :align :compact :contiguous-term :row-major))

(def-kernel tile_fits_default (&out C)
  (declare #'(&out out-m => nil)
           (global-size :set-to 32)
           (local-size  :set-to 32))          ; one warp
  (let ((tile (make-register-tile float (64 64) 0.0)))
    (store-tile tile C (0 0))))
