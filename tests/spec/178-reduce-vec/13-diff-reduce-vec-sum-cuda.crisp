;; TEST-EXPECT: PASS
;; COMPILE-WITH[--hardware-profile=h100 --ir-target=ptx --differentiate]: PASS
;; HOIST-HARDWARE-PROFILE: h100
;; VERIFY-AUTODIFF[CUDA]: A=300@0:0.01 at.A=257 expect.A=1.0 atol=1e-2 h=0.5 group=64 groups=2
;;
;; ENDEAVOUR 178 -- the CUDA twin of 10: AUTODIFF through reduce-vec (default strategy).
;;
;; NOT YET RUN ON NVIDIA (written on the BMG box, where a [CUDA] check SKIPs).  Element 257 is
;; thread 1's third stride iteration; d(out)/dA[k] = 1.

(def-type in-vec (vector float :address-space :global :align :compact))
(def-type out-c  (cell float :address-space :global))

(def-kernel diff_rv_sum_cuda (A &out out)
  (declare #'(in-vec &out out-c => nil)
           (global-size :set-to 128)
           (local-size  :set-to 64))
  (reduce-vec #'+ A 0.0 out))
