;; CHECK-FAIL: "dispatch"
;; def-function (thread-level) cannot call a def-grid-function.
;; Grid functions require a dispatch context.

(def-type out-t (cell int :address-space :global :access :read-write))

(def-grid-function my-grid-fn (&out result)
  (declare #'(&out out-t))
  (set! (~ result) 0))

(def-function bad-caller (result)
  (declare #'(&out out-t => nil))
  (my-grid-fn result))
