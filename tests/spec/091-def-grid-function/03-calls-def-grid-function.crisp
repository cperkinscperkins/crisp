;; TEST-EXPECT: PASS
;; TEST-WITH[--ir-target=spv]
;; def-grid-function can call another def-grid-function.

(def-type out-t (cell int :address-space :global))

(def-grid-function set-value (v &out result)
  (declare #'(int &out out-t))
  (set! (~ result) v))

(def-grid-function fill-with-ten (&out result)
  (declare #'(&out out-t))
  (set-value 10 result))
