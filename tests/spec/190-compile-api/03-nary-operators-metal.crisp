;; TEST-EXPECT: PASS
;; TEST-HOIST[L0]: validate-l0-host-run
;; TEST-HOIST[CUDA]: validate-cuda-host-run
;; HOIST-EXPECT: BUFFER arith: 6 6 4 2
;; HOIST-EXPECT: BUFFER minmax: 1 3 2 3
;; HOIST-EXPECT: BUFFER chains: 1 0 1 1
;; HOIST-EXPECT: BUFFER more: 1 1 1 0
;; SKIP-WITH[--differentiate]: "min / max have no AD rule (a pre-existing gap, not BUG 127; 04-nary-product-ad covers AD through a fold)"
;;
;; BUG 127 (endeavour 190) -- an operator call with more than two operands once compiled with the
;; extra operands SILENTLY DROPPED: (* x x w) was (* x x).  Found by the compile-API PyTorch example.
;; Now, as in Common Lisp: + - * / min max FOLD LEFT, and < <= > >= = CHAIN, each operand evaluated
;; once.  Inputs are pre-filled 0 1 2 3, so a = 1, b = 2, c = 3.
;;   arith:  (+ a b c) = 6   (* a b c) = 6   (- 10 a b c) = 4   (/ 12 b c) = 2
;;   minmax: (min c b a) = 1 (max a c b) = 3 (+ b) = 2          (* c) = 3
;;   chains: (< a b c) = 1   (< a c b) = 0   (= a a a) = 1      (> c b a) = 1
;;   more:   (<= a a b) = 1  (>= c c a) = 1, and with NON-ATOMIC operands (bound to temporaries):
;;           (< xs[1] xs[2] xs[3]) = 1       (< xs[3] xs[2] xs[1]) = 0

(def-type ivec-t (vector int :address-space :global :align :compact))

(def-kernel nary_ops (xs &out arith minmax chains more)
  (declare #'(ivec-t &out ivec-t ivec-t ivec-t ivec-t => nil)
           (global-size :set-to 4)
           (local-size  :set-to 4))
  (let ((a (~ xs 1)) (b (~ xs 2)) (c (~ xs 3)))
    (set! (~ arith 0) (+ a b c))
    (set! (~ arith 1) (* a b c))
    (set! (~ arith 2) (- 10 a b c))
    (set! (~ arith 3) (/ 12 b c))
    (set! (~ minmax 0) (min c b a))
    (set! (~ minmax 1) (max a c b))
    (set! (~ minmax 2) (+ b))
    (set! (~ minmax 3) (* c))
    (set! (~ chains 0) (if (< a b c) 1 0))
    (set! (~ chains 1) (if (< a c b) 1 0))
    (set! (~ chains 2) (if (= a a a) 1 0))
    (set! (~ chains 3) (if (> c b a) 1 0))
    (set! (~ more 0) (if (<= a a b) 1 0))
    (set! (~ more 1) (if (>= c c a) 1 0))
    (set! (~ more 2) (if (< (~ xs 1) (~ xs 2) (~ xs 3)) 1 0))
    (set! (~ more 3) (if (< (~ xs 3) (~ xs 2) (~ xs 1)) 1 0))))
