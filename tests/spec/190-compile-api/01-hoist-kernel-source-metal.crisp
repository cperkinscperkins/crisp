;; TEST-EXPECT: PASS
;; TEST-HOIST[L0]: validate-l0-host-run
;; HOIST-KERNEL: source
;; HOIST-EXPECT: compiled at run time through the Crisp compile API
;; HOIST-EXPECT: BUFFER out: 1 3 5 7
;;
;; Endeavour 190, S4 -- the dogfood hoist.  The generated launcher holds THIS FILE'S TEXT, compiles
;; it at run time through the C API (c-api/include/crisp.h), and takes every argument slot from the
;; API's answers rather than from indices baked in at hoist time.
;; Inputs are pre-filled 0 1 2 3, so out[k] = 2 * xs[k] + 1 -> 1 3 5 7.

(def-type ivec-t (vector int :address-space :global :align :compact))

(def-kernel twice_plus_one (xs &out out)
  (declare #'(ivec-t &out ivec-t => nil)
           (global-size :set-to 4)
           (local-size  :set-to 4))
  (set! (~ out 0) (+ (* 2 (~ xs 0)) 1))
  (set! (~ out 1) (+ (* 2 (~ xs 1)) 1))
  (set! (~ out 2) (+ (* 2 (~ xs 2)) 1))
  (set! (~ out 3) (+ (* 2 (~ xs 3)) 1)))
