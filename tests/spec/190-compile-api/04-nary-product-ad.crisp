;; TEST-EXPECT: PASS
;; VERIFY-AUTODIFF: A=[1.0 2.0 3.0 4.0] atol=1e-3 at.A=1 expect.A=12.0
;;
;; BUG 127 (endeavour 190) -- a three-operand product must differentiate as the full product.
;; f(A) = A[1] * A[2] * A[3], folded left to ((A[1] * A[2]) * A[3]).  At A = [1 2 3 4]:
;;   df/dA[1] = A[2] * A[3] = 3 * 4 = 12      (when the third operand was dropped it was 3)

(def-type in-vec (vector float :address-space :global :align :compact))
(def-type out-c  (cell float :address-space :global))

(def-kernel triple_product (A &out C)
  (declare #'(in-vec &out out-c))
  (set! (~ C) (* (~ A 1) (~ A 2) (~ A 3))))
