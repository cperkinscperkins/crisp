;; TEST-WITH[--differentiate]


(with-template-type (T)
    (def-type in-ish (cell T :address-space :global))
    (def-type out-ish (cell T :address-space :global))

    (def-type binop-t #'(T T => T)) ;; templated function type alias

    (def-function hof-operation (a b f)
        (declare #'(T T (binop-t T) => T))
        (funcall f (* a a) b))

    (def-kernel sub_op_k (A B &out C)
        (declare #'((in-ish T) (in-ish T) &out (out-ish T)))
        (set! (~ C) (hof-operation (~ A) (~ B) #'+))))

(gen-sub_op_k float)
