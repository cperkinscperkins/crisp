(def-type in-ish (cell float :address-space :global))
(def-type out-ish (cell float :address-space :global))

(def-function some-operation (A B)
    (declare #'(in-ish in-ish => float))
    (set! (~ A) (~ B)) ;;<-- mutation
    (* (~ A) (~ B)))

(def-kernel sub_op (A B &out C)
  (declare #'(in-ish in-ish &out out-ish))
  (set! (~ C) (some-operation A B)))
