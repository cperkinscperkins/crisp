;; TEST-WITH[--differentiate]

(def-type in-ish (cell float :address-space :global))
(def-type out-ish (cell float :address-space :global))

(def-function some-operation (a b)
    (declare #'(float float => float float))
    (return (+ (* a a) b)
             (* (+ a a) b)))

(def-kernel sub_op_mvb (A B &out C D)
  (declare #'(in-ish in-ish &out out-ish out-ish))
  (let ((x y (some-operation (~ A) (~ B))))
     (set! (~ C) x)
     (set! (~ D) y)))