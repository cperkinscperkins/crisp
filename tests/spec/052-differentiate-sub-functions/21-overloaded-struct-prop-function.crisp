;; TEST-WITH[--differentiate]
;; KNOWN-ISSUE[differentiate]: BUG-126
;; (BUG 126: the backward pass stores a FLOAT adjoint into the point-typed A_GRAD cell -- 4 bytes
;; into an 8-byte struct.  It compiled silently until endeavour 186 typed element stores.)

(def-struct point (x float) (y float))

(def-type in-ish (cell point :address-space :global))
(def-type out-ish (cell point :address-space :global))

(def-function some-operation (a b)
    (declare #'(float float => float))
    (+ (* a a) b))

(def-function x~ (pt)
    (declare #'(point => float))
    (* (~x~ pt) (y~ pt)))

(def-kernel struct_op (A &out C)
  (declare #'(in-ish &out out-ish))
  (set! (x~ (~ C)) (some-operation (x~ (~ A)) (y~ (~ A)))))