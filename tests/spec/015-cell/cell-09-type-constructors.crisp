;; storage handle type definitions.

;; type constructors

;; &key (cell T &key :address-space)
(def-function kernel-proxy (A B C)
    (declare #'((cell int) (cell int :address-space :global) (cell float :address-space :local) => nil))
    (let ((quot rem (truncate (~ C))))
        (set! (~ A) quot)
        (set! (~ B) rem)))

(def-function kernel-proximate (A B C)
    (declare #'((cell long :address-space :global) (cell long :address-space :local) (cell long :address-space :local) => nil))
    (set! (~ C) (to-float (+ (~ A) (~ B)))))

(def-function change-order (A B C)
    (declare #'((cell float :address-space :local)
                (cell long)
                (cell float :address-space :global)))
    (set! (~ C) (+ (to-float (~ B)) (~ A))))