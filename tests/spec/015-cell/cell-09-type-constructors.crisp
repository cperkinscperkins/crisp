;; storage handle type definitions.

;; type constructors

;; &key (cell T &key :address-space :access)
(def-function kernel-proxy (A B C)
    (declare #'((cell int) (cell int :address-space :global) (cell float :address-space :local) => nil))
    (let ((quot rem (truncate (~ C))))
        (set! (~ A) quot)
        (set! (~ B) rem)))

(def-function kernel-proximate (A B C)
    (declare #'((cell long :address-space :global :access :read-only) (cell long :address-space :local :access :read-only) (cell long :address-space :local :access :write-only) => nil))
    (set! (~ C) (to-float (+ (~ A) (~ B)))))

