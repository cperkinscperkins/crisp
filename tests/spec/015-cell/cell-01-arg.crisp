;; cell is a parameterized type.
;; It's type declaration uses &key for :address-space.
;; we no longer attempt to support 'cell' alone or '(cell)'.

(def-function test-cell-as-arg (c1)
    (declare #'((cell long) => nil))
    (return))

(with-template-type (T)
    (def-function test-templated-cell-as-arg (c)
        (declare #'((cell T) => nil))
        (return)))

(gen-test-templated-cell-as-arg float)