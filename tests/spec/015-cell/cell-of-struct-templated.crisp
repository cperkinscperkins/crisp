(with-template-type (T)
    (def-struct point (x T) (y T)))

;; Helper to test setting member of dereferenced cell of templated struct
(with-template-type (T)
    (def-function test-cell-of-struct (p v)
        (declare #'((cell (point T) :address-space :global :access :read-write) T => nil))
        (set! (x~ (~ p)) v)
        (return)))

(def-function test-explicit (p v)
    (declare #'((cell (point int) :address-space :global :access :read-write) int => nil))
    ;; Explicitly instantiate everything
    (gen-point int) 
    (gen-test-cell-of-struct int)
    
    ;; Call the generic function
    (test-cell-of-struct p v)
    
    ;; Test manual set! logic too
    (set! (y~ (~ p)) v)
    (return))

(def-function test-implicit (p v)
    (declare #'((cell (point long) :address-space :global :access :read-write) long => nil))
    ;; Implicitly instantiate via usage
    (test-cell-of-struct p v)
    (set! (y~ (~ p)) v)
    (return))

;; double 
(with-template-type (T U)
    (def-function compare-parent (A B)
        (declare #'((cell T) (cell U) => ulong))
        ;; (equal (parent~ A) (parent~ B)) ;; do we have equal? Do we want it?  Would = work?
        ;; alternately
        (= (byte-size~ (parent~ A)) (byte-size~ (parent~ B)))))

;; top level
(gen-compare-parent long float)
(def-function compare-parent-cells-01 (c1 c2)
    (declare #'((cell long) (cell float) => ulong))
    (compare-parent c1 c2))

;; nested
(def-function compare-parent-cells-02 (c1 c2)
    (declare #'((cell float) (cell long) => ulong))
    (gen-compare-parent float long)
    (compare-parent c1 c2))

;; inferred (if possible)
;; if this is not possible, just leave a note and comment out this last
;; test function. don't delete it.
(def-function compare-parent-cells-02 (c1 c2)
    (declare #'((cell uint) (cell double) => ulong))
    (compare-parent c1 c2))