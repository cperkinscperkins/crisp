;; TEST-WITH[--ir-target=llvmir --differentiate]: validate-subtraction-chain-rule
;; VERIFY-AUTODIFF: A=5.0 B=2.0 atol=1e-3 expect.A=1.0 expect.B=-1.0
;;
;; C = A - B  =>  df/dA = 1.0,  df/dB = -1.0

(def-type in-ish (cell float :address-space :global))
(def-type out-ish (cell float :address-space :global))

(def-kernel cell_sub (A B &out C)
  (declare #'(in-ish in-ish &out out-ish))
  (set! (~ C) (- (~ A) (~ B))))
