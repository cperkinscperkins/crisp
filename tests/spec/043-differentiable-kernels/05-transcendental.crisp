;; TEST-WITH[--ir-target=llvmir --differentiate]: validate-transcendental-chain-rule

(def-type in-ish (cell float :address-space :global))
(def-type out-ish (cell float :address-space :global))

(def-kernel cell_sin (A &out C)
  (declare #'(in-ish &out out-ish))
  (set! (~ C) (sin (~ A))))
