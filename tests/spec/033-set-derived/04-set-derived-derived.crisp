;; TEST-WITH[ir-target=llvmir] : validate-correct-overload-set-derived-derived

(def-struct point (x int) (y int))

(def-derived-type coordinate point :subst :descendant)

(def-struct vertex (a int) (b int) (c int))

(set-derived coordinate vertex)

(def-function sum-point (p)
    (declare #'(point => int))
    (x~ p))

(def-function sum-point (c)
    (declare #'(coordinate => int))
    (+ (x~ c) (y~ c)))

(def-function do-math (c v)
    (declare #'(coordinate vertex => int))
    (+ (sum-point c) (sum-point v)))
    