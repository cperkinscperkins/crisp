;; CHECK-FAIL: "needs half or bfloat16 operands"
;; CHECK-FAIL-FLAGS: --ir-target=ptx --ir-target-arch=sm_100a
;; Endeavour 213 -- :b-major :mn on a tf32 tcgen05 multiply is refused: the transpose-B bit is defined for
;; 16-bit operands only, so a float B can only be read as (N K).
(declaim (precision fast))
(def-type mt (matrix float :address-space :global :align :compact :contiguous-term :row-major))
(def-kernel e213_one (&out C)
  (declare #'(&out mt) (global-size :set-to 128) (local-size :set-to 128))
  (let ((A-tile (make-scratch-matrix float (128 32)))
        (B-tile (make-scratch-matrix float (32 128)))
        (D (make-tcgen05-accumulator float (128 128) 0.0)))
    (tcgen05-accumulate-via-tile (128 128 32) D A-tile B-tile :swizzle :128b :b-major :mn)
    (store-tile D C (0 0))))
