;; ENDEAVOUR 176 -- IMPLICIT SCRATCH.  Spec 38 with its :local-scratch-vec left out.  TDD.
;;
;; Same grid and answer as 55, through the CAS-loop strategy instead of the native atomic.

(def-type vec-t (vector float :address-space :global :align :compact))

(def-kernel grid_reduce_cas_implicit (&out out)
  (declare #'(&out vec-t => nil)
           (global-size :set-to 256)
           (local-size  :set-to 64))
  (let ((contrib (to-float (get-global-linear-id))))
    (grid-reduce-cas! #'+ contrib 0.0 out)))
