;; TEST-EXPECT: PASS
;; TEST-WITH[--hardware-profile=bmg --ir-target=spv]
;; SKIP-DEFAULT-PASS
;; TEST-HOIST[L0]: validate-l0-host-run
;; HOIST-HARDWARE-PROFILE: bmg
;; HOIST-EXPECT: BUFFER out: 15 120 2 3
;; SKIP-WITH[--differentiate]: "forward monomorphization only; reduce-warp AD is spec 09's subject"
;;
;; ENDEAVOUR 175 -- a warp reduction reached through a MONOMORPHIZED binop parameter.  TDD.
;;
;; Crisp templates a caller by its function argument: passing #'f to a function instantiates a
;; specialised copy of that function for f (007-templates/02, "HOF-04: Implicit Templating
;; (Monomorphism)").  This spec puts a warp collective on the far side of that instantiation --
;; `warp-reduce-with` takes the binop and calls reduce-warp with it -- which is how a user would
;; actually factor a library of reductions.
;;
;; THE SAME FORWARDER IS INSTANTIATED TWICE, with #'wmax and #'wsum, and BOTH results are
;; checked.  That is the point: a single instantiation would prove only that a function-typed
;; parameter parses.  Two instantiations from one definition, giving two different answers from
;; identical inputs, is what shows the monomorphization actually specialises the body.
;;
;;   every lane contributes its own lane id, over a 16-lane bmg warp:
;;     max -> 15        sum -> 0+1+...+15 = 120
;;
;; Slots 2 and 3 keep the harness pre-fill, so the spec also says the election wrote once.
;;
;; KNOWN TO FAIL AT THE TIME OF WRITING, and the failure is the reason the spec exists:
;;
;;     this kernel uses a shuffle, but its SPIR-V subgroup size cannot be pinned...
;;
;; 173's D7 check reads *kernel-dispatch-declarations* under the name of the function CURRENTLY
;; BEING GENERATED.  For a sub-function that is `warp-reduce-with`, which has no dispatch
;; declarations of its own, so the lookup returns NIL and the kernel's perfectly good
;; (local-size :set-to 64) is never consulted.  Subgroup size is a KERNEL execution mode; a
;; helper does not have one.  Isolated with plain #'+ and no templating at all, so it is a
;; scope bug in D7 rather than anything to do with binops.  See plan/bugs.md.
;;
;; The reduction is computed UNCONDITIONALLY and only the write is elected -- a warp collective
;; inside the election would be refused, and correctly so (errors/04).

(def-type vec-t (vector float :address-space :global :align :compact))

(def-function wmax (a b)
  (declare #'(float float => float))
  (if (> a b) a b))

(def-function wsum (a b)
  (declare #'(float float => float))
  (+ a b))

(def-function warp-reduce-with (f x seed)
  (declare #'(#'(float float => float) float float => float))
  (let ((v x))
    (reduce-warp f v seed)
    v))

(def-kernel monomorphized_warp_reduce (&out out)
  (declare #'(&out vec-t => nil)
           (global-size :set-to 64)
           (local-size  :set-to 64))
  (let ((lane (to-float (warp-lane))))
    ;; Two instantiations of ONE forwarder.
    (let ((mx (warp-reduce-with #'wmax lane -1.0e30))
          (sm (warp-reduce-with #'wsum lane 0.0)))
      (when-thread-in-group-is 0
        (set! (~ out 0) mx)
        (set! (~ out 1) sm)))))
