;; SKIP-WITH[--differentiate]: "fails without lax mode"
;; TEST-WITH[--ir-target=llvmir] : validate-def-record-explode-ir

;; Verifies that records are passed as EXPLODED parameters (SROA), not aggregates.

(def-record v-point (x int) (y int))
;; Expected: %POINT = type { i32, i32 }

(def-function take-point (p)
  (declare (type p v-point) (return-type int))
  ;; Expected: define i32 @take_point_point(i32 %0, i32 %1) -> CORRECT (Exploded)
  (return (+ (x~ p) (y~ p))))

(def-kernel make_and_pass (p)
  (declare (type p v-point) (return-type int))
  ;; Point should explode to 2 int parameters in physical signature
  (take-point p))

