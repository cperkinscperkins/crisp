

(with-template-type (T)
  (def-record v-point 
    (x T) 
    (y T)))

;; 1. Template Instantiation
(def-function test-gen ()
    (declare #'( => (v-point float)))
    (gen-v-point float)
    (make-v-point :x 1.0 :y 2.0))

(def-function test-type-infer ()
    (declare #'( => (v-point int)))
    (make-v-point :x (as-int 1) :y (as-int 2)))

;; 2. Template Function with Template Struct
(with-template-type (T)
  (def-function test-poly (x y)
    (declare #'(T T => (v-point T)))
    (make-v-point :x x :y y)))

(def-function test-of-gen-func ()
    (declare #'( => (v-point long)))
    (gen-test-poly long)
    (test-poly (as-long 1) (as-long 2)))

(def-function test-of-inference-func ()
    (declare #'( => (v-point int)))
    (test-poly (as-int 1) (as-int 2)))
