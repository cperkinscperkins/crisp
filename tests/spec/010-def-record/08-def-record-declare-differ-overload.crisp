;; this is not wrong. It should be allowed and it should work.
;; type resolution doesn't use return types, so this should
;; take the 'slot' of the normal x~ accessor 

(def-record virtual-point 
  (x float) 
  (y float))


(def-function x~ (p)
  (declare #'(virtual-point => long))  ; <-- long, not float.
  (to-long (truncate (~x~ p))))