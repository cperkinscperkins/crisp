;; CHECK-FAIL: "Type mismatch"

;; Negative Test: Return Type Mismatch in Record Inference
;; Expected Error: Type mismatch: Expected (POINT LONG), Actual (POINT INT)

(with-template-type (T)
  (def-record point 
    (x T) 
    (y T)))



(def-function inference ()
    (declare #'( => (point long)))
    (gen-point int)
    ;; This infers POINT<INT> because we explicitly make it so.
    ;; It should mismatch the declared POINT<LONG>.
    (make-point :x (as-int 1) :y (as-int 2)))

