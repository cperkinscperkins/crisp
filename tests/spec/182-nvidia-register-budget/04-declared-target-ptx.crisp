;; TEST-EXPECT: PASS
;; TEST-WITH[--hardware-profile=h100 --ir-target=ptx]: validate-ptx-minnctapersm-2
;;
;; ENDEAVOUR 182 -- (declare (occupancy-target N)) asks for N threads per compute unit on this kernel,
;; whether or not the profile has a target and whether or not the kernel streams.  512 over a 256-thread
;; workgroup is .minnctapersm 2.

(def-type in-vec (vector float :address-space :global :align :compact))
(def-type out-c  (cell float :address-space :global))

(def-kernel rv_sum_declared (A &out out)
  (declare #'(in-vec &out out-c => nil)
           (global-size :derive-from A :strategy :strided)
           (local-size  :set-to (256))
           (occupancy-target 512))
  (reduce-vec #'+ A 0.0 out))
