;; TEST-EXPECT: PASS
;; TEST-WITH[--ir-target=ptx]: validate-ptx-maxnreg-96
;;
;; BUG 135 -- (declare (max-registers N)) is normative: it reaches ptxas as .maxnreg N, and ptxas spills
;; whatever does not fit.  It is independent of the workgroup bound, so both appear here.

(def-type in-vec (vector float :address-space :global :align :compact))
(def-type out-c  (cell float :address-space :global))

(def-kernel rv_capped (A &out out)
  (declare #'(in-vec &out out-c => nil)
           (global-size :derive-from A :strategy :strided)
           (local-size  :set-to (288))
           (max-registers 96))
  (reduce-vec #'+ A 0.0 out))
