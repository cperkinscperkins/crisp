;; TEST-EXPECT: PASS
;; TEST-WITH[--hardware-profile=stream-gpu --ir-target=ptx]: validate-ptx-minnctapersm-2
;;
;; ENDEAVOUR 182 -- the profile states THREADS per compute unit, so the block count follows the
;; workgroup: 1024 over 512 threads is .minnctapersm 2 (and .maxntid 512, 1, 1).

(def-hardware-profile stream-gpu :simd-width 32 :compute-units 132 :stream-occupancy-target 1024)
(def-type in-vec (vector float :address-space :global :align :compact))
(def-type out-c  (cell float :address-space :global))

(def-kernel rv_sum_512 (A &out out)
  (declare #'(in-vec &out out-c => nil)
           (global-size :derive-from A :strategy :strided)
           (local-size  :set-to (512)))
  (reduce-vec #'+ A 0.0 out))
