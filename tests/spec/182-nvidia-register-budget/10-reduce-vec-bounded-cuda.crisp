;; TEST-EXPECT: PASS
;; TEST-HOIST[CUDA]: validate-cuda-host-run
;; HOIST-HARDWARE-PROFILE: stream-gpu
;; HOIST-EXPECT: BUFFER out: 6
;;
;; ENDEAVOUR 182 -- on metal: the bounded kernel (spec 01) runs and gives the right answer through the
;; CUDA hoist, whose occupancy query now sees ptxas's bounded register count and sizes the grid from it.

(def-hardware-profile stream-gpu :simd-width 32 :compute-units 132 :stream-occupancy-target 1024)
(def-type in-vec (vector float :address-space :global :align :compact))
(def-type out-c  (cell float :address-space :global))

(def-kernel rv_sum_bounded_cuda (A &out out)
  (declare #'(in-vec &out out-c => nil)
           (global-size :derive-from A :strategy :strided)
           (local-size  :set-to (256)))
  (reduce-vec #'+ A 0.0 out))
