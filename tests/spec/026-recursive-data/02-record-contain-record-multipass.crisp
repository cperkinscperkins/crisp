;;
;;  records can contain records
;;  Even  if not in reverse dependency order, they should still compile fine.
;;  UNLESS --single-passs is used, then they should error and NOT compile.

;; FAIL-WITH[--single-pass]: "some reasonable message"


(def-record v-rect (ul-corner v-point) (lr-corner v-point))

(def-record v-point (x int) (y int))



