
;; TEST-HOIST[L0] : validate-l0-structs-and-aliases-hoisted



;; iii should appear in metadata by virtue of being in point which is used in rect which 
;; appears at kernel boundary.
(def-type iii int)


;; both point and rect should appear in the metadata.
;; by virtue of rect being included at kernel boundary, and rect depending on point.
(def-struct point (x iii) (y int))

(def-struct rect (ul-corner point) (lr-corner point))




(def-kernel moar_kernel (c)
    (declare (type c (cell rect :address-space :global :access :read-write)))
  (let ((r (~ c))
        (p (ul-corner~ r))
        (loc-x (x~ p)))
    (set! (x~ p) (+ loc-x 1))))