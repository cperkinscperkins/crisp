
;; TEST-HOIST[L0] : validate-l0-cell-address-space
;; TEST-HOIST[L0]: validate-l0-host-run
;; HOIST-EXPECT: BUFFER gc: 17
;; (no TEST-HOIST[CUDA]: PTX codegen for local cells emits cvta.to.shared on raw offset — runtime crash)

;; Expected in generated C++:
;; - 'g' and 'gc' → zeMemAllocDevice (global device memory)
;; - 'l' → Local memory setup (via kernel group size, no explicit allocation)

(def-kernel address_space_test (g l &out gc)
    (declare (type g (cell int :address-space :global))
             (type l (cell int :address-space :local))
             (type gc (cell int :address-space :global)))
    (set! (~ l) 17) ;; setup local
    (set! (~ gc)  (~ l)))

