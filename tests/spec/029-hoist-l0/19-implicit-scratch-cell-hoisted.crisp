


;; TEST-HOIST[L0] : validate-l0-host-run
;; TEST-HOIST[CUDA]: validate-cuda-host-run
;; HOIST-EXPECT: BUFFER out-c: 8

(def-type out-cell (cell int :address-space :global))

;; Scratch cells default to :local per design (see ideal_001.md).
(def-type scratch-cell (cell int :address-space :local))

(def-function fun-D (sc &out out-cell)
    (declare #'(scratch-cell &out out-cell => nil))
  (set! (~ out-cell) (+ (~ sc) 1)))

(def-function fun-C (sc)
    (declare #'(scratch-cell => nil))
  (set! (~ sc) 7))

(def-function fun-B (&out out-cell)
    (declare #'(&out out-cell => int))
  (let ((sc (make-scratch-cell int)))
     (fun-C sc)
     (fun-D sc out-cell)
     (return 42))) ;; keep us on our toes. Is ignored.
    
(def-function fun-A (&out out-c)
    (declare #'(&out out-cell => int))
  (fun-B out-c))

(def-kernel top_kernel (&out out-c)
    (declare (type out-c out-cell))
  (fun-A out-c))