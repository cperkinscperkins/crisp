;; TEST-EXPECT: PASS
;; TEST-HOIST[L0]: validate-l0-host-run
;; HOIST-EXPECT: BUFFER h: 15360 15360 15360 15361
;; COMPILE-WITH[--hardware-profile=bmg --ir-target=spv]: PASS
;; COMPILE-WITH[--ir-target=ptx --ir-target-arch=sm_90]: PASS
;;
;; Endeavour 186 (BUG 059) -- (to-half x) narrows a float to half, round-to-nearest-even, and stores
;; it into a half element at the element's width.  The hoister prints half buffers as their raw bits.
;;   1.0              -> 0x3C00 = 15360
;;   1 + 2^-12        -> below half an ulp (2^-11): rounds down          15360
;;   1 + 2^-11        -> EXACTLY half an ulp: ties to even (mantissa 0) 15360
;;   1 + 3*2^-12      -> above half an ulp: rounds up, 0x3C01           15361
;; Truncation would give 15360 for the last one too.  The values are built on (get-workgroup-id 0) -- 0
;; at run time, unknown to the compiler -- so the conversion runs on the device, not in the folder.

(def-type h-vec (vector half :address-space :global :align :compact))

(def-kernel to_half_rne (&out h)
  (declare #'(&out h-vec => nil)
           (global-size :set-to 1))
  (let ((z (to-float (get-workgroup-id 0))))
    (set! (~ h 0) (to-half (+ z 1.0)))
    (set! (~ h 1) (to-half (+ z 1.000244140625)))
    (set! (~ h 2) (to-half (+ z 1.00048828125)))
    (set! (~ h 3) (to-half (+ z 1.000732421875)))))
