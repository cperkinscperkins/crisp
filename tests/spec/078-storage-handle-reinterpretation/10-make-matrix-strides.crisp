;; make-matrix with explicit :strides key.
;; When :strides is provided explicitly, result alignment is forced to :strided.
;; Source: compact int vector with >= 9 elements.
;; Strides '(3 1): stride-dim0 = 3 (row stride), stride-dim1 = 1 (col stride).
;; This is standard row-major layout for a 3-wide matrix, but specified explicitly.
;; Access element [0, 2].

(def-type int-vec-t (vector int :align :compact :address-space :global))

(def-function test-make-matrix-strides (v)
    (declare #'(int-vec-t => int))
  (let ((mat (make-matrix v int 3 3 :strides '(3 1))))
    (~ mat 0 2)))
