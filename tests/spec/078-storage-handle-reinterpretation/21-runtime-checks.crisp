;; TEST-WITH[--runtime-checks] : validate-has-die-check
;;
;; Verify that make-vector and make-cell emit runtime bounds checks
;; when --runtime-checks is active.
;;
;; Under --runtime-checks each reinterpretation checks that the view fits its source; a failed
;; check dies (endeavour 193): a CAS on the module-scope die record, then the thread returns.
;; (It was llvm.trap, which SPIR-V turns into OpUnreachable and IGC deletes -- BUG 136.)
;;
;; DEFAULT pass: compiles cleanly, no check emitted.
;; TEST-WITH pass: the die-record CAS must appear in the IR, and llvm.trap must not.

(def-type int-vec-t (vector int :align :compact :address-space :global))

(def-function test-rt-check-make-vector (v)
    (declare #'(int-vec-t => int))
  (let ((view (make-vector v int :length 3)))
    (~ view 0)))

(def-function test-rt-check-make-cell (v)
    (declare #'(int-vec-t => int))
  (let ((c (make-cell v int :offset 2)))
    (~ c)))
