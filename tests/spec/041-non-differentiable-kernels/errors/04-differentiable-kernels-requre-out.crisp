;; TEST-EXPECT: PASS
;; FAIL-WITH[--differentiate]: "is not differentiable"

;; this kernel errors when --differentiate is used, because it doesn't have an &out parameter.
;; the error message also mentions declare forward-only as the remediation.

;; and, of course, it compiles perfectly when --differentiate is NOT used.

(def-kernel not_me (C) 
  (declare #'((cell float :address-space :global) => nil))
  (set! (~ C) 2.0))