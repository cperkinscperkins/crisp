;; CHECK-FAIL: "<meaningful error message here>"
;;

(def-struct point (x int) (y int))

(def-derived-type coordinate point :subst :no)

;; Now we have two distance functions.  But they are still not substitutable.
(def-function distance (p1 p2)
    (declare #'(point point => int))
    ;; we don't have most math ops yet.
    (+ (x~ p1) (x~ p2)))

(def-function distance (c1 c2)
    (declare #'(coordinate coordinate => int))
    (+ (y~ c1) (y~ c2)))

(def-type out-c (cell int :address-space :global :access :write-only))

(def-kernel measure_distance (ax ay bx by &out res-p)
    (declare #'(int int int int &out out-c))
    (let ((p1 (make-point :x ax :y ay))
          (c2  (make-coordinate :x bx :y by)))
      (set! (~ res-p) (distance p1 c2))))
