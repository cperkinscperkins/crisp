;; TEST-EXPECT: PASS
;; TEST-WITH[--ir-target=spv]
;; local-barrier synchronizes all threads within a workgroup.
;; Lowers to OpControlBarrier (Workgroup scope, Workgroup memory) in SPIR-V.

(def-type out-t (cell int :address-space :global :access :read-write))

(def-kernel test_local_barrier (&out c)
  (declare #'(&out out-t))
  (local-barrier)
  (set! (~ c) 0))
