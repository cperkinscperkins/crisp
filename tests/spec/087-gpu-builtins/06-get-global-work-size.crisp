;; TEST-EXPECT: PASS
;; TEST-WITH[--ir-target=spv]
;; get-global-work-size: 3D form returns ulong3 (total threads per grid dimension);
;; scalar form returns ulong for compile-time dimension n.

(def-type out-3d (cell ulong3 :address-space :global))
(def-type out-1d (cell ulong  :address-space :global))

(def-kernel test_get_global_work_size_3d (&out result)
  (declare #'(&out out-3d))
  (set! (~ result) (get-global-work-size)))

(def-kernel test_get_global_work_size_n (&out result)
  (declare #'(&out out-1d))
  (set! (~ result) (get-global-work-size 0)))
