;; TEST-EXPECT: PASS
;; TEST-WITH[--ir-target=spv]
;; get-global-id-abs: absolute thread index = get-global-id + get-global-offset.
;; 3D form returns ulong3; scalar form returns ulong for compile-time dimension n.
;; Synthesized from GlobalInvocationId + GlobalOffset built-ins.

(def-type out-3d (cell ulong3 :address-space :global :access :read-write))
(def-type out-1d (cell ulong  :address-space :global :access :read-write))

(def-kernel test_get_global_id_abs_3d (&out result)
  (declare #'(&out out-3d))
  (set! (~ result) (get-global-id-abs)))

(def-kernel test_get_global_id_abs_n (&out result)
  (declare #'(&out out-1d))
  (set! (~ result) (get-global-id-abs 0)))
