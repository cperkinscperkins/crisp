;; TEST-EXPECT: PASS
;; TEST-WITH[--ir-target=spv]
;; get-num-groups: 3D form returns ulong3 (total workgroups in each grid dimension);
;; scalar form returns ulong for compile-time dimension n.

(def-type out-3d (cell ulong3 :address-space :global))
(def-type out-1d (cell ulong  :address-space :global))

(def-kernel test_get_num_groups_3d (&out result)
  (declare #'(&out out-3d))
  (set! (~ result) (get-num-groups)))

(def-kernel test_get_num_groups_n (&out result)
  (declare #'(&out out-1d))
  (set! (~ result) (get-num-groups 0)))
