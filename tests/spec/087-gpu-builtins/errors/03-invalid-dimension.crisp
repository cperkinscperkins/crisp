;; CHECK-FAIL: "dimension"
;; The dimension argument to scalar GPU built-ins must be 0, 1, or 2.
;; Dimension 3 is out of range and should be a compile-time error.

(def-type out-t (cell ulong :address-space :global))

(def-kernel bad_kernel (&out result)
  (declare #'(&out out-t))
  (set! (~ result) (get-global-id 3)))
