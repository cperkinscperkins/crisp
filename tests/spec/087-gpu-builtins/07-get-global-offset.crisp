;; TEST-EXPECT: PASS
;; TEST-WITH[--ir-target=spv]
;; get-global-offset: 3D form returns ulong3 (grid starting offset per dimension);
;; scalar form returns ulong for compile-time dimension n.

(def-type out-3d (cell ulong3 :address-space :global))
(def-type out-1d (cell ulong  :address-space :global))

(def-kernel test_get_global_offset_3d (&out result)
  (declare #'(&out out-3d))
  (set! (~ result) (get-global-offset)))

(def-kernel test_get_global_offset_n (&out result)
  (declare #'(&out out-1d))
  (set! (~ result) (get-global-offset 0)))
