;; TEST-EXPECT: PASS
;; VERIFY-AUTODIFF: x=0.5 y=3.0 atol=1e-2 expect.x=1.0 expect.y=0.0
;;
;; Endeavour 170 AD ON-METAL: op-saturate passes the gradient where the clamp is the identity and
;; blocks it where it clamps (decision D7). x=0.5 is inside [0,1] (dx = 1); y=3.0 is clamped (dy = 0).

(def-type f-c (cell float :address-space :global))

(def-kernel k (x y &out res)
  (declare #'(f-c f-c &out f-c))
  (set! (~ res) (+ (op-saturate (~ x)) (op-saturate (~ y)))))
