;; TEST-EXPECT: PASS
;; TEST-WITH[--force-math-precision=ieee] : validate-hw-24-sin-cos-approx
;;
;; Endeavour 170: op-sin-approx / op-cos-approx carry afn under ieee (PTX f32: native
;; sin.approx / cos.approx, no libdevice).

(def-type f-c (cell float :address-space :global))

(def-kernel k (x &out s c)
  (declare #'(f-c &out f-c f-c))
  (set! (~ s) (op-sin-approx (~ x)))
  (set! (~ c) (op-cos-approx (~ x))))
