;; TEST-EXPECT: PASS
;; TEST-HOIST[CUDA]: validate-cuda-host-run
;; FFI-LINK: $CUDA_HOME/nvvm/libdevice/libdevice.10.bc
;; SKIP-WITH[--differentiate]: "AD across the PTX libdevice path is endeavour 128 Phase 5 (see 128/13)"
;; HOIST-EXPECT: BUFFER rsq: 0.5
;; HOIST-EXPECT: BUFFER rcp: 0.125
;; HOIST-EXPECT: BUFFER lg: 3
;; HOIST-EXPECT: BUFFER ex: 8
;; HOIST-EXPECT: BUFFER sn: 0.479
;; HOIST-EXPECT: BUFFER cs: 0.877
;;
;; Endeavour 170 ON-METAL, NVIDIA: the CUDA twin of 30-approx-metal. On PTX rsqrt / rcp / exp2 / sin / cos
;; lower to the NATIVE *.approx instructions (verified in the .ptx by hand), while op-log2-approx is the
;; libdevice __nv_fast_log2f call -- hence the FFI-LINK, which 30 could not use because it also runs on L0.
;; The expectations are prefixes, so they tolerate the approximation; 0.479 / 0.877 are sin / cos of 0.5.
;; x = gid + 1 = 1.0 at runtime keeps the constant folder away from the operands.

(def-type f-c (cell float :address-space :global))

(def-kernel approx_metal_cuda (&out rsq rcp lg ex sn cs)
  (declare #'(&out f-c f-c f-c f-c f-c f-c => nil)
           (global-size :set-to 1))
  (let ((x (to-float (+ (get-global-id 0) 1ul))))
    (set! (~ rsq) (op-rsqrt-approx (* x 4.0)))
    (set! (~ rcp) (op-rcp-approx (* x 8.0)))
    (set! (~ lg) (op-log2-approx (* x 8.0)))
    (set! (~ ex) (op-exp2-approx (* x 3.0)))
    (set! (~ sn) (op-sin-approx (* x 0.5)))
    (set! (~ cs) (op-cos-approx (* x 0.5)))))
