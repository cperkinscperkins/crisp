;; TEST-EXPECT: PASS
;; TEST-WITH[--force-math-precision=ieee] : validate-fma-widen-float-double
;;
;; Endeavour 170: op-fma widening, float multipliers into a double accumulator => double.
;; Two fpext float->double, then @llvm.fma.f64. No float-width multiply.

(def-type float-c  (cell float  :address-space :global))
(def-type double-c (cell double :address-space :global))

(def-kernel k (a b c &out res)
  (declare #'(float-c float-c double-c &out double-c))
  (set! (~ res) (op-fma (~ a) (~ b) (~ c))))
