;; TEST-WITH[--ir-target=llvmir --differentiate]: validate-vec-chain-depth-grad
;;
;; Chain of sub-functions with vector input:
;;   C[idx] = final_op(other_op(some_op(A[idx], B[idx])), B[idx])
;;
;; The backward walk must thread adjoints through three sub-function _GRAD calls:
;;   final_op_GRAD → other_op_GRAD → some_op_GRAD
;;
;; Expected:
;;   - @some_operation_grad, @other_operation_grad, @final_operation_grad all defined
;;   - @vec_chain_grad defined
;;   - backward kernel body chains through all three _GRAD calls
;;   - idx_GRAD NOT present

(def-type in-vec  (vector float :address-space :global :access :read-only  :align :compact))
(def-type out-vec (vector float :address-space :global :access :read-write :align :compact))

(def-function some-operation (a b)
    (declare #'(float float => float))
    (+ (* a a) b))

(def-function other-operation (v)
    (declare #'(float => float))
    (+ 20.0 (* v v)))

(def-function final-operation (v b)
    (declare #'(float float => float))
    (+ v (* b b)))

(def-kernel vec_chain (A B idx &out C)
  (declare #'(in-vec in-vec ulong &out out-vec))
  (set! (~ C idx) (final-operation (other-operation (some-operation (~ A idx) (~ B idx)))
                                   (~ B idx))))
