;; TEST-WITH[--ir-target=llvmir --differentiate]: validate-vec-fan-out-sub-grad
;;
;; Fan-out: same input variable A used in two separate sub-function calls.
;; Both calls contribute to A_GRAD in the backward kernel — the gradient
;; must be accumulated (not overwritten) from both paths.
;;
;; Forward: C[idx] = some_operation(A[idx], B[idx])
;;                   - augmentation(A[idx])
;;   where some_operation(a, b) = a*a + b
;;         augmentation(a)      = a * 11.11
;;
;; Expected:
;;   - @some_operation_grad and @augmentation_grad defined
;;   - @vec_fan_op_grad defined
;;   - backward kernel calls both _GRAD functions
;;   - both contribute to A_GRAD (additive accumulation)

(def-type in-vec  (vector float :address-space :global  :align :compact))
(def-type out-vec (vector float :address-space :global :align :compact))

(def-function some-operation (a b)
    (declare #'(float float => float))
    (+ (* a a) b))

(def-function augmentation (a)
    (declare #'(float => float))
    (* a 11.11))

(def-kernel vec_fan_op (A B idx &out C)
  (declare #'(in-vec in-vec ulong &out out-vec))
  (let ((c-1 (some-operation (~ A idx) (~ B idx)))
        (c-2 (augmentation (~ A idx))))
    (set! (~ C idx) (- c-1 c-2))))
