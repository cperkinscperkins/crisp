;;
;; CHECK-FAIL: "is already used by another instantiation"
;;
;; Two instantiations of one template given the same explicit kernel name.  Codegen would keep only
;; the second (its "Redefining function ... replacing existing definition" path), silently losing
;; the long kernel.  Graduated from tests/adversarial (ADV-019).

(with-template-type (T)
    (def-kernel-exact my_call_function (byte-size ptr offset)
        (declare #'(ulong voidp ulong))
        (return)))

(gen-my_call_function long "my_colliding_kernel")
(gen-my_call_function float "my_colliding_kernel")
