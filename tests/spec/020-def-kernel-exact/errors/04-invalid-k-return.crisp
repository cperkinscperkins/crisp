
;; CHECK-FAIL: "Invalid Return: Function declared to return VOID/NIL but returned a value."
;; this is forcing return nil.  maybe that's ok?  Think about it.

(def-kernel-exact bad_kernel ()
    (declare #'(=> nil))  
    (return 7)) ;; <-- only (return) and (return nil) are valid. any other value to (return XXXX) is bad