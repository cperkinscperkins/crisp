
;; the type expression arg to marshall-cell must be a complete type.
;; incomplete types are errors.


(def-kernel-exact return_7 (byte-size ptr offset)
    (declare #'(ulong voidp ulong))
    ;; the cell type expression passed to marshall-cell must be complete.
    ;; "(cell int)", for example, would not work.
    (let ((c (marshall-cell (cell int) byte-size ptr offset)))
        (set! (~ c) 7)))