;; Call a function

(def-type out-c (cell long :address-space :global :access :read-write))


;; In theory, def-kernel-exact COULD support &out. But it seems "inappropriate"



(def-function store-7-return-8 (&out c)
    (declare #'(&out out-c => long))
    (set! (~ c) 7)
    (as-long 8))

;; kernel ALWAYS return nil, no matter what operation is in "last place'.
(def-kernel-exact call_function (byte-size ptr offset)
    (declare #'(ulong voidp ulong))
    (let ((c (marshall-cell out-c byte-size ptr offset)))
        (store-7-return-8 c)))  ; <-- inject implicit (return) at end of every kernel ?? something