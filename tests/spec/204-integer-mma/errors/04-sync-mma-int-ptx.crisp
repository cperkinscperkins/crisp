;; CHECK-FAIL: "has no NVIDIA lowering"
;; CHECK-FAIL-FLAGS: --ir-target=ptx --ir-target-arch=sm_90
;; Endeavour 204 -- sync mma has no integer lowering here; the message points at wgmma.
(def-type a-mat (matrix char :address-space :global :align :compact :contiguous-term :row-major))
(def-type c-mat (matrix int :address-space :global :align :compact :contiguous-term :row-major))

(def-kernel k (A B &out C)
  (declare #'(a-mat a-mat &out c-mat) (global-size :set-to 16) (local-size :set-to 16))
  (let ((C-tile (make-register-tile int (16 8) 0)))
    (mma-accumulate-via-tile (16 8 8) C-tile A B)
    (store-tile C-tile C (0 0))))
