;; CHECK-FAIL: "is not one of the active hardware"
;; CHECK-FAIL-FLAGS: --hardware-profile=noint8 --ir-target=spv
;; Endeavour 204 -- hardware without an int8 shape is a compile error, never a slow fallback.
(def-hardware-profile noint8 :simd-width 16 :mma-shapes ((8 16 8) (8 16 16)))
(def-type a-mat (matrix char :address-space :global :align :compact :contiguous-term :row-major))
(def-type c-mat (matrix int :address-space :global :align :compact :contiguous-term :row-major))

(def-kernel k (A B &out C)
  (declare #'(a-mat a-mat &out c-mat) (global-size :set-to 16) (local-size :set-to 16))
  (let ((C-tile (make-register-tile int (16 16) 0)))
    (mma-accumulate-via-tile (8 16 32) C-tile A B)
    (store-tile C-tile C (0 0))))
