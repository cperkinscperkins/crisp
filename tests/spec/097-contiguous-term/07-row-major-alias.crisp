;; TEST-EXPECT: PASS
;; TEST-WITH[--ir-target=spv]
;; TEST-HOIST[L0]: validate-l0-host-run
;; HOIST-EXPECT: BUFFER out: 1
;; SKIP-WITH[--differentiate]: "integer output, no differentiable params"
;; :contiguous-term :row-major is a matrix-only alias for :last.
;; Normalized at parse time; contiguous-term~ must return :last.

(def-type mat-t (matrix float :align :compact :address-space :global :access :read-write :contiguous-term :row-major))
(def-type out-t (cell int :address-space :global :access :read-write))

(def-kernel test_row_major_alias (m &out out)
  (declare #'(mat-t &out out-t => nil))
  (set! (~ out) (if (= (contiguous-term~ m) :last) 1 0)))
