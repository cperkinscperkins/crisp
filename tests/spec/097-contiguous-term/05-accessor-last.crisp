;; TEST-EXPECT: PASS
;; TEST-WITH[--ir-target=spv]
;; TEST-HOIST[L0]: validate-l0-host-run
;; HOIST-EXPECT: BUFFER out: 1
;; SKIP-WITH[--differentiate]: "integer output, no differentiable params"
;; contiguous-term~ returns the compile-time :last constant.
;; The kernel sets out[0]=1 if contiguous-term~ equals :last, else 0.

(def-type mat-t (matrix float :align :compact :address-space :global :contiguous-term :last))
(def-type out-t (cell int :address-space :global))

(def-kernel test_ct_accessor_last (m &out out)
  (declare #'(mat-t &out out-t => nil))
  (set! (~ out) (if (= (contiguous-term~ m) :last) 1 0)))
