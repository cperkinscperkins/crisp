;; TEST-EXPECT: PASS
;; TEST-WITH[--ir-target=spv]
;; TEST-HOIST[L0]: validate-l0-host-run
;; HOIST-EXPECT: BUFFER out: 1

;; :contiguous-term :col-major is a matrix-only alias for :first.
;; Normalized at parse time; contiguous-term~ must return :first.

(def-type mat-t (matrix float :align :compact :address-space :global :contiguous-term :col-major))
(def-type out-t (cell int :address-space :global))

(def-kernel test_col_major_alias (m &out out)
  (declare #'(mat-t &out out-t => nil))
  (set! (~ out) (if (= (contiguous-term~ m) :first) 1 0)))
