;;
;; TEST-EXPECT: PASS
;;
;; (set! (x~ (~ cell)) val) on a read-only cell should be a compile error.
;;
;; We don't have read-only enforcement yet.  Enable test when it is present.

(def-type ro-float2 (cell float2 :address-space :global))

(def-kernel bad_set_x (c)
  (declare forward-only #'(ro-float2))
  (set! (x~ (~ c)) 5.0))
