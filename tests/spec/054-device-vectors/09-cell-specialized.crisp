
(def-type in-c (cell ushort2 :address-space :global :access :read-only))

(def-type out-c (cell ushort2 :address-space :global :access :write-only))

(def-kernel cell_arg (u2 v2 &out res2)
    (declare forward-only #'(in-c ushort2 &out out-c))
    (set! (~ res2) v2)
    (set! (~ res2) (~ u2)))