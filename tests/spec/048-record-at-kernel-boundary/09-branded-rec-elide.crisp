;; TEST-WITH[--metadata] : validate-no-brand-in-metadata

;; branding should be elided in .metacrisp

(def-record v-point 
   (brand token-t ulong :subst :no :enforce :always)
    (x token-t) 
    (y int))


(def-function authenticate (vp tkn)
    (declare #'(v-point (token-t vp) => int))
    1)

(def-type out-c (cell int :address-space :global))

(def-kernel record_on_boundary_k (vp &out c)
    (declare #'(v-point &out out-c))
    (set! (~ c) (authenticate vp (x~ vp))))




