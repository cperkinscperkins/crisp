
;; point should appear in the metadata by virtue of being used at the kernel param boundary.
(def-struct non-composable-point 
   (brand x-t int :subst :ancestor :enforce :always)
   (brand y-t int :subst :ancestor :enforce :always)
   (x x-t) 
   (y y-t))


(def-kernel my_kernel (c &out result)
    (declare (type c result (cell non-composable-point :address-space :global :access :read-write)))
  (let ((loc-x (x~ (~ c))))
    (set! (x~ (~ result)) (+ loc-x 1))))