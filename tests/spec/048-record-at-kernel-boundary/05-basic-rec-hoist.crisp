;; TEST-HOIST[L0] : validate-l0-host-run
;; HOIST-EXPECT: BUFFER c: 1

;; aliasing
(def-type fff float)

(def-record v-point (x fff) (y int))

(def-type out-c (cell float :address-space :global))

(def-kernel record_on_boundary_k (vp &out c)
    (declare #'(v-point &out out-c))
    (set! (~ c) (* (x~ vp) (y~ vp))))
