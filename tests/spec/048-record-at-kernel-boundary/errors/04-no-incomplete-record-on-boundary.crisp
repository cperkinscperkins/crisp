
;; CHECK-FAIL: "COMPLETE types"

;; while def-record is allowed at kernel boundary,
;; incomplete types are NOT.

(def-type fff float)

(def-record v-point (x fff)
                    (y int)
                    (earnestness float :c-t)) ;; <-- no default value

(def-type out-c (cell float :address-space :global))

(def-kernel record_on_boundary_k (vp-1 vp-2 &out c)
    (declare #'(v-point (v-point :earnestness 3.0) &out out-c)) ;; first v-point is incomplete
    (let ((c-factor (* (earnestness~ vp-1) (earnestness~ vp-2))))
      (set! (~ c) (+ c-factor (* (x~ vp-1) (x~ vp-2))))))