;; TEST-WITH[--metadata] : validate-nested-rec-in-metadata
;; SKIP-WITH[--differentiate] : "nested records at kernel boundary: %expand-record-kernel-inputs only destructures one level — inner v-point fields are not reached, so no differentiable params"

;; v-rect is on the kernel boundary.
;; by virtue of that, v-point will also appear in the metadata.

(def-record v-point (x int) (y int))

(def-record v-rect (top-left v-point) (bottom-right v-point))

(def-type out-c (cell int :address-space :global))

(def-kernel rect_on_boundary_k (vr &out c)
    (declare #'(v-rect &out out-c))
    (set! (~ c) (* (x~ (top-left~ vr))
                   (y~ (bottom-right~ vr)))))