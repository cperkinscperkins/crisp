;; TEST-HOIST[L0] : validate-l0-host-run
;; TEST-HOIST[CUDA]: validate-cuda-host-run
;; HOIST-EXPECT: BUFFER c: 7

;; the :earnestness is kernel compile time property. It can't be set by the host.
;; It's fine for it to appear in the .metacrisp, but should NOT effect
;; the kernel submission signature.  

;; aliasing
(def-type fff float)

(def-record v-point (x fff) 
                    (y int)
                    (earnestness float :c-t 2.0f))

(def-type out-c (cell float :address-space :global))

(def-kernel rec_with_ct_on_boundary_k (vp-1 vp-2 &out c)
    (declare #'(v-point (v-point :earnestness 3.0) &out out-c))
    (let ((c-factor (* (earnestness~ vp-1) (earnestness~ vp-2))))
      (set! (~ c) (+ c-factor (* (x~ vp-1) (x~ vp-2))))))
