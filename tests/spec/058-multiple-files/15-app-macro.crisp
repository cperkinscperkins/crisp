;; TEST-EXPECT: FAIL
;; when compiled by itself, this test will fail because "add-three" is not defined.

(def-type out-c (cell float :address-space :global))

(def-kernel add_three_ff (a b c &out res)
    (declare #'(float float float &out out-c))
    (gen-3 float)
    (let ((r (add-three a b c)))
        (set! (~ res) r)))