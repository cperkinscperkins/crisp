;; TEST-EXPECT: FAIL
;; when compiled by itself, this test will fail because "add-three" is not defined.

(with-template-type (T)
    (def-type out-c (cell T :address-space :global :access :read-write))

    (def-kernel add_three (a b c &out res)
        (declare #'(T T T &out out-c))
        (let ((r (add-three a b c)))
            (set! (~ res) r))))

(gen-add_three float "add_three_f")
(gen-add_three long "add_three_l")