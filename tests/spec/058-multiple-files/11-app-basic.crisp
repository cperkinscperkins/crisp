
;; TEST-EXPECT: FAIL
;; when compiled by itself, this test will fail because "add-three-ints" is not defined.

(def-type out-c (cell int :address-space :global))

(def-kernel add_three (a b c &out res)
    (declare #'(int int int &out out-c))
    (let ((r (add-three-ints a b c)))
        (set! (~ res) r)))