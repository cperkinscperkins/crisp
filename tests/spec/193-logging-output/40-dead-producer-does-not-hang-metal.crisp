;; TEST-WITH[--ir-target=ptx --ir-target-arch=sm_90] : validate-ptx-wait-checks-die-record
;; SKIP-DEFAULT-PASS
;;
;; MMA-DIMS: 32 16 32
;; HOIST-ARCH: sm_90
;; TEST-HOIST[CUDA]: validate-cuda-mma-run
;; HOIST-EXPECT: DIE 40-dead-producer-does-not-hang-metal.crisp:41 group 0 local
;; HOIST-EXPECT: MMA_WRONG
;;
;; Endeavour 193 Phase E -- a dead producer must not hang its consumers.  This is 139/06 (the
;; distributed warp-spec :block matmul) with the producer dying at its SECOND K-step: the first is
;; streamed normally, so the consumers complete one lap, then wait on `full` for a phase flip that
;; never comes.  On the H100 that wait hung (logging-probes/FINDINGS.md).  In a kernel that can die,
;; each try_wait spin also loads the die record, so the consumers see the death and unwind.  The kernel
;; finishes, the launcher reports the death, and C is incomplete -- so the host reference check reports
;; a wrong result.  (The first K-step's loads also give --differentiate the load-tile provenance its
;; tile-multiply backward needs.)

(def-type a-mat (matrix float :address-space :global :align :compact :contiguous-term :row-major))
(def-type b-mat (matrix float :address-space :global :align :compact :contiguous-term :col-major))
(def-type c-mat (matrix float :address-space :global :align :compact :contiguous-term :row-major))

(def-kernel dead_producer (A B &out C)
  (declare #'(a-mat b-mat &out c-mat)
           (global-size :set-to 96)
           (local-size  :set-to 96))          ; 3 warps: 1 producer + 2 consumers
  (let ((A-ring  (make-scratch-matrix-ring float (32 8) :ring-count 2))
        (B-ring  (make-scratch-matrix-ring float (8 16) :ring-count 2))
        (C-tile  (make-register-tile float (32 16) 0.0 :warps '(false true true)))
        (K       (inner-dimension A B))
        (empty   (make-async-barrier-ring :ring-count 2 :mode :block :arrivals 2 :initial-state :signaled))
        (full    (make-async-barrier-ring :ring-count 2 :mode :block :arrivals 2 :initial-state :waiting)))
    (tile-stride C (32 16) (grid-y grid-x)
      (with-warp-specialization (:producer 1 :consumer 2)

        ;; PRODUCER -- streams the first K-step, then dies at the second.
        (:producer
          (dotimes (grid-k (/ (to-ulong K) (to-ulong 8)))
            (let ((slot (mod grid-k (to-ulong 2))))
              (when (= grid-k (to-ulong 1))
                (die "producer gives up"))                             ;; site
              (await (ring-get empty slot))
              (load-tile A (ring-get A-ring slot) (grid-y grid-k) :barrier (ring-get full slot))
              (load-tile B (ring-get B-ring slot) (grid-k grid-x) :barrier (ring-get full slot)))))

        ;; CONSUMER (x2) -- waits on `full`, which the producer never fills.
        (:consumer
          (dotimes (grid-k (/ (to-ulong K) (to-ulong 8)))
            (let ((slot (mod grid-k (to-ulong 2))))
              (await (ring-get full slot))
              (mma-accumulate-via-tile (16 8 8) C-tile (ring-get A-ring slot) (ring-get B-ring slot))
              (signal (ring-get empty slot))))
          (store-tile C-tile C (grid-y grid-x)))))))
