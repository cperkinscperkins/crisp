;; TEST-EXPECT: PASS
;; TEST-HOIST[L0]: validate-l0-host-run
;; TEST-HOIST[CUDA]: validate-cuda-host-run
;; HOIST-EXPECT: BUFFER out: 7 7 7 7
;;
;; Endeavour 193 -- without --logging-output, r-t-output and r-t-output-0 compile away along with
;; their arguments.  (Today the forms do not exist at all, so this fails as an unsupported form.)

(def-type out-v (vector float :align :compact :address-space :global))

(def-kernel output_gone_by_default (&out out)
  (declare #'(&out out-v => nil)
           (global-size :set-to 4)
           (local-size  :set-to 4))
  (r-t-output "every lane" (get-local-id 0))
  (r-t-output-0 "lane zero only")
  (set! (~ out (get-local-id 0)) 7.0))
