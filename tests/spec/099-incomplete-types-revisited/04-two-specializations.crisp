;; Single helper with incomplete (tensor float 1) is called with TWO different
;; complete types in the same kernel — one :compact, one :strided.
;;
;; Expected: TWO distinct specializations of double-at are emitted.  IR should
;; contain two functions whose mangled names differ in the align segment.  The
;; compact specialization should not load strides; the strided one should.

(def-type in-compact (tensor float 1 :address-space :global :align :compact))
(def-type in-strided (tensor float 1 :address-space :global :align :strided))
(def-type out-v      (tensor float 1 :address-space :global :align :compact))

(def-function double-at (v idx)
    (declare #'((tensor float 1) ulong => float))
    (* (~ v idx) 2.0f))

(def-kernel two_specs_test (A B idx &out C)
    (declare #'(in-compact in-strided ulong &out out-v))
    (set! (~ C idx) (+ (double-at A idx) (double-at B idx))))
