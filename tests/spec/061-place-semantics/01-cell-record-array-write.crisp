;; TEST-HOIST[L0] : validate-l0-host-run
;; TEST-HOIST[CUDA]: validate-cuda-host-run
;; HOIST-EXPECT: BUFFER c: 0 0 42 0

;; Place semantics: write through a cell-of-record containing an (array int 4) field.
;; Kernel sets values[2] = 42 via (set! (~ (values~ (~ c)) 2) 42).
;;
;; This validates that (set! (~ (accessor~ (~ cell)) idx) val) correctly writes
;; back to the cell's backing global memory rather than to a local alloca.
;; The cell parameter is ptr addrspace(1) — no IGC TypeArray issues at kernel boundary.
;; The internal [4 x i32] SSA values are locals from the global load — also fine.
;;
;; See: plan/bugs.md #029, tests/spec/061-place-semantics/DESIGN.md.

(def-record data-rec (values (array int 4)))

(def-type dat-c (cell data-rec :address-space :global))

(def-kernel cell_rec_arr_write_k (c)
    (declare forward-only #'(dat-c))
    (set! (~ (values~ (~ c)) 2) 42))
