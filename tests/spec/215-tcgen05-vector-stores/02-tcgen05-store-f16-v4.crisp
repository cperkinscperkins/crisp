;; Endeavour 215 -- 16-byte epilogue stores for a tcgen05 accumulator: a half C (GPU MODE matmul_v2's case).
;;
;; fp16 operands, a float accumulator, and (to-half D): each element is rounded as it leaves tensor
;; memory.  When the row run is contiguous and 16-byte aligned, eight halves per %store-run leave as ONE
;; st.global.v4.b32; else endeavour 197's packed pairs (st.global.b32); else scalars (st.global.b16).
;; On the B200 matmul the 4-byte pair stores were a third of the scored time (226 -> 171 us with v4).
;;
;; What the PTX must show (validate-ptx-tcgen05-vector-stores-f16), for 4 chunks of a 128x128 D:
;;   16 x st.global.v4.b32 (4 chunks x 4 runs of 8 halves);
;;   the pair arm (st.global.b32) and the scalar arm (st.global.b16) still present as the fallbacks.
;;
;; SKIP-DEFAULT-PASS
;; TEST-WITH[--ir-target=ptx --ir-target-arch=sm_100a] : validate-ptx-tcgen05-vector-stores-f16
;; SKIP-WITH[--differentiate]: "tcgen05 has no backward yet (D-208-8)"
;;
;; MMA-DIMS: 128 128 64
;; HOIST-ARCH: sm_100a
;; TEST-HOIST[CUDA]: validate-cuda-mma-run
;; HOIST-EXPECT: MMA_CORRECT

(def-type a-mat (matrix half :address-space :global :align :compact :contiguous-term :row-major))
(def-type b-mat (matrix half :address-space :global :align :compact :contiguous-term :col-major))
(def-type c-mat (matrix half :address-space :global :align :compact :contiguous-term :row-major))

(def-kernel tcgen05_store_f16_v4 (A B &out C)
  (declare #'(a-mat b-mat &out c-mat)
           (global-size :set-to 128) (local-size :set-to 128))
  (let ((A-tile (make-scratch-matrix half (128 64)))
        (B-tile (make-scratch-matrix half (128 64)))
        (D      (make-tcgen05-accumulator float (128 128) 0.0))
        (bar    (make-async-barrier :mode :block)))
    (load-tile A A-tile (0 0) :barrier bar :swizzle :128b)
    (load-tile B B-tile (0 0) :barrier bar :swizzle :128b)
    (await bar)
    (tcgen05-accumulate-via-tile (128 128 64) D A-tile B-tile :swizzle :128b)
    (store-tile (to-half D) C (0 0))))
