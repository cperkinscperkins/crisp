;; Endeavour 215 -- 16-byte epilogue stores for a tcgen05 accumulator: a float C.
;;
;; The tcgen05 32x32b layout gives each thread a whole accumulator ROW, so the store can leave in 16-byte
;; vectors.  store-tile now tries three arms per 32-column chunk: when the row run is contiguous and
;; 16-byte aligned (a run-time check), eight elements per %store-run -> two st.global.v4.b32; else
;; endeavour 197's packed pairs (st.global.v2.b32); else scalars.
;;
;; What the PTX must show (validate-ptx-tcgen05-vector-stores-f32), for 4 chunks of a 128x128 D:
;;   32 x st.global.v4.b32 (4 chunks x 4 runs of 8 floats x 2 vectors; LLVM 21 prints f32 as .b32);
;;   the pair arm (st.global.v2.b32) and the scalar arm (st.global.b32) still present as the fallbacks.
;;
;; SKIP-DEFAULT-PASS
;; TEST-WITH[--ir-target=ptx --ir-target-arch=sm_100a] : validate-ptx-tcgen05-vector-stores-f32
;; SKIP-WITH[--differentiate]: "tcgen05 has no backward yet (D-208-8)"
;;
;; MMA-DIMS: 128 128 64
;; HOIST-ARCH: sm_100a
;; TEST-HOIST[CUDA]: validate-cuda-mma-run
;; HOIST-EXPECT: MMA_CORRECT

(def-type a-mat (matrix bfloat16 :address-space :global :align :compact :contiguous-term :row-major))
(def-type b-mat (matrix bfloat16 :address-space :global :align :compact :contiguous-term :col-major))
(def-type c-mat (matrix float    :address-space :global :align :compact :contiguous-term :row-major))

(def-kernel tcgen05_store_f32_v4 (A B &out C)
  (declare #'(a-mat b-mat &out c-mat)
           (global-size :set-to 128) (local-size :set-to 128))
  (let ((A-tile (make-scratch-matrix bfloat16 (128 64)))
        (B-tile (make-scratch-matrix bfloat16 (128 64)))
        (D      (make-tcgen05-accumulator float (128 128) 0.0))
        (bar    (make-async-barrier :mode :block)))
    (load-tile A A-tile (0 0) :barrier bar :swizzle :128b)
    (load-tile B B-tile (0 0) :barrier bar :swizzle :128b)
    (await bar)
    (tcgen05-accumulate-via-tile (128 128 64) D A-tile B-tile :swizzle :128b)
    (store-tile D C (0 0))))
