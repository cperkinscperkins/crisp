;; TEST-EXPECT: PASS
;; TEST-HOIST[L0]: validate-l0-host-run
;; HOIST-EXPECT: BUFFER s1: 1020408163264
;; HOIST-EXPECT: BUFFER c1: 7
;; HOIST-EXPECT: BUFFER s2: 1020408163264
;; HOIST-EXPECT: BUFFER c2: 7
;; HOIST-EXPECT: BUFFER s3: 306122448
;; HOIST-EXPECT: BUFFER c3: 5
;; HOIST-EXPECT: BUFFER s4: 0
;; HOIST-EXPECT: BUFFER c4: 0
;; HOIST-EXPECT: BUFFER s5: 1
;; HOIST-EXPECT: BUFFER c5: 1
;;
;; Endeavour 172 ON-METAL: do-times-by-doubling / do-times-by-doubling+ iteration sequence.
;; i starts at INIT and doubles while i <= N (the last value bound is <= N).
;;
;; sN = sN*100 + i,  cN = iteration count.
;;   1: (do-times-by-doubling  (i 1 64))    1 2 4 8 16 32 64   c=7   (doc example; N reached exactly)
;;   2: (do-times-by-doubling  (i 1 100))   1 2 4 8 16 32 64   c=7   (doc example; N not a power of 2)
;;   3: (do-times-by-doubling  (i 3 50))    3 6 12 24 48       c=5   (init not a power of 2)
;;   4: (do-times-by-doubling  (i 5 4))     --                 c=0   (init > N)
;;   5: (do-times-by-doubling+ (i 1 1))     1                  c=1   (init = N)
;; z = workgroup id = 0 at runtime (uniform, not constant-foldable).

(def-type u-c (cell ulong :address-space :global))

(def-kernel do_times_by_doubling_metal (&out s1 c1 s2 c2 s3 c3 s4 c4 s5 c5)
  (declare #'(&out u-c u-c u-c u-c u-c u-c u-c u-c u-c u-c => nil)
           (global-size :set-to 1))
  (let ((z (get-workgroup-id 0)))
    (set! (~ s1) 0ul) (set! (~ c1) 0ul)
    (set! (~ s2) 0ul) (set! (~ c2) 0ul)
    (set! (~ s3) 0ul) (set! (~ c3) 0ul)
    (set! (~ s4) 0ul) (set! (~ c4) 0ul)
    (set! (~ s5) 0ul) (set! (~ c5) 0ul)
    (do-times-by-doubling (i 1 (+ z 64ul))
      (set! (~ s1) (+ (* (~ s1) 100ul) i))
      (set! (~ c1) (+ (~ c1) 1ul)))
    (do-times-by-doubling (i 1 (+ z 100ul))
      (set! (~ s2) (+ (* (~ s2) 100ul) i))
      (set! (~ c2) (+ (~ c2) 1ul)))
    (do-times-by-doubling (i (+ z 3ul) (+ z 50ul))
      (set! (~ s3) (+ (* (~ s3) 100ul) i))
      (set! (~ c3) (+ (~ c3) 1ul)))
    (do-times-by-doubling (i (+ z 5ul) (+ z 4ul))
      (set! (~ s4) (+ (* (~ s4) 100ul) i))
      (set! (~ c4) (+ (~ c4) 1ul)))
    (do-times-by-doubling+ (i (+ z 1ul) (+ z 1ul))
      (set! (~ s5) (+ (* (~ s5) 100ul) i))
      (set! (~ c5) (+ (~ c5) 1ul)))))
