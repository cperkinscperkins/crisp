;; TEST-EXPECT: FAIL
;; CHECK-FAIL: "must be greater than 0"
;; Endeavour 172: Literal init 0 is a compile error (D3): 0 doubled is 0 forever.

(def-type u-c (cell ulong :address-space :global))

(def-kernel k_literal_init_zero (&out out)
  (declare #'(&out u-c => nil)
           (global-size :set-to 1))
  (do-times-by-doubling (i 0 64)
    (set! (~ out) (+ (~ out) i))))
