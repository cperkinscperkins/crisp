;; TEST-EXPECT: FAIL
;; CHECK-FAIL: "Malformed"
;; Endeavour 172: dec-times-by-factor requires (i N factor); the factor is not optional.

(def-type u-c (cell ulong :address-space :global))

(def-kernel k_malformed_arity (&out out)
  (declare #'(&out u-c => nil)
           (global-size :set-to 1))
  (dec-times-by-factor (i 64)
    (set! (~ out) (+ (~ out) i))))
