;; TEST-EXPECT: FAIL
;; CHECK-FAIL: "unsigned"
;; Endeavour 172: A float operand is rejected (D2).

(def-type u-c (cell ulong :address-space :global))

(def-kernel k_float_operand (n &out out)
  (declare #'(float &out u-c => nil)
           (global-size :set-to 1))
  (dec-times-by-half (i n)
    (set! (~ out) (+ (~ out) i))))
