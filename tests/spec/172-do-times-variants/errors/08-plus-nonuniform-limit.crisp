;; TEST-EXPECT: FAIL
;; CHECK-FAIL: "uniform"
;; Endeavour 172: dec-times+ with a per-work-item N is rejected (D5).

(def-type u-c (cell ulong :address-space :global))

(def-kernel k_limit (&out out)
  (declare #'(&out u-c => nil)
           (global-size :set-to 1))
  (dec-times+ (i (get-local-id 0))
    (set! (~ out) (+ (~ out) i))))
