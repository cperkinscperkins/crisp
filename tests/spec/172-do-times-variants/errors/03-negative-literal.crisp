;; TEST-EXPECT: FAIL
;; CHECK-FAIL: "unsigned"
;; Endeavour 172: A negative literal operand is rejected (D2: literals must be non-negative).

(def-type u-c (cell ulong :address-space :global))

(def-kernel k_negative_literal (&out out)
  (declare #'(&out u-c => nil)
           (global-size :set-to 1))
  (dec-times (i -5)
    (set! (~ out) (+ (~ out) i))))
