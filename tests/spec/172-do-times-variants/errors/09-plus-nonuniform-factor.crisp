;; TEST-EXPECT: FAIL
;; CHECK-FAIL: "uniform"
;; Endeavour 172: do-times-by-multiply+ checks the FACTOR too, not just N (D5).  N and init are uniform.

(def-type u-c (cell ulong :address-space :global))

(def-kernel k_factor (&out out)
  (declare #'(&out u-c => nil)
           (global-size :set-to 1))
  (do-times-by-multiply+ (i 1 64 (+ (get-local-id 0) 2ul))
    (set! (~ out) (+ (~ out) i))))
