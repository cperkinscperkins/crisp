;; TEST-EXPECT: PASS
;; TEST-HOIST[L0]: validate-l0-host-run
;; HOIST-EXPECT: BUFFER g1: 0
;; HOIST-EXPECT: BUFFER g2: 0
;; HOIST-EXPECT: BUFFER g3: 0
;; HOIST-EXPECT: BUFFER g4: 0
;; HOIST-EXPECT: BUFFER g5: 0
;; HOIST-EXPECT: BUFFER g6: 0
;; HOIST-EXPECT: BUFFER o1: 64
;; HOIST-EXPECT: BUFFER o2: 41
;; HOIST-EXPECT: BUFFER o3: 1
;; HOIST-EXPECT: BUFFER o4: 64
;; HOIST-EXPECT: BUFFER o5: 64
;; HOIST-EXPECT: BUFFER f5: 9223372036854775808
;;
;; Endeavour 172 ON-METAL: termination gates (decision D3).  Every value below is RUNTIME
;; (built from the workgroup id, z = 0), so none of the compile-time literal gates can fire.
;; A regression here is a HANG, not a wrong number.
;;
;; Runtime gates -> ZERO iterations (gN = iteration count):
;;   g1: (do-times-by-doubling (i 0 64))          init 0 would double forever
;;   g2: (do-times-by-multiply (i 1 64 1))        factor 1 would never grow
;;   g3: (do-times-by-multiply (i 1 64 0))        factor 0
;;   g4: (dec-times-by-factor  (i 64 1))          factor 1 would never shrink
;;   g5: (dec-times-by-factor  (i 64 0))          factor 0 (also a divide by zero)
;;   g6: (dec-times            (i 64 0))          stride 0 (start is ((N-1)/s)*s -- divide by zero)
;;
;; Overflow safety at N = ULONG_MAX (= z - 1, wraps) -- oN = iteration count:
;;   o1: (do-times-by-doubling (i 1 MAX))         1 .. 2^63                 64   (2^64 would wrap to 0)
;;   o2: (do-times-by-multiply (i 1 MAX 3))       1 .. 3^40                 41   (3^40 = 12157665459056928801 <= MAX < 3^41)
;;   o3: (do-times-by-doubling (i MAX MAX))       MAX                        1   (2*MAX wraps)
;;   o4: (do-power-step        (i MAX))           1 .. 2^63                 64   (2^64 would wrap to 0)
;;   o5: (dec-power-step       (i MAX))           2^63 .. 1                 64   (padded limit 2^64 is not representable)
;;       f5 = first value = 2^63 = 9223372036854775808

(def-type u-c (cell ulong :address-space :global))

(def-kernel runtime_gates_metal (&out g1 g2 g3 g4 g5 g6 o1 o2 o3 o4 o5 f5)
  (declare #'(&out u-c u-c u-c u-c u-c u-c u-c u-c u-c u-c u-c u-c => nil)
           (global-size :set-to 1))
  (let* ((z   (get-workgroup-id 0))
         (one (+ z 1ul))
         (big (- z 1ul)))
    (set! (~ g1) 0ul) (set! (~ g2) 0ul) (set! (~ g3) 0ul)
    (set! (~ g4) 0ul) (set! (~ g5) 0ul) (set! (~ g6) 0ul)
    (set! (~ o1) 0ul) (set! (~ o2) 0ul) (set! (~ o3) 0ul)
    (set! (~ o4) 0ul) (set! (~ o5) 0ul) (set! (~ f5) 0ul)
    ;; runtime gates
    (do-times-by-doubling (i z (+ z 64ul))
      (set! (~ g1) (+ (~ g1) 1ul)))
    (do-times-by-multiply (i one (+ z 64ul) one)
      (set! (~ g2) (+ (~ g2) 1ul)))
    (do-times-by-multiply (i one (+ z 64ul) z)
      (set! (~ g3) (+ (~ g3) 1ul)))
    (dec-times-by-factor (i (+ z 64ul) one)
      (set! (~ g4) (+ (~ g4) 1ul)))
    (dec-times-by-factor (i (+ z 64ul) z)
      (set! (~ g5) (+ (~ g5) 1ul)))
    (dec-times (i (+ z 64ul) z)
      (set! (~ g6) (+ (~ g6) 1ul)))
    ;; overflow safety
    (do-times-by-doubling (i one big)
      (set! (~ o1) (+ (~ o1) 1ul)))
    (do-times-by-multiply (i one big (+ z 3ul))
      (set! (~ o2) (+ (~ o2) 1ul)))
    (do-times-by-doubling (i big big)
      (set! (~ o3) (+ (~ o3) 1ul)))
    (do-power-step (i big)
      (set! (~ o4) (+ (~ o4) 1ul)))
    (dec-power-step (i big)
      (when (= (~ o5) 0ul) (set! (~ f5) i))
      (set! (~ o5) (+ (~ o5) 1ul)))))
