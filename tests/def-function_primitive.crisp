(def-function first () 
  (declare (return-type int)) 
7)

(def-function adds (a b) 
  (declare (type a b int) (return-type int)) 
  (+ a b))

(def-function moar (a b) 
  (declare #'(int int => int)) 
  (+ a b))

(def-function call-another (a b)
  (declare #'(int int => int))
  (moar a b))

(def-function nested-calls (a b)
  (declare #'(int int => int))
  (+ a (+ b (first))))