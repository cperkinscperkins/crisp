
;; Negative Test: Ambiguous/Conflicting Struct Inference
;; Expected Error: Type mismatch (or ambiguous return)

(with-template-type (T)
  (def-struct point 
    (x T) 
    (y T)))
    
;; Simplified ambiguity/inference failure test
;; Verifies that mixing types doesn't magically fix the return type mismatch.

;; Need to ensure types are instantiated to find constructors.
(def-function force-instantiation ()
  (declare (return-type (point long) (point int)))
  (make-point (as-long 0) (as-long 0))
  (make-point (as-int 0) (as-int 0)))

;; Wait, generic functions aren't fully supported like this in tests without macro support nearby.
;; Let's simplify the test to just be a straight mismatch with MULTIPLE returns?
;; No, the original test was "failure-to-infer".
;; Let's replicate the structure but with explicit returns.

(def-function failure-to-infer ()
    (declare #'( => (point long)))
    ;; Return valid long point
    (make-point (as-long 1) (as-long 2)) 
    ;; Return invalid int point (ambiguity/mismatch)
    (make-point (as-int 1) (as-int 2)))
