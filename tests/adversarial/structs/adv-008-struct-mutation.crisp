;; KNOWN-ISSUE: ADV-008

(def-type cell-float (cell float :address-space :global))

(def-struct point
  (x float)
  (y float))

;; A thread-level function that mutates a point
(def-function mutate-point (p)
  (declare #'(point => nil))
  (set! (x~ p) 100.0)
  nil)

;; Kernel that takes a struct DIRECTLY (carved in constant memory)
;; Passing it to mutate-point should be a compiler error!
(def-kernel kernel_struct_mutator (my_point &out out_res)
  (declare #'(point &out cell-float => nil))
  (mutate-point my_point)
  (set! (~ out_res) (x~ my_point)))
