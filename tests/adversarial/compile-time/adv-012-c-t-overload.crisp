(def-type cell-float (cell float :address-space :global))
(def-enumeration mode :fast :safe)
(def-struct my-cfg (val float) (exec mode :c-t :safe))

(def-function my-overloaded-cfg (cfg)
  (declare #'( (my-cfg :exec :fast) => float))
  (* 2.0 (val~ cfg)))

(def-function my-overloaded-cfg (cfg)
  (declare #'( (my-cfg :exec :safe) => float))
  (* 1.0 (val~ cfg)))

(def-kernel overload_ct_prop (in_val &out out_res)
  (declare #'(float &out cell-float => nil))
  (let ((c (make-my-cfg :val in_val :exec :fast)))
    (set! (~ out_res) (my-overloaded-cfg c))))
