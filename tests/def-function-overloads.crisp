(def-function add-two (x y)
    (declare #'(int int => int))
  (+ x y))

(def-function add-two (x y)
    (declare #'(long long => long))
  (+ x y))

(def-function add-three (x y z)
    (declare #'(long long long => long))
  (add-two x (add-two y z)))

(def-function add-three (x y z)
    (declare #'(int int int => int))
  (add-two x (add-two y z)))

