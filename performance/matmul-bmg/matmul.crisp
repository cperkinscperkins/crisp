;; Chapter-0 baseline (Endeavor 134 bookend) — synchronous SLM-staged tiled matmul on BMG.
;;
;;   C[8x16] = A[8xK] . B[Kx16], tf32, single sub-group (one 8x16 XMX tile).
;;
;; This is deliberately a MICROBENCH, not a full GEMM: one workgroup, one output
;; tile, but a LARGE K (set by the harness).  So the runtime is dominated by the
;; K-loop's SYNCHRONOUS staging — each K-step stages an 8x8 A-block and 8x16 B-block
;; from global into SLM via sync load-tile-at, sync-workgroups, then one
;; cooperative-matrix MMA.  That staging latency is EXACTLY what the three MMA
;; "chapters" optimize (Ch1 async tile load / Ch2 pipelined / Ch3 warp-specialized),
;; so this number is the honest "Chapter 0" floor they improve on.
;;
;; Same kernel as tests/spec/133-mma-spv/12-tiled-matmul-bmg.crisp (proven correct on
;; BMG); the performance/ role just times it at large K with an L0 harness.
;;
;; BMG XMX shape is (8 16 8) and B must be row-major (no PackedB_ColumnMajor on SPV).
;;
;; Compile: crisp-compile.exe --hardware-profile=bmg --ir-target=spv matmul.crisp

(def-hardware-profile bmg :simd-width 16 :mma-shapes ((8 16 8)))

(def-type a-mat (matrix float :address-space :global :align :compact :contiguous-term :row-major))
(def-type b-mat (matrix float :address-space :global :align :compact :contiguous-term :row-major))
(def-type c-mat (matrix float :address-space :global :align :compact :contiguous-term :row-major))

(def-kernel matmul (A B &out C)
  (declare #'(a-mat b-mat &out c-mat)
           (global-size :set-to 16)
           (local-size  :set-to 16))          ; one sub-group
  (let ((A-tile (make-scratch-matrix float (8 8)))      ; SLM: M×8 (one K-step of A)
        (B-tile (make-scratch-matrix float (8 16)))     ; SLM: 8×N (one K-step of B)
        (C-tile (make-register-tile float (8 16) 0.0))
        (K      (to-int (inner-dimension A B))))
    (dotimes (kt (/ K 8))
      (load-tile-at A A-tile (0 (* kt 8)))      ; stage A[:, kt*8 : kt*8+8]
      (load-tile-at B B-tile ((* kt 8) 0))      ; stage B[kt*8 : kt*8+8, :]
      (sync-workgroup)
      (mma-accumulate-via-tile (8 16 8) C-tile A-tile B-tile)
      (sync-workgroup))
    (store-tile C-tile C (0 0))))
