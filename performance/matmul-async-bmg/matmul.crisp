;; Chapter-1 (async tile load) — SLM-staged tiled matmul on BMG.
;;
;;   C[8x16] = A[8xK] . B[Kx16], tf32, single sub-group (one 8x16 XMX tile).
;;
;; This is the ASYNC twin of ../matmul-bmg/matmul.crisp (the Chapter-0 sync floor):
;; byte-for-byte the same microbench (one workgroup, one output tile, large K), but the
;; K-step staging goes through an async barrier — each A/B block is pulled global->SLM via
;; OpGroupAsyncCopy (per-row, since the tiles are 2D strided sub-blocks) and the (await)
;; lowers to OpGroupWaitEvents.  On BMG `:mode :linear` is the OpGroupAsyncCopy path.
;;
;; The perf question this answers: does Chapter-1 async staging beat the Chapter-0 sync
;; floor on BMG at large K?  (On integrated-SLM Intel hardware the overlap win is smaller
;; than on discrete NVIDIA, but this is the honest apples-to-apples measurement.)
;;
;; BMG XMX shape is (8 16 8) and B must be row-major (no PackedB_ColumnMajor on SPV).
;;
;; Compile: crisp-compile.exe --hardware-profile=bmg --ir-target=spv matmul.crisp

(def-hardware-profile bmg :simd-width 16 :mma-shapes ((8 16 8)))

(def-type a-mat (matrix float :address-space :global :align :compact :contiguous-term :row-major))
(def-type b-mat (matrix float :address-space :global :align :compact :contiguous-term :row-major))
(def-type c-mat (matrix float :address-space :global :align :compact :contiguous-term :row-major))

(def-kernel matmul (A B &out C)
  (declare #'(a-mat b-mat &out c-mat)
           (global-size :set-to 16)
           (local-size  :set-to 16))          ; one sub-group
  (let ((A-tile (make-scratch-matrix float (8 8)))      ; SLM: M×8 (one K-step of A)
        (B-tile (make-scratch-matrix float (8 16)))     ; SLM: 8×N (one K-step of B)
        (C-tile (make-register-tile float (8 16) 0.0))
        (K      (inner-dimension A B))
        (bar    (make-async-barrier :type :global :mode :linear)))
    (matrix-multiply-tile-stride C C-tile K 8 (grid-y grid-x grid-k)
      (load-tile A A-tile (grid-y grid-k) :barrier bar)   ; async-stage A[:, grid-k*8 : +8]
      (load-tile B B-tile (grid-k grid-x) :barrier bar)   ; async-stage B[grid-k*8 : +8, :]
      (await bar)                                         ; OpGroupWaitEvents
      (mma-accumulate-via-tile (8 16 8) C-tile A-tile B-tile)
      (sync-workgroup))))
