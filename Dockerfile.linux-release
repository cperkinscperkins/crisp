# Builds the Linux x86_64 release binaries (crisp-compile, crisp-hoist-l0, crisp-hoist-cuda) and
# supplies LLVM-C-linux.so.  Mirrors the GitHub Actions CI setup (.github/workflows/ci.yml): Ubuntu
# 24.04, SBCL from apt, LLVM 21 from apt.llvm.org, Quicklisp.  Used by scripts/build-linux-release.sh.
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        sbcl wget gnupg lsb-release curl ca-certificates git patchelf \
    && rm -rf /var/lib/apt/lists/*

# LLVM 21 (the compiler's libLLVM; the same major as the bundled llc / llvm-as / llvm-spirv)
RUN wget -qO - https://apt.llvm.org/llvm-snapshot.gpg.key | gpg --dearmor -o /usr/share/keyrings/llvm.gpg \
    && echo "deb [signed-by=/usr/share/keyrings/llvm.gpg] http://apt.llvm.org/noble/ llvm-toolchain-noble-21 main" \
         > /etc/apt/sources.list.d/llvm.list \
    && apt-get update && apt-get install -y --no-install-recommends llvm-21 llvm-21-dev \
    && rm -rf /var/lib/apt/lists/*

# Quicklisp, installed into the image so the build does not re-download it
RUN curl -sO https://beta.quicklisp.org/quicklisp.lisp \
    && echo "" | sbcl --non-interactive --load quicklisp.lisp \
         --eval '(quicklisp-quickstart:install)' --eval '(ql:add-to-init-file)' --eval '(quit)' \
    && rm quicklisp.lisp

WORKDIR /build
