;; GPU MODE Challenge 04: histogram_v2 -- Single-Launch Last-Man + 8x Replicated Shared Histogram + Run-of-4 Collapse
;;
;; Strategy:
;;   1. 8x Replicated 256-bin shared-memory histogram (8 * 256 = 2,048 uint32 bins = 8 KB):
;;      Each warp (wid = tid / 32, 0..7) updates its own private 256-bin sub-table in shared memory,
;;      eliminating cross-warp shared-memory bank conflicts even at 90% single-value contention.
;;   2. 128-bit uint4 (16 bytes = 16 uint8 elements per load) grid-stride loop:
;;      For each 32-bit word w (4 packed bytes), checks if all 4 bytes are identical:
;;        (= w (* (logand w 255u) 16843009u))   ;; 0x01010101 = 16843009
;;      When true (common at 40% and 90% contention!), performs a SINGLE atomic-add! of +4u
;;      instead of 4 separate atomic increments to the same bin!
;;   3. Single-launch Last-Man global reduction:
;;      Each CTA reduces its 8 sub-tables for bin `tid` (0..255) and atomic-adds into persistent
;;      global scratch `partials[tid]` (initialized to 0). The last CTA to finish (tracked via
;;      `ticket`) reads `partials[tid]` with `atomic-xchg!` back to 0 and writes the final count
;;      directly to `output[tid]` (`st.global.cs.u64`) -- zero host-side `output.zero_()` launch!

(def-type in-vec      (vector uchar :address-space :global :align :compact))
(def-type in-vec4     (vector uint4 :address-space :global :align :compact))
(def-type partial-vec (vector ulong :address-space :global :align :compact))
(def-type ticket-cell (cell   uint  :address-space :global))
(def-type out-vec     (vector ulong :address-space :global :align :compact :cache :streaming))
(def-type smem-vec    (vector uint  :address-space :local  :align :compact))

(def-function accum-word (w base &out shist)
  (declare #'(uint ulong &out smem-vec => nil))
  (let ((b0 (logand w 255u)))
    (if (= w (* b0 16843009u))
        (atomic-add! (~ shist (+ base (to-ulong b0))) 4u)
        (let ((b1 (logand (/ w 256u)   255u))
              (b2 (logand (/ w 65536u) 255u))
              (b3 (/ w 16777216u)))
          (atomic-inc! (~ shist (+ base (to-ulong b0))))
          (atomic-inc! (~ shist (+ base (to-ulong b1))))
          (atomic-inc! (~ shist (+ base (to-ulong b2))))
          (atomic-inc! (~ shist (+ base (to-ulong b3)))))))
  (return))

(def-kernel histogram_kernel (input &out partials ticket output)
  (declare #'(in-vec &out partial-vec ticket-cell out-vec => nil)
           (global-size :derive-from input :strategy :strided)
           (local-size  :set-to 256))
  (let ((shist   (make-scratch-vector smem-vec 2048))
        (is-last (make-scratch-cell uint))
        (tid     (to-ulong (get-local-id 0)))
        (wid     (/ tid 32ul))
        (ng      (to-ulong (get-num-groups 0)))
        (n16     (/ (length~ input) 16ul))
        (in4     (make-vector input uint4 :length n16))
        (base    (* wid 256ul)))
    ;; 1. Zero all 2,048 shared-memory bins (8 per thread)
    (dotimes+ (k 8ul)
      (set! (~ shist (+ (* k 256ul) tid)) 0u))
    (sync-workgroup)

    ;; 2. Grid-stride 128-bit uint4 loads (16 bytes per load, unrolled 4x = 64 bytes/iter)
    (loop-vector-stride in4 (i)
      (declare (unroll 4))
      (let ((v (~ in4 i)))
        (accum-word (x~ v) base shist)
        (accum-word (y~ v) base shist)
        (accum-word (z~ v) base shist)
        (accum-word (w~ v) base shist)))
    (sync-workgroup)

    ;; 3. Sum the 8 warp sub-tables for bin `tid` (0..255)
    (let ((c0 (+ (+ (~ shist tid)           (~ shist (+ tid 256ul)))
                 (+ (~ shist (+ tid 512ul)) (~ shist (+ tid 768ul)))))
          (c1 (+ (+ (~ shist (+ tid 1024ul)) (~ shist (+ tid 1280ul)))
                 (+ (~ shist (+ tid 1536ul)) (~ shist (+ tid 1792ul))))))
      (let ((total (to-ulong (+ c0 c1))))
        (when (= ng 1ul)
          (set! (~ output tid) total))
        (when (> ng 1ul)
          (when (> total 0ul)
            (atomic-add! (~ partials tid) total))
          (mem-fence)
          (when (= tid 0ul)
            (let ((arrived (to-ulong (atomic-inc! (~ ticket)))))
              (set! (~ is-last) (if (= arrived (- ng 1ul)) 1u 0u))))
          (sync-workgroup)
          (when (= (~ is-last) 1u)
            (mem-fence)
            (set! (~ output tid) (atomic-xchg! (~ partials tid) 0ul))
            (when (= tid 0ul)
              (atomic-xchg! (~ ticket) 0u))))))
    (return)))
