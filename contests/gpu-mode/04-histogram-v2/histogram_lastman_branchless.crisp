;; GPU MODE Challenge 04: histogram_v2 -- Single-Launch Last-Man + 8x Replicated Shared Histogram + Branchless Byte Extraction
;;
;; Tests pure branchless 4-byte extraction (`bfe.u32` + `shr.u32` + 4x `atom.shared.add.u32`)
;; without the per-word `w == b0 * 0x01010101` branch.

(def-type in-vec      (vector uchar :address-space :global :align :compact :cache (:streaming :prefetch 256)))
(def-type in-vec4     (vector uint4 :address-space :global :align :compact :cache (:streaming :prefetch 256)))
(def-type partial-vec (vector ulong :address-space :global :align :compact))
(def-type ticket-cell (cell   uint  :address-space :global))
(def-type out-vec     (vector ulong :address-space :global :align :compact :cache :streaming))
(def-type smem-vec    (vector uint  :address-space :local  :align :compact))

(def-function accum-word-branchless (w base &out shist)
  (declare #'(uint ulong &out smem-vec => uint))
  (let ((b0 (logand w 255u))
        (b1 (logand (/ w 256u)   255u))
        (b2 (logand (/ w 65536u) 255u))
        (b3 (/ w 16777216u)))
    (atomic-inc! (~ shist (+ base (to-ulong b0))))
    (atomic-inc! (~ shist (+ base (to-ulong b1))))
    (atomic-inc! (~ shist (+ base (to-ulong b2))))
    (atomic-inc! (~ shist (+ base (to-ulong b3))))))

(def-kernel histogram_kernel (input &out partials ticket output)
  (declare #'(in-vec &out partial-vec ticket-cell out-vec => nil)
           (global-size :derive-from input :strategy :strided)
           (local-size  :set-to 256))
  (let ((shist   (make-scratch-vector smem-vec 2048))
        (is-last (make-scratch-cell uint))
        (tid     (to-ulong (get-local-id 0)))
        (wid     (/ tid 32ul))
        (ng      (to-ulong (get-num-groups 0)))
        (n16     (/ (length~ input) 16ul))
        (in4     (make-vector input uint4 :length n16))
        (base    (* wid 256ul)))
    (dotimes+ (k 8ul)
      (set! (~ shist (+ (* k 256ul) tid)) 0u))
    (sync-workgroup)

    (loop-vector-stride in4 (i)
      (declare (unroll 4))
      (let ((v (~ in4 i)))
        (accum-word-branchless (x~ v) base shist)
        (accum-word-branchless (y~ v) base shist)
        (accum-word-branchless (z~ v) base shist)
        (accum-word-branchless (w~ v) base shist)))
    (sync-workgroup)

    (let ((c0 (+ (+ (~ shist tid)           (~ shist (+ tid 256ul)))
                 (+ (~ shist (+ tid 512ul)) (~ shist (+ tid 768ul)))))
          (c1 (+ (+ (~ shist (+ tid 1024ul)) (~ shist (+ tid 1280ul)))
                 (+ (~ shist (+ tid 1536ul)) (~ shist (+ tid 1792ul))))))
      (let ((total (to-ulong (+ c0 c1))))
        (when (= ng 1ul)
          (set! (~ output tid) total))
        (when (> ng 1ul)
          (when (> total 0ul)
            (atomic-add! (~ partials tid) total))
          (mem-fence)
          (when (= tid 0ul)
            (let ((arrived (to-ulong (atomic-inc! (~ ticket)))))
              (set! (~ is-last) (if (= arrived (- ng 1ul)) 1u 0u))))
          (sync-workgroup)
          (when (= (~ is-last) 1u)
            (mem-fence)
            (set! (~ output tid) (atomic-xchg! (~ partials tid) 0ul))
            (when (= tid 0ul)
              (atomic-xchg! (~ ticket) 0u))))))
    (return)))

