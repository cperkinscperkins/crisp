;; PROBE (2026-11-11): v7's kernel (matmul_b200_tcgen05_mn.crisp) made PERSISTENT -- one workgroup per SM
;; (148 x 192), a 2-slot tensor-memory accumulator ring (2 x 256 columns = all 512) so the MMA warp starts
;; tile i+1 while the epilogue drains tile i, and a 4-deep TMA ring (4 x 48 KB = 192 KB) that the second
;; resident workgroup's shared memory used to occupy.  endeavour 209's template (scripts/crisp_bench/
;; gen_b200.py, persistent), with v7's (K N) B read :b-major :mn.  209 round 2 measured this shape 8-10%
;; behind the 2-per-SM tile grid on dense fp16; this re-asks on the contest's shapes.
;; Requires M % 128 = 0, N % 256 = 0, K % 64 = 0.

(def-type a-mat (matrix half :address-space :global :align :compact :contiguous-term :row-major))
(def-type b-mat (matrix half :address-space :global :align :compact :contiguous-term :row-major))
(def-type c-mat (matrix half :address-space :global :align :compact :contiguous-term :row-major))

(def-kernel matmul (A B &out C)
  (declare #'(a-mat b-mat &out c-mat)
           (global-size :set-to 28416)              ; 148 SMs x 192 threads: one workgroup per SM
           (local-size :set-to 192))                 ; epilogue warpgroup + producer warp + mma warp
  (let ((A-ring    (make-scratch-matrix-ring half (128 64) :ring-count 4))
        (B-ring    (make-scratch-matrix-ring half (64 256) :ring-count 4))   ; (K N) -- Major::MN
        (acc       (make-tcgen05-accumulator-ring float (128 256) :ring-count 2))
        (K         (inner-dimension A B))
        (tiles     (to-ulong 0))
        (empty     (make-async-barrier-ring :ring-count 4 :mode :block :arrivals 1 :initial-state :signaled))
        (full      (make-async-barrier-ring :ring-count 4 :mode :block :arrivals 2 :initial-state :waiting))
        (acc-full  (make-async-barrier-ring :ring-count 2 :mode :block :arrivals 1 :initial-state :waiting))
        (acc-empty (make-async-barrier-ring :ring-count 2 :mode :block :arrivals 4 :initial-state :signaled)))
    (tile-stride C (128 256) (grid-y grid-x)
      (let ((s (mod tiles (to-ulong 2))))
        (with-warp-specialization (:epilogue 4 :producer 1 :mma 1)
          (:epilogue
            (await (ring-get acc-full s))
            (store-tile (to-half (ring-get acc s)) C (grid-y grid-x))
            (signal (ring-get acc-empty s)))
          (:producer
            (dotimes (grid-k (/ (to-ulong K) (to-ulong 64)))
              (let ((slot (mod grid-k (to-ulong 4))))
                (await (ring-get empty slot))
                (load-tile A (ring-get A-ring slot) (grid-y grid-k) :barrier (ring-get full slot) :swizzle :128b)
                (load-tile B (ring-get B-ring slot) (grid-k grid-x) :barrier (ring-get full slot) :swizzle :128b))))
          (:mma
            (await (ring-get acc-empty s))
            (let ((D (ring-get acc s)))
              (dotimes (grid-k (/ (to-ulong K) (to-ulong 64)))
                (let ((slot (mod grid-k (to-ulong 4))))
                  (await (ring-get full slot))
                  (tcgen05-accumulate-via-tile (128 256 64) D (ring-get A-ring slot) (ring-get B-ring slot)
                                               :swizzle :128b :b-major :mn :on-complete (ring-get empty slot)))))
            (tcgen05-commit (ring-get acc-full s))))
        (set! tiles (+ tiles (to-ulong 1)))))))
