;; conv2d_v2 FFT lane, radix-8 tile transforms (GENERATED by gen_fft8.py -- edit that, then re-run it).
;;
;; Same contract as conv2d_fft.crisp's fft_fwd / fft_inv (layouts, dims, scrambled bin order shared by X, W
;; and Y), but each 64-point FFT is two radix-8 steps done in registers instead of six radix-2 stages in
;; shared memory: 4 barriers per tile instead of 12, a third of the shared traffic.  The bin order differs
;; from conv2d_fft.crisp's (digit-swapped instead of bit-reversed), so fft8_fwd pairs only with fft8_inv;
;; cgemm does not care.
;; Shared tile: element (r, c) at r * 73 + c + c / 8.  Row steps put lanes on rows (32 rows per warp,
;; conflict-free for an odd stride); column steps put lanes on columns.  tw = W64^m for m < 64 (re ; im).
(def-type in-vec   (vector float :address-space :global :align :compact))
(def-type out-vec  (vector float :address-space :global :align :compact))
(def-type dims-vec (vector int   :address-space :global :align :compact))

(def-function splat (s)
  (declare #'(float => float4))
  ##(s s s s))

;; An 8-point DFT of (a0 .. a7), forward sign (W8 = e^(-2 pi i / 8)), as two 4-point DFTs (even / odd).
(def-function dft8 (a0r a0i a1r a1i a2r a2i a3r a3i a4r a4i a5r a5i a6r a6i a7r a7i)
  (declare #'(float float float float float float float float float float float float float float float float
              => float float float float float float float float float float float float float float float float))
  (let ((t0r (+ a0r a4r)) (t0i (+ a0i a4i)) (t1r (- a0r a4r)) (t1i (- a0i a4i))
        (t2r (+ a2r a6r)) (t2i (+ a2i a6i)) (dr  (- a2r a6r)) (di  (- a2i a6i))
        (e0r (+ t0r t2r)) (e0i (+ t0i t2i)) (e2r (- t0r t2r)) (e2i (- t0i t2i))
        (e1r (+ t1r di))  (e1i (- t1i dr))  (e3r (- t1r di))  (e3i (+ t1i dr))       ; -i d = (di, -dr)
        (s0r (+ a1r a5r)) (s0i (+ a1i a5i)) (s1r (- a1r a5r)) (s1i (- a1i a5i))
        (s2r (+ a3r a7r)) (s2i (+ a3i a7i)) (fr  (- a3r a7r)) (fi  (- a3i a7i))
        (o0r (+ s0r s2r)) (o0i (+ s0i s2i)) (o2r (- s0r s2r)) (o2i (- s0i s2i))
        (o1r (+ s1r fi))  (o1i (- s1i fr))  (o3r (- s1r fi))  (o3i (+ s1i fr))
        (q1r (* (+ o1r o1i) 0.70710678118654752)) (q1i (* (- o1i o1r) 0.70710678118654752))  ; W8^1
        (q2r o2i) (q2i (- o2r))                                                            ; W8^2 = -i
        (q3r (* (- o3i o3r) 0.70710678118654752)) (q3i (* (- (+ o3r o3i)) 0.70710678118654752)))  ; W8^3
    (return (+ e0r o0r) (+ e0i o0i) (+ e1r q1r) (+ e1i q1i) (+ e2r q2r) (+ e2i q2i) (+ e3r q3r) (+ e3i q3i)
            (- e0r o0r) (- e0i o0i) (- e1r q1r) (- e1i q1i) (- e2r q2r) (- e2i q2i) (- e3r q3r) (- e3i q3i))))

;; The same with the inverse sign (W8 = e^(+2 pi i / 8)), unscaled.
(def-function idft8 (a0r a0i a1r a1i a2r a2i a3r a3i a4r a4i a5r a5i a6r a6i a7r a7i)
  (declare #'(float float float float float float float float float float float float float float float float
              => float float float float float float float float float float float float float float float float))
  (let ((t0r (+ a0r a4r)) (t0i (+ a0i a4i)) (t1r (- a0r a4r)) (t1i (- a0i a4i))
        (t2r (+ a2r a6r)) (t2i (+ a2i a6i)) (dr  (- a2r a6r)) (di  (- a2i a6i))
        (e0r (+ t0r t2r)) (e0i (+ t0i t2i)) (e2r (- t0r t2r)) (e2i (- t0i t2i))
        (e1r (- t1r di))  (e1i (+ t1i dr))  (e3r (+ t1r di))  (e3i (- t1i dr))       ; +i d = (-di, dr)
        (s0r (+ a1r a5r)) (s0i (+ a1i a5i)) (s1r (- a1r a5r)) (s1i (- a1i a5i))
        (s2r (+ a3r a7r)) (s2i (+ a3i a7i)) (fr  (- a3r a7r)) (fi  (- a3i a7i))
        (o0r (+ s0r s2r)) (o0i (+ s0i s2i)) (o2r (- s0r s2r)) (o2i (- s0i s2i))
        (o1r (- s1r fi))  (o1i (+ s1i fr))  (o3r (+ s1r fi))  (o3i (- s1i fr))
        (q1r (* (- o1r o1i) 0.70710678118654752)) (q1i (* (+ o1r o1i) 0.70710678118654752))  ; W8^-1
        (q2r (- o2i)) (q2i o2r)                                                            ; W8^-2 = i
        (q3r (* (- (+ o3r o3i)) 0.70710678118654752)) (q3i (* (- o3r o3i) 0.70710678118654752)))  ; W8^-3
    (return (+ e0r o0r) (+ e0i o0i) (+ e1r q1r) (+ e1i q1i) (+ e2r q2r) (+ e2i q2i) (+ e3r q3r) (+ e3i q3i)
            (- e0r o0r) (- e0i o0i) (- e1r q1r) (- e1i q1i) (- e2r q2r) (- e2i q2i) (- e3r q3r) (- e3i q3i))))

;; Shared offset of column position cp (0 .. 63) within a row: one pad word per 8 columns.
(def-function coff (cp)
  (declare #'(uint => uint))
  (+ cp (shift-right cp 3u)))

;; Where frequency f (0 .. 63) of a radix-8 transform sits: its two octal digits swapped.
(def-function perm8 (f)
  (declare #'(uint => uint))
  (+ (* (logand f 7u) 8u) (shift-right f 3u)))

;; Forward: one workgroup per tile (mode 0: g = ci * NBT + tile) or filter (mode 1: g = co * C + ci).
(def-kernel fft8_fwd (src tw dims &out outr outi)
  (declare #'(in-vec in-vec dims-vec &out out-vec out-vec => nil)
           (global-size :derive-from outr :strategy :strided)
           (local-size  :set-to 256))
  (let ((C    (to-uint (~ dims 0)))
        (H    (to-uint (~ dims 1)))
        (K    (to-uint (~ dims 2)))
        (mode (~ dims 3))
        (NBT  (to-uint (~ dims 4)))
        (nt   (to-uint (~ dims 5)))
        (NBTP (to-uint (~ dims 6)))
        (V    (- 65u K))
        (NR   (if (= mode 0) 64u K))                ; rows that can be nonzero
        (re   (make-scratch-vector float 4672))     ; 64 x 73
        (im   (make-scratch-vector float 4672))
        (twr  (make-scratch-vector float 64))
        (twi  (make-scratch-vector float 64))
        (g    (to-uint (get-workgroup-id 0)))
        (tid  (to-uint (get-local-linear-id)))
        (lane (logand tid 31u))
        (wq   (shift-right tid 5u))
        (bt   (rem g NBT))
        (ntt  (* nt nt))
        (tt   (rem bt ntt))
        (y0   (* (/ tt nt) V))
        (x0   (* (rem tt nt) V))
        (base (if (= mode 0) (* (+ (* (/ bt ntt) C) (/ g NBT)) H H) (* g K K)))
        (obase (if (= mode 0) (* (+ (* (/ g NBT) NBTP) bt) 2112u) (* g 2112u))))
    (declare (uniform C H K mode NBT nt NBTP V NR))
    (when (< tid 64u)
      (set! (~ twr tid) (~ tw tid))
      (set! (~ twi tid) (~ tw (+ tid 64u))))
    (dotimes (j 16u)
      (let ((idx (+ tid (* j 256u)))
            (row (shift-right idx 6u))
            (cx  (logand idx 63u))
            (dst (+ (* row 73u) (coff cx))))
        (set! (~ re dst)
              (if (= mode 0)
                  (let ((gy (+ y0 row)) (gx (+ x0 cx)))
                    (if (and (< gy H) (< gx H)) (~ src (+ base (* gy H) gx)) 0.0))
                  (if (and (< row K) (< cx K)) (~ src (+ base (* row K) cx)) 0.0)))
        (set! (~ im dst) 0.0)))
    (sync-workgroup)
    ;; rows, step A: thread (row = lane + 32 rr, n2 = wq)
    (dotimes (rr 2u)
      (let ((row (+ lane (* rr 32u))))
        (when (< row NR)
              (let ((pb (+ (* row 73u) wq)))
                (let ((b0r b0i b1r b1i b2r b2i b3r b3i b4r b4i b5r b5i b6r b6i b7r b7i
                       (dft8 (~ re (+ pb 0u)) (~ im (+ pb 0u)) (~ re (+ pb 9u)) (~ im (+ pb 9u)) (~ re (+ pb 18u)) (~ im (+ pb 18u)) (~ re (+ pb 27u)) (~ im (+ pb 27u)) (~ re (+ pb 36u)) (~ im (+ pb 36u)) (~ re (+ pb 45u)) (~ im (+ pb 45u)) (~ re (+ pb 54u)) (~ im (+ pb 54u)) (~ re (+ pb 63u)) (~ im (+ pb 63u)))))
                  (set! (~ re (+ pb 0u)) b0r) (set! (~ im (+ pb 0u)) b0i)
                  (let ((wr (~ twr (* wq 1u))) (wi (~ twi (* wq 1u))))
                    (set! (~ re (+ pb 9u)) (- (* b1r wr) (* b1i wi)))
                    (set! (~ im (+ pb 9u)) (+ (* b1i wr) (* b1r wi))))
                  (let ((wr (~ twr (* wq 2u))) (wi (~ twi (* wq 2u))))
                    (set! (~ re (+ pb 18u)) (- (* b2r wr) (* b2i wi)))
                    (set! (~ im (+ pb 18u)) (+ (* b2i wr) (* b2r wi))))
                  (let ((wr (~ twr (* wq 3u))) (wi (~ twi (* wq 3u))))
                    (set! (~ re (+ pb 27u)) (- (* b3r wr) (* b3i wi)))
                    (set! (~ im (+ pb 27u)) (+ (* b3i wr) (* b3r wi))))
                  (let ((wr (~ twr (* wq 4u))) (wi (~ twi (* wq 4u))))
                    (set! (~ re (+ pb 36u)) (- (* b4r wr) (* b4i wi)))
                    (set! (~ im (+ pb 36u)) (+ (* b4i wr) (* b4r wi))))
                  (let ((wr (~ twr (* wq 5u))) (wi (~ twi (* wq 5u))))
                    (set! (~ re (+ pb 45u)) (- (* b5r wr) (* b5i wi)))
                    (set! (~ im (+ pb 45u)) (+ (* b5i wr) (* b5r wi))))
                  (let ((wr (~ twr (* wq 6u))) (wi (~ twi (* wq 6u))))
                    (set! (~ re (+ pb 54u)) (- (* b6r wr) (* b6i wi)))
                    (set! (~ im (+ pb 54u)) (+ (* b6i wr) (* b6r wi))))
                  (let ((wr (~ twr (* wq 7u))) (wi (~ twi (* wq 7u))))
                    (set! (~ re (+ pb 63u)) (- (* b7r wr) (* b7i wi)))
                    (set! (~ im (+ pb 63u)) (+ (* b7i wr) (* b7r wi)))))))))
    (sync-workgroup)
    ;; rows, step B: thread (row, k1 = wq)
    (dotimes (rr 2u)
      (let ((row (+ lane (* rr 32u))))
        (when (< row NR)
              (let ((pb (+ (* row 73u) (* wq 9u))))
                (let ((b0r b0i b1r b1i b2r b2i b3r b3i b4r b4i b5r b5i b6r b6i b7r b7i
                       (dft8 (~ re (+ pb 0u)) (~ im (+ pb 0u)) (~ re (+ pb 1u)) (~ im (+ pb 1u)) (~ re (+ pb 2u)) (~ im (+ pb 2u)) (~ re (+ pb 3u)) (~ im (+ pb 3u)) (~ re (+ pb 4u)) (~ im (+ pb 4u)) (~ re (+ pb 5u)) (~ im (+ pb 5u)) (~ re (+ pb 6u)) (~ im (+ pb 6u)) (~ re (+ pb 7u)) (~ im (+ pb 7u)))))
                  (set! (~ re (+ pb 0u)) b0r) (set! (~ im (+ pb 0u)) b0i)
                  (set! (~ re (+ pb 1u)) b1r) (set! (~ im (+ pb 1u)) b1i)
                  (set! (~ re (+ pb 2u)) b2r) (set! (~ im (+ pb 2u)) b2i)
                  (set! (~ re (+ pb 3u)) b3r) (set! (~ im (+ pb 3u)) b3i)
                  (set! (~ re (+ pb 4u)) b4r) (set! (~ im (+ pb 4u)) b4i)
                  (set! (~ re (+ pb 5u)) b5r) (set! (~ im (+ pb 5u)) b5i)
                  (set! (~ re (+ pb 6u)) b6r) (set! (~ im (+ pb 6u)) b6i)
                  (set! (~ re (+ pb 7u)) b7r) (set! (~ im (+ pb 7u)) b7i))))))
    (sync-workgroup)
    ;; columns kx = 0 .. 32 (at perm8(kx)), step A then B along y: thread (kx = lane, group = wq); kx 32: tid < 8
    (dotimes (cr 2u)
      (let ((kx (if (= cr 0u) lane 32u))
            (cg (if (= cr 0u) wq tid)))
        (when (or (= cr 0u) (< tid 8u))
            (let ((pb (+ (* cg 73u) (coff (perm8 kx)))))
              (let ((b0r b0i b1r b1i b2r b2i b3r b3i b4r b4i b5r b5i b6r b6i b7r b7i
                     (dft8 (~ re (+ pb 0u)) (~ im (+ pb 0u)) (~ re (+ pb 584u)) (~ im (+ pb 584u)) (~ re (+ pb 1168u)) (~ im (+ pb 1168u)) (~ re (+ pb 1752u)) (~ im (+ pb 1752u)) (~ re (+ pb 2336u)) (~ im (+ pb 2336u)) (~ re (+ pb 2920u)) (~ im (+ pb 2920u)) (~ re (+ pb 3504u)) (~ im (+ pb 3504u)) (~ re (+ pb 4088u)) (~ im (+ pb 4088u)))))
                (set! (~ re (+ pb 0u)) b0r) (set! (~ im (+ pb 0u)) b0i)
                (let ((wr (~ twr (* cg 1u))) (wi (~ twi (* cg 1u))))
                  (set! (~ re (+ pb 584u)) (- (* b1r wr) (* b1i wi)))
                  (set! (~ im (+ pb 584u)) (+ (* b1i wr) (* b1r wi))))
                (let ((wr (~ twr (* cg 2u))) (wi (~ twi (* cg 2u))))
                  (set! (~ re (+ pb 1168u)) (- (* b2r wr) (* b2i wi)))
                  (set! (~ im (+ pb 1168u)) (+ (* b2i wr) (* b2r wi))))
                (let ((wr (~ twr (* cg 3u))) (wi (~ twi (* cg 3u))))
                  (set! (~ re (+ pb 1752u)) (- (* b3r wr) (* b3i wi)))
                  (set! (~ im (+ pb 1752u)) (+ (* b3i wr) (* b3r wi))))
                (let ((wr (~ twr (* cg 4u))) (wi (~ twi (* cg 4u))))
                  (set! (~ re (+ pb 2336u)) (- (* b4r wr) (* b4i wi)))
                  (set! (~ im (+ pb 2336u)) (+ (* b4i wr) (* b4r wi))))
                (let ((wr (~ twr (* cg 5u))) (wi (~ twi (* cg 5u))))
                  (set! (~ re (+ pb 2920u)) (- (* b5r wr) (* b5i wi)))
                  (set! (~ im (+ pb 2920u)) (+ (* b5i wr) (* b5r wi))))
                (let ((wr (~ twr (* cg 6u))) (wi (~ twi (* cg 6u))))
                  (set! (~ re (+ pb 3504u)) (- (* b6r wr) (* b6i wi)))
                  (set! (~ im (+ pb 3504u)) (+ (* b6i wr) (* b6r wi))))
                (let ((wr (~ twr (* cg 7u))) (wi (~ twi (* cg 7u))))
                  (set! (~ re (+ pb 4088u)) (- (* b7r wr) (* b7i wi)))
                  (set! (~ im (+ pb 4088u)) (+ (* b7i wr) (* b7r wi)))))))))
    (sync-workgroup)
    (dotimes (cr 2u)
      (let ((kx (if (= cr 0u) lane 32u))
            (cg (if (= cr 0u) wq tid)))
        (when (or (= cr 0u) (< tid 8u))
            (let ((pb (+ (* cg 584u) (coff (perm8 kx)))))
              (let ((b0r b0i b1r b1i b2r b2i b3r b3i b4r b4i b5r b5i b6r b6i b7r b7i
                     (dft8 (~ re (+ pb 0u)) (~ im (+ pb 0u)) (~ re (+ pb 73u)) (~ im (+ pb 73u)) (~ re (+ pb 146u)) (~ im (+ pb 146u)) (~ re (+ pb 219u)) (~ im (+ pb 219u)) (~ re (+ pb 292u)) (~ im (+ pb 292u)) (~ re (+ pb 365u)) (~ im (+ pb 365u)) (~ re (+ pb 438u)) (~ im (+ pb 438u)) (~ re (+ pb 511u)) (~ im (+ pb 511u)))))
                (set! (~ re (+ pb 0u)) b0r) (set! (~ im (+ pb 0u)) b0i)
                (set! (~ re (+ pb 73u)) b1r) (set! (~ im (+ pb 73u)) b1i)
                (set! (~ re (+ pb 146u)) b2r) (set! (~ im (+ pb 146u)) b2i)
                (set! (~ re (+ pb 219u)) b3r) (set! (~ im (+ pb 219u)) b3i)
                (set! (~ re (+ pb 292u)) b4r) (set! (~ im (+ pb 292u)) b4i)
                (set! (~ re (+ pb 365u)) b5r) (set! (~ im (+ pb 365u)) b5i)
                (set! (~ re (+ pb 438u)) b6r) (set! (~ im (+ pb 438u)) b6i)
                (set! (~ re (+ pb 511u)) b7r) (set! (~ im (+ pb 511u)) b7i))))))
    (sync-workgroup)
    (dotimes (j 9u)
      (let ((idx (+ tid (* j 256u))))
        (when (< idx 2112u)
          (let ((si (+ (* (/ idx 33u) 73u) (coff (perm8 (rem idx 33u))))))
            (set! (~ outr (+ obase idx)) (~ re si))
            (set! (~ outi (+ obase idx)) (if (= mode 0) (~ im si) (- (~ im si))))))))))

;; Inverse: one workgroup per (co, tile), g = co * NBT + tile.  Columns B^-1, A^-1 along y; each kept row's
;; other half spectrum by symmetry; rows B^-1, A^-1 along x; write the V x V corner that did not wrap.
(def-kernel fft8_inv (yr yi tw dims &out Y)
  (declare #'(in-vec in-vec in-vec dims-vec &out out-vec => nil)
           (global-size :derive-from Y :strategy :strided)
           (local-size  :set-to 256))
  (let ((C    (to-uint (~ dims 0)))
        (H    (to-uint (~ dims 1)))
        (K    (to-uint (~ dims 2)))
        (NBT  (to-uint (~ dims 4)))
        (nt   (to-uint (~ dims 5)))
        (NBTP (to-uint (~ dims 6)))
        (V    (- 65u K))
        (O    (+ (- H K) 1u))
        (re   (make-scratch-vector float 4672))
        (im   (make-scratch-vector float 4672))
        (twr  (make-scratch-vector float 64))
        (twi  (make-scratch-vector float 64))
        (g    (to-uint (get-workgroup-id 0)))
        (tid  (to-uint (get-local-linear-id)))
        (lane (logand tid 31u))
        (wq   (shift-right tid 5u))
        (co   (/ g NBT))
        (bt   (rem g NBT))
        (ntt  (* nt nt))
        (tt   (rem bt ntt))
        (oy0  (* (/ tt nt) V))
        (ox0  (* (rem tt nt) V))
        (obase (* (+ (* (/ bt ntt) C) co) O O))
        (ibase (* (+ (* co NBTP) bt) 2112u)))
    (declare (uniform C H K NBT nt NBTP V O))
    (when (< tid 64u)
      (set! (~ twr tid) (~ tw tid))
      (set! (~ twi tid) (~ tw (+ tid 64u))))
    (dotimes (j 9u)
      (let ((idx (+ tid (* j 256u))))
        (when (< idx 2112u)
          (let ((di (+ (* (/ idx 33u) 73u) (coff (perm8 (rem idx 33u))))))
            (set! (~ re di) (~ yr (+ ibase idx)))
            (set! (~ im di) (~ yi (+ ibase idx)))))))
    (sync-workgroup)
    (dotimes (cr 2u)
      (let ((kx (if (= cr 0u) lane 32u))
            (cg (if (= cr 0u) wq tid)))
        (when (or (= cr 0u) (< tid 8u))
            (let ((pb (+ (* cg 584u) (coff (perm8 kx)))))
              (let ((b0r b0i b1r b1i b2r b2i b3r b3i b4r b4i b5r b5i b6r b6i b7r b7i
                     (idft8 (~ re (+ pb 0u)) (~ im (+ pb 0u)) (~ re (+ pb 73u)) (~ im (+ pb 73u)) (~ re (+ pb 146u)) (~ im (+ pb 146u)) (~ re (+ pb 219u)) (~ im (+ pb 219u)) (~ re (+ pb 292u)) (~ im (+ pb 292u)) (~ re (+ pb 365u)) (~ im (+ pb 365u)) (~ re (+ pb 438u)) (~ im (+ pb 438u)) (~ re (+ pb 511u)) (~ im (+ pb 511u)))))
                (set! (~ re (+ pb 0u)) b0r) (set! (~ im (+ pb 0u)) b0i)
                (let ((wr (~ twr (* cg 1u))) (wi (~ twi (* cg 1u))))
                  (set! (~ re (+ pb 73u)) (+ (* b1r wr) (* b1i wi)))
                  (set! (~ im (+ pb 73u)) (- (* b1i wr) (* b1r wi))))
                (let ((wr (~ twr (* cg 2u))) (wi (~ twi (* cg 2u))))
                  (set! (~ re (+ pb 146u)) (+ (* b2r wr) (* b2i wi)))
                  (set! (~ im (+ pb 146u)) (- (* b2i wr) (* b2r wi))))
                (let ((wr (~ twr (* cg 3u))) (wi (~ twi (* cg 3u))))
                  (set! (~ re (+ pb 219u)) (+ (* b3r wr) (* b3i wi)))
                  (set! (~ im (+ pb 219u)) (- (* b3i wr) (* b3r wi))))
                (let ((wr (~ twr (* cg 4u))) (wi (~ twi (* cg 4u))))
                  (set! (~ re (+ pb 292u)) (+ (* b4r wr) (* b4i wi)))
                  (set! (~ im (+ pb 292u)) (- (* b4i wr) (* b4r wi))))
                (let ((wr (~ twr (* cg 5u))) (wi (~ twi (* cg 5u))))
                  (set! (~ re (+ pb 365u)) (+ (* b5r wr) (* b5i wi)))
                  (set! (~ im (+ pb 365u)) (- (* b5i wr) (* b5r wi))))
                (let ((wr (~ twr (* cg 6u))) (wi (~ twi (* cg 6u))))
                  (set! (~ re (+ pb 438u)) (+ (* b6r wr) (* b6i wi)))
                  (set! (~ im (+ pb 438u)) (- (* b6i wr) (* b6r wi))))
                (let ((wr (~ twr (* cg 7u))) (wi (~ twi (* cg 7u))))
                  (set! (~ re (+ pb 511u)) (+ (* b7r wr) (* b7i wi)))
                  (set! (~ im (+ pb 511u)) (- (* b7i wr) (* b7r wi)))))))))
    (sync-workgroup)
    (dotimes (cr 2u)
      (let ((kx (if (= cr 0u) lane 32u))
            (cg (if (= cr 0u) wq tid)))
        (when (or (= cr 0u) (< tid 8u))
            (let ((pb (+ (* cg 73u) (coff (perm8 kx)))))
              (let ((b0r b0i b1r b1i b2r b2i b3r b3i b4r b4i b5r b5i b6r b6i b7r b7i
                     (idft8 (~ re (+ pb 0u)) (~ im (+ pb 0u)) (~ re (+ pb 584u)) (~ im (+ pb 584u)) (~ re (+ pb 1168u)) (~ im (+ pb 1168u)) (~ re (+ pb 1752u)) (~ im (+ pb 1752u)) (~ re (+ pb 2336u)) (~ im (+ pb 2336u)) (~ re (+ pb 2920u)) (~ im (+ pb 2920u)) (~ re (+ pb 3504u)) (~ im (+ pb 3504u)) (~ re (+ pb 4088u)) (~ im (+ pb 4088u)))))
                (set! (~ re (+ pb 0u)) b0r) (set! (~ im (+ pb 0u)) b0i)
                (set! (~ re (+ pb 584u)) b1r) (set! (~ im (+ pb 584u)) b1i)
                (set! (~ re (+ pb 1168u)) b2r) (set! (~ im (+ pb 1168u)) b2i)
                (set! (~ re (+ pb 1752u)) b3r) (set! (~ im (+ pb 1752u)) b3i)
                (set! (~ re (+ pb 2336u)) b4r) (set! (~ im (+ pb 2336u)) b4i)
                (set! (~ re (+ pb 2920u)) b5r) (set! (~ im (+ pb 2920u)) b5i)
                (set! (~ re (+ pb 3504u)) b6r) (set! (~ im (+ pb 3504u)) b6i)
                (set! (~ re (+ pb 4088u)) b7r) (set! (~ im (+ pb 4088u)) b7i))))))
    (sync-workgroup)
    ;; rows 0 .. V-1: frequency kx = 33 .. 63 is the conjugate of frequency 64 - kx
    (dotimes (j 8u)
      (let ((idx (+ tid (* j 256u)))
            (row (/ idx 31u))
            (kx  (+ (rem idx 31u) 33u)))
        (when (< row V)
          (let ((dst (+ (* row 73u) (coff (perm8 kx))))
                (sr  (+ (* row 73u) (coff (perm8 (- 64u kx))))))
            (set! (~ re dst) (~ re sr))
            (set! (~ im dst) (- (~ im sr)))))))
    (sync-workgroup)
    (dotimes (rr 2u)
      (let ((row (+ lane (* rr 32u))))
        (when (< row V)
              (let ((pb (+ (* row 73u) (* wq 9u))))
                (let ((b0r b0i b1r b1i b2r b2i b3r b3i b4r b4i b5r b5i b6r b6i b7r b7i
                       (idft8 (~ re (+ pb 0u)) (~ im (+ pb 0u)) (~ re (+ pb 1u)) (~ im (+ pb 1u)) (~ re (+ pb 2u)) (~ im (+ pb 2u)) (~ re (+ pb 3u)) (~ im (+ pb 3u)) (~ re (+ pb 4u)) (~ im (+ pb 4u)) (~ re (+ pb 5u)) (~ im (+ pb 5u)) (~ re (+ pb 6u)) (~ im (+ pb 6u)) (~ re (+ pb 7u)) (~ im (+ pb 7u)))))
                  (set! (~ re (+ pb 0u)) b0r) (set! (~ im (+ pb 0u)) b0i)
                  (let ((wr (~ twr (* wq 1u))) (wi (~ twi (* wq 1u))))
                    (set! (~ re (+ pb 1u)) (+ (* b1r wr) (* b1i wi)))
                    (set! (~ im (+ pb 1u)) (- (* b1i wr) (* b1r wi))))
                  (let ((wr (~ twr (* wq 2u))) (wi (~ twi (* wq 2u))))
                    (set! (~ re (+ pb 2u)) (+ (* b2r wr) (* b2i wi)))
                    (set! (~ im (+ pb 2u)) (- (* b2i wr) (* b2r wi))))
                  (let ((wr (~ twr (* wq 3u))) (wi (~ twi (* wq 3u))))
                    (set! (~ re (+ pb 3u)) (+ (* b3r wr) (* b3i wi)))
                    (set! (~ im (+ pb 3u)) (- (* b3i wr) (* b3r wi))))
                  (let ((wr (~ twr (* wq 4u))) (wi (~ twi (* wq 4u))))
                    (set! (~ re (+ pb 4u)) (+ (* b4r wr) (* b4i wi)))
                    (set! (~ im (+ pb 4u)) (- (* b4i wr) (* b4r wi))))
                  (let ((wr (~ twr (* wq 5u))) (wi (~ twi (* wq 5u))))
                    (set! (~ re (+ pb 5u)) (+ (* b5r wr) (* b5i wi)))
                    (set! (~ im (+ pb 5u)) (- (* b5i wr) (* b5r wi))))
                  (let ((wr (~ twr (* wq 6u))) (wi (~ twi (* wq 6u))))
                    (set! (~ re (+ pb 6u)) (+ (* b6r wr) (* b6i wi)))
                    (set! (~ im (+ pb 6u)) (- (* b6i wr) (* b6r wi))))
                  (let ((wr (~ twr (* wq 7u))) (wi (~ twi (* wq 7u))))
                    (set! (~ re (+ pb 7u)) (+ (* b7r wr) (* b7i wi)))
                    (set! (~ im (+ pb 7u)) (- (* b7i wr) (* b7r wi)))))))))
    (sync-workgroup)
    (dotimes (rr 2u)
      (let ((row (+ lane (* rr 32u))))
        (when (< row V)
              (let ((pb (+ (* row 73u) wq)))
                (let ((b0r b0i b1r b1i b2r b2i b3r b3i b4r b4i b5r b5i b6r b6i b7r b7i
                       (idft8 (~ re (+ pb 0u)) (~ im (+ pb 0u)) (~ re (+ pb 9u)) (~ im (+ pb 9u)) (~ re (+ pb 18u)) (~ im (+ pb 18u)) (~ re (+ pb 27u)) (~ im (+ pb 27u)) (~ re (+ pb 36u)) (~ im (+ pb 36u)) (~ re (+ pb 45u)) (~ im (+ pb 45u)) (~ re (+ pb 54u)) (~ im (+ pb 54u)) (~ re (+ pb 63u)) (~ im (+ pb 63u)))))
                  (set! (~ re (+ pb 0u)) b0r) (set! (~ im (+ pb 0u)) b0i)
                  (set! (~ re (+ pb 9u)) b1r) (set! (~ im (+ pb 9u)) b1i)
                  (set! (~ re (+ pb 18u)) b2r) (set! (~ im (+ pb 18u)) b2i)
                  (set! (~ re (+ pb 27u)) b3r) (set! (~ im (+ pb 27u)) b3i)
                  (set! (~ re (+ pb 36u)) b4r) (set! (~ im (+ pb 36u)) b4i)
                  (set! (~ re (+ pb 45u)) b5r) (set! (~ im (+ pb 45u)) b5i)
                  (set! (~ re (+ pb 54u)) b6r) (set! (~ im (+ pb 54u)) b6i)
                  (set! (~ re (+ pb 63u)) b7r) (set! (~ im (+ pb 63u)) b7i))))))
    (sync-workgroup)
    (dotimes (j 16u)
      (let ((idx (+ tid (* j 256u)))
            (row (shift-right idx 6u))
            (px  (logand idx 63u))
            (oy  (+ oy0 row))
            (ox  (+ ox0 px)))
        (when (and (< row V) (< px V) (< oy O) (< ox O))
          (set! (~ Y (+ obase (* oy O) ox))
                (* (~ re (+ (* row 73u) (coff px))) 0.000244140625)))))))

;; cgemm with 512-thread workgroups: warps 0-7 and 8-15 take two neighbouring 7-tile blocks of the same
;; 32 channels, so each Wf line fetched from L2 serves both (through L1).  Groups = 66 * nCG * ceil(nTB / 2);
;; a block past the padded tile count idles.
(def-kernel cgemm2 (xr xi wr wi dims &out yr yi)
  (declare #'(in-vec in-vec in-vec in-vec dims-vec &out out-vec out-vec => nil)
           (global-size :derive-from yr :strategy :strided)
           (local-size  :set-to 512))
  (let ((C    (to-ulong (~ dims 0)))
        (NBT  (to-ulong (~ dims 4)))
        (NBTP (to-ulong (~ dims 6)))
        (nTB  (/ (+ (/ NBTP 7ul) 1ul) 2ul))     ; workgroups along the tiles
        (nCG  (/ (+ C 31ul) 32ul))
        (g    (get-workgroup-id 0))
        (tid  (get-local-linear-id))
        (tb   (rem g nTB))
        (cg   (rem (/ g nTB) nCG))
        (bin  (+ (* (/ g (* nTB nCG)) 32ul) (logand tid 31ul)))
        (co0  (+ (* cg 32ul) (* (logand (shift-right tid 5ul) 7ul) 4ul)))
        (t0   (* (+ (* tb 2ul) (shift-right tid 8ul)) 7ul))
        (CS   (* C 2112ul))                       ; Wf: next co
        (TS   (* NBTP 2112ul))                    ; Xf: next ci;  Yf: next co
        (r0 ##(0.0 0.0 0.0 0.0)) (q0 ##(0.0 0.0 0.0 0.0))
        (r1 ##(0.0 0.0 0.0 0.0)) (q1 ##(0.0 0.0 0.0 0.0))
        (r2 ##(0.0 0.0 0.0 0.0)) (q2 ##(0.0 0.0 0.0 0.0))
        (r3 ##(0.0 0.0 0.0 0.0)) (q3 ##(0.0 0.0 0.0 0.0))
        (r4 ##(0.0 0.0 0.0 0.0)) (q4 ##(0.0 0.0 0.0 0.0))
        (r5 ##(0.0 0.0 0.0 0.0)) (q5 ##(0.0 0.0 0.0 0.0))
        (r6 ##(0.0 0.0 0.0 0.0)) (q6 ##(0.0 0.0 0.0 0.0)))
    (declare (uniform C NBT NBTP nTB nCG CS TS))
    (when (and (< co0 C) (< t0 NBTP))
      (dotimes (ci C)
        (let ((wb  (+ (* (+ (* co0 C) ci) 2112ul) bin))
              (a0  (~ wr wb))                (b0 (~ wi wb))
              (a1  (~ wr (+ wb CS)))         (b1 (~ wi (+ wb CS)))
              (a2  (~ wr (+ wb (* 2ul CS)))) (b2 (~ wi (+ wb (* 2ul CS))))
              (a3  (~ wr (+ wb (* 3ul CS)))) (b3 (~ wi (+ wb (* 3ul CS))))
              (wr4 ##(a0 a1 a2 a3))
              (wi4 ##(b0 b1 b2 b3))
              (wn4 ##((- b0) (- b1) (- b2) (- b3)))
              (xb  (+ (* ci TS) (* t0 2112ul) bin))
              (u0 (~ xr xb))              (v0 (~ xi xb))
              (u1 (~ xr (+ xb 2112ul)))   (v1 (~ xi (+ xb 2112ul)))
              (u2 (~ xr (+ xb 4224ul)))   (v2 (~ xi (+ xb 4224ul)))
              (u3 (~ xr (+ xb 6336ul)))   (v3 (~ xi (+ xb 6336ul)))
              (u4 (~ xr (+ xb 8448ul)))   (v4 (~ xi (+ xb 8448ul)))
              (u5 (~ xr (+ xb 10560ul)))  (v5 (~ xi (+ xb 10560ul)))
              (u6 (~ xr (+ xb 12672ul)))  (v6 (~ xi (+ xb 12672ul))))
          ;; (wr + i wi)(u + i v) = (wr u - wi v) + i (wr v + wi u)
          (set! r0 (op-fma wn4 (splat v0) (op-fma wr4 (splat u0) r0)))
          (set! q0 (op-fma wi4 (splat u0) (op-fma wr4 (splat v0) q0)))
          (set! r1 (op-fma wn4 (splat v1) (op-fma wr4 (splat u1) r1)))
          (set! q1 (op-fma wi4 (splat u1) (op-fma wr4 (splat v1) q1)))
          (set! r2 (op-fma wn4 (splat v2) (op-fma wr4 (splat u2) r2)))
          (set! q2 (op-fma wi4 (splat u2) (op-fma wr4 (splat v2) q2)))
          (set! r3 (op-fma wn4 (splat v3) (op-fma wr4 (splat u3) r3)))
          (set! q3 (op-fma wi4 (splat u3) (op-fma wr4 (splat v3) q3)))
          (set! r4 (op-fma wn4 (splat v4) (op-fma wr4 (splat u4) r4)))
          (set! q4 (op-fma wi4 (splat u4) (op-fma wr4 (splat v4) q4)))
          (set! r5 (op-fma wn4 (splat v5) (op-fma wr4 (splat u5) r5)))
          (set! q5 (op-fma wi4 (splat u5) (op-fma wr4 (splat v5) q5)))
          (set! r6 (op-fma wn4 (splat v6) (op-fma wr4 (splat u6) r6)))
          (set! q6 (op-fma wi4 (splat u6) (op-fma wr4 (splat v6) q6)))))
      (let ((yb (+ (* co0 TS) (* t0 2112ul) bin)))
        (when (< t0 NBT)
          (let ((o (+ yb 0ul)))
            (set! (~ yr o) (x~ r0)) (set! (~ yr (+ o TS)) (y~ r0)) (set! (~ yr (+ o (* 2ul TS))) (z~ r0)) (set! (~ yr (+ o (* 3ul TS))) (w~ r0))
            (set! (~ yi o) (x~ q0)) (set! (~ yi (+ o TS)) (y~ q0)) (set! (~ yi (+ o (* 2ul TS))) (z~ q0)) (set! (~ yi (+ o (* 3ul TS))) (w~ q0))))
        (when (< (+ t0 1ul) NBT)
          (let ((o (+ yb 2112ul)))
            (set! (~ yr o) (x~ r1)) (set! (~ yr (+ o TS)) (y~ r1)) (set! (~ yr (+ o (* 2ul TS))) (z~ r1)) (set! (~ yr (+ o (* 3ul TS))) (w~ r1))
            (set! (~ yi o) (x~ q1)) (set! (~ yi (+ o TS)) (y~ q1)) (set! (~ yi (+ o (* 2ul TS))) (z~ q1)) (set! (~ yi (+ o (* 3ul TS))) (w~ q1))))
        (when (< (+ t0 2ul) NBT)
          (let ((o (+ yb 4224ul)))
            (set! (~ yr o) (x~ r2)) (set! (~ yr (+ o TS)) (y~ r2)) (set! (~ yr (+ o (* 2ul TS))) (z~ r2)) (set! (~ yr (+ o (* 3ul TS))) (w~ r2))
            (set! (~ yi o) (x~ q2)) (set! (~ yi (+ o TS)) (y~ q2)) (set! (~ yi (+ o (* 2ul TS))) (z~ q2)) (set! (~ yi (+ o (* 3ul TS))) (w~ q2))))
        (when (< (+ t0 3ul) NBT)
          (let ((o (+ yb 6336ul)))
            (set! (~ yr o) (x~ r3)) (set! (~ yr (+ o TS)) (y~ r3)) (set! (~ yr (+ o (* 2ul TS))) (z~ r3)) (set! (~ yr (+ o (* 3ul TS))) (w~ r3))
            (set! (~ yi o) (x~ q3)) (set! (~ yi (+ o TS)) (y~ q3)) (set! (~ yi (+ o (* 2ul TS))) (z~ q3)) (set! (~ yi (+ o (* 3ul TS))) (w~ q3))))
        (when (< (+ t0 4ul) NBT)
          (let ((o (+ yb 8448ul)))
            (set! (~ yr o) (x~ r4)) (set! (~ yr (+ o TS)) (y~ r4)) (set! (~ yr (+ o (* 2ul TS))) (z~ r4)) (set! (~ yr (+ o (* 3ul TS))) (w~ r4))
            (set! (~ yi o) (x~ q4)) (set! (~ yi (+ o TS)) (y~ q4)) (set! (~ yi (+ o (* 2ul TS))) (z~ q4)) (set! (~ yi (+ o (* 3ul TS))) (w~ q4))))
        (when (< (+ t0 5ul) NBT)
          (let ((o (+ yb 10560ul)))
            (set! (~ yr o) (x~ r5)) (set! (~ yr (+ o TS)) (y~ r5)) (set! (~ yr (+ o (* 2ul TS))) (z~ r5)) (set! (~ yr (+ o (* 3ul TS))) (w~ r5))
            (set! (~ yi o) (x~ q5)) (set! (~ yi (+ o TS)) (y~ q5)) (set! (~ yi (+ o (* 2ul TS))) (z~ q5)) (set! (~ yi (+ o (* 3ul TS))) (w~ q5))))
        (when (< (+ t0 6ul) NBT)
          (let ((o (+ yb 12672ul)))
            (set! (~ yr o) (x~ r6)) (set! (~ yr (+ o TS)) (y~ r6)) (set! (~ yr (+ o (* 2ul TS))) (z~ r6)) (set! (~ yr (+ o (* 3ul TS))) (w~ r6))
            (set! (~ yi o) (x~ q6)) (set! (~ yi (+ o TS)) (y~ q6)) (set! (~ yi (+ o (* 2ul TS))) (z~ q6)) (set! (~ yi (+ o (* 3ul TS))) (w~ q6))))))))
