;; conv2d_v2 performant entry, FFT lane (GPUs whose cuDNN reference is itself an FFT -- the A100).
;;
;; Where the reference is accurate, the convolution may be computed any accurate way, and the 32 x 32 filter
;; makes the direct method 100x more arithmetic than an FFT.  Overlap-save on 64 x 64 tiles:
;;
;;   fft_fwd  (mode 0)  every input tile (64 x 64, step V = 65 - K)  -> 64 x 33 half spectrum
;;   fft_fwd  (mode 1)  every filter, zero-padded to 64 x 64          -> 64 x 33 half spectrum, conjugated
;;   cgemm              per frequency bin: Yf[co][tile] = sum over ci of conj(Wf[co][ci]) * Xf[ci][tile]
;;   fft_inv            every (co, tile): inverse transform, keep the V x V corner that did not wrap
;;
;; conj(Wf) * Xf is the spectrum of the circular CROSS-correlation, which is what conv2d computes (no flip).
;; Complex numbers are planar: a real array and an imaginary array, so every stage is plain fp32 arithmetic.
;; Spectra are stored in a scrambled bin order (rows bit-reversed), the same for X, W and Y -- a per-bin
;; product never needs the natural order, so no stage unscrambles.
;;
;; Layouts (bins innermost, NB = 64 * 33 = 2112):  Xf [ci][tile][bin]   Wf [co][ci][bin]   Yf [co][tile][bin]
;; with tiles = batch x nt x nt, padded to NBTP (a multiple of 7) for cgemm's 7-tile register block.
;; dims = (C, H, K, mode, NBT, nt, NBTP, B).  The twiddles tw = (cos 2 pi m / 64 ; -sin 2 pi m / 64), m < 32,
;; come from the host.  K must be at most 33 (V >= 32 keeps the tile count small; correctness needs K <= 64).
(def-type in-vec   (vector float :address-space :global :align :compact))
(def-type out-vec  (vector float :address-space :global :align :compact))
(def-type dims-vec (vector int   :address-space :global :align :compact))

(def-function splat (s)
  (declare #'(float => float4))
  ##(s s s s))

;; The 6-bit reversal of v (0 <= v < 64).
(def-function bitrev6 (v)
  (declare #'(ulong => ulong))
  (logior (logior (logior (shift-left (logand v 1ul) 5ul) (shift-left (logand v 2ul) 3ul))
                  (logior (shift-left (logand v 4ul) 1ul) (shift-right (logand v 8ul) 1ul)))
          (logior (shift-right (logand v 16ul) 3ul) (shift-right (logand v 32ul) 5ul))))

;; One workgroup per tile (mode 0: g = ci * NBT + tile) or per filter (mode 1: g = co * C + ci).
;; Rows: decimation in time along x, input loaded bit-reversed, so the row spectra come out natural and the
;; half spectrum is columns 0 .. 32.  Columns: decimation in frequency along y on those 33 columns (natural
;; in, bit-reversed out).  Shared rows are padded to 65 floats.
(def-kernel fft_fwd (src tw dims &out outr outi)
  (declare #'(in-vec in-vec dims-vec &out out-vec out-vec => nil)
           (global-size :derive-from outr :strategy :strided)
           (local-size  :set-to 256))
  (let ((C    (to-ulong (~ dims 0)))
        (H    (to-ulong (~ dims 1)))
        (K    (to-ulong (~ dims 2)))
        (mode (~ dims 3))
        (NBT  (to-ulong (~ dims 4)))
        (nt   (to-ulong (~ dims 5)))
        (NBTP (to-ulong (~ dims 6)))
        (V    (- 65ul K))
        (NR   (if (= mode 0) 64ul K))             ; rows that can be nonzero
        (re   (make-scratch-vector float 4160))   ; 64 x 65
        (im   (make-scratch-vector float 4160))
        (twr  (make-scratch-vector float 32))
        (twi  (make-scratch-vector float 32))
        (g    (get-workgroup-id 0))
        (tid  (get-local-linear-id))
        (bt   (rem g NBT))
        (ntt  (* nt nt))
        (tt   (rem bt ntt))
        (y0   (* (/ tt nt) V))
        (x0   (* (rem tt nt) V))
        (base (if (= mode 0) (* (+ (* (/ bt ntt) C) (/ g NBT)) H H) (* g K K)))
        (obase (if (= mode 0) (* (+ (* (/ g NBT) NBTP) bt) 2112ul) (* g 2112ul))))
    (declare (uniform C H K mode NBT nt NBTP V NR))
    (when (< tid 32ul)
      (set! (~ twr tid) (~ tw tid))
      (set! (~ twi tid) (~ tw (+ tid 32ul))))
    (dotimes (j 16ul)
      (let ((idx (+ tid (* j 256ul)))
            (row (shift-right idx 6ul))
            (cx  (logand idx 63ul))
            (dst (+ (* row 65ul) (bitrev6 cx))))
        (set! (~ re dst)
              (if (= mode 0)
                  (let ((gy (+ y0 row)) (gx (+ x0 cx)))
                    (if (and (< gy H) (< gx H)) (~ src (+ base (* gy H) gx)) 0.0))
                  (if (and (< row K) (< cx K)) (~ src (+ base (* row K) cx)) 0.0)))
        (set! (~ im dst) 0.0)))
    (sync-workgroup)
    ;; rows: DIT, span hs = 1, 2, .. 32
    (dotimes (s 6ul)
      (let ((hs (shift-left 1ul s)))
        (dotimes (j 8ul)
          (let ((idx (+ tid (* j 256ul)))
                (row (shift-right idx 5ul)))
            (when (< row NR)
              (let ((bk  (logand idx 31ul))
                    (pos (logand bk (- hs 1ul)))
                    (i0  (+ (* row 65ul) (shift-left (- bk pos) 1ul) pos))
                    (i1  (+ i0 hs))
                    (m   (shift-left pos (- 5ul s)))
                    (wr  (~ twr m))
                    (wi  (~ twi m))
                    (ar  (~ re i0))
                    (ai  (~ im i0))
                    (cr  (~ re i1))
                    (ci  (~ im i1))
                    (br  (- (* cr wr) (* ci wi)))
                    (bi  (+ (* cr wi) (* ci wr))))
                (set! (~ re i0) (+ ar br))
                (set! (~ im i0) (+ ai bi))
                (set! (~ re i1) (- ar br))
                (set! (~ im i1) (- ai bi))))))
        (sync-workgroup)))
    ;; columns 0 .. 32: DIF along y, span hs = 32, 16, .. 1
    (dotimes (s 6ul)
      (let ((hs (shift-right 32ul s)))
        (dotimes (j 5ul)
          (let ((idx (+ tid (* j 256ul))))
            (when (< idx 1056ul)
              (let ((cx  (rem idx 33ul))
                    (bk  (/ idx 33ul))
                    (pos (logand bk (- hs 1ul)))
                    (r0  (+ (shift-left (- bk pos) 1ul) pos))
                    (i0  (+ (* r0 65ul) cx))
                    (i1  (+ i0 (* hs 65ul)))
                    (m   (shift-left pos s))
                    (wr  (~ twr m))
                    (wi  (~ twi m))
                    (ar  (~ re i0))
                    (ai  (~ im i0))
                    (cr  (~ re i1))
                    (ci  (~ im i1))
                    (dr  (- ar cr))
                    (di  (- ai ci)))
                (set! (~ re i0) (+ ar cr))
                (set! (~ im i0) (+ ai ci))
                (set! (~ re i1) (- (* dr wr) (* di wi)))
                (set! (~ im i1) (+ (* dr wi) (* di wr)))))))
        (sync-workgroup)))
    (dotimes (j 9ul)
      (let ((idx (+ tid (* j 256ul))))
        (when (< idx 2112ul)
          (let ((src-i (+ (* (/ idx 33ul) 65ul) (rem idx 33ul))))
            (set! (~ outr (+ obase idx)) (~ re src-i))
            (set! (~ outi (+ obase idx)) (if (= mode 0) (~ im src-i) (- (~ im src-i))))))))))

;; Per frequency bin a complex GEMM, M = co, N = tile, K-dim = ci.  A warp is 32 consecutive bins (so every
;; load is one coalesced 128-byte line); a thread owns 4 output channels x 7 tiles of ITS bin: fourteen
;; float4 accumulators (real, imaginary), lanes = the 4 channels.  The 8 warps of a workgroup share the
;; tile block (their Xf loads hit L1) and differ in channels.  g = (bin group * nCG + co group) * nTB + tb.
(def-kernel cgemm (xr xi wr wi dims &out yr yi)
  (declare #'(in-vec in-vec in-vec in-vec dims-vec &out out-vec out-vec => nil)
           (global-size :derive-from yr :strategy :strided)
           (local-size  :set-to 256))
  (let ((C    (to-ulong (~ dims 0)))
        (NBT  (to-ulong (~ dims 4)))
        (NBTP (to-ulong (~ dims 6)))
        (nTB  (/ NBTP 7ul))
        (nCG  (/ (+ C 31ul) 32ul))
        (g    (get-workgroup-id 0))
        (tid  (get-local-linear-id))
        (tb   (rem g nTB))
        (cg   (rem (/ g nTB) nCG))
        (bin  (+ (* (/ g (* nTB nCG)) 32ul) (logand tid 31ul)))
        (co0  (+ (* cg 32ul) (* (shift-right tid 5ul) 4ul)))
        (t0   (* tb 7ul))
        (CS   (* C 2112ul))                       ; Wf: next co
        (TS   (* NBTP 2112ul))                    ; Xf: next ci;  Yf: next co
        (r0 ##(0.0 0.0 0.0 0.0)) (q0 ##(0.0 0.0 0.0 0.0))
        (r1 ##(0.0 0.0 0.0 0.0)) (q1 ##(0.0 0.0 0.0 0.0))
        (r2 ##(0.0 0.0 0.0 0.0)) (q2 ##(0.0 0.0 0.0 0.0))
        (r3 ##(0.0 0.0 0.0 0.0)) (q3 ##(0.0 0.0 0.0 0.0))
        (r4 ##(0.0 0.0 0.0 0.0)) (q4 ##(0.0 0.0 0.0 0.0))
        (r5 ##(0.0 0.0 0.0 0.0)) (q5 ##(0.0 0.0 0.0 0.0))
        (r6 ##(0.0 0.0 0.0 0.0)) (q6 ##(0.0 0.0 0.0 0.0)))
    (declare (uniform C NBT NBTP nTB nCG CS TS))
    (when (< co0 C)
      (dotimes (ci C)
        (let ((wb  (+ (* (+ (* co0 C) ci) 2112ul) bin))
              (a0  (~ wr wb))                (b0 (~ wi wb))
              (a1  (~ wr (+ wb CS)))         (b1 (~ wi (+ wb CS)))
              (a2  (~ wr (+ wb (* 2ul CS)))) (b2 (~ wi (+ wb (* 2ul CS))))
              (a3  (~ wr (+ wb (* 3ul CS)))) (b3 (~ wi (+ wb (* 3ul CS))))
              (wr4 ##(a0 a1 a2 a3))
              (wi4 ##(b0 b1 b2 b3))
              (wn4 ##((- b0) (- b1) (- b2) (- b3)))
              (xb  (+ (* ci TS) (* t0 2112ul) bin))
              (u0 (~ xr xb))              (v0 (~ xi xb))
              (u1 (~ xr (+ xb 2112ul)))   (v1 (~ xi (+ xb 2112ul)))
              (u2 (~ xr (+ xb 4224ul)))   (v2 (~ xi (+ xb 4224ul)))
              (u3 (~ xr (+ xb 6336ul)))   (v3 (~ xi (+ xb 6336ul)))
              (u4 (~ xr (+ xb 8448ul)))   (v4 (~ xi (+ xb 8448ul)))
              (u5 (~ xr (+ xb 10560ul)))  (v5 (~ xi (+ xb 10560ul)))
              (u6 (~ xr (+ xb 12672ul)))  (v6 (~ xi (+ xb 12672ul))))
          ;; (wr + i wi)(u + i v) = (wr u - wi v) + i (wr v + wi u)
          (set! r0 (op-fma wn4 (splat v0) (op-fma wr4 (splat u0) r0)))
          (set! q0 (op-fma wi4 (splat u0) (op-fma wr4 (splat v0) q0)))
          (set! r1 (op-fma wn4 (splat v1) (op-fma wr4 (splat u1) r1)))
          (set! q1 (op-fma wi4 (splat u1) (op-fma wr4 (splat v1) q1)))
          (set! r2 (op-fma wn4 (splat v2) (op-fma wr4 (splat u2) r2)))
          (set! q2 (op-fma wi4 (splat u2) (op-fma wr4 (splat v2) q2)))
          (set! r3 (op-fma wn4 (splat v3) (op-fma wr4 (splat u3) r3)))
          (set! q3 (op-fma wi4 (splat u3) (op-fma wr4 (splat v3) q3)))
          (set! r4 (op-fma wn4 (splat v4) (op-fma wr4 (splat u4) r4)))
          (set! q4 (op-fma wi4 (splat u4) (op-fma wr4 (splat v4) q4)))
          (set! r5 (op-fma wn4 (splat v5) (op-fma wr4 (splat u5) r5)))
          (set! q5 (op-fma wi4 (splat u5) (op-fma wr4 (splat v5) q5)))
          (set! r6 (op-fma wn4 (splat v6) (op-fma wr4 (splat u6) r6)))
          (set! q6 (op-fma wi4 (splat u6) (op-fma wr4 (splat v6) q6)))))
      (let ((yb (+ (* co0 TS) (* t0 2112ul) bin)))
        (when (< t0 NBT)
          (let ((o (+ yb 0ul)))
            (set! (~ yr o) (x~ r0)) (set! (~ yr (+ o TS)) (y~ r0)) (set! (~ yr (+ o (* 2ul TS))) (z~ r0)) (set! (~ yr (+ o (* 3ul TS))) (w~ r0))
            (set! (~ yi o) (x~ q0)) (set! (~ yi (+ o TS)) (y~ q0)) (set! (~ yi (+ o (* 2ul TS))) (z~ q0)) (set! (~ yi (+ o (* 3ul TS))) (w~ q0))))
        (when (< (+ t0 1ul) NBT)
          (let ((o (+ yb 2112ul)))
            (set! (~ yr o) (x~ r1)) (set! (~ yr (+ o TS)) (y~ r1)) (set! (~ yr (+ o (* 2ul TS))) (z~ r1)) (set! (~ yr (+ o (* 3ul TS))) (w~ r1))
            (set! (~ yi o) (x~ q1)) (set! (~ yi (+ o TS)) (y~ q1)) (set! (~ yi (+ o (* 2ul TS))) (z~ q1)) (set! (~ yi (+ o (* 3ul TS))) (w~ q1))))
        (when (< (+ t0 2ul) NBT)
          (let ((o (+ yb 4224ul)))
            (set! (~ yr o) (x~ r2)) (set! (~ yr (+ o TS)) (y~ r2)) (set! (~ yr (+ o (* 2ul TS))) (z~ r2)) (set! (~ yr (+ o (* 3ul TS))) (w~ r2))
            (set! (~ yi o) (x~ q2)) (set! (~ yi (+ o TS)) (y~ q2)) (set! (~ yi (+ o (* 2ul TS))) (z~ q2)) (set! (~ yi (+ o (* 3ul TS))) (w~ q2))))
        (when (< (+ t0 3ul) NBT)
          (let ((o (+ yb 6336ul)))
            (set! (~ yr o) (x~ r3)) (set! (~ yr (+ o TS)) (y~ r3)) (set! (~ yr (+ o (* 2ul TS))) (z~ r3)) (set! (~ yr (+ o (* 3ul TS))) (w~ r3))
            (set! (~ yi o) (x~ q3)) (set! (~ yi (+ o TS)) (y~ q3)) (set! (~ yi (+ o (* 2ul TS))) (z~ q3)) (set! (~ yi (+ o (* 3ul TS))) (w~ q3))))
        (when (< (+ t0 4ul) NBT)
          (let ((o (+ yb 8448ul)))
            (set! (~ yr o) (x~ r4)) (set! (~ yr (+ o TS)) (y~ r4)) (set! (~ yr (+ o (* 2ul TS))) (z~ r4)) (set! (~ yr (+ o (* 3ul TS))) (w~ r4))
            (set! (~ yi o) (x~ q4)) (set! (~ yi (+ o TS)) (y~ q4)) (set! (~ yi (+ o (* 2ul TS))) (z~ q4)) (set! (~ yi (+ o (* 3ul TS))) (w~ q4))))
        (when (< (+ t0 5ul) NBT)
          (let ((o (+ yb 10560ul)))
            (set! (~ yr o) (x~ r5)) (set! (~ yr (+ o TS)) (y~ r5)) (set! (~ yr (+ o (* 2ul TS))) (z~ r5)) (set! (~ yr (+ o (* 3ul TS))) (w~ r5))
            (set! (~ yi o) (x~ q5)) (set! (~ yi (+ o TS)) (y~ q5)) (set! (~ yi (+ o (* 2ul TS))) (z~ q5)) (set! (~ yi (+ o (* 3ul TS))) (w~ q5))))
        (when (< (+ t0 6ul) NBT)
          (let ((o (+ yb 12672ul)))
            (set! (~ yr o) (x~ r6)) (set! (~ yr (+ o TS)) (y~ r6)) (set! (~ yr (+ o (* 2ul TS))) (z~ r6)) (set! (~ yr (+ o (* 3ul TS))) (w~ r6))
            (set! (~ yi o) (x~ q6)) (set! (~ yi (+ o TS)) (y~ q6)) (set! (~ yi (+ o (* 2ul TS))) (z~ q6)) (set! (~ yi (+ o (* 3ul TS))) (w~ q6))))))))

;; One workgroup per (co, tile): g = co * NBT + tile.  Columns: inverse DIT along y (bit-reversed in,
;; natural out); then each kept row gets its other half spectrum by symmetry (a real row's spectrum is
;; Hermitian) and an inverse DIF along x (natural in, bit-reversed out -- read back through bitrev6).
;; Only the V rows and V columns that did not wrap are transformed / written.
(def-kernel fft_inv (yr yi tw dims &out Y)
  (declare #'(in-vec in-vec in-vec dims-vec &out out-vec => nil)
           (global-size :derive-from Y :strategy :strided)
           (local-size  :set-to 256))
  (let ((C    (to-ulong (~ dims 0)))
        (H    (to-ulong (~ dims 1)))
        (K    (to-ulong (~ dims 2)))
        (NBT  (to-ulong (~ dims 4)))
        (nt   (to-ulong (~ dims 5)))
        (NBTP (to-ulong (~ dims 6)))
        (V    (- 65ul K))
        (O    (+ (- H K) 1ul))
        (re   (make-scratch-vector float 4160))
        (im   (make-scratch-vector float 4160))
        (twr  (make-scratch-vector float 32))
        (twi  (make-scratch-vector float 32))
        (g    (get-workgroup-id 0))
        (tid  (get-local-linear-id))
        (co   (/ g NBT))
        (bt   (rem g NBT))
        (ntt  (* nt nt))
        (tt   (rem bt ntt))
        (oy0  (* (/ tt nt) V))
        (ox0  (* (rem tt nt) V))
        (obase (* (+ (* (/ bt ntt) C) co) O O))
        (ibase (* (+ (* co NBTP) bt) 2112ul)))
    (declare (uniform C H K NBT nt NBTP V O))
    (when (< tid 32ul)
      (set! (~ twr tid) (~ tw tid))
      (set! (~ twi tid) (- (~ tw (+ tid 32ul)))))        ; conjugate twiddles: inverse transform
    (dotimes (j 9ul)
      (let ((idx (+ tid (* j 256ul))))
        (when (< idx 2112ul)
          (let ((dst (+ (* (/ idx 33ul) 65ul) (rem idx 33ul))))
            (set! (~ re dst) (~ yr (+ ibase idx)))
            (set! (~ im dst) (~ yi (+ ibase idx)))))))
    (sync-workgroup)
    ;; columns 0 .. 32: inverse DIT along y, span hs = 1, 2, .. 32
    (dotimes (s 6ul)
      (let ((hs (shift-left 1ul s)))
        (dotimes (j 5ul)
          (let ((idx (+ tid (* j 256ul))))
            (when (< idx 1056ul)
              (let ((cx  (rem idx 33ul))
                    (bk  (/ idx 33ul))
                    (pos (logand bk (- hs 1ul)))
                    (r0  (+ (shift-left (- bk pos) 1ul) pos))
                    (i0  (+ (* r0 65ul) cx))
                    (i1  (+ i0 (* hs 65ul)))
                    (m   (shift-left pos (- 5ul s)))
                    (wr  (~ twr m))
                    (wi  (~ twi m))
                    (ar  (~ re i0))
                    (ai  (~ im i0))
                    (cr  (~ re i1))
                    (ci  (~ im i1))
                    (br  (- (* cr wr) (* ci wi)))
                    (bi  (+ (* cr wi) (* ci wr))))
                (set! (~ re i0) (+ ar br))
                (set! (~ im i0) (+ ai bi))
                (set! (~ re i1) (- ar br))
                (set! (~ im i1) (- ai bi))))))
        (sync-workgroup)))
    ;; rows 0 .. V-1: columns 33 .. 63 = conj of columns 31 .. 1
    (dotimes (j 8ul)
      (let ((idx (+ tid (* j 256ul)))
            (row (/ idx 31ul))
            (cx  (+ (rem idx 31ul) 33ul)))
        (when (< row V)
          (set! (~ re (+ (* row 65ul) cx)) (~ re (+ (* row 65ul) (- 64ul cx))))
          (set! (~ im (+ (* row 65ul) cx)) (- (~ im (+ (* row 65ul) (- 64ul cx))))))))
    (sync-workgroup)
    ;; rows 0 .. V-1: inverse DIF along x, span hs = 32, 16, .. 1
    (dotimes (s 6ul)
      (let ((hs (shift-right 32ul s)))
        (dotimes (j 8ul)
          (let ((idx (+ tid (* j 256ul)))
                (row (shift-right idx 5ul)))
            (when (< row V)
              (let ((bk  (logand idx 31ul))
                    (pos (logand bk (- hs 1ul)))
                    (i0  (+ (* row 65ul) (shift-left (- bk pos) 1ul) pos))
                    (i1  (+ i0 hs))
                    (m   (shift-left pos s))
                    (wr  (~ twr m))
                    (wi  (~ twi m))
                    (ar  (~ re i0))
                    (ai  (~ im i0))
                    (cr  (~ re i1))
                    (ci  (~ im i1))
                    (dr  (- ar cr))
                    (di  (- ai ci)))
                (set! (~ re i0) (+ ar cr))
                (set! (~ im i0) (+ ai ci))
                (set! (~ re i1) (- (* dr wr) (* di wi)))
                (set! (~ im i1) (+ (* dr wi) (* di wr)))))))
        (sync-workgroup)))
    (dotimes (j 16ul)
      (let ((idx (+ tid (* j 256ul)))
            (row (shift-right idx 6ul))
            (px  (logand idx 63ul))
            (oy  (+ oy0 row))
            (ox  (+ ox0 px)))
        (when (and (< row V) (< px V) (< oy O) (< ox O))
          (set! (~ Y (+ obase (* oy O) ox))
                (* (~ re (+ (* row 65ul) (bitrev6 px))) 0.000244140625)))))))

;; ===== 32-bit index twins (generated by make_fft32.py; edit the 64-bit originals, then re-run) =====

(def-function bitrev6u (v)
  (declare #'(uint => uint))
  (logior (logior (logior (shift-left (logand v 1u) 5u) (shift-left (logand v 2u) 3u))
                  (logior (shift-left (logand v 4u) 1u) (shift-right (logand v 8u) 1u)))
          (logior (shift-right (logand v 16u) 3u) (shift-right (logand v 32u) 5u))))

(def-kernel fft_fwd32 (src tw dims &out outr outi)
  (declare #'(in-vec in-vec dims-vec &out out-vec out-vec => nil)
           (global-size :derive-from outr :strategy :strided)
           (local-size  :set-to 256))
  (let ((C    (to-uint (~ dims 0)))
        (H    (to-uint (~ dims 1)))
        (K    (to-uint (~ dims 2)))
        (mode (~ dims 3))
        (NBT  (to-uint (~ dims 4)))
        (nt   (to-uint (~ dims 5)))
        (NBTP (to-uint (~ dims 6)))
        (V    (- 65u K))
        (NR   (if (= mode 0) 64u K))             ; rows that can be nonzero
        (re   (make-scratch-vector float 4160))   ; 64 x 65
        (im   (make-scratch-vector float 4160))
        (twr  (make-scratch-vector float 32))
        (twi  (make-scratch-vector float 32))
        (g    (to-uint (get-workgroup-id 0)))
        (tid  (to-uint (get-local-linear-id)))
        (bt   (rem g NBT))
        (ntt  (* nt nt))
        (tt   (rem bt ntt))
        (y0   (* (/ tt nt) V))
        (x0   (* (rem tt nt) V))
        (base (if (= mode 0) (* (+ (* (/ bt ntt) C) (/ g NBT)) H H) (* g K K)))
        (obase (if (= mode 0) (* (+ (* (/ g NBT) NBTP) bt) 2112u) (* g 2112u))))
    (declare (uniform C H K mode NBT nt NBTP V NR))
    (when (< tid 32u)
      (set! (~ twr tid) (~ tw tid))
      (set! (~ twi tid) (~ tw (+ tid 32u))))
    (dotimes (j 16u)
      (let ((idx (+ tid (* j 256u)))
            (row (shift-right idx 6u))
            (cx  (logand idx 63u))
            (dst (+ (* row 65u) (bitrev6u cx))))
        (set! (~ re dst)
              (if (= mode 0)
                  (let ((gy (+ y0 row)) (gx (+ x0 cx)))
                    (if (and (< gy H) (< gx H)) (~ src (+ base (* gy H) gx)) 0.0))
                  (if (and (< row K) (< cx K)) (~ src (+ base (* row K) cx)) 0.0)))
        (set! (~ im dst) 0.0)))
    (sync-workgroup)
    ;; rows: DIT, span hs = 1, 2, .. 32
    (dotimes (s 6u)
      (let ((hs (shift-left 1u s)))
        (dotimes (j 8u)
          (let ((idx (+ tid (* j 256u)))
                (row (shift-right idx 5u)))
            (when (< row NR)
              (let ((bk  (logand idx 31u))
                    (pos (logand bk (- hs 1u)))
                    (i0  (+ (* row 65u) (shift-left (- bk pos) 1u) pos))
                    (i1  (+ i0 hs))
                    (m   (shift-left pos (- 5u s)))
                    (wr  (~ twr m))
                    (wi  (~ twi m))
                    (ar  (~ re i0))
                    (ai  (~ im i0))
                    (cr  (~ re i1))
                    (ci  (~ im i1))
                    (br  (- (* cr wr) (* ci wi)))
                    (bi  (+ (* cr wi) (* ci wr))))
                (set! (~ re i0) (+ ar br))
                (set! (~ im i0) (+ ai bi))
                (set! (~ re i1) (- ar br))
                (set! (~ im i1) (- ai bi))))))
        (sync-workgroup)))
    ;; columns 0 .. 32: DIF along y, span hs = 32, 16, .. 1
    (dotimes (s 6u)
      (let ((hs (shift-right 32u s)))
        (dotimes (j 5u)
          (let ((idx (+ tid (* j 256u))))
            (when (< idx 1056u)
              (let ((cx  (rem idx 33u))
                    (bk  (/ idx 33u))
                    (pos (logand bk (- hs 1u)))
                    (r0  (+ (shift-left (- bk pos) 1u) pos))
                    (i0  (+ (* r0 65u) cx))
                    (i1  (+ i0 (* hs 65u)))
                    (m   (shift-left pos s))
                    (wr  (~ twr m))
                    (wi  (~ twi m))
                    (ar  (~ re i0))
                    (ai  (~ im i0))
                    (cr  (~ re i1))
                    (ci  (~ im i1))
                    (dr  (- ar cr))
                    (di  (- ai ci)))
                (set! (~ re i0) (+ ar cr))
                (set! (~ im i0) (+ ai ci))
                (set! (~ re i1) (- (* dr wr) (* di wi)))
                (set! (~ im i1) (+ (* dr wi) (* di wr)))))))
        (sync-workgroup)))
    (dotimes (j 9u)
      (let ((idx (+ tid (* j 256u))))
        (when (< idx 2112u)
          (let ((src-i (+ (* (/ idx 33u) 65u) (rem idx 33u))))
            (set! (~ outr (+ obase idx)) (~ re src-i))
            (set! (~ outi (+ obase idx)) (if (= mode 0) (~ im src-i) (- (~ im src-i))))))))))

(def-kernel cgemm32 (xr xi wr wi dims &out yr yi)
  (declare #'(in-vec in-vec in-vec in-vec dims-vec &out out-vec out-vec => nil)
           (global-size :derive-from yr :strategy :strided)
           (local-size  :set-to 256))
  (let ((C    (to-uint (~ dims 0)))
        (NBT  (to-uint (~ dims 4)))
        (NBTP (to-uint (~ dims 6)))
        (nTB  (/ NBTP 7u))
        (nCG  (/ (+ C 31u) 32u))
        (g    (to-uint (get-workgroup-id 0)))
        (tid  (to-uint (get-local-linear-id)))
        (tb   (rem g nTB))
        (cg   (rem (/ g nTB) nCG))
        (bin  (+ (* (/ g (* nTB nCG)) 32u) (logand tid 31u)))
        (co0  (+ (* cg 32u) (* (shift-right tid 5u) 4u)))
        (t0   (* tb 7u))
        (CS   (* C 2112u))                       ; Wf: next co
        (TS   (* NBTP 2112u))                    ; Xf: next ci;  Yf: next co
        (r0 ##(0.0 0.0 0.0 0.0)) (q0 ##(0.0 0.0 0.0 0.0))
        (r1 ##(0.0 0.0 0.0 0.0)) (q1 ##(0.0 0.0 0.0 0.0))
        (r2 ##(0.0 0.0 0.0 0.0)) (q2 ##(0.0 0.0 0.0 0.0))
        (r3 ##(0.0 0.0 0.0 0.0)) (q3 ##(0.0 0.0 0.0 0.0))
        (r4 ##(0.0 0.0 0.0 0.0)) (q4 ##(0.0 0.0 0.0 0.0))
        (r5 ##(0.0 0.0 0.0 0.0)) (q5 ##(0.0 0.0 0.0 0.0))
        (r6 ##(0.0 0.0 0.0 0.0)) (q6 ##(0.0 0.0 0.0 0.0)))
    (declare (uniform C NBT NBTP nTB nCG CS TS))
    (when (< co0 C)
      (dotimes (ci C)
        (let ((wb  (+ (* (+ (* co0 C) ci) 2112u) bin))
              (a0  (~ wr wb))                (b0 (~ wi wb))
              (a1  (~ wr (+ wb CS)))         (b1 (~ wi (+ wb CS)))
              (a2  (~ wr (+ wb (* 2u CS)))) (b2 (~ wi (+ wb (* 2u CS))))
              (a3  (~ wr (+ wb (* 3u CS)))) (b3 (~ wi (+ wb (* 3u CS))))
              (wr4 ##(a0 a1 a2 a3))
              (wi4 ##(b0 b1 b2 b3))
              (wn4 ##((- b0) (- b1) (- b2) (- b3)))
              (xb  (+ (* ci TS) (* t0 2112u) bin))
              (u0 (~ xr xb))              (v0 (~ xi xb))
              (u1 (~ xr (+ xb 2112u)))   (v1 (~ xi (+ xb 2112u)))
              (u2 (~ xr (+ xb 4224u)))   (v2 (~ xi (+ xb 4224u)))
              (u3 (~ xr (+ xb 6336u)))   (v3 (~ xi (+ xb 6336u)))
              (u4 (~ xr (+ xb 8448u)))   (v4 (~ xi (+ xb 8448u)))
              (u5 (~ xr (+ xb 10560u)))  (v5 (~ xi (+ xb 10560u)))
              (u6 (~ xr (+ xb 12672u)))  (v6 (~ xi (+ xb 12672u))))
          ;; (wr + i wi)(u + i v) = (wr u - wi v) + i (wr v + wi u)
          (set! r0 (op-fma wn4 (splat v0) (op-fma wr4 (splat u0) r0)))
          (set! q0 (op-fma wi4 (splat u0) (op-fma wr4 (splat v0) q0)))
          (set! r1 (op-fma wn4 (splat v1) (op-fma wr4 (splat u1) r1)))
          (set! q1 (op-fma wi4 (splat u1) (op-fma wr4 (splat v1) q1)))
          (set! r2 (op-fma wn4 (splat v2) (op-fma wr4 (splat u2) r2)))
          (set! q2 (op-fma wi4 (splat u2) (op-fma wr4 (splat v2) q2)))
          (set! r3 (op-fma wn4 (splat v3) (op-fma wr4 (splat u3) r3)))
          (set! q3 (op-fma wi4 (splat u3) (op-fma wr4 (splat v3) q3)))
          (set! r4 (op-fma wn4 (splat v4) (op-fma wr4 (splat u4) r4)))
          (set! q4 (op-fma wi4 (splat u4) (op-fma wr4 (splat v4) q4)))
          (set! r5 (op-fma wn4 (splat v5) (op-fma wr4 (splat u5) r5)))
          (set! q5 (op-fma wi4 (splat u5) (op-fma wr4 (splat v5) q5)))
          (set! r6 (op-fma wn4 (splat v6) (op-fma wr4 (splat u6) r6)))
          (set! q6 (op-fma wi4 (splat u6) (op-fma wr4 (splat v6) q6)))))
      (let ((yb (+ (* co0 TS) (* t0 2112u) bin)))
        (when (< t0 NBT)
          (let ((o (+ yb 0u)))
            (set! (~ yr o) (x~ r0)) (set! (~ yr (+ o TS)) (y~ r0)) (set! (~ yr (+ o (* 2u TS))) (z~ r0)) (set! (~ yr (+ o (* 3u TS))) (w~ r0))
            (set! (~ yi o) (x~ q0)) (set! (~ yi (+ o TS)) (y~ q0)) (set! (~ yi (+ o (* 2u TS))) (z~ q0)) (set! (~ yi (+ o (* 3u TS))) (w~ q0))))
        (when (< (+ t0 1u) NBT)
          (let ((o (+ yb 2112u)))
            (set! (~ yr o) (x~ r1)) (set! (~ yr (+ o TS)) (y~ r1)) (set! (~ yr (+ o (* 2u TS))) (z~ r1)) (set! (~ yr (+ o (* 3u TS))) (w~ r1))
            (set! (~ yi o) (x~ q1)) (set! (~ yi (+ o TS)) (y~ q1)) (set! (~ yi (+ o (* 2u TS))) (z~ q1)) (set! (~ yi (+ o (* 3u TS))) (w~ q1))))
        (when (< (+ t0 2u) NBT)
          (let ((o (+ yb 4224u)))
            (set! (~ yr o) (x~ r2)) (set! (~ yr (+ o TS)) (y~ r2)) (set! (~ yr (+ o (* 2u TS))) (z~ r2)) (set! (~ yr (+ o (* 3u TS))) (w~ r2))
            (set! (~ yi o) (x~ q2)) (set! (~ yi (+ o TS)) (y~ q2)) (set! (~ yi (+ o (* 2u TS))) (z~ q2)) (set! (~ yi (+ o (* 3u TS))) (w~ q2))))
        (when (< (+ t0 3u) NBT)
          (let ((o (+ yb 6336u)))
            (set! (~ yr o) (x~ r3)) (set! (~ yr (+ o TS)) (y~ r3)) (set! (~ yr (+ o (* 2u TS))) (z~ r3)) (set! (~ yr (+ o (* 3u TS))) (w~ r3))
            (set! (~ yi o) (x~ q3)) (set! (~ yi (+ o TS)) (y~ q3)) (set! (~ yi (+ o (* 2u TS))) (z~ q3)) (set! (~ yi (+ o (* 3u TS))) (w~ q3))))
        (when (< (+ t0 4u) NBT)
          (let ((o (+ yb 8448u)))
            (set! (~ yr o) (x~ r4)) (set! (~ yr (+ o TS)) (y~ r4)) (set! (~ yr (+ o (* 2u TS))) (z~ r4)) (set! (~ yr (+ o (* 3u TS))) (w~ r4))
            (set! (~ yi o) (x~ q4)) (set! (~ yi (+ o TS)) (y~ q4)) (set! (~ yi (+ o (* 2u TS))) (z~ q4)) (set! (~ yi (+ o (* 3u TS))) (w~ q4))))
        (when (< (+ t0 5u) NBT)
          (let ((o (+ yb 10560u)))
            (set! (~ yr o) (x~ r5)) (set! (~ yr (+ o TS)) (y~ r5)) (set! (~ yr (+ o (* 2u TS))) (z~ r5)) (set! (~ yr (+ o (* 3u TS))) (w~ r5))
            (set! (~ yi o) (x~ q5)) (set! (~ yi (+ o TS)) (y~ q5)) (set! (~ yi (+ o (* 2u TS))) (z~ q5)) (set! (~ yi (+ o (* 3u TS))) (w~ q5))))
        (when (< (+ t0 6u) NBT)
          (let ((o (+ yb 12672u)))
            (set! (~ yr o) (x~ r6)) (set! (~ yr (+ o TS)) (y~ r6)) (set! (~ yr (+ o (* 2u TS))) (z~ r6)) (set! (~ yr (+ o (* 3u TS))) (w~ r6))
            (set! (~ yi o) (x~ q6)) (set! (~ yi (+ o TS)) (y~ q6)) (set! (~ yi (+ o (* 2u TS))) (z~ q6)) (set! (~ yi (+ o (* 3u TS))) (w~ q6))))))))

(def-kernel fft_inv32 (yr yi tw dims &out Y)
  (declare #'(in-vec in-vec in-vec dims-vec &out out-vec => nil)
           (global-size :derive-from Y :strategy :strided)
           (local-size  :set-to 256))
  (let ((C    (to-uint (~ dims 0)))
        (H    (to-uint (~ dims 1)))
        (K    (to-uint (~ dims 2)))
        (NBT  (to-uint (~ dims 4)))
        (nt   (to-uint (~ dims 5)))
        (NBTP (to-uint (~ dims 6)))
        (V    (- 65u K))
        (O    (+ (- H K) 1u))
        (re   (make-scratch-vector float 4160))
        (im   (make-scratch-vector float 4160))
        (twr  (make-scratch-vector float 32))
        (twi  (make-scratch-vector float 32))
        (g    (to-uint (get-workgroup-id 0)))
        (tid  (to-uint (get-local-linear-id)))
        (co   (/ g NBT))
        (bt   (rem g NBT))
        (ntt  (* nt nt))
        (tt   (rem bt ntt))
        (oy0  (* (/ tt nt) V))
        (ox0  (* (rem tt nt) V))
        (obase (* (+ (* (/ bt ntt) C) co) O O))
        (ibase (* (+ (* co NBTP) bt) 2112u)))
    (declare (uniform C H K NBT nt NBTP V O))
    (when (< tid 32u)
      (set! (~ twr tid) (~ tw tid))
      (set! (~ twi tid) (- (~ tw (+ tid 32u)))))        ; conjugate twiddles: inverse transform
    (dotimes (j 9u)
      (let ((idx (+ tid (* j 256u))))
        (when (< idx 2112u)
          (let ((dst (+ (* (/ idx 33u) 65u) (rem idx 33u))))
            (set! (~ re dst) (~ yr (+ ibase idx)))
            (set! (~ im dst) (~ yi (+ ibase idx)))))))
    (sync-workgroup)
    ;; columns 0 .. 32: inverse DIT along y, span hs = 1, 2, .. 32
    (dotimes (s 6u)
      (let ((hs (shift-left 1u s)))
        (dotimes (j 5u)
          (let ((idx (+ tid (* j 256u))))
            (when (< idx 1056u)
              (let ((cx  (rem idx 33u))
                    (bk  (/ idx 33u))
                    (pos (logand bk (- hs 1u)))
                    (r0  (+ (shift-left (- bk pos) 1u) pos))
                    (i0  (+ (* r0 65u) cx))
                    (i1  (+ i0 (* hs 65u)))
                    (m   (shift-left pos (- 5u s)))
                    (wr  (~ twr m))
                    (wi  (~ twi m))
                    (ar  (~ re i0))
                    (ai  (~ im i0))
                    (cr  (~ re i1))
                    (ci  (~ im i1))
                    (br  (- (* cr wr) (* ci wi)))
                    (bi  (+ (* cr wi) (* ci wr))))
                (set! (~ re i0) (+ ar br))
                (set! (~ im i0) (+ ai bi))
                (set! (~ re i1) (- ar br))
                (set! (~ im i1) (- ai bi))))))
        (sync-workgroup)))
    ;; rows 0 .. V-1: columns 33 .. 63 = conj of columns 31 .. 1
    (dotimes (j 8u)
      (let ((idx (+ tid (* j 256u)))
            (row (/ idx 31u))
            (cx  (+ (rem idx 31u) 33u)))
        (when (< row V)
          (set! (~ re (+ (* row 65u) cx)) (~ re (+ (* row 65u) (- 64u cx))))
          (set! (~ im (+ (* row 65u) cx)) (- (~ im (+ (* row 65u) (- 64u cx))))))))
    (sync-workgroup)
    ;; rows 0 .. V-1: inverse DIF along x, span hs = 32, 16, .. 1
    (dotimes (s 6u)
      (let ((hs (shift-right 32u s)))
        (dotimes (j 8u)
          (let ((idx (+ tid (* j 256u)))
                (row (shift-right idx 5u)))
            (when (< row V)
              (let ((bk  (logand idx 31u))
                    (pos (logand bk (- hs 1u)))
                    (i0  (+ (* row 65u) (shift-left (- bk pos) 1u) pos))
                    (i1  (+ i0 hs))
                    (m   (shift-left pos s))
                    (wr  (~ twr m))
                    (wi  (~ twi m))
                    (ar  (~ re i0))
                    (ai  (~ im i0))
                    (cr  (~ re i1))
                    (ci  (~ im i1))
                    (dr  (- ar cr))
                    (di  (- ai ci)))
                (set! (~ re i0) (+ ar cr))
                (set! (~ im i0) (+ ai ci))
                (set! (~ re i1) (- (* dr wr) (* di wi)))
                (set! (~ im i1) (+ (* dr wi) (* di wr)))))))
        (sync-workgroup)))
    (dotimes (j 16u)
      (let ((idx (+ tid (* j 256u)))
            (row (shift-right idx 6u))
            (px  (logand idx 63u))
            (oy  (+ oy0 row))
            (ox  (+ ox0 px)))
        (when (and (< row V) (< px V) (< oy O) (< ox O))
          (set! (~ Y (+ obase (* oy O) ox))
                (* (~ re (+ (* row 65u) (bitrev6u px))) 0.000244140625)))))))
