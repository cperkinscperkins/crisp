;; conv2d_v2 performant entry (H100 lane): a register-tiled direct convolution that keeps cuDNN's rounding.
;;
;; On the H100 the reference is cuDNN's implicit_convolve_sgemm with TF32 off: every output is ONE fp32
;; fused-multiply-add chain in (input channel, filter row, filter column) order, and the checker wants that
;; chain's rounding (~2e-3 off the exact answer at K=32, C=128 -- more than its 1e-3 atol).  So no FFT, no
;; tensor cores, no split sums.  What is left is doing the 0.85e12 FMAs well:
;;
;;   * a workgroup owns 32 output channels x an 8 x 32 pixel patch of one image (8192 outputs);
;;   * a thread owns 8 channels x 4 neighbouring pixels: eight float4 accumulators, each lane its own chain;
;;   * for each (ci, ky) the workgroup stages the 8 x (31 + K) input rows and the K x 32 filter taps in
;;     shared memory, then every thread runs kx = 0 .. K-1: one new input value (a sliding window of four),
;;     two float4 filter loads (a broadcast), eight float4 FMAs.
;;
;; w_transpose first reorders W from (co, ci, ky, kx) to (ci, ky, kx, co) so the taps load coalesced.
;; Shapes come in a small int vector, dims = (C, H, K, B).  K must be at most 32 (the staged row is 63 wide).
(def-type in-vec   (vector float :address-space :global :align :compact))
(def-type out-vec  (vector float :address-space :global :align :compact))
(def-type dims-vec (vector int   :address-space :global :align :compact))

(def-function splat (s)
  (declare #'(float => float4))
  ##(s s s s))

;; WT = W transposed, seen as matrices: W is C rows (co) x CKK columns (ci, ky, kx), WT is CKK x C,
;; i.e. WT[((ci * K + ky) * K + kx) * C + co] = W[((co * C + ci) * K + ky) * K + kx].  A workgroup moves one
;; 32 x 32 tile through shared memory (rows padded to 33, so the column reads miss no banks): both the
;; global reads and the global writes are whole 128-byte rows.  Groups = ceil(C / 32) * ceil(CKK / 32).
(def-kernel w_transpose (W dims &out WT)
  (declare #'(in-vec dims-vec &out out-vec => nil)
           (global-size :derive-from WT :strategy :strided)
           (local-size  :set-to 256))
  (let ((C    (to-ulong (~ dims 0)))
        (K    (to-ulong (~ dims 2)))
        (CKK  (* C K K))
        (tile (make-scratch-vector float 1056))   ; 32 x 33
        (ntc  (/ (+ CKK 31ul) 32ul))
        (wg   (get-workgroup-id 0))
        (r0   (* (/ wg ntc) 32ul))                ; first co of the tile
        (c0   (* (rem wg ntc) 32ul))              ; first (ci, ky, kx) of the tile
        (t    (get-local-linear-id))
        (tx   (rem t 32ul))
        (ty   (/ t 32ul)))
    (dotimes (j 4ul)
      (let ((row (+ r0 ty (* j 8ul)))
            (col (+ c0 tx)))
        (when (and (< row C) (< col CKK))
          (set! (~ tile (+ (* (+ ty (* j 8ul)) 33ul) tx)) (~ W (+ (* row CKK) col))))))
    (sync-workgroup)
    (dotimes (j 4ul)
      (let ((row (+ c0 ty (* j 8ul)))             ; WT row = (ci, ky, kx)
            (col (+ r0 tx)))                      ; WT column = co
        (when (and (< row CKK) (< col C))
          (set! (~ WT (+ (* row C) col)) (~ tile (+ (* tx 33ul) ty (* j 8ul)))))))))

(def-kernel conv_tiled (X WT dims &out Y)
  (declare #'(in-vec in-vec dims-vec &out out-vec => nil)
           (global-size :derive-from Y :strategy :strided)
           (local-size  :set-to 256))
  (let ((C   (to-ulong (~ dims 0)))
        (H   (to-ulong (~ dims 1)))
        (K   (to-ulong (~ dims 2)))
        (O   (+ (- H K) 1ul))
        (xs  (make-scratch-vector float 512))       ; 8 rows x 63, row stride 63 (= -1 mod 32 banks)
        (ws  (make-scratch-vector float 1024))      ; K x 32 taps, [kx][co]
        (ws4 (make-vector ws float4 :length 256ul))
        ;; which patch: wg = ((b * nco + cot) * nby + by) * nbx + bx
        (nbx (/ (+ O 31ul) 32ul))
        (nby (/ (+ O 7ul) 8ul))
        (nco (/ (+ C 31ul) 32ul))
        (wg  (get-workgroup-id 0))
        (bx  (rem wg nbx))
        (by  (rem (/ wg nbx) nby))
        (cot (rem (/ wg (* nbx nby)) nco))
        (b   (/ wg (* nbx nby nco)))
        (ox0 (* bx 32ul))
        (oy0 (* by 8ul))
        (co0 (* cot 32ul))
        ;; which outputs this thread owns
        (t   (get-local-linear-id))
        (g   (/ t 64ul))                           ; channel group: co0 + 8g .. co0 + 8g + 7 (a warp shares it)
        (r   (rem (/ t 8ul) 8ul))                  ; patch row
        (c0  (* (rem t 8ul) 4ul))                  ; first of the thread's four patch columns
        (a0 (splat 0.0)) (a1 (splat 0.0)) (a2 (splat 0.0)) (a3 (splat 0.0))
        (a4 (splat 0.0)) (a5 (splat 0.0)) (a6 (splat 0.0)) (a7 (splat 0.0)))
    (declare (uniform C H K O))
    (dotimes+ (ci C)
      (dotimes+ (ky K)
        (sync-workgroup)
        ;; stage the input rows oy0 + ky .. oy0 + ky + 7, columns ox0 .. ox0 + 62 (zero past the image)
        (dotimes (j 2ul)
          (let ((e (+ t (* j 256ul))))
            (when (< e 504ul)
              (let ((gy (+ oy0 ky (/ e 63ul)))
                    (gx (+ ox0 (rem e 63ul))))
                (set! (~ xs e) (if (and (< gy H) (< gx H))
                                   (~ X (+ (* (+ (* (+ (* b C) ci) H) gy) H) gx))
                                   0.0))))))
        ;; stage the taps WT[ci, ky, kx, co0 .. co0 + 31] as ws[kx * 32 + co]
        (dotimes (j 4ul)
          (let ((e (+ t (* j 256ul))))
            (when (< e (* K 32ul))
              (let ((co (+ co0 (rem e 32ul))))
                (set! (~ ws e) (if (< co C)
                                   (~ WT (+ (* (+ (* (+ (* ci K) ky) K) (/ e 32ul)) C) co))
                                   0.0))))))
        (sync-workgroup)
        (let ((xr (+ (* r 63ul) c0))
              (xa (~ xs xr))
              (xb (~ xs (+ xr 1ul)))
              (xc (~ xs (+ xr 2ul))))
          (dotimes (kx K)
            (let ((xd (~ xs (+ xr kx 3ul)))
                  (x4 ##(xa xb xc xd))
                  (wl (~ ws4 (+ (* kx 8ul) (* g 2ul))))          ; taps for channels 8g .. 8g + 3
                  (wh (~ ws4 (+ (* kx 8ul) (* g 2ul) 1ul))))     ; and 8g + 4 .. 8g + 7
              (set! a0 (op-fma x4 (splat (x~ wl)) a0))
              (set! a1 (op-fma x4 (splat (y~ wl)) a1))
              (set! a2 (op-fma x4 (splat (z~ wl)) a2))
              (set! a3 (op-fma x4 (splat (w~ wl)) a3))
              (set! a4 (op-fma x4 (splat (x~ wh)) a4))
              (set! a5 (op-fma x4 (splat (y~ wh)) a5))
              (set! a6 (op-fma x4 (splat (z~ wh)) a6))
              (set! a7 (op-fma x4 (splat (w~ wh)) a7))
              (set! xa xb)
              (set! xb xc)
              (set! xc xd))))))
    ;; write the 8 x 4 outputs that lie inside the image
    (let ((oy (+ oy0 r))
          (ox (+ ox0 c0)))
      (when (< oy O)
        (dotimes (j 8ul)
          (let ((co (+ co0 (* g 8ul) j))
                (v  (cond ((= j 0ul) a0) ((= j 1ul) a1) ((= j 2ul) a2) ((= j 3ul) a3)
                          ((= j 4ul) a4) ((= j 5ul) a5) ((= j 6ul) a6) (else a7))))
            (when (< co C)
              (let ((row (* (+ (* (+ (* b C) co) O) oy) O)))
                (when (< ox O)          (set! (~ Y (+ row ox))      (x~ v)))
                (when (< (+ ox 1ul) O)  (set! (~ Y (+ row ox 1ul))  (y~ v)))
                (when (< (+ ox 2ul) O)  (set! (~ Y (+ row ox 2ul))  (z~ v)))
                (when (< (+ ox 3ul) O)  (set! (~ Y (+ row ox 3ul))  (w~ v)))))))))))

;; v2: a thread owns 8 channels x 8 neighbouring pixels (sixteen float4 accumulators): 64 FMAs per kx for
;; three shared loads, and the workgroup patch is 8 x 64 pixels (staged rows 95 wide, = -1 mod 32 banks).
;; Groups = B * ceil(C / 32) * ceil(O / 8) * ceil(O / 64).
(def-kernel conv_tiled8 (X WT dims &out Y)
  (declare #'(in-vec in-vec dims-vec &out out-vec => nil)
           (global-size :derive-from Y :strategy :strided)
           (local-size  :set-to 256))
  (let ((C   (to-ulong (~ dims 0)))
        (H   (to-ulong (~ dims 1)))
        (K   (to-ulong (~ dims 2)))
        (O   (+ (- H K) 1ul))
        (xs  (make-scratch-vector float 768))       ; 8 rows x 95
        (ws  (make-scratch-vector float 1024))      ; K x 32 taps, [kx][co]
        (ws4 (make-vector ws float4 :length 256ul))
        (nbx (/ (+ O 63ul) 64ul))
        (nby (/ (+ O 7ul) 8ul))
        (nco (/ (+ C 31ul) 32ul))
        (wg  (get-workgroup-id 0))
        (bx  (rem wg nbx))
        (by  (rem (/ wg nbx) nby))
        (cot (rem (/ wg (* nbx nby)) nco))
        (b   (/ wg (* nbx nby nco)))
        (ox0 (* bx 64ul))
        (oy0 (* by 8ul))
        (co0 (* cot 32ul))
        (t   (get-local-linear-id))
        (g   (/ t 64ul))
        (r   (rem (/ t 8ul) 8ul))
        (c0  (* (rem t 8ul) 8ul))
        (l0 (splat 0.0)) (l1 (splat 0.0)) (l2 (splat 0.0)) (l3 (splat 0.0))
        (l4 (splat 0.0)) (l5 (splat 0.0)) (l6 (splat 0.0)) (l7 (splat 0.0))
        (h0 (splat 0.0)) (h1 (splat 0.0)) (h2 (splat 0.0)) (h3 (splat 0.0))
        (h4 (splat 0.0)) (h5 (splat 0.0)) (h6 (splat 0.0)) (h7 (splat 0.0)))
    (declare (uniform C H K O))
    (dotimes+ (ci C)
      (dotimes+ (ky K)
        (sync-workgroup)
        (dotimes (j 3ul)
          (let ((e (+ t (* j 256ul))))
            (when (< e 760ul)
              (let ((gy (+ oy0 ky (/ e 95ul)))
                    (gx (+ ox0 (rem e 95ul))))
                (set! (~ xs e) (if (and (< gy H) (< gx H))
                                   (~ X (+ (* (+ (* (+ (* b C) ci) H) gy) H) gx))
                                   0.0))))))
        (dotimes (j 4ul)
          (let ((e (+ t (* j 256ul))))
            (when (< e (* K 32ul))
              (let ((co (+ co0 (rem e 32ul))))
                (set! (~ ws e) (if (< co C)
                                   (~ WT (+ (* (+ (* (+ (* ci K) ky) K) (/ e 32ul)) C) co))
                                   0.0))))))
        (sync-workgroup)
        (let ((xr (+ (* r 95ul) c0))
              (x0 (~ xs xr))         (x1 (~ xs (+ xr 1ul))) (x2 (~ xs (+ xr 2ul))) (x3 (~ xs (+ xr 3ul)))
              (x4 (~ xs (+ xr 4ul))) (x5 (~ xs (+ xr 5ul))) (x6 (~ xs (+ xr 6ul))))
          (dotimes (kx K)
            (let ((x7 (~ xs (+ xr kx 7ul)))
                  (lo ##(x0 x1 x2 x3))
                  (hi ##(x4 x5 x6 x7))
                  (wl (~ ws4 (+ (* kx 8ul) (* g 2ul))))
                  (wh (~ ws4 (+ (* kx 8ul) (* g 2ul) 1ul))))
              (set! l0 (op-fma lo (splat (x~ wl)) l0)) (set! h0 (op-fma hi (splat (x~ wl)) h0))
              (set! l1 (op-fma lo (splat (y~ wl)) l1)) (set! h1 (op-fma hi (splat (y~ wl)) h1))
              (set! l2 (op-fma lo (splat (z~ wl)) l2)) (set! h2 (op-fma hi (splat (z~ wl)) h2))
              (set! l3 (op-fma lo (splat (w~ wl)) l3)) (set! h3 (op-fma hi (splat (w~ wl)) h3))
              (set! l4 (op-fma lo (splat (x~ wh)) l4)) (set! h4 (op-fma hi (splat (x~ wh)) h4))
              (set! l5 (op-fma lo (splat (y~ wh)) l5)) (set! h5 (op-fma hi (splat (y~ wh)) h5))
              (set! l6 (op-fma lo (splat (z~ wh)) l6)) (set! h6 (op-fma hi (splat (z~ wh)) h6))
              (set! l7 (op-fma lo (splat (w~ wh)) l7)) (set! h7 (op-fma hi (splat (w~ wh)) h7))
              (set! x0 x1) (set! x1 x2) (set! x2 x3) (set! x3 x4)
              (set! x4 x5) (set! x5 x6) (set! x6 x7))))))
    (let ((oy (+ oy0 r))
          (ox (+ ox0 c0)))
      (when (< oy O)
        (dotimes (j 8ul)
          (let ((co (+ co0 (* g 8ul) j))
                (vl (cond ((= j 0ul) l0) ((= j 1ul) l1) ((= j 2ul) l2) ((= j 3ul) l3)
                          ((= j 4ul) l4) ((= j 5ul) l5) ((= j 6ul) l6) (else l7)))
                (vh (cond ((= j 0ul) h0) ((= j 1ul) h1) ((= j 2ul) h2) ((= j 3ul) h3)
                          ((= j 4ul) h4) ((= j 5ul) h5) ((= j 6ul) h6) (else h7))))
            (when (< co C)
              (let ((row (* (+ (* (+ (* b C) co) O) oy) O)))
                (when (< ox O)          (set! (~ Y (+ row ox))      (x~ vl)))
                (when (< (+ ox 1ul) O)  (set! (~ Y (+ row ox 1ul))  (y~ vl)))
                (when (< (+ ox 2ul) O)  (set! (~ Y (+ row ox 2ul))  (z~ vl)))
                (when (< (+ ox 3ul) O)  (set! (~ Y (+ row ox 3ul))  (w~ vl)))
                (when (< (+ ox 4ul) O)  (set! (~ Y (+ row ox 4ul))  (x~ vh)))
                (when (< (+ ox 5ul) O)  (set! (~ Y (+ row ox 5ul))  (y~ vh)))
                (when (< (+ ox 6ul) O)  (set! (~ Y (+ row ox 6ul))  (z~ vh)))
                (when (< (+ ox 7ul) O)  (set! (~ Y (+ row ox 7ul))  (w~ vh)))))))))))

;; v1p: v1's tile (8 channels x 4 pixels per thread, 8 x 32 pixel patch) with the staging PIPELINED.  One
;; loop over the stages s = (ci, ky) runs one step ahead: step s stores stage s-1's values (already in
;; registers) to shared memory, issues stage s's global loads into the same registers, then computes stage
;; s-1 while those loads are in flight.  The kx loop is unrolled by 4.  Each output's chain is unchanged.
(def-kernel conv_tiled_p (X WT dims &out Y)
  (declare #'(in-vec in-vec dims-vec &out out-vec => nil)
           (global-size :derive-from Y :strategy :strided)
           (local-size  :set-to 256))
  (let ((C   (to-ulong (~ dims 0)))
        (H   (to-ulong (~ dims 1)))
        (K   (to-ulong (~ dims 2)))
        (O   (+ (- H K) 1ul))
        (NS  (* C K))                               ; stages (not S: Lisp reads s and S as one symbol)
        (xs  (make-scratch-vector float 512))
        (ws  (make-scratch-vector float 1024))
        (ws4 (make-vector ws float4 :length 256ul))
        (nbx (/ (+ O 31ul) 32ul))
        (nby (/ (+ O 7ul) 8ul))
        (nco (/ (+ C 31ul) 32ul))
        (wg  (get-workgroup-id 0))
        (bx  (rem wg nbx))
        (by  (rem (/ wg nbx) nby))
        (cot (rem (/ wg (* nbx nby)) nco))
        (b   (/ wg (* nbx nby nco)))
        (ox0 (* bx 32ul))
        (oy0 (* by 8ul))
        (co0 (* cot 32ul))
        (t   (get-local-linear-id))
        (g   (/ t 64ul))
        (r   (rem (/ t 8ul) 8ul))
        (c0  (* (rem t 8ul) 4ul))
        ;; this thread's staging slots: input elements t and t + 256 of the 8 x 63 patch, taps t + 256j
        (e1  (+ t 256ul))
        (xy0 (/ t 63ul))  (xx0 (rem t 63ul))
        (xy1 (/ e1 63ul)) (xx1 (rem e1 63ul))
        (wco (+ co0 (rem t 32ul)))                  ; the same channel for all four tap slots
        (wkx (/ t 32ul))                            ; tap slot j holds kx = wkx + 8j
        (px0 0.0) (px1 0.0) (pw0 0.0) (pw1 0.0) (pw2 0.0) (pw3 0.0)
        (a0 (splat 0.0)) (a1 (splat 0.0)) (a2 (splat 0.0)) (a3 (splat 0.0))
        (a4 (splat 0.0)) (a5 (splat 0.0)) (a6 (splat 0.0)) (a7 (splat 0.0)))
    (declare (uniform C H K O NS))
    (dotimes+ (s (+ NS 1ul))
      (when+ (> s 0ul)
        (sync-workgroup)
        (set! (~ xs t) px0)
        (when (< e1 504ul) (set! (~ xs e1) px1))
        (set! (~ ws t) pw0)
        (when (< e1 (* K 32ul)) (set! (~ ws e1) pw1))
        (when (< (+ t 512ul) (* K 32ul)) (set! (~ ws (+ t 512ul)) pw2))
        (when (< (+ t 768ul) (* K 32ul)) (set! (~ ws (+ t 768ul)) pw3))
        (sync-workgroup))
      (when (< s NS)
        (let ((ci   (/ s K))
              (ky   (rem s K))
              (xpl  (* (+ (* b C) ci) H))           ; plane (b, ci)
              (wrow (* (+ (* ci K) ky) K)))         ; WT row of (ci, ky, kx = 0)
          (let ((gy (+ oy0 ky xy0)) (gx (+ ox0 xx0)))
            (set! px0 (if (and (< gy H) (< gx H)) (~ X (+ (* (+ xpl gy) H) gx)) 0.0)))
          (let ((gy (+ oy0 ky xy1)) (gx (+ ox0 xx1)))
            (set! px1 (if (and (< e1 504ul) (< gy H) (< gx H)) (~ X (+ (* (+ xpl gy) H) gx)) 0.0)))
          (when (< wco C)
            (set! pw0 (~ WT (+ (* (+ wrow wkx) C) wco)))
            (when (< (+ wkx 8ul) K)  (set! pw1 (~ WT (+ (* (+ wrow wkx 8ul) C) wco))))
            (when (< (+ wkx 16ul) K) (set! pw2 (~ WT (+ (* (+ wrow wkx 16ul) C) wco))))
            (when (< (+ wkx 24ul) K) (set! pw3 (~ WT (+ (* (+ wrow wkx 24ul) C) wco)))))))
      (when+ (> s 0ul)
        (let ((xr (+ (* r 63ul) c0))
              (xa (~ xs xr))
              (xb (~ xs (+ xr 1ul)))
              (xc (~ xs (+ xr 2ul))))
          (dotimes (kx K)
            (declare (unroll 4))
            (let ((xd (~ xs (+ xr kx 3ul)))
                  (x4 ##(xa xb xc xd))
                  (wl (~ ws4 (+ (* kx 8ul) (* g 2ul))))
                  (wh (~ ws4 (+ (* kx 8ul) (* g 2ul) 1ul))))
              (set! a0 (op-fma x4 (splat (x~ wl)) a0))
              (set! a1 (op-fma x4 (splat (y~ wl)) a1))
              (set! a2 (op-fma x4 (splat (z~ wl)) a2))
              (set! a3 (op-fma x4 (splat (w~ wl)) a3))
              (set! a4 (op-fma x4 (splat (x~ wh)) a4))
              (set! a5 (op-fma x4 (splat (y~ wh)) a5))
              (set! a6 (op-fma x4 (splat (z~ wh)) a6))
              (set! a7 (op-fma x4 (splat (w~ wh)) a7))
              (set! xa xb)
              (set! xb xc)
              (set! xc xd))))))
    (let ((oy (+ oy0 r))
          (ox (+ ox0 c0)))
      (when (< oy O)
        (dotimes (j 8ul)
          (let ((co (+ co0 (* g 8ul) j))
                (v  (cond ((= j 0ul) a0) ((= j 1ul) a1) ((= j 2ul) a2) ((= j 3ul) a3)
                          ((= j 4ul) a4) ((= j 5ul) a5) ((= j 6ul) a6) (else a7))))
            (when (< co C)
              (let ((row (* (+ (* (+ (* b C) co) O) oy) O)))
                (when (< ox O)          (set! (~ Y (+ row ox))      (x~ v)))
                (when (< (+ ox 1ul) O)  (set! (~ Y (+ row ox 1ul))  (y~ v)))
                (when (< (+ ox 2ul) O)  (set! (~ Y (+ row ox 2ul))  (z~ v)))
                (when (< (+ ox 3ul) O)  (set! (~ Y (+ row ox 3ul))  (w~ v)))))))))))

;; v1p32: v1p with 32-bit index arithmetic (every index here is below 2^32: the largest buffer, W, holds
;; 16.7M floats) -- fewer registers, aiming at 3 workgroups per SM instead of 2.
(def-kernel conv_tiled_p32 (X WT dims &out Y)
  (declare #'(in-vec in-vec dims-vec &out out-vec => nil)
           (global-size :derive-from Y :strategy :strided)
           (local-size  :set-to 256))
  (let ((C   (to-uint (~ dims 0)))
        (H   (to-uint (~ dims 1)))
        (K   (to-uint (~ dims 2)))
        (O   (+ (- H K) 1u))
        (NS  (* C K))                               ; stages (not S: Lisp reads s and S as one symbol)
        (xs  (make-scratch-vector float 512))
        (ws  (make-scratch-vector float 1024))
        (ws4 (make-vector ws float4 :length 256ul))
        (nbx (/ (+ O 31u) 32u))
        (nby (/ (+ O 7u) 8u))
        (nco (/ (+ C 31u) 32u))
        (wg  (to-uint (get-workgroup-id 0)))
        (bx  (rem wg nbx))
        (by  (rem (/ wg nbx) nby))
        (cot (rem (/ wg (* nbx nby)) nco))
        (b   (/ wg (* nbx nby nco)))
        (ox0 (* bx 32u))
        (oy0 (* by 8u))
        (co0 (* cot 32u))
        (t   (to-uint (get-local-linear-id)))
        (g   (/ t 64u))
        (r   (rem (/ t 8u) 8u))
        (c0  (* (rem t 8u) 4u))
        ;; this thread's staging slots: input elements t and t + 256 of the 8 x 63 patch, taps t + 256j
        (e1  (+ t 256u))
        (xy0 (/ t 63u))  (xx0 (rem t 63u))
        (xy1 (/ e1 63u)) (xx1 (rem e1 63u))
        (wco (+ co0 (rem t 32u)))                  ; the same channel for all four tap slots
        (wkx (/ t 32u))                            ; tap slot j holds kx = wkx + 8j
        (px0 0.0) (px1 0.0) (pw0 0.0) (pw1 0.0) (pw2 0.0) (pw3 0.0)
        (a0 (splat 0.0)) (a1 (splat 0.0)) (a2 (splat 0.0)) (a3 (splat 0.0))
        (a4 (splat 0.0)) (a5 (splat 0.0)) (a6 (splat 0.0)) (a7 (splat 0.0)))
    (declare (uniform C H K O NS))
    (dotimes+ (s (+ NS 1u))
      (when+ (> s 0u)
        (sync-workgroup)
        (set! (~ xs t) px0)
        (when (< e1 504u) (set! (~ xs e1) px1))
        (set! (~ ws t) pw0)
        (when (< e1 (* K 32u)) (set! (~ ws e1) pw1))
        (when (< (+ t 512u) (* K 32u)) (set! (~ ws (+ t 512u)) pw2))
        (when (< (+ t 768u) (* K 32u)) (set! (~ ws (+ t 768u)) pw3))
        (sync-workgroup))
      (when (< s NS)
        (let ((ci   (/ s K))
              (ky   (rem s K))
              (xpl  (* (+ (* b C) ci) H))           ; plane (b, ci)
              (wrow (* (+ (* ci K) ky) K)))         ; WT row of (ci, ky, kx = 0)
          (let ((gy (+ oy0 ky xy0)) (gx (+ ox0 xx0)))
            (set! px0 (if (and (< gy H) (< gx H)) (~ X (+ (* (+ xpl gy) H) gx)) 0.0)))
          (let ((gy (+ oy0 ky xy1)) (gx (+ ox0 xx1)))
            (set! px1 (if (and (< e1 504u) (< gy H) (< gx H)) (~ X (+ (* (+ xpl gy) H) gx)) 0.0)))
          (when (< wco C)
            (set! pw0 (~ WT (+ (* (+ wrow wkx) C) wco)))
            (when (< (+ wkx 8u) K)  (set! pw1 (~ WT (+ (* (+ wrow wkx 8u) C) wco))))
            (when (< (+ wkx 16u) K) (set! pw2 (~ WT (+ (* (+ wrow wkx 16u) C) wco))))
            (when (< (+ wkx 24u) K) (set! pw3 (~ WT (+ (* (+ wrow wkx 24u) C) wco)))))))
      (when+ (> s 0u)
        (let ((xr (+ (* r 63u) c0))
              (xa (~ xs xr))
              (xb (~ xs (+ xr 1u)))
              (xc (~ xs (+ xr 2u))))
          (dotimes (kx K)
            (declare (unroll 4))
            (let ((xd (~ xs (+ xr kx 3u)))
                  (x4 ##(xa xb xc xd))
                  (wl (~ ws4 (+ (* kx 8u) (* g 2u))))
                  (wh (~ ws4 (+ (* kx 8u) (* g 2u) 1u))))
              (set! a0 (op-fma x4 (splat (x~ wl)) a0))
              (set! a1 (op-fma x4 (splat (y~ wl)) a1))
              (set! a2 (op-fma x4 (splat (z~ wl)) a2))
              (set! a3 (op-fma x4 (splat (w~ wl)) a3))
              (set! a4 (op-fma x4 (splat (x~ wh)) a4))
              (set! a5 (op-fma x4 (splat (y~ wh)) a5))
              (set! a6 (op-fma x4 (splat (z~ wh)) a6))
              (set! a7 (op-fma x4 (splat (w~ wh)) a7))
              (set! xa xb)
              (set! xb xc)
              (set! xc xd))))))
    (let ((oy (+ oy0 r))
          (ox (+ ox0 c0)))
      (when (< oy O)
        (dotimes (j 8u)
          (let ((co (+ co0 (* g 8u) j))
                (v  (cond ((= j 0u) a0) ((= j 1u) a1) ((= j 2u) a2) ((= j 3u) a3)
                          ((= j 4u) a4) ((= j 5u) a5) ((= j 6u) a6) (else a7))))
            (when (< co C)
              (let ((row (* (+ (* (+ (* b C) co) O) oy) O)))
                (when (< ox O)          (set! (~ Y (+ row ox))      (x~ v)))
                (when (< (+ ox 1u) O)  (set! (~ Y (+ row ox 1u))  (y~ v)))
                (when (< (+ ox 2u) O)  (set! (~ Y (+ row ox 2u))  (z~ v)))
                (when (< (+ ox 3u) O)  (set! (~ Y (+ row ox 3u))  (w~ v)))))))))))

;; v1p32r: v1p32 held to 80 registers (ptxas) so THREE workgroups fit per SM (86 -> 2).
(def-kernel conv_tiled_p32r (X WT dims &out Y)
  (declare #'(in-vec in-vec dims-vec &out out-vec => nil)
           (global-size :derive-from Y :strategy :strided)
           (local-size  :set-to 256)
           (max-registers 80))
  (let ((C   (to-uint (~ dims 0)))
        (H   (to-uint (~ dims 1)))
        (K   (to-uint (~ dims 2)))
        (O   (+ (- H K) 1u))
        (NS  (* C K))                               ; stages (not S: Lisp reads s and S as one symbol)
        (xs  (make-scratch-vector float 512))
        (ws  (make-scratch-vector float 1024))
        (ws4 (make-vector ws float4 :length 256ul))
        (nbx (/ (+ O 31u) 32u))
        (nby (/ (+ O 7u) 8u))
        (nco (/ (+ C 31u) 32u))
        (wg  (to-uint (get-workgroup-id 0)))
        (bx  (rem wg nbx))
        (by  (rem (/ wg nbx) nby))
        (cot (rem (/ wg (* nbx nby)) nco))
        (b   (/ wg (* nbx nby nco)))
        (ox0 (* bx 32u))
        (oy0 (* by 8u))
        (co0 (* cot 32u))
        (t   (to-uint (get-local-linear-id)))
        (g   (/ t 64u))
        (r   (rem (/ t 8u) 8u))
        (c0  (* (rem t 8u) 4u))
        ;; this thread's staging slots: input elements t and t + 256 of the 8 x 63 patch, taps t + 256j
        (e1  (+ t 256u))
        (xy0 (/ t 63u))  (xx0 (rem t 63u))
        (xy1 (/ e1 63u)) (xx1 (rem e1 63u))
        (wco (+ co0 (rem t 32u)))                  ; the same channel for all four tap slots
        (wkx (/ t 32u))                            ; tap slot j holds kx = wkx + 8j
        (px0 0.0) (px1 0.0) (pw0 0.0) (pw1 0.0) (pw2 0.0) (pw3 0.0)
        (a0 (splat 0.0)) (a1 (splat 0.0)) (a2 (splat 0.0)) (a3 (splat 0.0))
        (a4 (splat 0.0)) (a5 (splat 0.0)) (a6 (splat 0.0)) (a7 (splat 0.0)))
    (declare (uniform C H K O NS))
    (dotimes+ (s (+ NS 1u))
      (when+ (> s 0u)
        (sync-workgroup)
        (set! (~ xs t) px0)
        (when (< e1 504u) (set! (~ xs e1) px1))
        (set! (~ ws t) pw0)
        (when (< e1 (* K 32u)) (set! (~ ws e1) pw1))
        (when (< (+ t 512u) (* K 32u)) (set! (~ ws (+ t 512u)) pw2))
        (when (< (+ t 768u) (* K 32u)) (set! (~ ws (+ t 768u)) pw3))
        (sync-workgroup))
      (when (< s NS)
        (let ((ci   (/ s K))
              (ky   (rem s K))
              (xpl  (* (+ (* b C) ci) H))           ; plane (b, ci)
              (wrow (* (+ (* ci K) ky) K)))         ; WT row of (ci, ky, kx = 0)
          (let ((gy (+ oy0 ky xy0)) (gx (+ ox0 xx0)))
            (set! px0 (if (and (< gy H) (< gx H)) (~ X (+ (* (+ xpl gy) H) gx)) 0.0)))
          (let ((gy (+ oy0 ky xy1)) (gx (+ ox0 xx1)))
            (set! px1 (if (and (< e1 504u) (< gy H) (< gx H)) (~ X (+ (* (+ xpl gy) H) gx)) 0.0)))
          (when (< wco C)
            (set! pw0 (~ WT (+ (* (+ wrow wkx) C) wco)))
            (when (< (+ wkx 8u) K)  (set! pw1 (~ WT (+ (* (+ wrow wkx 8u) C) wco))))
            (when (< (+ wkx 16u) K) (set! pw2 (~ WT (+ (* (+ wrow wkx 16u) C) wco))))
            (when (< (+ wkx 24u) K) (set! pw3 (~ WT (+ (* (+ wrow wkx 24u) C) wco)))))))
      (when+ (> s 0u)
        (let ((xr (+ (* r 63u) c0))
              (xa (~ xs xr))
              (xb (~ xs (+ xr 1u)))
              (xc (~ xs (+ xr 2u))))
          (dotimes (kx K)
            (declare (unroll 4))
            (let ((xd (~ xs (+ xr kx 3u)))
                  (x4 ##(xa xb xc xd))
                  (wl (~ ws4 (+ (* kx 8u) (* g 2u))))
                  (wh (~ ws4 (+ (* kx 8u) (* g 2u) 1u))))
              (set! a0 (op-fma x4 (splat (x~ wl)) a0))
              (set! a1 (op-fma x4 (splat (y~ wl)) a1))
              (set! a2 (op-fma x4 (splat (z~ wl)) a2))
              (set! a3 (op-fma x4 (splat (w~ wl)) a3))
              (set! a4 (op-fma x4 (splat (x~ wh)) a4))
              (set! a5 (op-fma x4 (splat (y~ wh)) a5))
              (set! a6 (op-fma x4 (splat (z~ wh)) a6))
              (set! a7 (op-fma x4 (splat (w~ wh)) a7))
              (set! xa xb)
              (set! xb xc)
              (set! xc xd))))))
    (let ((oy (+ oy0 r))
          (ox (+ ox0 c0)))
      (when (< oy O)
        (dotimes (j 8u)
          (let ((co (+ co0 (* g 8u) j))
                (v  (cond ((= j 0u) a0) ((= j 1u) a1) ((= j 2u) a2) ((= j 3u) a3)
                          ((= j 4u) a4) ((= j 5u) a5) ((= j 6u) a6) (else a7))))
            (when (< co C)
              (let ((row (* (+ (* (+ (* b C) co) O) oy) O)))
                (when (< ox O)          (set! (~ Y (+ row ox))      (x~ v)))
                (when (< (+ ox 1u) O)  (set! (~ Y (+ row ox 1u))  (y~ v)))
                (when (< (+ ox 2u) O)  (set! (~ Y (+ row ox 2u))  (z~ v)))
                (when (< (+ ox 3u) O)  (set! (~ Y (+ row ox 3u))  (w~ v)))))))))))

;; v1p32e: v1p32 on a grid the HOST chooses (dims = C, H, K, B, nbx, nby).  O = 225 is 7 x 32 + 1 and 28 x 8 + 1,
;; so the last column and the last row of patches hold one useful line each (15% of the workgroups).  The host
;; rounds the patch counts DOWN when the leftover strip is thin and conv_edge computes that strip.
(def-kernel conv_tiled_p32e (X WT dims &out Y)
  (declare #'(in-vec in-vec dims-vec &out out-vec => nil)
           (global-size :derive-from Y :strategy :strided)
           (local-size  :set-to 256))
  (let ((C   (to-uint (~ dims 0)))
        (H   (to-uint (~ dims 1)))
        (K   (to-uint (~ dims 2)))
        (O   (+ (- H K) 1u))
        (NS  (* C K))                               ; stages (not S: Lisp reads s and S as one symbol)
        (xs  (make-scratch-vector float 512))
        (ws  (make-scratch-vector float 1024))
        (ws4 (make-vector ws float4 :length 256ul))
        (nbx (to-uint (~ dims 4)))                  ; patch columns, chosen by the host
        (nby (to-uint (~ dims 5)))                  ; patch rows
        (nco (/ (+ C 31u) 32u))
        (wg  (to-uint (get-workgroup-id 0)))
        (bx  (rem wg nbx))
        (by  (rem (/ wg nbx) nby))
        (cot (rem (/ wg (* nbx nby)) nco))
        (b   (/ wg (* nbx nby nco)))
        (ox0 (* bx 32u))
        (oy0 (* by 8u))
        (co0 (* cot 32u))
        (t   (to-uint (get-local-linear-id)))
        (g   (/ t 64u))
        (r   (rem (/ t 8u) 8u))
        (c0  (* (rem t 8u) 4u))
        ;; this thread's staging slots: input elements t and t + 256 of the 8 x 63 patch, taps t + 256j
        (e1  (+ t 256u))
        (xy0 (/ t 63u))  (xx0 (rem t 63u))
        (xy1 (/ e1 63u)) (xx1 (rem e1 63u))
        (wco (+ co0 (rem t 32u)))                  ; the same channel for all four tap slots
        (wkx (/ t 32u))                            ; tap slot j holds kx = wkx + 8j
        (px0 0.0) (px1 0.0) (pw0 0.0) (pw1 0.0) (pw2 0.0) (pw3 0.0)
        (a0 (splat 0.0)) (a1 (splat 0.0)) (a2 (splat 0.0)) (a3 (splat 0.0))
        (a4 (splat 0.0)) (a5 (splat 0.0)) (a6 (splat 0.0)) (a7 (splat 0.0)))
    (declare (uniform C H K O NS))
    (dotimes+ (s (+ NS 1u))
      (when+ (> s 0u)
        (sync-workgroup)
        (set! (~ xs t) px0)
        (when (< e1 504u) (set! (~ xs e1) px1))
        (set! (~ ws t) pw0)
        (when (< e1 (* K 32u)) (set! (~ ws e1) pw1))
        (when (< (+ t 512u) (* K 32u)) (set! (~ ws (+ t 512u)) pw2))
        (when (< (+ t 768u) (* K 32u)) (set! (~ ws (+ t 768u)) pw3))
        (sync-workgroup))
      (when (< s NS)
        (let ((ci   (/ s K))
              (ky   (rem s K))
              (xpl  (* (+ (* b C) ci) H))           ; plane (b, ci)
              (wrow (* (+ (* ci K) ky) K)))         ; WT row of (ci, ky, kx = 0)
          (let ((gy (+ oy0 ky xy0)) (gx (+ ox0 xx0)))
            (set! px0 (if (and (< gy H) (< gx H)) (~ X (+ (* (+ xpl gy) H) gx)) 0.0)))
          (let ((gy (+ oy0 ky xy1)) (gx (+ ox0 xx1)))
            (set! px1 (if (and (< e1 504u) (< gy H) (< gx H)) (~ X (+ (* (+ xpl gy) H) gx)) 0.0)))
          (when (< wco C)
            (set! pw0 (~ WT (+ (* (+ wrow wkx) C) wco)))
            (when (< (+ wkx 8u) K)  (set! pw1 (~ WT (+ (* (+ wrow wkx 8u) C) wco))))
            (when (< (+ wkx 16u) K) (set! pw2 (~ WT (+ (* (+ wrow wkx 16u) C) wco))))
            (when (< (+ wkx 24u) K) (set! pw3 (~ WT (+ (* (+ wrow wkx 24u) C) wco)))))))
      (when+ (> s 0u)
        (let ((xr (+ (* r 63u) c0))
              (xa (~ xs xr))
              (xb (~ xs (+ xr 1u)))
              (xc (~ xs (+ xr 2u))))
          (dotimes (kx K)
            (declare (unroll 4))
            (let ((xd (~ xs (+ xr kx 3u)))
                  (x4 ##(xa xb xc xd))
                  (wl (~ ws4 (+ (* kx 8u) (* g 2u))))
                  (wh (~ ws4 (+ (* kx 8u) (* g 2u) 1u))))
              (set! a0 (op-fma x4 (splat (x~ wl)) a0))
              (set! a1 (op-fma x4 (splat (y~ wl)) a1))
              (set! a2 (op-fma x4 (splat (z~ wl)) a2))
              (set! a3 (op-fma x4 (splat (w~ wl)) a3))
              (set! a4 (op-fma x4 (splat (x~ wh)) a4))
              (set! a5 (op-fma x4 (splat (y~ wh)) a5))
              (set! a6 (op-fma x4 (splat (z~ wh)) a6))
              (set! a7 (op-fma x4 (splat (w~ wh)) a7))
              (set! xa xb)
              (set! xb xc)
              (set! xc xd))))))
    (let ((oy (+ oy0 r))
          (ox (+ ox0 c0)))
      (when (< oy O)
        (dotimes (j 8u)
          (let ((co (+ co0 (* g 8u) j))
                (v  (cond ((= j 0u) a0) ((= j 1u) a1) ((= j 2u) a2) ((= j 3u) a3)
                          ((= j 4u) a4) ((= j 5u) a5) ((= j 6u) a6) (else a7))))
            (when (< co C)
              (let ((row (* (+ (* (+ (* b C) co) O) oy) O)))
                (when (< ox O)          (set! (~ Y (+ row ox))      (x~ v)))
                (when (< (+ ox 1u) O)  (set! (~ Y (+ row ox 1u))  (y~ v)))
                (when (< (+ ox 2u) O)  (set! (~ Y (+ row ox 2u))  (z~ v)))
                (when (< (+ ox 3u) O)  (set! (~ Y (+ row ox 3u))  (w~ v)))))))))))

;; conv_edge: the outputs the patch grid leaves out -- columns x-lim .. O-1 of rows 0 .. y-lim-1, then rows
;; y-lim .. O-1 entire -- one thread each, the same (ci, ky, kx) chain as everywhere else.
;; x-lim = min(32 nbx, O), y-lim = min(8 nby, O).  Threads = B * C * (y-lim * (O - x-lim) + (O - y-lim) * O).
(def-kernel conv_edge (X W dims &out Y)
  (declare #'(in-vec in-vec dims-vec &out out-vec => nil)
           (global-size :derive-from Y :strategy :strided)
           (local-size  :set-to 256))
  (let ((C    (to-uint (~ dims 0)))
        (H    (to-uint (~ dims 1)))
        (K    (to-uint (~ dims 2)))
        (NB   (to-uint (~ dims 3)))
        (O    (+ (- H K) 1u))
        (xlim (min (* (to-uint (~ dims 4)) 32u) O))
        (ylim (min (* (to-uint (~ dims 5)) 8u) O))
        (wx   (- O xlim))
        (E    (+ (* ylim wx) (* (- O ylim) O)))   ; edge outputs per (b, co) plane
        (n    (* NB C E))
        (i    (to-uint (get-global-id 0))))
    (when (< i n)
      (let ((j  (rem i E))
            (co (rem (/ i E) C))
            (b  (/ i (* E C)))
            (in-a (< j (* ylim wx)))
            (jb (- j (* ylim wx)))
            (oy (if in-a (/ j wx) (+ ylim (/ jb O))))
            (ox (if in-a (+ xlim (rem j wx)) (rem jb O)))
            (acc 0.0))
        (dotimes (ci C)
          (dotimes (ky K)
            (let ((x-row (+ (* (+ (* (+ (* b C) ci) H) oy ky) H) ox))
                  (w-row (* (+ (* (+ (* co C) ci) K) ky) K)))
              (dotimes (kx K)
                (set! acc (op-fma (~ X (+ x-row kx)) (~ W (+ w-row kx)) acc))))))
        (set! (~ Y (+ (* (+ (* (+ (* b C) co) O) oy) O) ox)) acc)))))

;; v1pe: v1p (64-bit indices -- faster than p32 on the H100) on the host-chosen grid of v1p32e; the thin
;; leftover strips go to conv_edge.
(def-kernel conv_tiled_pe (X WT dims &out Y)
  (declare #'(in-vec in-vec dims-vec &out out-vec => nil)
           (global-size :derive-from Y :strategy :strided)
           (local-size  :set-to 256))
  (let ((C   (to-ulong (~ dims 0)))
        (H   (to-ulong (~ dims 1)))
        (K   (to-ulong (~ dims 2)))
        (O   (+ (- H K) 1ul))
        (NS  (* C K))                               ; stages (not S: Lisp reads s and S as one symbol)
        (xs  (make-scratch-vector float 512))
        (ws  (make-scratch-vector float 1024))
        (ws4 (make-vector ws float4 :length 256ul))
        (nbx (to-ulong (~ dims 4)))                 ; patch columns, chosen by the host
        (nby (to-ulong (~ dims 5)))                 ; patch rows
        (nco (/ (+ C 31ul) 32ul))
        (wg  (get-workgroup-id 0))
        (bx  (rem wg nbx))
        (by  (rem (/ wg nbx) nby))
        (cot (rem (/ wg (* nbx nby)) nco))
        (b   (/ wg (* nbx nby nco)))
        (ox0 (* bx 32ul))
        (oy0 (* by 8ul))
        (co0 (* cot 32ul))
        (t   (get-local-linear-id))
        (g   (/ t 64ul))
        (r   (rem (/ t 8ul) 8ul))
        (c0  (* (rem t 8ul) 4ul))
        ;; this thread's staging slots: input elements t and t + 256 of the 8 x 63 patch, taps t + 256j
        (e1  (+ t 256ul))
        (xy0 (/ t 63ul))  (xx0 (rem t 63ul))
        (xy1 (/ e1 63ul)) (xx1 (rem e1 63ul))
        (wco (+ co0 (rem t 32ul)))                  ; the same channel for all four tap slots
        (wkx (/ t 32ul))                            ; tap slot j holds kx = wkx + 8j
        (px0 0.0) (px1 0.0) (pw0 0.0) (pw1 0.0) (pw2 0.0) (pw3 0.0)
        (a0 (splat 0.0)) (a1 (splat 0.0)) (a2 (splat 0.0)) (a3 (splat 0.0))
        (a4 (splat 0.0)) (a5 (splat 0.0)) (a6 (splat 0.0)) (a7 (splat 0.0)))
    (declare (uniform C H K O NS))
    (dotimes+ (s (+ NS 1ul))
      (when+ (> s 0ul)
        (sync-workgroup)
        (set! (~ xs t) px0)
        (when (< e1 504ul) (set! (~ xs e1) px1))
        (set! (~ ws t) pw0)
        (when (< e1 (* K 32ul)) (set! (~ ws e1) pw1))
        (when (< (+ t 512ul) (* K 32ul)) (set! (~ ws (+ t 512ul)) pw2))
        (when (< (+ t 768ul) (* K 32ul)) (set! (~ ws (+ t 768ul)) pw3))
        (sync-workgroup))
      (when (< s NS)
        (let ((ci   (/ s K))
              (ky   (rem s K))
              (xpl  (* (+ (* b C) ci) H))           ; plane (b, ci)
              (wrow (* (+ (* ci K) ky) K)))         ; WT row of (ci, ky, kx = 0)
          (let ((gy (+ oy0 ky xy0)) (gx (+ ox0 xx0)))
            (set! px0 (if (and (< gy H) (< gx H)) (~ X (+ (* (+ xpl gy) H) gx)) 0.0)))
          (let ((gy (+ oy0 ky xy1)) (gx (+ ox0 xx1)))
            (set! px1 (if (and (< e1 504ul) (< gy H) (< gx H)) (~ X (+ (* (+ xpl gy) H) gx)) 0.0)))
          (when (< wco C)
            (set! pw0 (~ WT (+ (* (+ wrow wkx) C) wco)))
            (when (< (+ wkx 8ul) K)  (set! pw1 (~ WT (+ (* (+ wrow wkx 8ul) C) wco))))
            (when (< (+ wkx 16ul) K) (set! pw2 (~ WT (+ (* (+ wrow wkx 16ul) C) wco))))
            (when (< (+ wkx 24ul) K) (set! pw3 (~ WT (+ (* (+ wrow wkx 24ul) C) wco)))))))
      (when+ (> s 0ul)
        (let ((xr (+ (* r 63ul) c0))
              (xa (~ xs xr))
              (xb (~ xs (+ xr 1ul)))
              (xc (~ xs (+ xr 2ul))))
          (dotimes (kx K)
            (declare (unroll 4))
            (let ((xd (~ xs (+ xr kx 3ul)))
                  (x4 ##(xa xb xc xd))
                  (wl (~ ws4 (+ (* kx 8ul) (* g 2ul))))
                  (wh (~ ws4 (+ (* kx 8ul) (* g 2ul) 1ul))))
              (set! a0 (op-fma x4 (splat (x~ wl)) a0))
              (set! a1 (op-fma x4 (splat (y~ wl)) a1))
              (set! a2 (op-fma x4 (splat (z~ wl)) a2))
              (set! a3 (op-fma x4 (splat (w~ wl)) a3))
              (set! a4 (op-fma x4 (splat (x~ wh)) a4))
              (set! a5 (op-fma x4 (splat (y~ wh)) a5))
              (set! a6 (op-fma x4 (splat (z~ wh)) a6))
              (set! a7 (op-fma x4 (splat (w~ wh)) a7))
              (set! xa xb)
              (set! xb xc)
              (set! xc xd))))))
    (let ((oy (+ oy0 r))
          (ox (+ ox0 c0)))
      (when (< oy O)
        (dotimes (j 8ul)
          (let ((co (+ co0 (* g 8ul) j))
                (v  (cond ((= j 0ul) a0) ((= j 1ul) a1) ((= j 2ul) a2) ((= j 3ul) a3)
                          ((= j 4ul) a4) ((= j 5ul) a5) ((= j 6ul) a6) (else a7))))
            (when (< co C)
              (let ((row (* (+ (* (+ (* b C) co) O) oy) O)))
                (when (< ox O)          (set! (~ Y (+ row ox))      (x~ v)))
                (when (< (+ ox 1ul) O)  (set! (~ Y (+ row ox 1ul))  (y~ v)))
                (when (< (+ ox 2ul) O)  (set! (~ Y (+ row ox 2ul))  (z~ v)))
                (when (< (+ ox 3ul) O)  (set! (~ Y (+ row ox 3ul))  (w~ v)))))))))))
