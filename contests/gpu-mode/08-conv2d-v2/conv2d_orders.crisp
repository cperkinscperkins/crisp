;; conv2d_v2 DIAGNOSTIC kernels: does one sequential fp32 FMA chain reproduce cuDNN's rounding?
;; The fp32 cuDNN reference is ~2e-3 rms off the exact answer at K=32, C=128 (diag 2026-11-11), so the
;; checker wants cuDNN's error, not accuracy.  Two orders of the 131072-term chain:
;;   conv_crs : ci outer, then ky, then kx   (K index = (ci * K + ky) * K + kx, NCHW / KCRS order)
;;   conv_rsc : ky outer, then kx, then ci   (K index = (ky * K + kx) * C + ci, NHWC-style order)
(def-type in-vec   (vector float :address-space :global :align :compact))
(def-type out-vec  (vector float :address-space :global :align :compact))
(def-type dims-vec (vector int   :address-space :global :align :compact))

(def-kernel conv_crs (X W dims &out Y)
  (declare #'(in-vec in-vec dims-vec &out out-vec => nil)
           (global-size :derive-from Y :strategy :strided)
           (local-size  :set-to 256))
  (let ((C (to-ulong (~ dims 0)))
        (H (to-ulong (~ dims 1)))
        (K (to-ulong (~ dims 2)))
        (O (+ (- H K) 1ul)))
    (loop-vector-stride Y (i)
      (let ((ox (rem i O))
            (oy (rem (/ i O) O))
            (co (rem (/ i (* O O)) C))
            (b  (/ i (* O O C)))
            (acc 0.0))
        (dotimes (ci C)
          (dotimes (ky K)
            (let ((x-row (+ (* (+ (* (+ (* b C) ci) H) oy ky) H) ox))
                  (w-row (* (+ (* (+ (* co C) ci) K) ky) K)))
              (dotimes (kx K)
                (set! acc (op-fma (~ X (+ x-row kx)) (~ W (+ w-row kx)) acc))))))
        (set! (~ Y i) acc)))))

(def-kernel conv_rsc (X W dims &out Y)
  (declare #'(in-vec in-vec dims-vec &out out-vec => nil)
           (global-size :derive-from Y :strategy :strided)
           (local-size  :set-to 256))
  (let ((C (to-ulong (~ dims 0)))
        (H (to-ulong (~ dims 1)))
        (K (to-ulong (~ dims 2)))
        (O (+ (- H K) 1ul)))
    (loop-vector-stride Y (i)
      (let ((ox (rem i O))
            (oy (rem (/ i O) O))
            (co (rem (/ i (* O O)) C))
            (b  (/ i (* O O C)))
            (acc 0.0))
        (dotimes (ky K)
          (dotimes (kx K)
            (dotimes (ci C)
              (set! acc (op-fma (~ X (+ (* (+ (* (+ (* b C) ci) H) oy ky) H) ox kx))
                                (~ W (+ (* (+ (* (+ (* co C) ci) K) ky) K) kx))
                                acc)))))
        (set! (~ Y i) acc)))))
