;; GPU MODE Challenge: vectoradd_v2 (Variant 2: Direct 4x half4 per thread with constant +256 stride)
;; Each block of 256 threads processes 1024 half4s (4096 halfs = 8 KB) using constant immediate
;; PTX displacements [+2048], [+4096], [+6144] and issues all 8 loads before the 4 stores.

(def-type in-vec  (vector half :address-space :global :align :compact))
(def-type out-vec (vector half :address-space :global :align :compact))

(def-kernel vector_add_f16 (A B &out C)
  (declare #'(in-vec in-vec &out out-vec => nil)
           (global-size :derive-from A :strategy :strided)
           (local-size  :set-to 256))
  (let ((bid  (to-ulong (get-workgroup-id 0)))
        (tid  (to-ulong (get-local-id 0)))
        (base (+ (* bid 1024ul) tid))
        (n    (length~ A))
        (n4   (/ n 4ul))
        (a4   (make-vector A half4 :length n4))
        (b4   (make-vector B half4 :length n4))
        (c4   (make-vector C half4 :length n4)))
    (if (< (+ (* bid 1024ul) 1023ul) n4)
        (let ((v0 (+ (~ a4 base)           (~ b4 base)))
              (v1 (+ (~ a4 (+ base 256ul)) (~ b4 (+ base 256ul))))
              (v2 (+ (~ a4 (+ base 512ul)) (~ b4 (+ base 512ul))))
              (v3 (+ (~ a4 (+ base 768ul)) (~ b4 (+ base 768ul)))))
          (set! (~ c4 base)           v0)
          (set! (~ c4 (+ base 256ul)) v1)
          (set! (~ c4 (+ base 512ul)) v2)
          (set! (~ c4 (+ base 768ul)) v3))
        (progn
          (when (< base n4)
            (set! (~ c4 base) (+ (~ a4 base) (~ b4 base))))
          (when (< (+ base 256ul) n4)
            (set! (~ c4 (+ base 256ul)) (+ (~ a4 (+ base 256ul)) (~ b4 (+ base 256ul)))))
          (when (< (+ base 512ul) n4)
            (set! (~ c4 (+ base 512ul)) (+ (~ a4 (+ base 512ul)) (~ b4 (+ base 512ul)))))
          (when (< (+ base 768ul) n4)
            (set! (~ c4 (+ base 768ul)) (+ (~ a4 (+ base 768ul)) (~ b4 (+ base 768ul)))))
          (let ((tail (+ (* n4 4ul) tid)))
            (when (and (= bid 0ul) (< tail n))
              (set! (~ C tail) (+ (~ A tail) (~ B tail)))))))))

