# Crisp Intel benchmark image
#
# Base: intel/oneapi-basekit (DPC++, oneDPL, L0 driver, OpenCL runtime)
# Adds: SBCL, LLVM-21 (llc / opt / llvm-as / llvm-spirv), Quicklisp
#
# Built and used by scripts/bench-intel.sh.  Intended for running
# Crisp-vs-SYCL-vs-oneDPL competitive benchmarks on an Intel GPU
# (BMG / Arc / iGPU) inside a Docker container on Windows + WSL2.
#
# GPU passthrough (REQUIRED for L0 GPU device — see scripts/bench-intel.sh):
#   docker run --device=/dev/dxg \
#              -v /usr/lib/wsl:/usr/lib/wsl \
#              -e LD_LIBRARY_PATH=/usr/lib/wsl/lib:... \
#              ...
# Without these, only CPU OpenCL is visible.  With them, sycl-ls reports
# the BMG via both level_zero:gpu and opencl:gpu.

FROM intel/oneapi-basekit:latest

# Don't prompt during apt-get
ENV DEBIAN_FRONTEND=noninteractive

# Pin SBCL version — same as scripts/bench-on-pod.sh uses on RunPod
ARG SBCL_VERSION=2.5.5

# ----------------------------------------------------------------------
# Base deps + LLVM-21 toolchain
# ----------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
        wget bzip2 curl ca-certificates gnupg lsb-release \
        software-properties-common build-essential \
    && wget -qO- https://apt.llvm.org/llvm-snapshot.gpg.key \
       | gpg --dearmor -o /usr/share/keyrings/llvm-archive-keyring.gpg \
    && echo "deb [signed-by=/usr/share/keyrings/llvm-archive-keyring.gpg] http://apt.llvm.org/$(lsb_release -cs)/ llvm-toolchain-$(lsb_release -cs)-21 main" \
       > /etc/apt/sources.list.d/llvm-21.list \
    && apt-get update && apt-get install -y --no-install-recommends \
        llvm-21 llvm-21-dev clang-21 \
    && ln -sf /usr/bin/llc-21 /usr/bin/llc \
    && ln -sf /usr/bin/opt-21 /usr/bin/opt \
    && ln -sf /usr/bin/llvm-as-21 /usr/bin/llvm-as \
    && rm -rf /var/lib/apt/lists/*

# ----------------------------------------------------------------------
# llvm-spirv — not in apt.llvm.org 21.x as a separate package, but the
# oneAPI base image ships SPIRV-LLVM-Translator inside the compiler dir.
# Symlink it onto PATH so Crisp's `(resolve-tool-executable "llvm-spirv")`
# finds it.
# ----------------------------------------------------------------------
RUN ln -sf /opt/intel/oneapi/compiler/2025.3/bin/compiler/llvm-spirv /usr/bin/llvm-spirv

# ocloc -- Intel's offline compiler, needed for AOT (-fsycl-targets=spir64_gen -device bmg-g21).
# SYCL-TLA's own CMake DEFAULTS to AOT (spir64_gen); JIT (spir64) is the non-default path.  Without
# ocloc, scripts/crisp_bench/matmul.py's `if shutil.which("ocloc")` silently fell back to JIT, so
# the peer was built in the one configuration upstream does not test -- and said so only in a note.
#
# The image already shipped an ocloc under vtune/.../GTPin, but it needs LD_LIBRARY_PATH and its
# device list ends at pvc / mtl / xe-lpg -- `ocloc ids bmg-g21` answers "Unknown acronym".  The apt
# package is version-matched to the runtime: intel-ocloc 25.18.33578.15 against a driver reporting
# 1.6.33578, and `ocloc ids bmg-g21` resolves to 20.1.0, exactly what sycl-ls reports for the B580.
#
# NOTE: ocloc alone does NOT fix SYCL-TLA — under this apt runtime its own unmodified example failed
# verification on AOT and JIT alike, on v0.9.2 and on main.  ocloc is here because AOT is the
# configuration upstream supports and because the fallback to JIT was silent.  What DID fix it is
# the runtime/IGC upgrade in the next block; this apt install is now only the version FLOOR that
# block replaces, kept because it also pulls the ICD wiring the newer debs expect to find.
RUN apt-get update     && apt-get install -y --no-install-recommends intel-ocloc     && rm -rf /var/lib/apt/lists/*

# ----------------------------------------------------------------------
# Intel compute runtime + IGC — PINNED, and NEWER than any apt source carries.
#
# WHY THIS BLOCK EXISTS.  Until 2026-08-28 this image took its whole Intel GPU stack from
# `repositories.intel.com/gpu/ubuntu noble`, whose newest build is 25.18.33578.  SYCL-TLA's own CI
# runs BMG against 25.48+.  BELOW THAT FLOOR ITS MODERN COLLECTIVE IS SILENTLY MISCOMPILED:
# MainloopXeL1Staged uses inline vISA `lsc_load_block2d` with address payloads, and on 25.18 that
# kernel builds clean, launches clean, raises no fault, returns Success — and writes an all-zero
# output matrix.  That is what quarantined 44 peer sweeps / 247 points; see
# benchmarks/results/invalid-peer-2026-08-28/README.md.
#
# The six hypotheses in that README all varied something SYCL-TLA-side (harness, library version,
# checkout, JIT/AOT, L0/OpenCL, build macros) and all were falsified, because the RUNTIME looked
# verified-good: Crisp's own Subgroup2DBlockLoadINTEL + SubgroupMatrixMultiplyAccumulateINTEL
# kernels ran correct through it at 108.9 TFLOPS.  They did, and it was broken anyway — Crisp emits
# SPIR-V instructions, the modern collective emits inline vISA, and only the latter was affected.
# It was never a WSL2 problem and never a SYCL-TLA bug; the host driver was current throughout.
#
# On 26.27 the SAME clone, config and compiler passes: upstream's 00_bmg_gemm reports
# `Disposition: Passed`, and our own peer verifies with max_abs_err exactly 0.
#
# NOTE ON PROVENANCE: these versions exist ONLY as GitHub release debs — no apt source has them, so
# this cannot be expressed as an apt pin.  IGC 2.38.2 is the revision compute-runtime 26.27.39122.11
# names as its build pair; bump them together, never one alone.
#
# The new IGC installs into /usr/local/lib, which PRECEDES /lib/x86_64-linux-gnu in ld.so search
# order, so it wins even if the old one is present — but leaving apt's libigc2 (2.11.12) installed
# and merely shadowed is a trap for the next person who reads `apt list --installed` to find out
# which compiler is live.  Purge it; with the new stack in, nothing depends on it.
# ----------------------------------------------------------------------
ARG NEO_VERSION=26.27.39122.11
ARG IGC_VERSION=2.38.2
ARG IGC_BUILD=22051
ARG GMMLIB_VERSION=22.10.0
RUN mkdir -p /tmp/neo && cd /tmp/neo \
    && IGC_URL="https://github.com/intel/intel-graphics-compiler/releases/download/v${IGC_VERSION}" \
    && NEO_URL="https://github.com/intel/compute-runtime/releases/download/${NEO_VERSION}" \
    && wget -q "${IGC_URL}/intel-igc-core-2_${IGC_VERSION}%2B${IGC_BUILD}_amd64.deb" \
    && wget -q "${IGC_URL}/intel-igc-opencl-2_${IGC_VERSION}%2B${IGC_BUILD}_amd64.deb" \
    && wget -q "${NEO_URL}/intel-opencl-icd_${NEO_VERSION}-0_amd64.deb" \
    && wget -q "${NEO_URL}/libze-intel-gpu1_${NEO_VERSION}-0_amd64.deb" \
    && wget -q "${NEO_URL}/intel-ocloc_${NEO_VERSION}-0_amd64.deb" \
    && wget -q "${NEO_URL}/libigdgmm12_${GMMLIB_VERSION}_amd64.deb" \
    && dpkg -i ./*.deb \
    && apt-get purge -y libigc2 libigdfcl2 \
    && ldconfig \
    && cd / && rm -rf /tmp/neo

# ----------------------------------------------------------------------
# SBCL — install from upstream binary tarball
# ----------------------------------------------------------------------
RUN cd /tmp \
    && wget -q "https://prdownloads.sourceforge.net/sbcl/sbcl-${SBCL_VERSION}-x86-64-linux-binary.tar.bz2" \
    && tar xjf "sbcl-${SBCL_VERSION}-x86-64-linux-binary.tar.bz2" \
    && cd "sbcl-${SBCL_VERSION}-x86-64-linux" \
    && INSTALL_ROOT=/usr/local sh install.sh \
    && cd / && rm -rf "/tmp/sbcl-${SBCL_VERSION}"*

# ----------------------------------------------------------------------
# Quicklisp — preinstall for the root user that runs benchmarks
# Silent install so JSON-RPC-style consumers don't see chatter
# ----------------------------------------------------------------------
RUN curl -sO https://beta.quicklisp.org/quicklisp.lisp \
    && echo "" | sbcl --non-interactive \
         --load quicklisp.lisp \
         --eval '(quicklisp-quickstart:install)' \
         --eval '(ql:add-to-init-file)' \
         --eval '(quit)' \
    && rm -f quicklisp.lisp

# ----------------------------------------------------------------------
# Final environment
# ----------------------------------------------------------------------
# Source the oneAPI environment for every shell.
RUN echo '. /opt/intel/oneapi/setvars.sh > /dev/null 2>&1' >> /etc/bash.bashrc

# Crisp build expects to find system tools (opt, llc, llvm-spirv) on PATH.
ENV CRISP_USE_SYSTEM_TOOLS=true

WORKDIR /workspace
CMD ["bash"]
